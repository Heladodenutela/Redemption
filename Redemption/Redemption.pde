// Revisa si ganaste algún logro nuevo y lo anuncia.
void revisarLogros() {
  if (!logroHecho[1] && claseEstado.length > 0 && claseEstado[0] == 1) sumarBandera("PUNTUAL_D1", 1);
  if (amistad != null) for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 3) { if (bandera("PAREJA") <= 0) sumarBandera("PAREJA", 1); }
