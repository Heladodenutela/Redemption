// Lo llama clickHorario() al principio; true = el click ya se usó
boolean clickHorarioV22() {
  iniciarPropios();
  if (dentro(celX2 - 156, celY1 + 17, 140, 36)) {
    horEditor = !horEditor;
    if (horEditor) {
      for (int d = 0; d < 11; d++) horDias[d] = false;
      horDias[horarioDia] = true;
    }
    return true;
  }
  if (!horEditor) {
    for (int h = 6; h < 24; h++) {
      float y = HOR_Y0 + (h - 6) * HOR_FILA;
      if (esBloquePropio(horarioDia, h) && dentro(celX2 - 52, y, 30, HOR_FILA)) { quitarBloquePropio(horarioDia, h); return true; }
    }
    return false;
  }
  float x = celX1, y = celY1 + MSG_HEAD, w = celX2 - celX1;
  for (int i = 0; i < ACTIVIDADES_PROPIAS.length; i++) {
    float cx = x + 20 + (i % 2) * 262, cy = y + 38 + (i / 2) * 40;
    if (dentro(cx, cy, 250, 34)) { horAct = i; return true; }
  }
  float y2 = y + 38 + 6 * 40 + 8;
  if (dentro(x + 90, y2, 36, 36)) horHora = max(5, horHora - 1);
  if (dentro(x + 226, y2, 36, 36)) horHora = min(23, horHora + 1);
  if (dentro(x + 360, y2, 36, 36)) horDur = max(1, horDur - 1);
  if (dentro(x + 496, y2, 36, 36)) horDur = min(6, horDur + 1);
  float y3 = y2 + 56;
  float dw = (w - 110) / 10.0;
  for (int d = 1; d <= 10; d++) if (dentro(x + 84 + (d - 1) * dw + 2, y3, dw - 4, 36)) horDias[d] = !horDias[d];
  float y4 = y3 + 46;
  if (dentro(x + 84, y4, 150, 32)) for (int d = 1; d <= 10; d++) horDias[d] = true;
  if (dentro(x + 244, y4, 150, 32)) for (int d = 1; d <= 10; d++) horDias[d] = d != 6 && d != 7;
  float y5 = celY2 - 70;
  if (dentro(x + 20, y5, 200, 50)) horEditor = false;
  if (dentro(x + w - 300, y5, 280, 50)) agregarBloquesPropios();
  return true;
}

