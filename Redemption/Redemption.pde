  }
}

// ============================ CÁLCULO: PENDIENTE RÁPIDA ============================
// Sale una recta (o dos). ¿Sube, está plana o baja? (1, 2, 3 o click). Desde el nivel 3:
// ¿cuál de las dos sube más rápido? Contra el reloj.
int prRondas, prRonda, prBien, prFin, prError;
float prM1, prM2;
boolean prDoble;

// Empieza el minijuego de la pendiente.
void iniciarPendiente() {
  prRondas = 8 + nivelClase() * 2;
  prRonda = 0;
  prBien = 0;
  prFin = millis() + (40 - nivelClase() * 3) * 1000;
  nuevaRecta();
}

// Inventa una recta (o dos para comparar) al azar.
void nuevaRecta() {
  prDoble = nivelClase() >= 3 && random(1) < 0.5;
  if (prDoble) {
    prM1 = random(0.2, 2.5);
    if (random(1) < 0.5) prM2 = prM1 + 1 * random(0.4, 1.2); else prM2 = prM1 + (-1) * random(0.4, 1.2);
    if (prM2 < 0.1) prM2 = prM1 + 0.8;
  } else {
    float r = random(1);
    if (r < 0.4) prM1 = random(0.3, 2.5); else if (r < 0.8) prM1 = -random(0.3, 2.5); else prM1 = 0;
  }
}

final float PR_X = 450, PR_Y = 160, PR_T = 520;

// Dibuja el plano con la recta y las respuestas.
void dibujarPendiente() {
  noStroke();
  fill(25, 35, 50);
  rect(0, 0, ANCHO, ALTO);
  fill(250);
  rect(PR_X, PR_Y, PR_T, PR_T, 8);
  stroke(220);
  for (int i = 1; i < 10; i++) { line(PR_X + i * PR_T / 10, PR_Y, PR_X + i * PR_T / 10, PR_Y + PR_T); line(PR_X, PR_Y + i * PR_T / 10, PR_X + PR_T, PR_Y + i * PR_T / 10); }
  stroke(120);
  strokeWeight(2);
  line(PR_X, PR_Y + PR_T / 2, PR_X + PR_T, PR_Y + PR_T / 2);
  line(PR_X + PR_T / 2, PR_Y, PR_X + PR_T / 2, PR_Y + PR_T);
  strokeWeight(5);
  dibujarRecta(prM1, color(60, 120, 230));
  if (prDoble) dibujarRecta(prM2, color(230, 90, 60));
  strokeWeight(1);
  noStroke();
  fill(255);
  textSize(28);
  textAlign(CENTER, BASELINE);
  int resto = max(0, (prFin - millis()) / 1000);
  text("PENDIENTE RÁPIDA · " + (prRonda + 1) + " de " + prRondas + " · " + resto + " s · aciertos " + prBien, 800, 70);
  textSize(26);
  if (prDoble) text("¿Cuál sube más rápido?", 800, 125); else text("¿La recta sube, está plana o baja?", 800, 125);
  String[] op;
  if (prDoble) {
    op = new String[] { "La azul", "La roja" };
  } else {
    op = new String[] { "Sube (+)", "Plana (0)", "Baja (−)" };
  }
  for (int i = 0; i < op.length; i++) {
    float x = 1050, y = 240 + i * 120;
    boolean encima = mouseX > x && mouseX < x + 320 && mouseY > y && mouseY < y + 90;
    if (millis() < prError) {
      fill(color(255, 160, 160));
    } else {
      if (encima) fill(color(255, 225, 140)); else fill(color(245));
    }
    rect(x, y, 320, 90, 12);
    fill(30);
    textAlign(CENTER, CENTER);
    text((i + 1) + ")  " + op[i], x + 160, y + 45);
  }
  textAlign(LEFT, BASELINE);
  if (prRonda >= prRondas || millis() > prFin) {
    int notas;
    if (prBien >= prRondas * 0.8) notas = 3; else if (prBien >= prRondas / 2) notas = 1; else notas = 0;
    terminarMinijuegoClase(notas, "Acertaste " + prBien + " de " + prRondas + " pendientes.");
  }
}

// Dibuja una recta con pendiente m en el plano.
void dibujarRecta(float m, int c) {
  stroke(c);
  float cx = PR_X + PR_T / 2, cy = PR_Y + PR_T / 2, esc = PR_T / 10;
  float x1 = -5, x2 = 5;
  float y1 = constrain(m * x1, -5, 5), y2 = constrain(m * x2, -5, 5);
  if (m != 0) { x1 = y1 / m; x2 = y2 / m; }
  line(cx + x1 * esc, cy - y1 * esc, cx + x2 * esc, cy - y2 * esc);
}

// Elige si la pendiente es positiva, cero o negativa (o cuál es mayor).
void elegirPendiente(int i) {
  boolean bien;
  if (prDoble) bien = (i == 0) == (prM1 > prM2);
  else bien = (i == 0 && prM1 > 0) || (i == 1 && prM1 == 0) || (i == 2 && prM1 < 0);
  if (bien) prBien++;
  else { prError = millis() + 250; prFin -= 1500; }
  prRonda++;
  nuevaRecta();
}

// Click en una respuesta de la pendiente.
void clickPendiente() {
  int n;
  if (prDoble) n = 2; else n = 3;
  for (int i = 0; i < n; i++) {
    float x = 1050, y = 240 + i * 120;
    if (mouseX > x && mouseX < x + 320 && mouseY > y && mouseY < y + 90) elegirPendiente(i);
  }
}

