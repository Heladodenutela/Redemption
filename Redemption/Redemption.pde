// Si dejaste a alguien esperando, vuelve a escribirte (una vez por día).
void insistir(String chat, int f) {
  if (chatReclamoDia[f] == dia) return;
  for (int k = 0; k < INSISTE.length; k++) {
    if (INSISTE[k][0].equals(chat)) {
      chatReclamoDia[f] = dia;
      agregarMensaje(chat, '1', INSISTE[k][1 + dia % 2]);
      if (!noMolestar || !esDeNoche()) aviso("WhatsApp · " + chat + ": " + recortarTexto(INSISTE[k][1 + dia % 2], 50));
      return;
    }
  }
}

// ============================ "VISTO" ============================
// Abriste el chat, había algo por contestar y no contestaste en VISTO_HORAS: baja la amistad.
int[] vistoDesde = new int[MSG_FILAS];
boolean[] vistoCastigado = new boolean[MSG_FILAS];

// Minuto absoluto para medir cuánto llevas sin responder.
int minutoSocial() {
  return dia * 1440 + minutoJuego(minutoAhora());
}

// Revisa los mensajes que dejaste en visto mucho tiempo y castiga la amistad.
void revisarVistos() {
  if (msgPendiente == null) return;
  for (int f = 0; f < MSG_FILAS; f++) {
    if (msgPendiente[f] < 0 || msg[f][0].equals("")) { vistoDesde[f] = -1; vistoCastigado[f] = false; } else {
      if (vistoDesde[f] < 0 && cel == 6 && chatAbierto == f) vistoDesde[f] = minutoSocial();
      if (vistoDesde[f] >= 0 && !vistoCastigado[f] && minutoSocial() - vistoDesde[f] >= VISTO_HORAS * 60) {
        vistoCastigado[f] = true;
        castigarVisto(f, VISTO_CASTIGO, "Dejaste en visto a ");
      }
    }
  }
}

// Baja la amistad por dejar a alguien en visto y anota el reproche.
void castigarVisto(int fila, int cuanto, String texto) {
  String chat = msg[fila][0];
  if (esGrupo(chat) || esChatSistema(chat)) return;
  int p = personaDelChat(chat);
  if (p < 0) return;
  cambiarAmistad(p, -cuanto);
  vistoDia[p] = dia;
  aviso(texto + chat + " · amistad −" + cuanto);
}

// Al final del día (lo llama mensajesSinResponder antes de borrar lo pendiente)
void finDelDiaVisto(int fila) {
  if (vistoCastigado[fila]) return;
  if (vistoDesde[fila] >= 0) castigarVisto(fila, VISTO_CASTIGO, "Dejaste en visto a ");
  else castigarVisto(fila, SIN_LEER_CASTIGO, "No le contestaste a ");
  vistoDesde[fila] = -1;
}

