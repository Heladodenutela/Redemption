// Menú de opciones: 1-9 o click para elegir, Q o BACKSPACE para cancelar (el reloj sigue corriendo)
float MENU_X = 400, MENU_Y = 260, MENU_ANCHO = 800, MENU_FILA = 52;

// Dibuja el menú de opciones de un objeto (a dónde ir, qué comprar...).
void dibujarMenu() {
  float alto = 90 + tamInt(menuOpciones) * MENU_FILA + 40;
  noStroke();
  fill(0, 0, 0, 120);
  rect(0, 0, ANCHO, ALTO);
  fill(245, 240, 225);
  rect(MENU_X, MENU_Y, MENU_ANCHO, alto, 12);
  fill(40);
  textSize(30);
  textAlign(LEFT, BASELINE);
  text(menuTitulo, MENU_X + 30, MENU_Y + 50);
  textSize(22);
  for (int k = 0; k < tamInt(menuOpciones); k++) {
    int c = menuOpciones[k + 1];
    float fy = MENU_Y + 80 + k * MENU_FILA;
    boolean encima = mouseX > MENU_X + 20 && mouseX < MENU_X + MENU_ANCHO - 20 && mouseY > fy && mouseY < fy + MENU_FILA - 6;
    boolean alcanza = dinero >= precioDe(c);
    if (encima) fill(color(210, 225, 250)); else fill(color(255));
    rect(MENU_X + 20, fy, MENU_ANCHO - 40, MENU_FILA - 6, 8);
    if (alcanza) fill(color(30)); else fill(color(170, 60, 60));
    text((k + 1) + ")  " + textoOpcion(c), MENU_X + 36, fy + 32);
  }
  fill(110);
  textSize(18);
  text("1-" + tamInt(menuOpciones) + " o click: elegir   ·   Q: cancelar   ·   el reloj sigue corriendo", MENU_X + 30, MENU_Y + alto - 16);
}

// Teclas 1 a 9 para elegir una opción del menú.
void teclasMenu() {
  if (key >= '1' && key <= '9') {
    int k = key - '1';
    if (k < tamInt(menuOpciones)) {
      menuAbierto = false;
      usarConexion(menuOpciones[k + 1]);
    }
  } else if (key == 'q' || key == 'Q' || key == BACKSPACE) {
    menuAbierto = false;
  }
}

// Click en una opción del menú.
void clickMenu() {
  for (int k = 0; k < tamInt(menuOpciones); k++) {
    float fy = MENU_Y + 80 + k * MENU_FILA;
    if (mouseX > MENU_X + 20 && mouseX < MENU_X + MENU_ANCHO - 20 && mouseY > fy && mouseY < fy + MENU_FILA - 6) {
      menuAbierto = false;
      usarConexion(menuOpciones[k + 1]);
      return;
    }
  }
}

// Pantalla de "Caminando..." / bus / taxi. El reloj ya se descuenta al llegar.
void dibujarViaje() {
  float p = constrain((millis() - viajeInicio) / (float) DURACION_VIAJE_MS, 0, 1);
  int hd = horaDelDia();
  int llegada = (hd + viajeMin * 2) % 2880;
  int hdCielo = (hd + round(viajeMin * 2 * p)) % 2880;
  float esc = escalaPJ();
  if (viajeModo == BUS) {
    dibujarFondo(I1, hdCielo);

    dibujarHoja(pj_don_oscar, 160, 240, 0, (cuadros / 13) % 4, aPantallaX(1350) - 80 * esc, aPantallaY(pisoMapa[I1]) - 225 * esc, esc);
    int fila;
    if (viajeDormido && p > 0.3) fila = 13; else fila = 11;
    dibujarHoja(pj_protagonista, 160, 240, fila, (cuadros / 13) % 4, aPantallaX(700) - 80 * esc, aPantallaY(pisoMapa[I1]) - 225 * esc, esc);
    if (viajeDormido && p > 0.3) dibujarHoja(ef_zzz, 90, 90, 0, (cuadros / 10) % 4, aPantallaX(720), aPantallaY(pisoMapa[I1]) - 300 * esc, esc);
  } else if (viajeModo == TAXI) {
    background(0);
    dibujarCielo(hdCielo);
    fill(80);
    noStroke();
    rect(0, 600, ANCHO, 300);
    float tx = lerp(-400, ANCHO, p);
    dibujarHoja(veh_taxi_de_don_beto, 400, 190, 1, (cuadros / 6) % 4, tx, 600 - 190, 1);
  } else {

    background(0);
    dibujarCielo(hdCielo);
    fill(60, 70, 60);
    noStroke();
    rect(0, 700, ANCHO, 200);
    dibujarHoja(pj_protagonista, 160, 240, 5, (cuadros / 8) % 4, 720, 700 - 225, 1);
  }
  fill(0, 0, 0, 160);
  rect(0, 60, ANCHO, 120);
  fill(255);
  textAlign(CENTER, CENTER);
  textSize(40);
  String titulo;
  if (viajeModo == A_PIE) {
    titulo = "Caminando...";
  } else {
    if (viajeModo == TAXI) titulo = "En el taxi..."; else titulo = "En el bus...";
  }
  text(titulo, 800, 100);
  textSize(24);
  text(viajeTexto + "      " + horaTexto(hd) + "  ->  " + horaTexto(llegada), 800, 148);
  textAlign(LEFT, BASELINE);

  fill(255, 255, 255, 60);
  rect(500, 840, 600, 12, 6);
  fill(255);
  rect(500, 840, 600 * p, 12, 6);
}

// ============================ ANIMACIÓN DE SPRITES ============================
// Medidas de las hojas de personajes (versión x5)
final int PJ_CW = 160, PJ_CH = 240, PJ_PIES = 225, PJ_CENTRO = 80;

// Filas del protagonista
final int FILA_AFK = 0, FILA_AFK_ACCION = 1, FILA_CAM_IZQ = 4, FILA_CAM_DER = 5,
  FILA_COR_IZQ = 8, FILA_COR_DER = 9, FILA_SENTADO_LADO = 11, FILA_CABECEAR = 13;

// Velocidad de animación: cada cuántos frames cambia de cuadro (más alto = más lento)
int VEL_AFK = 13, VEL_CAMINAR = 8, VEL_CORRER = 5;

// Dibuja el cuadro (col, fila) de una hoja sin copiarlo (usa la versión de image() con recorte)
void dibujarHoja(PImage hoja, int cw, int ch, int fila, int col, float x, float y, float esc) {
  if (hoja == null || hoja.width <= 1) {

    noStroke();
    fill(255, 0, 255, 150);
    rect(x + cw * esc * 0.3, y + ch * esc * 0.3, cw * esc * 0.4, ch * esc * 0.64);
    return;
  }
  int sx = col * cw, sy = fila * ch;
  image(hoja, x, y, cw * esc, ch * esc, sx, sy, sx + cw, sy + ch);
}

// Personaje parado con los pies en pisoMundo y centrado en xMundo
void dibujarPersonaje(PImage hoja, int fila, int col, float xMundo, float pisoMundo) {
  float esc = escalaPJ();
  dibujarHoja(hoja, PJ_CW, PJ_CH, fila, col, aPantallaX(xMundo) - PJ_CENTRO * esc, aPantallaY(pisoMundo) - PJ_PIES * esc, esc);
}

// Dibuja al protagonista con su animación (quieto, caminando, corriendo, sentado).
void dibujarProtagonista() {
  if (dibujarProtagonistaEspecial()) return;
  int fila, vAnim;
  int col;
  if (pjMoviendo) {
    if (correr) {
      if (pjDir > 0) fila = FILA_COR_DER; else fila = FILA_COR_IZQ;
      vAnim = VEL_CORRER;
    } else {
      if (pjDir > 0) fila = FILA_CAM_DER; else fila = FILA_CAM_IZQ;
      vAnim = VEL_CAMINAR;
    }
    col = (cuadros / vAnim) % 4;
  } else {

    if (afkAccionFrame < 0 && millis() - pjQuietoDesde > ESPERA_AFK_ACCION && !menuAbierto) afkAccionFrame = cuadros;
    if (afkAccionFrame >= 0) {
      int k = (cuadros - afkAccionFrame) / VEL_AFK;
      if (k >= 4) {
        afkAccionFrame = -1;
        pjQuietoDesde = millis();
        fila = FILA_AFK;
        col = 0;
      } else {
        fila = FILA_AFK_ACCION;
        col = k;
      }
    } else {
      fila = FILA_AFK;
      col = (cuadros / VEL_AFK) % 4;
    }
  }
  dibujarPersonaje(pj_protagonista, fila, col, pjX, pisoMapa[mapaActual]);
}

