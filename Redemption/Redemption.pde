// Lo que se puede subir ahora: { "G<k>" (del guion) o "S<k>", etiqueta, texto }
// Deja el resultado en resOpcionesSubir.
void opcionesSubir() {
  String[][] l = new String[40][];
  misPostsHoy();
  int[] mios = resMisPostsHoy;
  for (int i = 1; i <= tamInt(mios); i++) agregarFila(l, new String[] { "G" + mios[i], "Del día", REDES_DIA[mios[i]][3] });
  for (int k = 0; k < SUBIDAS.length; k++) {
    if (!tieneTexto(subidasHechas, SUBIDAS[k][0]) && cumpleReq(SUBIDAS[k][2])) {
      agregarFila(l, new String[] { "S" + k, SUBIDAS[k][1], SUBIDAS[k][3] });
    }
  }
  resOpcionesSubir = l;
}

// Cuántas cosas subiste hoy a Aurora+.
int subidasHoy() {
  return bandera("SUBIDAS_D" + dia);
}

// Sube una publicación a Aurora+ (hay un máximo por día).
void subir(String id) {
  if (subidasHoy() >= SUBIDAS_POR_DIA) { aviso("Ya subiste " + SUBIDAS_POR_DIA + " cosas hoy. Deja algo para mañana."); return; }
  sumarBandera("SUBIDAS_D" + dia, 1);
  avanzarTiempo(REDES_MIN_POST * 2);
  catMedios[CAT_REDES] += REDES_MIN_POST * 4;
  redesMinHoy += REDES_MIN_POST * 2;
  if (empiezaCon(id, "G")) {
    int k = int(id.substring(1));
    agregarTexto(publicados, str(k));
    String r = aplicarEfectos(REDES_DIA[k][5], -1);
    int likes = 4 + stats[ST_SEGUIDORES] / 3;
    redResultado = new String[] { REDES_DIA[k][3], str(likes), "", r, fotoPorTexto(REDES_DIA[k][3]) };
    return;
  }
  int k = int(id.substring(1));
  String[] s = SUBIDAS[k];
  agregarTexto(subidasHechas, s[0]);
  if (s[1].equals("Foto")) {
    hecho("FOTO");

    int n = tamFilas(feed);
    if (n < feed.length) {
      for (int i = n; i > feedPos; i--) feed[i] = feed[i - 1];
      feed[feedPos] = new String[] { "Tú · acabas de subir", s[3], "tuyo", "-1", null, s[0] };
    }
  }
  int base = 3 + stats[ST_SEGUIDORES] / 3;
  int likes;
  if (s[4].equals("mala")) {
    likes = base * 2;
  } else {
    if (s[4].equals("polémica")) likes = base * 3 / 2 + 2; else likes = base + 3;
  }
  String r = aplicarEfectos(s[5], -1);
  redResultado = new String[] { s[3], str(likes), s[6], r, s[0] };
}

