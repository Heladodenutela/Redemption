// ============================ 6. REPARAR CONTROLES (Kevin) ============================
// Une cada cable con el puerto de su mismo color: click en el cable y luego en el puerto.
int[][] CT_COLORES = { {230, 60, 60}, {60, 140, 230}, {250, 210, 50}, {70, 190, 90}, {200, 90, 220}, {250, 140, 40} };
String[] CT_NOMBRES = { "ROJO", "AZUL", "AMARILLO", "VERDE", "MORADO", "NARANJA" };
int ctRonda, ctN, ctElegido, ctErrores, ctFin, ctHechos;
int[] ctPuerto = new int[6];
boolean[] ctUnido = new boolean[6];
int ctFlash = 0;

// Empieza el minijuego de reparar controles en PixelZone.
void iniciarControles() {
  ctRonda = 0;
  ctErrores = 0;
  ctHechos = 0;
  ctFin = millis() + round(facil(B_CONTROLES_SEGUNDOS) * 1000);
  nuevaRondaControles();
}

// Nueva ronda: más cables y los puertos revueltos.
void nuevaRondaControles() {
  ctN = 4 + ctRonda;
  for (int i = 0; i < ctN; i++) { ctPuerto[i] = i; ctUnido[i] = false; }
  for (int i = ctN - 1; i > 0; i--) { int j = int(random(i + 1)); int t = ctPuerto[i]; ctPuerto[i] = ctPuerto[j]; ctPuerto[j] = t; }
  ctElegido = -1;
}

// Altura del cable o puerto i.
float ctY(int i) { return 220 + i * (520.0 / ctN); }

// Click en un cable y después en el puerto del mismo color.
void clickControles() {
  for (int i = 0; i < ctN; i++) if (!ctUnido[i] && dist(mouseX, mouseY, 480, ctY(i)) < 36) { ctElegido = i; return; }
  if (ctElegido < 0) return;
  for (int j = 0; j < ctN; j++) {
    if (!(dist(mouseX, mouseY, 1120, ctY(j)) > 40)) {
      if (ctPuerto[j] == ctElegido) {
        ctUnido[ctElegido] = true;
        ctHechos++;
        ctElegido = -1;
        boolean todos = true;
        for (int k = 0; k < ctN; k++) if (!ctUnido[k]) todos = false;
        if (todos) { ctRonda++; if (ctRonda < 3) nuevaRondaControles(); }
      } else { ctErrores++; ctFlash = millis() + 250; }
      return;
    }
  }
}

// Dibuja los cables, los puertos y los que ya uniste.
void dibujarControles() {
  fondoMJ(30, 34, 46, "TALLER DE PIXELZONE · reparar controles (" + min(ctRonda + 1, 3) + "/3)",
    "Click en un cable (izquierda) y después en el puerto del MISMO color. Ojo: en la ronda 3 las letras mienten. Errores: " + ctErrores);
  int resta = ctFin - millis();
  barraTiempoMJ(resta / (facil(B_CONTROLES_SEGUNDOS) * 1000));
  if (ctRonda >= 3 || resta <= 0) {
    int p = constrain(round(100.0 * ctHechos / 15 - ctErrores * 6), 0, 100);
    if (ctRonda >= 3) {
      finMJ(p, "Tres controles como nuevos. Kevin: \"Contratado. En serio.\"");
    } else {
      finMJ(p, "Arreglaste " + ctHechos + " cables. Kevin termina el resto refunfuñando.");
    }
    return;
  }

  noStroke();
  fill(60, 64, 80);
  rect(380, 160, 840, 640, 40);
  for (int i = 0; i < ctN; i++) {
    int[] c = CT_COLORES[i];
    fill(c[0], c[1], c[2]);
    int aux1;
    if (ctElegido == i) aux1 = 66; else aux1 = 54;
    int aux2;
    if (ctElegido == i) aux2 = 66; else aux2 = 54;
    ellipse(480, ctY(i), aux1, aux2);
    int[] p = CT_COLORES[ctPuerto[i]];
    fill(30);
    rect(1080, ctY(i) - 30, 80, 60, 8);
    fill(p[0], p[1], p[2]);
    rect(1088, ctY(i) - 22, 64, 44, 6);
    if (ctRonda == 2) {
      int[] tinta = CT_COLORES[(ctPuerto[i] + 2) % ctN];
      fill(tinta[0], tinta[1], tinta[2]);
      textSize(17);
      textAlign(LEFT, CENTER);
      text(CT_NOMBRES[(ctPuerto[i] + 1) % ctN], 1170, ctY(i));
      textAlign(LEFT, BASELINE);
    }
  }
  strokeWeight(10);
  for (int i = 0; i < ctN; i++) {
    if (ctUnido[i]) {
      int j = 0;
      for (int k = 0; k < ctN; k++) if (ctPuerto[k] == i) j = k;
      stroke(CT_COLORES[i][0], CT_COLORES[i][1], CT_COLORES[i][2]);
      line(480, ctY(i), 1084, ctY(j));
    }
  }
  if (ctElegido >= 0) { stroke(CT_COLORES[ctElegido][0], CT_COLORES[ctElegido][1], CT_COLORES[ctElegido][2], 150); line(480, ctY(ctElegido), mouseX, mouseY); }
  strokeWeight(1);
  noStroke();
  if (millis() < ctFlash) { fill(255, 0, 0, 60); rect(0, 0, ANCHO, ALTO); }
}

