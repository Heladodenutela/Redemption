// ============================ 5. ORDENAR PASOS (tutoría, auxilios, pizarra, bici, receta) ============================
// Las tarjetas están revueltas: tócalas en el orden correcto.
String[][] ORD_SETS;
int orSet, orSig, orErrores, orFin, orVerHasta;
int[] orOrden = new int[8];
boolean[] orPuesta = new boolean[8];
String orMsg = "";
int orMsgHasta = 0, orAciertos = 0, orTotal = 0;

// ¿Este minijuego es de ordenar pasos? (cada escena tiene su propio orden).
boolean esOrden(String c) {
  return c.equals("PASOS") || c.equals("AUXILIOS") || c.equals("PIZARRA") || c.equals("BICI") || c.equals("RECETA")
