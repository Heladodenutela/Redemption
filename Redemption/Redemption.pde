// stats[]: el vector de valores del jugador. El dinero sigue en la variable "dinero"
// (stats[ST_DINERO] se copia de ahí solo para dibujar la barra).
final int ST_SOCIAL = 0, ST_NOTAS = 1, ST_ENERGIA = 2, ST_DINERO = 3, ST_SEGUIDORES = 4, ST_PANTALLA = 5;
final String[] NIVELES = { "Perdedor", "Reservado", "Normal", "Carismático", "Popular" };

// Minutos de cada categoría del día (se guardan en medios minutos: 1 intervalo del reloj = 30 s)
final int CAT_ESTUDIAR = 0, CAT_DORMIR = 1, CAT_EJERCICIO = 2, CAT_AMIGOS = 3, CAT_REDES = 4;
int[] catMedios = new int[5];
int pantallaMedios = 0;
int ultimoSuenoMin = 480;
int diaRelojVisto = 1;

// Pone los stats con los valores de inicio de la partida.
void iniciarStats() {
  stats[ST_SOCIAL] = SOCIAL_INICIAL;
  stats[ST_NOTAS] = NOTAS_INICIAL;
  stats[ST_ENERGIA] = ENERGIA_INICIAL;
  stats[ST_DINERO] = dinero;
  stats[ST_SEGUIDORES] = SEGUIDORES_INICIAL;
  stats[ST_PANTALLA] = 0;
  iniciarDialogos();
  iniciarModulo2();
  cargarDialogosDelDia();
}

// 0 Perdedor, 1 Reservado, 2 Normal, 3 Carismático, 4 Popular
int nivelSocial() {
  int s = stats[ST_SOCIAL];
  if (s >= 80) return 4;
  if (s >= 60) return 3;
  if (s >= 40) return 2;
  if (s >= 20) return 1;
  return 0;
}

// La deuda de sueño baja la energía máxima
int energiaMax() {
  int m = 100;
  if (deudaSueno >= 2) m = 50;
  else if (deudaSueno >= 1) m = 70;
  if (ultimoSuenoMin < 360) m = min(m, 60);
  return m;
}

// Suma (o resta) a un stat y lo deja en su rango
void cambiarStat(int k, int d) {
  if (k == ST_DINERO) { dinero = max(0, dinero + d); return; }
  if (k == ST_ENERGIA) d = gastoEnergia(d);
  stats[k] = stats[k] + d;
  if (k == ST_ENERGIA) stats[k] = constrain(stats[k], 0, energiaMax());
  else if (k == ST_SOCIAL || k == ST_NOTAS) stats[k] = constrain(stats[k], 0, 100);
  else stats[k] = max(0, stats[k]);
}

// Se llama cada intervalo del reloj (30 s de juego) desde cicloTiempo()
void tickReloj() {
  if (screen == 1 && cel != 0) {
    pantallaMedios++;
    catMedios[CAT_REDES]++;
    stats[ST_PANTALLA] = pantallaMedios / 2;
  }
  revisarEscenasMapa();
  tickReloj8();
  tickReloj2();
  revisarCambioDia();
  tickV20();
}

// El día cambia cuando el reloj pasa de las 5:00 (despierto o dormido)
int diaDelReloj() {
  return (horagp + 120) / 2880 + 1;
}

// Si el reloj ya pasó a otro día, hace todo lo que toca al cambiar de día.
void revisarCambioDia() {
  int dr = diaDelReloj();
  while (dr > diaRelojVisto) {
    diaRelojVisto++;
    registrarDiaSinDormir(dia);
    if (dia < 10) dia++;
    nuevoDia();
    nuevoDiaV20();
  }
}

// Empieza un día: borra lo del día anterior y arma los diálogos con los stats con los que amaneces
void nuevoDia() {
  nuevoDia2();
  for (int k = 0; k < catMedios.length; k++) catMedios[k] = 0;
  pantallaMedios = 0;
  stats[ST_PANTALLA] = 0;
  newtonHoy = false;
  cargarDialogosDelDia();
}

