// ============================ DÍAS DE CHARLA ============================
// Una "charla" cuenta cuando terminas de hablar con alguien (toda la cadena) o viven una escena juntos.
// Cuenta una sola vez por día: diasCharla = en cuántos días distintos han hablado.
int[] diasCharla, diaCharla, diaCharlaPrevio, diarioHechos, diarioDia, vistoDia;

// Prepara los contadores de charlas y vistos de cada persona.
void iniciarSocialV21() {
  int n = DLG_PERSONA.length;
  diasCharla = new int[n];
  diaCharla = new int[n];
  diaCharlaPrevio = new int[n];
  diarioHechos = new int[n];
  diarioDia = new int[n];
  vistoDia = new int[n];
  for (int f = 0; f < n; f++) { diaCharla[f] = -1; diaCharlaPrevio[f] = -1; diarioDia[f] = -1; vistoDia[f] = -9; }
  for (int k = 0; k < MSG_FILAS; k++) { vistoDesde[k] = -1; vistoCastigado[k] = false; chatNuevoDia[k] = -1; chatReclamoDia[k] = -1; }
  darContactosIniciales();
  leerDiario();
  armarCharlas();
  armarEscribir();
}

// Cuenta que hoy hablaste con alguien (una vez por día).
void registrarCharla(int f) {
  if (f < 0 || diasCharla == null || f >= diasCharla.length) return;
  if (diaCharla[f] == dia) return;
  diaCharlaPrevio[f] = diaCharla[f];
  diaCharla[f] = dia;
  diasCharla[f]++;
}

// ¿Hablaron ayer? (para "¿Eres el de ayer?")
boolean hablaronAyer(int f) {
  if (f < 0 || diaCharla == null) return false;
  int ultimo;
  if (diaCharla[f] == dia) ultimo = diaCharlaPrevio[f]; else ultimo = diaCharla[f];
  return ultimo == dia - 1;
}

// Días distintos en que ya hablaron (contando hoy si ya hablaron hoy)
int charlasCon(int f) {
  if (f < 0 || diasCharla == null) return 0; else return diasCharla[f];
}

// El número de la charla de hoy: cuenta hoy aunque todavía no hayan terminado de hablar
int charlaDeHoy(int f) {
  if (f < 0 || diasCharla == null) return 0;
  if (diaCharla[f] == dia) return diasCharla[f] + 0; else return diasCharla[f] + 1;
}

// Días de charla ANTES de hoy
int charlasAntes(int f) {
  if (f < 0 || diasCharla == null) return 0;
  if (diaCharla[f] == dia) return diasCharla[f] - 1; else return diasCharla[f] - 0;
}

// "CHARLAS:Sofía>=2", "ANTES:Paola>=1", "CONTACTO:Laura", "DIARIO:Valentina>=3" (diálogos diarios hechos)
// "AYER:Valentina" = hablaron ayer
boolean cumpleSocial(String c) {
  int i = posicionDe(c, ":");
  String tipo = c.substring(0, i), resto = c.substring(i + 1);
  if (tipo.equals("CONTACTO")) return esContacto(personaPorNombre(resto));
  if (tipo.equals("AYER")) return hablaronAyer(personaPorNombre(resto));
  partirComparacion(resto);
  String[] p = resPartirComparacion;
  int f = personaPorNombre(p[0]);
  if (f < 0) return false;
  int v;
  if (tipo.equals("CHARLAS")) {
    v = charlasCon(f);
  } else {
    if (tipo.equals("ANTES")) v = charlasAntes(f); else if (diarioHechos == null) v = 0; else v = diarioHechos[f];
  }
  if (p[1].equals("")) return v > 0;
  return comparar(v, p[1], int(p[2]));
}

// El número que viene después de un texto (por ejemplo, el 2 de "charlas >= 2").
int numeroTras(String s, int i) {
  int n = 0;
  while (i < s.length() && letraEn(s, i) == ' ') i++;
  while (i < s.length() && letraEn(s, i) >= '0' && letraEn(s, i) <= '9') { n = n * 10 + (letraEn(s, i) - '0'); i++; }
  return n;
}

