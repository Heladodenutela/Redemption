    if (suena && listaSonando == i + 1) { noFill(); stroke(255, 220, 90); strokeWeight(4); rect(celX1 + 38, by - 2, 84, 84, 12); noStroke(); strokeWeight(1); }
  }
  float yq = celY1 + LISTA_Y0 + 3 * LISTA_PASO;
  if (suena) botonCel(celX1 + 40, yq, celX2 - celX1 - 80, 64, "Quitar la lista (música del lugar)", color(110, 110, 130));
