// ¿Esta persona te está evitando (te bloqueó o está molesta)?
boolean teEvita(int f) {
  if (f < 0) return false;
  if (bloqueado(f)) return true;
  for (int k = 0; k < EVITA.length; k++) if (EVITA[k][0].equals(DLG_PERSONA[f]) && cumple(EVITA[k][1])) return true;
  return false;
}

// Lo que dice alguien que te está evitando.
String lineaEvita(int f) {
  if (bloqueado(f)) return lineaBloqueo(f);
  for (int k = 0; k < EVITA.length; k++) if (EVITA[k][0].equals(DLG_PERSONA[f]) && cumple(EVITA[k][1])) return EVITA[k][2];
  return "...";
}

// La mete asignarDialogo después del saludo: una de hábitos, una de lo de hoy, una de amistad y el nivel si no tenía
void agregarVariantes(int f) {
  String p = DLG_PERSONA[f];
  String[] tipos = { "H", "D", "A", "N" };
  for (int t = 0; t < tipos.length; t++) {
    String l = varianteDe(VARIANTES, p, tipos[t]);
    if (l == null) l = varianteDe(VARIANTES2, p, tipos[t]);
    if (l != null) {
      if (tipos[t].equals("N")) agregarNormal(f, l, null);
      else if (varianteFresca(f, l)) agregarNormal(f, l, "VAR");
    }
  }
}

// La primera línea de esa persona y ese tipo cuya condición se cumple (o null)
String varianteDe(String[][] tabla, String p, String tipo) {
  for (int k = 0; k < tabla.length; k++) {
    if (tabla[k][0].equals(p) && tabla[k][1].equals(tipo) && cumple(tabla[k][2])) return tabla[k][3];
  }
  return null;
}

