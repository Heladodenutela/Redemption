    int o = objetoCercano();
    if (o >= 0) { if (motivoObjetoCerrado(o) == null) agregarTexto(t, "[E] " + objNombre[o]); else agregarTexto(t, objNombre[o] + " · cerrado"); }
  }
  int k = npcParaHablar();
  if (k >= 0) {
    int f = npcPersona[k];
    if (dlgPos[f] < largo(f)) {
      agregarTexto(t, "[R] Hablar con " + nombreCorto(f) + "  •");
    } else {
      agregarTexto(t, "[R] Hablar con " + nombreCorto(f) + "");
