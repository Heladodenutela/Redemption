// Minuto absoluto desde el inicio del día 1 (sirve para medir esperas de varios días).
int minutoAbs() {
  return (dia - 1) * 1440 + minutoAhora();
}

// Dibuja la cuarta fila de apps (Notas, Mapa, Playlist, Batería).
void dibujarIconosCelular4() {
  if (!apps4Buscados) {
