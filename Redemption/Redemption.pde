int[] redesHora;
String[] redesCond;
boolean[] redesEnFeed;
boolean redesListas = false;

// Junta todas las publicaciones posibles de los 10 días (una sola vez).
void prepararRedes() {
  if (redesListas) return;
  redesListas = true;
  int base = REDES_DIA.length;

  String[][] cortas = new String[REDES_EXTRA.length][];
  for (int k = 0; k < REDES_EXTRA.length; k++) {
    String[] e = REDES_EXTRA[k];
    cortas[k] = new String[] { e[0], e[1], e[2], e[3], e[4], e[5] };
  }
  unirTablas(REDES_DIA, cortas);
  REDES_DIA = resUnirTablas;
  redesHora = new int[REDES_DIA.length];
  redesCond = new String[REDES_DIA.length];
  redesEnFeed = new boolean[REDES_DIA.length];
  for (int k = 0; k < REDES_DIA.length; k++) {
    if (k >= base) { redesHora[k] = aMin(REDES_EXTRA[k - base][6]); redesCond[k] = REDES_EXTRA[k - base][7]; } else {
      redesHora[k] = 0;
      redesCond[k] = "";
      for (int j = 0; j < REDES_CONDS.length; j++) {
        if (empiezaCon(REDES_DIA[k][3], REDES_CONDS[j][0])) { redesHora[k] = aMin(REDES_CONDS[j][1]); redesCond[k] = REDES_CONDS[j][2]; break; }
      }
    }
  }
}

// ¿Esta publicación ya puede salir? (es de hoy, ya es la hora y pasó lo que muestra)
boolean postDisponible(int k) {
  prepararRedes();
  if (k < 0 || k >= REDES_DIA.length) return false;
  if (int(REDES_DIA[k][0]) != dia) return false;
  String c = redesCond[k];
  if (c.equals("NUNCA")) return false;
  if (minutoAhora() < redesHora[k] && minutoAhora() >= 5 * 60) return false;
  return cumpleAlguna(c);
}

// "A | B" = basta con una
boolean cumpleAlguna(String c) {
  if (posicionDe(c, "|") < 0) return cumple(c);
  partirPorLetra(c, '|');
  String[] p = resPartirPorLetra;
  for (int i = 0; i < p.length; i++) if (cumple(p[i])) return true;
  return false;
}

// Lo llama armarFeed() al empezar el día: solo lo que ya puede salir
void agregarPostsDelDia() {
  prepararRedes();
  for (int k = 0; k < redesEnFeed.length; k++) redesEnFeed[k] = false;
  for (int k = 0; k < REDES_DIA.length; k++) {
    if (!REDES_DIA[k][1].equals("Tú") && postDisponible(k)) {
      agregarPostAlFeed(k, false);
    }
  }
}

// Pone una publicación en el feed.
void agregarPostAlFeed(int k, boolean arriba) {
  redesEnFeed[k] = true;
  String autor = REDES_DIA[k][1];
  int f = personaPorNombre(autor);
  String tipo;
  if (REDES_DIA[k][4].equals("útil")) {
    tipo = "util";
  } else if (REDES_DIA[k][4].equals("meme")) {
    tipo = "meme";
  } else {
    if (f >= 0) tipo = "amigo"; else if (empiezaCon(autor, "Anónimo")) tipo = "toxico"; else tipo = "chisme";
  }
  String[] fila = { autor + " · " + REDES_DIA[k][2], REDES_DIA[k][3], tipo, str(f) };
  int n = tamFilas(feed);
  if (n >= feed.length) return;
  if (!arriba) { agregarFila(feed, fila); return; }

  int pos = min(feedPos, n);
  for (int i = n; i > pos; i--) feed[i] = feed[i - 1];
  feed[pos] = fila;
}

// Cada intervalo del reloj: lo que ya pasó aparece en Aurora+ (con burbuja roja)
int ultimoRevisoPosts = -1;
// Agrega al feed las publicaciones cuya hora ya llegó.
void revisarPostsNuevos() {
  if (feed == null) return;
  prepararRedes();
  int m = minutoAhora();
  if (m == ultimoRevisoPosts) return;
  ultimoRevisoPosts = m;
  for (int k = 0; k < REDES_DIA.length; k++) {
    if (!redesEnFeed[k] && !REDES_DIA[k][1].equals("Tú") && postDisponible(k)) {
      agregarPostAlFeed(k, true);
      postsNuevos++;
  
      int f = personaPorNombre(REDES_DIA[k][1]);
      if (f >= 0 && amistad[f] >= 50 && cel != 10) aviso("Aurora+: " + nombreCorto(f) + " publicó algo");
    }
  }
}

