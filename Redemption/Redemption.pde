// ¿Se cumple la condición de un chisme (faltas a clase, etc.)?
boolean condicionChisme(String c) {
  if (empiezaCon(c, "FALTAS>=")) return faltas >= int(c.substring(8));
  return condicionMsg(c);
}

// Se llama al armar el feed (cada día): los chismes nuevos salen arriba
void agregarChismes() {
  redAbiertaHoy = false;
  int puestos = 0;
  for (int k = 0; k < CHISMES.length && puestos < 2; k++) {
    if (bandera("CHISME_" + k) <= 0 && condicionChisme(CHISMES[k][0])) {
      sumarBandera("CHISME_" + k, 1);
      int n = tamFilas(feed);
      if (n >= feed.length) return;
      for (int i = n; i > 0; i--) feed[i] = feed[i - 1];
      feed[0] = new String[] { CHISMES[k][1] + " · sobre ti", CHISMES[k][2], "sobre_ti", "-1", CHISMES[k][3] };
      puestos++;
    }
  }
}

// El efecto de un chisme se aplica cuando lo ves
void verChisme(String[] p) {
  if (p.length < 5 || p[4] == null) return;
  String r = aplicarEfectos(p[4], -1);
  p[4] = null;
  if (r.equals("")) aviso("Hablan de ti en Aurora+" + ""); else aviso("Hablan de ti en Aurora+" + ("  (" + r + ")"));
}

