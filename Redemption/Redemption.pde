// Mantén click (o ESPACIO) para jalar la pita. Que la cometa no salga de la franja verde.
float coY, coV, coX, coViento, coDentro, coTotal;
boolean coTira = false;
int coFin;

// Empieza el minijuego de la cometa de Valeria.
void iniciarCometa() {
  coY = 420;
  coV = 0;
  coX = 800;
  coViento = 0;
  coDentro = 0;
  coTotal = 0;
  coTira = false;
  coFin = millis() + round(B_COMETA_SEGUNDOS * 1000);
}

// Dibuja la cometa: mantén el click para subirla y no la dejes caer.
void dibujarCometa() {
  fondoMJ(130, 190, 240, "LA COMETA DE VALERIA", "Mantén el click (o ESPACIO) para jalar la pita. Que la cometa se quede en la franja verde.");
  float dt = dt20();
  int resta = coFin - millis();
  barraTiempoMJ(resta / (B_COMETA_SEGUNDOS * 1000.0));
  coTira = coTira || (mousePressed && actividad == ACT_MJ20);
  float banda1 = 260, banda2 = 260 + facil(190);
  coViento += random(-0.08, 0.08) * difMult * dt;
  coViento = constrain(coViento, -1.2, 1.2);
  if (coTira) coV += (-0.32) * dt + coViento * 0.05 * dt; else coV += 0.22 * dt + coViento * 0.05 * dt;
  coV *= pow(0.96, dt);
  coY = constrain(coY + coV * dt, 130, 760);
  coX = constrain(coX + coViento * 2 * dt, 300, 1300);
  coTotal++;
  if (coY > banda1 && coY < banda2) coDentro++;
  noStroke();
  fill(90, 200, 110, 70);
  rect(0, banda1, ANCHO, banda2 - banda1);
  fill(80, 160, 80);
  rect(0, 800, ANCHO, 100);

  fill(250, 200, 150);
  ellipse(800, 760, 40, 40);
  fill(240, 120, 160);
  rect(785, 780, 30, 50, 6);
  stroke(255);
  line(800, 770, coX, coY + 50);
  noStroke();
  fill(240, 70, 70);
  quad(coX, coY - 50, coX + 40, coY, coX, coY + 50, coX - 40, coY);
  fill(250, 210, 60);
  triangle(coX, coY - 50, coX + 40, coY, coX - 40, coY);
  fill(40);
  textSize(20);
  text("En la franja: " + round(100 * coDentro / max(1, coTotal)) + " %", 60, 860);
  coTira = false;
  if (resta <= 0) {
    int p = round(100 * coDentro / max(1, coTotal));
    if (p >= 60) {
      finMJ(p, "Valeria salta de la emoción: \"¡Es la que más alto vuela del parque!\"");
    } else {
      finMJ(p, "La cometa dio unas vueltas raras, pero Valeria se ríe igual.");
    }
  }
}

