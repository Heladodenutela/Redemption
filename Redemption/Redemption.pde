// Teclas de las actividades de la casa y el estudio (Q para salir, E para usar).
void teclasActividad2() {
  boolean cerrar = key == 'q' || key == 'Q' || key == BACKSPACE;
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  switch (actividad) {
  case ACT_ESTUDIO_JUEGO:
    if (cerrar) terminarSesionEstudio();
    break;
  case ACT_ESTUDIO_FIN:
    if (usar) empezarSesionEstudio();
    else if (cerrar) terminarActividad();
    break;
  case ACT_REACCION:
    if (usar || cerrar || key == 'r' || key == 'R') terminarActividad();
    break;
  case ACT_ARCADE:
    if (key >= '1' && key <= '4') jugarArcade(key - '1');
    else if (cerrar || usar) terminarActividad();
    break;
  case ACT_ARC_ROYALE:
    teclaFlechas(true);
    if (cerrar) terminarArcade(int((millis() - ryInicio) / 1000), 0, "Te rendiste.");
    break;
  case ACT_ARC_TORRE:
    if (key == ' ') soltarTorre();
    else if (cerrar) terminarArcade(numPisos - 1, 0, "Te rendiste en el piso " + (numPisos - 1) + ".");
    break;
  case ACT_ARC_DUELO:
    if (cerrar) terminarArcade(duMejor, 0, "Te rendiste.");
    else teclaDuelo();
    break;
  case ACT_ARC_FIN:
    if (usar) abrirArcade();
    else if (cerrar) terminarActividad();
    break;
  default:
    teclasActividad3();
  }
}

// Guarda qué flechas (o A/W/S/D) están presionadas para los minijuegos.
void teclaFlechas(boolean v) {
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') arcTecla[0] = v;
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') arcTecla[1] = v;
  if ((key == CODED && keyCode == UP) || key == 'w' || key == 'W') arcTecla[2] = v;
  if ((key == CODED && keyCode == DOWN) || key == 's' || key == 'S') arcTecla[3] = v;
}

// Lo llama keyReleased()
void soltarTeclasActividad() {
  if (actividad == ACT_ARC_ROYALE) teclaFlechas(false);
  soltarTeclas7();
}

// Devuelve true si la actividad usó el click
boolean clickActividad2() {
  switch (actividad) {
  case ACT_ESTUDIO_JUEGO: return clickEstudio();
  case ACT_ESTUDIO_FIN: return true;
  case ACT_REACCION: terminarActividad(); return true;
  case ACT_ARCADE: jugarArcade(arcadeEnMouse()); return true;
  case ACT_ARC_TORRE: soltarTorre(); return true;
  case ACT_ARC_ROYALE: return true;
  case ACT_ARC_DUELO: return true;
  case ACT_ARC_FIN: abrirArcade(); return true;
  }
  return clickActividad3();
}

// Dibuja las actividades de la casa y el estudio.
void dibujarActividad2() {
  switch (actividad) {
  case ACT_ESTUDIO_JUEGO: dibujarEstudioJuego(); break;
  case ACT_ESTUDIO_FIN: dibujarEstudioFin(); break;
  case ACT_REACCION: dibujarReaccion(); break;
  case ACT_ARCADE: dibujarArcade(); break;
  case ACT_ARC_ROYALE: dibujarRoyale(); break;
  case ACT_ARC_TORRE: dibujarTorre(); break;
  case ACT_ARC_DUELO: dibujarDuelo(); break;
  case ACT_ARC_FIN: dibujarArcadeFin(); break;
  default: dibujarActividad3();
  }
}

