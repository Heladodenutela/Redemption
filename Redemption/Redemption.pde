// #####################################################################################
//   IMITACIONES DE FUNCIONES NATIVAS
//   La profesora no permite usar charAt, startsWith, endsWith, indexOf, lastIndexOf, trim,
//   split, splitTokens, join, arrayCopy ni append. Aquí están hechas a mano y dan
//   exactamente lo mismo que las originales. Solo usan length, substring y equals de
//   los textos (y char/str para convertir). Ninguna llama a una prohibida: si una
//   necesita otra, llama a la imitación (por ejemplo partir usa posicionDeDesde).
//   Cada una tiene su propio nombre: no hay dos funciones con el mismo nombre.
// #####################################################################################

// ---- letras: para saber qué letra hay en una posición sin charAt ----
// letraTabla[c] es el texto de una sola letra cuyo código es c (están las 65.536).
// letraOrden dice en qué orden se buscan: primero las que más usa el juego, así casi
// siempre se encuentra en pocos pasos. van primero "_" y las mayúsculas, porque los
// nombres de las banderas (BLOQUEO_3, DIA_PERFECTO...) se leen letra por letra todo el tiempo.
String[] letraTabla;
int[] letraOrden;
final String LETRAS_FRECUENTES = "_EAOSRNIDLCTUMPBGVYQHFZJÑXKW0123456789eaosrnidlctumpbgvyqhfzjñxkw .,:;¦·|-¿?¡!\"'()[]{}<>=+*/\\#@&%$~^\n\t\ríéáóúÁÓÚÍÉüÜ−“”≥»—→←°×–↓↑²±’•³½º‘≤↺↻÷¹«";

// Arma la tabla de las 65.536 letras y el orden de búsqueda (primero las más usadas). La usa letraEn en vez de charAt.
void prepararLetras() {
  letraTabla = new String[65536];
  for (int c = 0; c < 65536; c++) letraTabla[c] = str(char(c));
  letraOrden = new int[65536];
  boolean[] puesta = new boolean[65536];
  int n = 0;
  for (int i = 0; i < LETRAS_FRECUENTES.length(); i++) {
    String x = LETRAS_FRECUENTES.substring(i, i + 1);
    int c = 0;
    while (!letraTabla[c].equals(x)) c++;
    if (!puesta[c]) {
      letraOrden[n] = c;
      n++;
      puesta[c] = true;
    }
  }
  for (int c = 0; c < 65536; c++) {
    if (!puesta[c]) {
      letraOrden[n] = c;
      n++;
    }
  }
}

// Código de un texto de una sola letra (lo busca en la tabla)
int codigoDeLetra(String x) {
  if (letraTabla == null) prepararLetras();
  for (int k = 0; k < 65536; k++) {
    int c = letraOrden[k];
    if (letraTabla[c].equals(x)) return c;
  }
  return -1;
}

// Hace lo mismo que s.charAt(i)
char letraEn(String s, int i) {
  return char(codigoDeLetra(s.substring(i, i + 1)));
}

// ---- comienzo y final ----
// Hace lo mismo que s.startsWith(p)
boolean empiezaCon(String s, String p) {
  if (p.length() > s.length()) return false;
  return s.substring(0, p.length()).equals(p);
}

// Hace lo mismo que s.endsWith(p)
boolean terminaCon(String s, String p) {
  if (p.length() > s.length()) return false;
  return s.substring(s.length() - p.length()).equals(p);
}

// ---- buscar un pedazo ----
// Hace lo mismo que s.indexOf(p, desde): primera posición desde "desde" donde aparece p (o -1)
int posicionDeDesde(String s, String p, int desde) {
  int m = p.length();
  if (desde < 0) desde = 0;
  if (desde > s.length()) desde = s.length();
  for (int i = desde; i + m <= s.length(); i++) {
    if (s.substring(i, i + m).equals(p)) return i;
  }
  return -1;
}

// Hace lo mismo que s.indexOf(p)
int posicionDe(String s, String p) {
  return posicionDeDesde(s, p, 0);
}

// Hace lo mismo que s.lastIndexOf(p, desde): última posición, buscando hacia atrás desde "desde"
int ultimaPosicionDeDesde(String s, String p, int desde) {
  int m = p.length();
  if (desde > s.length() - m) desde = s.length() - m;
  for (int i = desde; i >= 0; i--) {
    if (s.substring(i, i + m).equals(p)) return i;
  }
  return -1;
}

// Hace lo mismo que s.lastIndexOf(p)
int ultimaPosicionDe(String s, String p) {
  return ultimaPosicionDeDesde(s, p, s.length());
}

// ---- quitar espacios de los bordes ----
// Hace lo mismo que s.trim(): quita del principio y del final todo lo que tenga código hasta el espacio
String quitarBordes(String s) {
  int a = 0;
  int b = s.length();
  while (a < b && letraEn(s, a) <= ' ') a++;
  while (b > a && letraEn(s, b - 1) <= ' ') b--;
  return s.substring(a, b);
}

// Hace lo mismo que trim(s) de Processing: igual, pero antes cambia el espacio duro (código 160) por espacio
String quitarBordesProcessing(String s) {
  if (s == null) return null;
  return quitarBordes(s.replace(char(160), ' '));
}

String[] resPartir;

// ---- partir y juntar ----
// Hace lo mismo que split(s, "d"): parte en cada d; deja los pedazos vacíos
// Deja el resultado en resPartir.
void partir(String s, String d) {
  int n = 1;
  int k = posicionDe(s, d);
  while (k >= 0) {
    n++;
    k = posicionDeDesde(s, d, k + d.length());
  }
  String[] r = new String[n];
  int desde = 0;
  for (int i = 0; i < n - 1; i++) {
    k = posicionDeDesde(s, d, desde);
    r[i] = s.substring(desde, k);
    desde = k + d.length();
  }
  r[n - 1] = s.substring(desde);
  resPartir = r;
}

String[] resPartirPorLetra;

// Hace lo mismo que split(s, 'd') de Processing (con una letra): igual que partir; si s es null da null
// Deja el resultado en resPartirPorLetra.
void partirPorLetra(String s, char d) {
  if (s == null) { resPartirPorLetra = null; return; }
  partir(s, str(d));
  resPartirPorLetra = resPartir;
}

String[] resPartirTokens;

// Hace lo mismo que splitTokens(s, d): parte en cualquiera de las letras de d y no deja pedazos vacíos
// Deja el resultado en resPartirTokens.
void partirTokens(String s, String d) {
  int n = 0;
  boolean dentro = false;
  for (int i = 0; i < s.length(); i++) {
    if (posicionDe(d, s.substring(i, i + 1)) >= 0) {
      dentro = false;
    } else {
      if (!dentro) n++;
      dentro = true;
    }
  }
  String[] r = new String[n];
  int k = 0;
  int ini = -1;
  for (int i = 0; i <= s.length(); i++) {
    boolean corta = true;
    if (i < s.length()) corta = posicionDe(d, s.substring(i, i + 1)) >= 0;
    if (corta) {
      if (ini >= 0) {
        r[k] = s.substring(ini, i);
        k++;
        ini = -1;
      }
    } else if (ini < 0) {
      ini = i;
    }
  }
  resPartirTokens = r;
}

// Hace lo mismo que join(v, sep): pega todos con sep en medio
String juntar(String[] v, String sep) {
  if (v.length == 0) return "";
  return juntarTramo(v, sep, 0, v.length);
}

// Pega v[a] .. v[b-1] por mitades (así no se copia el mismo texto una y otra vez)
String juntarTramo(String[] v, String sep, int a, int b) {
  if (b - a == 1) return "" + v[a];
  int m = (a + b) / 2;
  return juntarTramo(v, sep, a, m) + sep + juntarTramo(v, sep, m, b);
}

// ---- copiar y alargar vectores ----
// Hace lo mismo que arrayCopy(de, i0, a, j0, n) con vectores de enteros
void copiarEnteros(int[] de, int i0, int[] a, int j0, int n) {
  if (de == a && i0 < j0) {
    for (int k = n - 1; k >= 0; k--) a[j0 + k] = de[i0 + k];
  } else {
    for (int k = 0; k < n; k++) a[j0 + k] = de[i0 + k];
  }
}

// Hace lo mismo que arrayCopy(de, i0, a, j0, n) con vectores de textos
void copiarTextos(String[] de, int i0, String[] a, int j0, int n) {
  if (de == a && i0 < j0) {
    for (int k = n - 1; k >= 0; k--) a[j0 + k] = de[i0 + k];
  } else {
    for (int k = 0; k < n; k++) a[j0 + k] = de[i0 + k];
  }
}

int[] resAlargarEnteros;

// Hace lo mismo que append(v, x) con enteros: un vector nuevo con un elemento más al final
// Deja el resultado en resAlargarEnteros.
void alargarEnteros(int[] v, int x) {
  int[] r = new int[v.length + 1];
  copiarEnteros(v, 0, r, 0, v.length);
  r[v.length] = x;
  resAlargarEnteros = r;
}

// #####################################################################################
//   TAMAÑO DE LA VENTANA y CAFÉ DE NICO
//   - El juego se sigue dibujando en un lienzo de 1600 x 900 (ANCHO x ALTO). draw() lo
//     escala al tamaño de la ventana y pone franjas negras si la ventana es más ancha o
//     más alta. El mouse se pasa de la ventana al lienzo apenas llega (convertirMouse).
//     El tamaño se elige en el título (botón PANTALLA) o en la pausa (pestaña Ajustes) y
//     se guarda en partidas/cuenta.txt.
//   - El kiosco de Nico es la misma Cantina (iniciarPedidos("NICO")) pero con cafés, panes
//     y dulces. Los dibujitos están en data/minijuegos/nico/.
// #####################################################################################

// ---- el lienzo y la ventana ----
final int ANCHO = 1600, ALTO = 900;
final int[][] VENTANA_TAMANOS = { {960, 540}, {1280, 720}, {1366, 768}, {1600, 900}, {1920, 1080} };
final float VENTANA_Y = 362, FPS_Y = 466;
int ventanaW = 1600, ventanaH = 900;
float ventanaEscala = 1, ventanaX = 0, ventanaY = 0;

// Ciclo principal (cada cuadro): escala el lienzo a la ventana, avanza el reloj, dibuja la pantalla que toca y lo que va encima (avisos, música).
void draw() {
  cuadros = cuadros + pasoCuadro;
  medidasVentana();
  translate(ventanaX, ventanaY);
  scale(ventanaEscala);
  dibujarJuego();
  resetMatrix();
  taparBordesVentana();
}

// Cuánto se agranda o achica el lienzo y dónde queda (centrado) dentro de la ventana
void medidasVentana() {
  ventanaEscala = min(anchoVentana() / (float) ANCHO, altoVentana() / (float) ALTO);
  ventanaX = round((anchoVentana() - ANCHO * ventanaEscala) / 2);
  ventanaY = round((altoVentana() - ALTO * ventanaEscala) / 2);
}

// El tamaño real de la ventana (width y height de Processing)
int anchoVentana() {
  return width;
}

// Alto real de la ventana.
int altoVentana() {
  return height;
}

// Franjas negras a los lados (o arriba y abajo) cuando la ventana no es 16:9
void taparBordesVentana() {
  if (ventanaX <= 0 && ventanaY <= 0) return;
  pushStyle();
  noStroke();
  fill(0);
  if (ventanaX > 0) {
    rect(0, 0, ventanaX, altoVentana());
    rect(anchoVentana() - ventanaX - 1, 0, ventanaX + 1, altoVentana());
  }
  if (ventanaY > 0) {
    rect(0, 0, anchoVentana(), ventanaY);
    rect(0, altoVentana() - ventanaY - 1, anchoVentana(), ventanaY + 1);
  }
  popStyle();
}

// El mouse llega en pixeles de la ventana: se pasa a pixeles del lienzo de 1600 x 900
void convertirMouse() {
  medidasVentana();
  mouseX = round((mouseX - ventanaX) / ventanaEscala);
  mouseY = round((mouseY - ventanaY) / ventanaEscala);
}

// Pasa la posición del mouse de la ventana al lienzo de 1600 x 900.
void mouseMoved() {
  convertirMouse();
}

// Pasa la posición del mouse de la ventana al lienzo mientras se arrastra.
void mouseDragged() {
  convertirMouse();
}

// Al arrancar: la ventana se puede estirar y queda del tamaño guardado
void iniciarVentana() {
  surface.setResizable(true);
  if (ventanaW > displayWidth || ventanaH > displayHeight - 40) {
    ventanaW = ANCHO;
    ventanaH = ALTO;
    for (int i = 0; i < VENTANA_TAMANOS.length; i++) {
      if (cabeEnPantalla(i)) {
        ventanaW = VENTANA_TAMANOS[i][0];
        ventanaH = VENTANA_TAMANOS[i][1];
      }
    }
  }
  if (ventanaW != anchoVentana() || ventanaH != altoVentana()) aplicarTamanoVentana();
}

// Cambia el tamaño de la ventana y la centra en la pantalla.
void aplicarTamanoVentana() {
  surface.setSize(ventanaW, ventanaH);
  surface.setLocation(max(0, (displayWidth - ventanaW) / 2), max(0, (displayHeight - ventanaH) / 2 - 20));
}

// Un tamaño sirve si cabe en la pantalla (dejando lugar para la barra de título)
boolean cabeEnPantalla(int i) {
  return VENTANA_TAMANOS[i][0] <= displayWidth && VENTANA_TAMANOS[i][1] <= displayHeight - 40;
}

// Elige uno de los tamaños de ventana de Ajustes y lo guarda.
void elegirTamanoVentana(int i) {
  ventanaW = VENTANA_TAMANOS[i][0];
  ventanaH = VENTANA_TAMANOS[i][1];
  aplicarTamanoVentana();
  guardarCuenta();
}

// Lee "ventana=1280,720" de cuenta.txt
void leerTamanoVentana(String v) {
  partirPorLetra(v, ',');
  String[] p = resPartirPorLetra;
  if (p.length < 2) return;
  int w = int(p[0]);
  int h = int(p[1]);
  if (w < 640 || h < 360) return;
  ventanaW = w;
  ventanaH = h;
}

// La fila de botones con los tamaños (en la pausa y en el título)
void dibujarOpcionesVentana(float x, float y) {
  fill(40);
  textSize(22);
  text("Ventana", x, y + 30);
  for (int i = 0; i < VENTANA_TAMANOS.length; i++) {
    float bx = x + 120 + i * 160;
    boolean puede = cabeEnPantalla(i);
    boolean actual = anchoVentana() == VENTANA_TAMANOS[i][0] && altoVentana() == VENTANA_TAMANOS[i][1];
    noStroke();
    if (actual) fill(110, 80, 200);
    else if (!puede) fill(205, 200, 192);
    else if (mouseX > bx && mouseX < bx + 150 && mouseY > y && mouseY < y + 44) fill(235, 228, 255);
    else fill(220, 214, 200);
    rect(bx, y, 150, 44, 10);
    if (actual) fill(255);
    else if (!puede) fill(150);
    else fill(40);
    textSize(19);
    textAlign(CENTER, CENTER);
    text(VENTANA_TAMANOS[i][0] + " × " + VENTANA_TAMANOS[i][1], bx + 75, y + 20);
    textAlign(LEFT, BASELINE);
  }
  fill(110);
  textSize(14);
  text("Ahora: " + anchoVentana() + " × " + altoVentana() + ". También puedes estirar la ventana con el mouse o maximizarla.", x + 120, y + 60);
}

// Click en uno de los tamaños de ventana.
boolean clickOpcionesVentana(float x, float y) {
  for (int i = 0; i < VENTANA_TAMANOS.length; i++) {
    float bx = x + 120 + i * 160;
    if (mouseX > bx && mouseX < bx + 150 && mouseY > y && mouseY < y + 44) {
      if (cabeEnPantalla(i)) elegirTamanoVentana(i);
      return true;
    }
  }
  return false;
}

// La ventanita del botón PANTALLA en el título
void dibujarMenuPantalla() {
  noStroke();
  fill(0, 0, 0, 170);
  rect(0, 0, ANCHO, ALTO);
  fill(245, 240, 228);
  rect(280, 250, 1040, 380, 18);
  fill(40);
  textSize(32);
  text("Tamaño de la ventana", 320, 310);
  fill(110);
  textSize(17);
  text("El juego se ve igual en todos los tamaños: solo cambia qué tan grande se ve. Se guarda para la próxima vez.", 320, 342);
  dibujarOpcionesVentana(320, 400);
  botonPausa(670, 540, 260, 54, "Volver", color(120, 110, 140));
}

// Clicks en la ventanita de opciones de pantalla del título.
boolean clickMenuPantalla() {
  if (clickOpcionesVentana(320, 400)) return true;
  if (mouseX > 670 && mouseX < 930 && mouseY > 540 && mouseY < 594) menuRanuras = 0;
  return true;
}

