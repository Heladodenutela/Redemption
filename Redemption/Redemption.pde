// Corta una hoja de una sola fila en cuadros de w x h y los deja en el vector (si la hoja falta, quedan null)
void cortarHoja(PImage hoja, PImage[] destino, int w, int h) {
  for (int i = 0; i < destino.length; i++) destino[i] = null;
  if (!hay(hoja)) return;
  for (int i = 0; i < destino.length; i++) if ((i + 1) * w <= hoja.width) destino[i] = hoja.get(i * w, 0, w, h);
}

// Dibuja una imagen dentro de un recuadro sin deformarla (centrada)
void imagenEnCaja(PImage img, float x, float y, float w, float h) {
  if (!hay(img)) return;
  float e = min(w / img.width, h / img.height);
  image(img, x + (w - img.width * e) / 2, y + (h - img.height * e) / 2, img.width * e, img.height * e);
}

// Botón de minijuego con un dibujito a la izquierda (el texto se acomoda en dos líneas si no cabe)
void botonMJIcono(float x, float y, float w, float h, String t, int c, PImage icono) {
  if (!hay(icono)) { botonMJ(x, y, w, h, t, c); return; }
  boolean enc = dentro(x, y, w, h);
  noStroke();
  if (enc) fill(lerpColor(c, color(255), 0.25));
  else fill(c);
  rect(x, y, w, h, 10);
  imagenEnCaja(icono, x + 5, y + 5, 50, h - 10);
  fill(255);
  textSize(16);
  textAlign(CENTER, CENTER);
  text(t, x + 58, y + 2, w - 62, h - 6);
  textAlign(LEFT, BASELINE);
}

// Cliente que espera (Cantina y Vueltos): cara contenta o impaciente
void dibujarClienteMJ(int cliente, boolean impaciente, float x, float y) {
  int k = cliente * 2;
  if (impaciente) k = k + 1;
  if (k < 0 || k >= mjClientes.length || !hay(mjClientes[k])) return;
  image(mjClientes[k], x, y);
}

