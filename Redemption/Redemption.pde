  ventana(430, 280, 740, 300, "Resultado");
  fill(40);
  textSize(24);
  text(deporteTexto, 470, 360, 660, 80);
  text(deportePremio, 470, 460, 660, 60);
  fill(110);
  textSize(20);
  text("[E] o click para seguir", 470, 555);
}

// ============================ RUGBY: el fútbol americano con el rival cada vez más rápido ============================
// Lo llama la "Práctica" de la cancha de rugby (D2)
boolean partidoRugby() {
  boolean copa = empezarPartido("Rugby");
  if (copa) vele = VELE_BASE + (rugbyGanados * VELE_SUBE); else vele = VELE_BASE + 0;
  return copa;
}

// Lo llama el botón "volver" al terminar el fútbol americano (screen 3)
void terminarPartidoRugby() {
  boolean gano = golesJ > golesE;
  if (vele > VELE_BASE) {
    registrarPartido(gano, golesJ + " - " + golesE + (" (rival a velocidad " + nf(vele, 1, 1) + ")"));
  } else {
    registrarPartido(gano, golesJ + " - " + golesE + "");
  }
  vele = VELE_BASE;
  empezarActividad(ACT_DEPORTE_RES);
}

