// Click en un producto de la tienda.
void clickTienda() {
  for (int k = 0; k < tiendaActual.length; k++) {
    float fy = TIENDA_Y + 80 + k * TIENDA_FILA;
    if (mouseX > TIENDA_X + 20 && mouseX < TIENDA_X + TIENDA_W - 20 && mouseY > fy && mouseY < fy + TIENDA_FILA - 6) {
      intentarComprar(k);
      return;
    }
  }
  float alto = 120 + tiendaActual.length * TIENDA_FILA + 60;
  if (mouseX < TIENDA_X || mouseX > TIENDA_X + TIENDA_W || mouseY < TIENDA_Y || mouseY > TIENDA_Y + alto) terminarActividad();
}

// Compra un producto si te alcanza la plata.
void intentarComprar(int k) {
  if (tiendaActual == null || k < 0 || k >= tiendaActual.length) return;
  int precio = int(tiendaActual[k][1]);
  if (dinero < precio) {
    aviso("No te alcanza: " + tiendaActual[k][0] + " cuesta $" + precio);
    return;
  }
  dinero = dinero - precio;
  agregarInventario(tiendaActual[k][0], 1);
  avisoGrande("¡Compraste!", tiendaActual[k][0], "−$" + precio + " · te quedan $" + dinero, color(60, 150, 80));
}

// ---- INVENTARIO: matriz { nombre, cantidad } ----
final int MAX_INV = 40;
String[][] inventario = new String[MAX_INV][2];
int numInv = 0;

// Agrega cosas al inventario (o suma la cantidad si ya las tienes).
void agregarInventario(String nombre, int cantidad) {
  for (int k = 0; k < numInv; k++) {
    if (inventario[k][0].equals(nombre)) {
      inventario[k][1] = str(int(inventario[k][1]) + cantidad);
      return;
    }
  }
  if (numInv >= MAX_INV) { aviso("Inventario lleno"); return; }
  inventario[numInv][0] = nombre;
  inventario[numInv][1] = str(cantidad);
  numInv++;
}

// Cuántas unidades tienes de algo.
int cantidadInventario(String nombre) {
  for (int k = 0; k < numInv; k++) if (inventario[k][0].equals(nombre)) return int(inventario[k][1]);
  return 0;
}

// Quita "cantidad"; si llega a 0 borra la fila y corre las de abajo. Devuelve false si no había suficiente.
boolean quitarInventario(String nombre, int cantidad) {
  for (int k = 0; k < numInv; k++) {
    if (inventario[k][0].equals(nombre)) {
      int c = int(inventario[k][1]);
      if (c < cantidad) return false;
      if (c > cantidad) { inventario[k][1] = str(c - cantidad); return true; }
      for (int j = k; j < numInv - 1; j++) { inventario[j][0] = inventario[j + 1][0]; inventario[j][1] = inventario[j + 1][1]; }
      numInv--;
      return true;
    }
  }
  return false;
}

// ============================ KARAOKE (micrófono abierto, P3) ============================
// Caen notas por 4 carriles (flechas o A S W D) y hay que tocarlas
// cuando pasan por la línea. Mientras, sale la letra abajo y el personaje en grande.
// Al final: Social y seguidores según el porcentaje, y gasta KARAOKE_MIN minutos (cuenta como Amigos).
String[] KARAOKE_LETRA = {
  "Suena la alarma y yo sigo en la pantalla,",
  "un video más y la noche se me escapa.",
  "Pero hoy dejo el celular en la cocina,",
  "que el día es largo y la gente me anima.",
  "Diez días, diez días en la U,",
  "y el tiempo que me queda lo decido yo."
};
final int MAX_NOTAS = 40;
float[][] notas = new float[MAX_NOTAS][3];
int karaokeSiguiente, karaokeAciertos, karaokeTotal, karaokeFallos, karaokeDestello, karaokeDestelloCarril;
final float KARAOKE_GOLPE_Y = 760, KARAOKE_CARRIL_X0 = 880, KARAOKE_CARRIL_DX = 130, KARAOKE_INICIO_Y = 150;
String[] KARAOKE_FLECHA = { "<", "v", "^", ">" };
int[][] KARAOKE_COLOR = { {255, 120, 160}, {120, 200, 255}, {140, 230, 140}, {255, 210, 90} };

// Empieza el karaoke.
void karaoke() {
  empezarActividad(ACT_KARAOKE);
  for (int k = 0; k < MAX_NOTAS; k++) notas[k][2] = 0;
  karaokeSiguiente = millis() + 1200;
  karaokeAciertos = 0;
  karaokeTotal = 0;
  karaokeFallos = 0;
}

// Cuánto dura la canción del karaoke.
int karaokeDuracion() {
  return KARAOKE_LETRA.length * KARAOKE_MS_LINEA;
}

// Dibuja el karaoke: las notas bajan y hay que presionar la flecha a tiempo.
void dibujarKaraoke() {
  int t = millis() - actividadInicio;

  if (ui_karaoke_escenario != null && ui_karaoke_escenario.width > 1) {
    image(ui_karaoke_escenario, 0, 0, 1600, 900);
  } else {
    noStroke();
    fill(25, 15, 40);
    rect(0, 0, ANCHO, ALTO);
    fill(255, 240, 180, 40);
    ellipse(380, 620, 620, 260);
    fill(255, 240, 180, 25);
    triangle(380, 0, 120, 620, 640, 620);
  }

  float esc = 2.4;
  int col = (cuadros / VEL_AFK) % 4;
  int fila;
  if (hojaTieneFila(pj_protagonista, FILA_CANTAR, PJ_CH)) fila = FILA_CANTAR; else fila = FILA_AFK;
  dibujarHoja(pj_protagonista, PJ_CW, PJ_CH, fila, col, 380 - PJ_CENTRO * esc, 660 - PJ_PIES * esc, esc);

  for (int c = 0; c < 4; c++) {
    float x = KARAOKE_CARRIL_X0 + c * KARAOKE_CARRIL_DX;
    fill(255, 255, 255, 25);
    rect(x - 45, KARAOKE_INICIO_Y - 40, 90, KARAOKE_GOLPE_Y - KARAOKE_INICIO_Y + 100, 10);
    boolean brilla = millis() < karaokeDestello && karaokeDestelloCarril == c;
    int[] cc = KARAOKE_COLOR[c];
    if (brilla) fill(cc[0], cc[1], cc[2], 255); else fill(cc[0], cc[1], cc[2], 110);
    rect(x - 45, KARAOKE_GOLPE_Y - 25, 90, 50, 10);
    fill(20);
    textSize(30);
    textAlign(CENTER, CENTER);
    text(KARAOKE_FLECHA[c], x, KARAOKE_GOLPE_Y);
  }

  if (t < karaokeDuracion() - 1500 && millis() >= karaokeSiguiente) {
    for (int k = 0; k < MAX_NOTAS; k++) {
      if (notas[k][2] == 0) {
        notas[k][0] = int(random(4));
        notas[k][1] = KARAOKE_INICIO_Y;
        notas[k][2] = 1;
        karaokeTotal++;
        break;
      }
    }
    karaokeSiguiente = millis() + KARAOKE_NOTA_CADA_MS + int(random(-150, 150));
  }

  float paso = KARAOKE_VEL * 1000.0 / max(1, frameRate);
  for (int k = 0; k < MAX_NOTAS; k++) {
    if (notas[k][2] != 0) {
      notas[k][1] += paso;
      if (notas[k][1] > KARAOKE_GOLPE_Y + KARAOKE_VENTANA) {
        notas[k][2] = 0;
        karaokeFallos++;
      } else {
        int c = int(notas[k][0]);
        int[] cc = KARAOKE_COLOR[c];
        float x = KARAOKE_CARRIL_X0 + c * KARAOKE_CARRIL_DX;
        fill(cc[0], cc[1], cc[2]);
        rect(x - 35, notas[k][1] - 20, 70, 40, 10);
        fill(20);
        textSize(26);
        text(KARAOKE_FLECHA[c], x, notas[k][1]);
      }
    }
  }

  int linea = min(t / KARAOKE_MS_LINEA, KARAOKE_LETRA.length - 1);
  fill(0, 0, 0, 170);
  rect(60, 790, 1480, 90, 12);
  fill(255);
  textSize(34);
  text(KARAOKE_LETRA[linea], 800, 822);
  fill(200);
  textSize(22);
  if (linea + 1 < KARAOKE_LETRA.length) text(KARAOKE_LETRA[linea + 1], 800, 860);

  textAlign(RIGHT, BASELINE);
  fill(255);
  textSize(24);
  text("Aciertos " + karaokeAciertos + " / " + karaokeTotal, 1560, 50);
  textAlign(LEFT, BASELINE);
  text("Micrófono abierto · ← ↓ ↑ → o A S W D", 40, 50);
  if (t >= karaokeDuracion() + 1500) terminarKaraoke();
}

// Flecha presionada en el karaoke: acierto o fallo.
void teclaKaraoke() {
  int c = -1;
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') c = 0;
  if ((key == CODED && keyCode == DOWN) || key == 's' || key == 'S') c = 1;
  if ((key == CODED && keyCode == UP) || key == 'w' || key == 'W') c = 2;
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') c = 3;
  if (key == 'q' || key == 'Q') { terminarKaraoke(); return; }
  if (c < 0) return;
  karaokeDestello = millis() + 120;
  karaokeDestelloCarril = c;

  int mejor = -1;
  float md = KARAOKE_VENTANA;
  for (int k = 0; k < MAX_NOTAS; k++) {
    if (notas[k][2] != 0 && int(notas[k][0]) == c) {
      float d = abs(notas[k][1] - KARAOKE_GOLPE_Y);
      if (d < md) { md = d; mejor = k; }
    }
  }
  if (mejor >= 0) {
    notas[mejor][2] = 0;
    karaokeAciertos++;
  } else {
    karaokeFallos++;
  }
}

// Porcentaje de aciertos en el karaoke.
float karaokePorcentaje() {
  int intentos = max(1, karaokeTotal + max(0, karaokeFallos - (karaokeTotal - karaokeAciertos)));
  return constrain(karaokeAciertos / (float) intentos, 0, 1);
}

int karaokeSocial, karaokeSeguidores;

// Termina el karaoke y da Social según cómo cantaste.
void terminarKaraoke() {
  hecho("KARAOKE");
  float p = karaokePorcentaje();
  karaokeSocial = round(p * KARAOKE_SOCIAL_MAX);
  karaokeSeguidores = round(p * KARAOKE_SEGUIDORES_MAX);
  cambiarStat(ST_SOCIAL, karaokeSocial);
  cambiarStat(ST_SEGUIDORES, karaokeSeguidores);
  catMedios[CAT_AMIGOS] += KARAOKE_MIN * 2;
  avanzarTiempo(KARAOKE_MIN);
  empezarActividad(ACT_KARAOKE_FIN);
}

// Dibuja el resultado del karaoke.
void dibujarKaraokeFin() {
  ventana(500, 260, 600, 320, "¡Cantaste!");
  fill(40);
  textSize(26);
  text("Precisión: " + round(karaokePorcentaje() * 100) + " %", 540, 360);
  text("Social +" + karaokeSocial + "   ·   Seguidores +" + karaokeSeguidores, 540, 410);
  text("Tiempo: " + KARAOKE_MIN + " min (cuenta como Amigos)", 540, 460);
  fill(110);
  textSize(20);
  text("[E] o click para bajar del escenario", 540, 545);
}

