// #####################################################################################
// #####################################################################################
//   FÚTBOL (cancha D1): EL MISMO MOTOR DEL RUGBY, CON ARCO Y ARQUEROS
//   Todo lo de abajo es una copia del motor del rugby con los nombres terminados en S
//   (para que no choque con el original, que sigue funcionando para el rugby).
// #####################################################################################
// #####################################################################################
final int F_XS = 0, F_YS = 1, F_ANGS = 2, F_ANGOBJS = 3, F_GIROS = 4, F_MOVS = 5, F_QUIETOS = 6,
  F_ESTADOS = 7, F_TIMERS = 8, F_OBJXS = 9, F_OBJYS = 10, F_IRS = 11, F_MARCAS = 12, F_MANIOBRAS = 13,
  F_MANTS = 14, F_CARRILS = 15, F_PROFS = 16, F_INMUNES = 17, F_ROLS = 18, F_DECS = 19, F_DECTS = 20, F_COLSS = 21;

// Columnas de la fila 8 de football (el balón) y sus estados
final int BALONS = 8, B_XS = 0, B_YS = 1, B_ESTS = 2, B_OXS = 3, B_OYS = 4, B_DXS = 5, B_DYS = 6,
  B_PS = 7, B_VPS = 8, B_PASADORS = 9, B_ALTS = 10, B_RECEPTORS = 11, AIRES = 9, SUELTOS = 10;
float[][] footballS = new float[9][F_COLSS];

// Roles, maniobras y decisiones de los bots
final int ROL_PORTEROS = 8, ROL_NADAS = 0, ROL_PORTADORS = 1, ROL_ATAQUES = 2, ROL_PERSEGUIRS = 3, ROL_MARCARS = 4, ROL_BALONS = 5, ROL_RECEPTORS = 6, ROL_SUBIRS = 7;
final int MAN_NINGUNAS = 0, MAN_CORTARS = 1, MAN_ACERCARSES = 2, MAN_PROFUNDOS = 3, MAN_ABRIRSES = 4, MAN_REGRESOS = 5;
final int DEC_RECTOS = 0, DEC_HUECOS = 1;
int[] durManiobraS = {0, 12, 12, 20, 12, 8};

// Velocidades
float veljS = 3.0;
float veleS = 3.0;
final float FACTOR_BALONS = 0.9;
final int CICLO_MSS = 100;

// Cancha
final float CX1S = 40, CX2S = 1560, CY1S = 110, CY2S = 880, CENTRO_YS = (CY1S + CY2S) / 2,
  ENDZONES = 100, FORM_XJS = 520, FORM_XES = 1080;

// Tackles, pases y probabilidades
final float RADIO_TACKLES = 60, RADIO_CONTACTOS = 22, RADIO_ATRAPES = 20, RADIO_INTERCEPCIONS = 16,
  SALIDA_PASES = 25, PASE_MAXS = 700, RADIO_PRESIONS = 220,
  PROB_TACKLES = 0.05, PROB_TACKLE_CERCAS = 0.35, PROB_TACKLE_BALONS = 0.25, PROB_MANIOBRAS = 0.05;
final int T_LANCES = 20, T_PISOS = 40, T_DERRIBADOS = 30, T_INMUNES = 30;
final int B_CURVAS = 12, B_RVXS = 13, B_RVYS = 14, B_POTS = 15;
final int GOLES_GANARS = 3;
final float ARCO_Y1S = 429, ARCO_Y2S = 563;

// Estado del partido (fbEstadoS: 0 jugando, 1 pausa, 2 fin)
int golesJS, golesES, equipoAtaqueS, controladoS, fbEstadoS, fbPausaS, fbTrasPausaS, fbSaqueS, fbCicloS, fbMarcaTS;
String fbMensajeS = "";

// Fútbol: equipo de un jugador (igual que en el rugby).
int equipoDeS(int k) { if (k < 4) return 0; else return 1; }
// Fútbol: primer jugador de un equipo.
int iniEqS(int eq) { if (eq == 0) return 0; else return 4; }
// Fútbol: hacia qué lado ataca un equipo.
float dirAtaqueS(int eq) { if (eq == 0) return 1; else return -1; }
// Fútbol: arco al que ataca un equipo.
float bordeAtaqueS(int eq) { if (eq == 0) return CX2S - 70; else return CX1S + 70; }
// ¿Este jugador es el arquero de su equipo?
boolean esArquero(int k) { return k == 0 || k == 4; }
// Dónde se para el arquero de un equipo.
float lineaArco(int eq) { if (eq == 0) return CX1S + 26; else return CX2S - 26; }

// Fútbol: qué jugador tiene el balón.
int duenoS() {
  int e = (int) footballS[BALONS][B_ESTS];
  if (e >= 0 && e < 8) return e;
  return -1;
}

// Fútbol: distancia entre dos jugadores.
float distJugS(int a, int b) {
  return dist(footballS[a][F_XS], footballS[a][F_YS], footballS[b][F_XS], footballS[b][F_YS]);
}

// Fútbol: distancia de un jugador a un punto.
float distAS(int k, float x, float y) {
  return dist(footballS[k][F_XS], footballS[k][F_YS], x, y);
}

// Fútbol: velocidad de un jugador (más lento con el balón).
float velDeS(int k) {
  float v;
  if (k < 4) v = veljS; else v = veleS;
  if (duenoS() == k) v = v * FACTOR_BALONS;
  if (sprintS[k]) v = v * SPRINT_VEL;
  return v;
}

// Velocidad del balon en el aire
float velPaseS(float largo) {
  return 7 + largo * 0.01;
}

// Fútbol: dónde estará el balón en x dentro de fr cuadros.
float balonXEnS(float fr) {
  float p = min(1, footballS[BALONS][B_PS] + footballS[BALONS][B_VPS] * fr);
  return lerp(footballS[BALONS][B_OXS], footballS[BALONS][B_DXS], p);
}

// Fútbol: dónde estará el balón en y dentro de fr cuadros.
float balonYEnS(float fr) {
  float p = min(1, footballS[BALONS][B_PS] + footballS[BALONS][B_VPS] * fr);
  return lerp(footballS[BALONS][B_OYS], footballS[BALONS][B_DYS], p);
}

float[] resPuntoAlcanzableS;

// Fútbol: ¿el jugador llega a donde va a caer el balón?
// Deja el resultado en resPuntoAlcanzableS.
void puntoAlcanzableS(int k, float v, int maxFr, float radio) {
  int restantes = ceil((1 - footballS[BALONS][B_PS]) / max(0.0001, footballS[BALONS][B_VPS]));
  int lim = min(maxFr, restantes);
  for (int fr = 1; fr <= lim; fr++) {
    float bx = balonXEnS(fr), by = balonYEnS(fr);
    if (distAS(k, bx, by) <= v * fr + radio) { resPuntoAlcanzableS = new float[] { bx, by }; return; }
  }
  resPuntoAlcanzableS = null;
}

// Fútbol: probabilidad de quitar el balón según la distancia.
float chanceTackleS(float dd) {
  float pr = constrain((RADIO_TACKLES - dd) / (RADIO_TACKLES - 20), 0, 1);
  return lerp(PROB_TACKLES, PROB_TACKLE_CERCAS, pr);
}

float[] resPuntoCorteJugadorS;

// Fútbol: punto donde un defensor puede cortarle el paso al que lleva el balón.
// Deja el resultado en resPuntoCorteJugadorS.
void puntoCorteJugadorS(int k, int du) {
  float px = footballS[du][F_XS], py = footballS[du][F_YS];
  if (footballS[du][F_MOVS] == 0) { resPuntoCorteJugadorS = new float[] { px, py }; return; }
  float vx = cos(footballS[du][F_ANGS]) * velDeS(du), vy = sin(footballS[du][F_ANGS]) * velDeS(du);
  for (int fr = 0; fr <= 60; fr += 3) {
    float fx = px + vx * fr, fy = py + vy * fr;
    if (distAS(k, fx, fy) <= velDeS(k) * fr + 10) { resPuntoCorteJugadorS = new float[] { fx, fy }; return; }
  }
  resPuntoCorteJugadorS = new float[] { px + vx * 8, py + vy * 8 };
}

// Fútbol: ¿tu jugador espera quieto el pase que viene?
boolean autoRecibeS(int k) {
  return k == controladoS && !(pArr || pIzq || pAba || pDer) && footballS[BALONS][B_ESTS] == AIRES
    && (int) footballS[BALONS][B_PASADORS] < 4 && (int) footballS[BALONS][B_RECEPTORS] == k;
}

// Fútbol: pone a los jugadores en su lugar para el saque.
void formacionS(int eqBalon) {
  float alto = CY2S - CY1S;
  for (int k = 0; k < 8; k++) {
    for (int c = 0; c < F_COLSS; c++) footballS[k][c] = 0;
    float yy;
    if (esArquero(k)) yy = CENTRO_YS; else yy = CY1S + alto * ((k % 4) - 0.5) / 3.0;
    footballS[k][F_YS] = yy;
    footballS[k][F_CARRILS] = yy;
    if (k < 4) {
      if (esArquero(k)) footballS[k][F_XS] = lineaArco(0); else footballS[k][F_XS] = FORM_XJS;
      footballS[k][F_ANGS] = 0;
    } else {
      if (esArquero(k)) footballS[k][F_XS] = lineaArco(1); else footballS[k][F_XS] = FORM_XES;
      footballS[k][F_ANGS] = PI;
    }
    footballS[k][F_ANGOBJS] = footballS[k][F_ANGS];
    footballS[k][F_OBJXS] = footballS[k][F_XS];
    footballS[k][F_OBJYS] = footballS[k][F_YS];
    footballS[k][F_QUIETOS] = 3;
    footballS[k][F_MARCAS] = -1;
    footballS[k][F_PROFS] = random(150, 480) * estProfundo[equipoDeS(k)];
  }
  for (int c = 0; c < F_COLSS; c++) footballS[BALONS][c] = 0;
  footballS[BALONS][B_PASADORS] = -1;
  footballS[BALONS][B_RECEPTORS] = -1;
  controladoS = 1;
  if (eqBalon == 0) darBalonS(2); else darBalonS(6);
  int aux1;
  if (eqBalon == 0) aux1 = 2; else aux1 = 6;
  int aux2;
  if (eqBalon == 0) aux2 = 770; else aux2 = 830;
  footballS[aux1][F_XS] = aux2;
  if (eqBalon == 0) footballS[2][F_YS] = CENTRO_YS; else footballS[6][F_YS] = CENTRO_YS;
  arqueroTiene = 0;
  fbMarcaTS = 0;
}

// Fútbol: le da el balón a un jugador.
void darBalonS(int k) {
  footballS[BALONS][B_ESTS] = k;
  footballS[BALONS][B_XS] = footballS[k][F_XS];
  footballS[BALONS][B_YS] = footballS[k][F_YS];
  footballS[BALONS][B_ALTS] = 0;
  equipoAtaqueS = equipoDeS(k);
  if (footballS[k][F_ESTADOS] == 1) {
    footballS[k][F_ESTADOS] = 0;
    footballS[k][F_TIMERS] = 0;
  }
  footballS[k][F_INMUNES] = T_INMUNES;
  footballS[k][F_DECS] = DEC_RECTOS;
  footballS[k][F_DECTS] = 3;
  footballS[k][F_OBJXS] = constrain(footballS[k][F_XS] + dirAtaqueS(equipoAtaqueS) * 150, CX1S + 10, CX2S - 10);
  footballS[k][F_OBJYS] = footballS[k][F_YS];
  footballS[k][F_IRS] = 1;
  for (int q = 0; q < 8; q++) {
    footballS[q][F_MANIOBRAS] = MAN_NINGUNAS;
    footballS[q][F_MANTS] = 0;
  }
  fbMarcaTS = 0;
  if (k < 4) cambiarControlS(k);
}

// Fútbol: cambia el jugador que manejas (nunca el arquero).
void cambiarControlS(int nuevo) {
  if (nuevo < 1 || nuevo > 3 || nuevo == controladoS) return;
  footballS[controladoS][F_OBJXS] = footballS[controladoS][F_XS];
  footballS[controladoS][F_OBJYS] = footballS[controladoS][F_YS];
  footballS[controladoS][F_IRS] = 0;
  controladoS = nuevo;
}

// Fútbol: el jugador se barre.
void lanzarseS(int k, float ang) {
  footballS[k][F_ESTADOS] = 1;
  footballS[k][F_TIMERS] = T_LANCES;
  footballS[k][F_ANGS] = ang;
  footballS[k][F_ANGOBJS] = ang;
  footballS[k][F_GIROS] = 0;
  footballS[k][F_MOVS] = 1;
}

// Fútbol: patea un pase o un tiro hacia un punto.
void lanzarPaseS(int k, float tx, float ty) {
  float x0 = footballS[k][F_XS], y0 = footballS[k][F_YS];
  float largo = dist(x0, y0, tx, ty);
  if (largo < SALIDA_PASES) return;
  float maxPase = PASE_MAXS * max(1, picPotencia);
  if (largo > maxPase) {
    tx = x0 + (tx - x0) * maxPase / largo;
    ty = y0 + (ty - y0) * maxPase / largo;
  }
  largo = max(1, dist(x0, y0, tx, ty));
  footballS[BALONS][B_CURVAS] = picCurva;
  footballS[BALONS][B_POTS] = picPotencia;
  footballS[BALONS][B_ESTS] = AIRES;
  footballS[BALONS][B_XS] = x0;
  footballS[BALONS][B_YS] = y0;
  footballS[BALONS][B_OXS] = x0;
  footballS[BALONS][B_OYS] = y0;
  footballS[BALONS][B_DXS] = tx;
  footballS[BALONS][B_DYS] = ty;
  footballS[BALONS][B_PS] = 0;
  boolean tiro = (equipoDeS(k) == 0 && tx > CX2S - 70) || (equipoDeS(k) == 1 && tx < CX1S + 70);
  if (tiro) {
    footballS[BALONS][B_VPS] = velPaseS(largo) * (1.6 + (min(picPotencia, 1.7) - 1) * 0.6) / largo;
  } else {
    footballS[BALONS][B_VPS] = velPaseS(largo) * (1.15 * picPotencia) / largo;
  }
  picPotencia = 1;
  picCurva = 0;
  footballS[BALONS][B_PASADORS] = k;
  int eq = equipoDeS(k), ini = iniEqS(eq);
  int rec = -1;
  float md = 99999;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k && footballS[q][F_ESTADOS] != 2) {
      float dd = distAS(q, tx, ty);
      if (dd < md) { md = dd; rec = q; }
    }
  }
  footballS[BALONS][B_RECEPTORS] = rec;
  footballS[k][F_OBJXS] = x0;
  footballS[k][F_OBJYS] = y0;
  if (eq == 0 && rec >= 0) cambiarControlS(rec);
}

// Fútbol: pasa el balón a un compañero.
void pasarAS(int k, int rec) {
  float rx = footballS[rec][F_XS], ry = footballS[rec][F_YS];
  float largo = distJugS(k, rec);
  float frames = largo / velPaseS(largo);
  if (footballS[rec][F_MOVS] == 1) {
    float adel = velDeS(rec) * frames * 0.6;
    rx += cos(footballS[rec][F_ANGS]) * adel;
    ry += sin(footballS[rec][F_ANGS]) * adel;
  }
  lanzarPaseS(k, rx, ry);
}

// Fútbol: click para pasar o tirar (mantener para cargar potencia).
void clickFutbolS() {
  int k = controladoS;
  if (footballS[k][F_ESTADOS] != 0) return;
  if (duenoS() == k) {
    picCargaDesde = millis();
  } else {
    lanzarseS(k, atan2(mouseY - footballS[k][F_YS], mouseX - footballS[k][F_XS]));
  }
}

// Un cuadro del fútbol: IA, roles, barridas, movimiento y goles.
void cicloFutbolS() {
  int du = duenoS();
  if (du >= 4) {
    portadorRivalS(du);

    if (esDefensa[du] && duenoS() == du && footballS[du][F_XS] <= lineaDefensa(1) + 15) {
      int del = delanteroLibre(du);
      if (del >= 0) pasarAS(du, del);
    }
  }
  actualizarControlS();
  calcularRolesS();
  footballS[0][F_ROLS] = ROL_PORTEROS;
  footballS[4][F_ROLS] = ROL_PORTEROS;
  arqueroConBalon();
  fbMarcaTS--;
  if (fbMarcaTS <= 0) {
    asignarMarcasS();
    fbMarcaTS = 5;
  }
  for (int k = 0; k < 8; k++) {
    if (k != controladoS && footballS[k][F_ROLS] == ROL_ATAQUES) {
      if (footballS[k][F_MANTS] > 0) {
        footballS[k][F_MANTS]--;
        if (footballS[k][F_MANTS] <= 0) footballS[k][F_MANIOBRAS] = MAN_NINGUNAS;
      } else if (random(1) < PROB_MANIOBRAS) {
        elegirManiobraS(k);
      }
    }
  }
  du = duenoS();
  for (int k = 0; k < 8; k++) {
    if (k != controladoS && k != du && footballS[k][F_ESTADOS] == 0) {
      if (random(1) < 0.5) actualizarObjetivoS(k);
    }
  }
  intentarTacklesS();
  for (int k = 0; k < 8; k++) aplicarInerciaS(k);
}

// Fútbol: pasa el control al jugador tuyo que tiene el balón o al más cercano.
void actualizarControlS() {
  int du = duenoS();
  if (du >= 0 && du < 4) {
    cambiarControlS(du);
    return;
  }
  int est = (int) footballS[BALONS][B_ESTS];
  float bx = footballS[BALONS][B_XS], by = footballS[BALONS][B_YS];
  if (est == AIRES) {
    if ((int) footballS[BALONS][B_PASADORS] < 4) return;
    bx = footballS[BALONS][B_DXS];
    by = footballS[BALONS][B_DYS];
  } else if (distAS(controladoS, bx, by) <= 40) {
    return;
  }
  int c = masCercanoS(0, bx, by);
  if (c >= 0 && (footballS[controladoS][F_ESTADOS] == 2 || distAS(c, bx, by) + 15 < distAS(controladoS, bx, by))) cambiarControlS(c);
}

// Fútbol: jugador de un equipo más cercano a un punto.
int masCercanoS(int eq, float x, float y) {
  int ini = iniEqS(eq), mejor = -1;
  float md = 99999;
  for (int q = ini; q < ini + 4; q++) {
    if (footballS[q][F_ESTADOS] != 2 && !esArquero(q)) {
      float dd = distAS(q, x, y);
      if (dd < md) { md = dd; mejor = q; }
    }
  }
  return mejor;
}

// Fútbol: decide qué hace cada jugador.
void calcularRolesS() {
  int du = duenoS();
  for (int k = 0; k < 8; k++) footballS[k][F_ROLS] = ROL_NADAS;
  if (du >= 0) {
    int eqA = equipoDeS(du), iA = iniEqS(eqA), iD = iniEqS(1 - eqA);
    for (int k = iA; k < iA + 4; k++) footballS[k][F_ROLS] = ROL_ATAQUES;
    footballS[du][F_ROLS] = ROL_PORTADORS;
    for (int k = iD; k < iD + 4; k++) footballS[k][F_ROLS] = ROL_MARCARS;
    int a = -1, b2 = -1;
    float da = 99999, db = 99999;
    for (int k = iD; k < iD + 4; k++) {
      if (footballS[k][F_ESTADOS] != 2) {
        float dd = distJugS(k, du);
        if (dd < da) { b2 = a; db = da; a = k; da = dd; }
        else if (dd < db) { b2 = k; db = dd; }
      }
    }
    if (a >= 0) footballS[a][F_ROLS] = ROL_PERSEGUIRS;
    if (a >= 0 && b2 >= 0) {
      float ladoA = footballS[a][F_YS] - footballS[du][F_YS];
      float ladoB = footballS[b2][F_YS] - footballS[du][F_YS];
      if (ladoA * ladoB < 0 || estAgresivo[1 - eqA] > 1.3) footballS[b2][F_ROLS] = ROL_PERSEGUIRS;
    }
    return;
  }
  boolean aire = (footballS[BALONS][B_ESTS] == AIRES);
  float bx = footballS[BALONS][B_XS], by = footballS[BALONS][B_YS];
  int[] cerca = {-1, -1};
  float[] dCerca = {99999, 99999};
  int[] botBalon = {-1, -1};
  for (int eq = 0; eq < 2; eq++) {
    int ini = iniEqS(eq);
    for (int k = ini; k < ini + 4; k++) { if (eq == equipoAtaqueS) footballS[k][F_ROLS] = ROL_ATAQUES; else footballS[k][F_ROLS] = ROL_MARCARS; }
    if (aire && eq == equipoAtaqueS) {
      int rec = (int) footballS[BALONS][B_RECEPTORS];
      if (rec >= 0) {
        footballS[rec][F_ROLS] = ROL_RECEPTORS;
        cerca[eq] = rec;
        dCerca[eq] = distAS(rec, footballS[BALONS][B_DXS], footballS[BALONS][B_DYS]);
      }
    } else {
      float dBot = 99999;
      for (int k = ini; k < ini + 4; k++) {
        if (footballS[k][F_ESTADOS] != 2) {
          float dd;
          if (aire) dd = distPuntoSegmentoS(footballS[k][F_XS], footballS[k][F_YS], bx, by, footballS[BALONS][B_DXS], footballS[BALONS][B_DYS]);
          else dd = distAS(k, bx, by);
          if (dd < dCerca[eq]) { dCerca[eq] = dd; cerca[eq] = k; }
          if (k != controladoS && dd < dBot) { dBot = dd; botBalon[eq] = k; }
        }
      }
      if (botBalon[eq] >= 0) footballS[botBalon[eq]][F_ROLS] = ROL_BALONS;
    }
  }
  for (int eq = 0; eq < 2; eq++) {
    if (cerca[eq] >= 0 && !(dCerca[eq] * 1.6 > dCerca[1 - eq])) {
      int ini = iniEqS(eq), mejor = -1;
      float dir = dirAtaqueS(eq), av = -99999;
      for (int k = ini; k < ini + 4; k++) {
        if (k != cerca[eq] && k != botBalon[eq] && k != controladoS && footballS[k][F_ESTADOS] != 2) {
          if (footballS[k][F_XS] * dir > av) { av = footballS[k][F_XS] * dir; mejor = k; }
        }
      }
      if (mejor >= 0) footballS[mejor][F_ROLS] = ROL_SUBIRS;
    }
  }
}

// Fútbol: ¿este jugador está marcando?
boolean esMarcadorS(int q) {
  return q != controladoS && footballS[q][F_ROLS] == ROL_MARCARS;
}

// Fútbol: a cada defensor le asigna un atacante.
void asignarMarcasS() {
  int du = duenoS();
  int eqA = equipoAtaqueS, iA = iniEqS(eqA), iD = iniEqS(1 - eqA);
  boolean[] tomado = new boolean[8];
  boolean[] listo = new boolean[8];
  for (int vuelta = 0; vuelta < 4; vuelta++) {
    int mejor = -1;
    float md = 99999;
    for (int q = iD; q < iD + 4; q++) {
      if (!listo[q] && esMarcadorS(q)) {
        int mk = (int) footballS[q][F_MARCAS];
        if (mk >= iA && mk < iA + 4 && mk != du) {
          float dd = distJugS(q, mk);
          if (dd < md) { md = dd; mejor = q; }
        }
      }
    }
    if (mejor < 0) break;
    listo[mejor] = true;
    int marca = (int) footballS[mejor][F_MARCAS];
    if (tomado[marca]) footballS[mejor][F_MARCAS] = -1;
    else tomado[marca] = true;
  }
  for (int q = iD; q < iD + 4; q++) {
    if (esMarcadorS(q) && !(listo[q] && footballS[q][F_MARCAS] >= 0)) {
      int mejor = -1;
      float md = 99999;
      for (int a = iA; a < iA + 4; a++) {
        if (a != du && !tomado[a] && !esArquero(a)) {
          float dd = distJugS(q, a);
          if (dd < md) { md = dd; mejor = a; }
        }
      }
      footballS[q][F_MARCAS] = mejor;
      if (mejor >= 0) tomado[mejor] = true;
    }
  }
}

// Fútbol: el rival elige una jugada (también según su estrategia).
void elegirManiobraS(int k) {
  int man = 1 + (int) random(5);
  if (random(1) < 0.3 * (estProfundo[equipoDeS(k)] - 1)) man = MAN_PROFUNDOS;
  if (man == MAN_CORTARS && !puedeCortarS(k)) man = 2 + (int) random(4);
  footballS[k][F_MANIOBRAS] = man;
  footballS[k][F_MANTS] = durManiobraS[man];
}

// Fútbol: ¿el jugador tiene espacio para cortar al centro?
boolean puedeCortarS(int k) {
  float x = footballS[k][F_XS], y = footballS[k][F_YS];
  if (abs(y - CENTRO_YS) < 90) return false;
  int eq = equipoDeS(k), ini = iniEqS(eq);
  float dir = dirAtaqueS(eq);
  for (int q = ini; q < ini + 4; q++) {
    if (q != k) {
      float adelante = (footballS[q][F_XS] - x) * dir;
      if (adelante > -15 && adelante < 60) {
        if (footballS[q][F_MANIOBRAS] == MAN_CORTARS || abs(footballS[q][F_YS] - CENTRO_YS) < 70) return false;
      }
    }
  }
  return true;
}

// Fútbol: mantiene la línea de jugadores separada.
float separarLineaS(int k, float tx, boolean ataca) {
  int eq = equipoDeS(k), ini = iniEqS(eq);
  float dir = dirAtaqueS(eq);
  int du = duenoS();
  int cuenta = 0;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k) {
      float lx = footballS[q][F_XS];
      if (q != controladoS && q != du && footballS[q][F_IRS] == 1) lx = footballS[q][F_OBJXS];
      if (abs(lx - tx) < 50) cuenta++;
    }
  }
  if (cuenta < 2) return tx;
  if (ataca) {
    float nuevo = tx + dir * 110;
    float borde = bordeAtaqueS(eq);
    if ((dir > 0 && nuevo > borde) || (dir < 0 && nuevo < borde)) nuevo = tx - dir * 110;
    return nuevo;
  }
  return tx - dir * 70;
}

// Fútbol: a dónde corre cada jugador según su rol y la estrategia.
void actualizarObjetivoS(int k) {
  int rol = (int) footballS[k][F_ROLS];
  int eq = equipoDeS(k);
  float dir = dirAtaqueS(eq);
  int du = duenoS();
  float x = footballS[k][F_XS], y = footballS[k][F_YS];
  float tx = x, ty = y;
  float refx;
  if (du >= 0) refx = footballS[du][F_XS]; else refx = footballS[BALONS][B_XS];
  float refy;
  if (du >= 0) refy = footballS[du][F_YS]; else refy = footballS[BALONS][B_YS];

  if (rol == ROL_PORTEROS) {
    tx = lineaArco(eq);
    float by = refy;
    if (footballS[BALONS][B_ESTS] == AIRES) by = footballS[BALONS][B_DYS];
    ty = constrain(lerp(CENTRO_YS, by, 0.7), ARCO_Y1S + 12, ARCO_Y2S - 12);

    if (du < 0 && footballS[BALONS][B_ESTS] == SUELTOS && abs(footballS[BALONS][B_XS] - tx) < 170 && abs(footballS[BALONS][B_YS] - CENTRO_YS) < 220) {
      tx = footballS[BALONS][B_XS];
      ty = footballS[BALONS][B_YS];
    }
    footballS[k][F_OBJXS] = tx;
    footballS[k][F_OBJYS] = ty;
    footballS[k][F_IRS] = 1;
    return;
  }
  if (esDefensa[k] && k != controladoS && (rol == ROL_ATAQUES || rol == ROL_SUBIRS)) {
    float linea = lineaDefensa(eq);
    if (eq == 0) tx = min(linea - 40, refx - 120); else tx = max(linea + 40, refx + 120);
    ty = lerp(footballS[k][F_CARRILS], refy, 0.25);
    footballS[k][F_OBJXS] = constrain(tx, CX1S + 10, CX2S - 10);
    footballS[k][F_OBJYS] = constrain(ty, CY1S + 14, CY2S - 14);
    footballS[k][F_IRS] = 1;
    return;
  }
  if (rol == ROL_PERSEGUIRS && du >= 0) {
    puntoCorteJugadorS(k, du);
    float[] pc = resPuntoCorteJugadorS;
    tx = pc[0];
    ty = pc[1];
  } else if (rol == ROL_MARCARS) {
    int mk = (int) footballS[k][F_MARCAS];
    if (mk >= 0 && mk != du) {
      float f;
      if (du >= 0) f = 0.7; else f = 0.85;
      tx = lerp(refx, footballS[mk][F_XS], f);
      ty = lerp(refy, footballS[mk][F_YS], f);
    } else {
      tx = refx - dir * 180;
      ty = lerp(refy, CENTRO_YS, 0.3);
    }
    tx = separarLineaS(k, tx, false);
  } else if (rol == ROL_ATAQUES) {
    int man = (int) footballS[k][F_MANIOBRAS];
    float carril = footballS[k][F_CARRILS];
    if (man == MAN_CORTARS) {
      tx = x + dir * 80;
      ty = CENTRO_YS;
    } else if (man == MAN_ACERCARSES) {
      float lado;
      if (carril < refy) lado = -1; else lado = 1;
      tx = refx + dir * 60;
      ty = refy + lado * 90;
    } else if (man == MAN_PROFUNDOS) {
      tx = bordeAtaqueS(eq);
      ty = carril;
    } else if (man == MAN_ABRIRSES) {
      tx = x + dir * 80;
      if (y < CENTRO_YS) ty = CY1S + 40; else ty = CY2S - 40;
    } else if (man == MAN_REGRESOS) {
      tx = refx + dir * 90;
      ty = y;
    } else {
      tx = refx + dir * footballS[k][F_PROFS];
      ty = carril;
    }
    tx = separarLineaS(k, tx, true);
  } else if (rol == ROL_BALONS) {
    if (footballS[BALONS][B_ESTS] == AIRES) {
      puntoAlcanzableS(k, velDeS(k), 400, RADIO_INTERCEPCIONS);
      float[] pt = resPuntoAlcanzableS;
      if (pt != null) {
        tx = pt[0];
        ty = pt[1];
      } else {
        tx = footballS[BALONS][B_DXS];
        ty = footballS[BALONS][B_DYS];
      }
    } else {
      tx = footballS[BALONS][B_XS];
      ty = footballS[BALONS][B_YS];
    }
  } else if (rol == ROL_RECEPTORS) {
    tx = footballS[BALONS][B_DXS];
    ty = footballS[BALONS][B_DYS];
  } else if (rol == ROL_SUBIRS) {
    tx = x + dir * 150;
    ty = footballS[k][F_CARRILS];
  }
  if (rol == ROL_ATAQUES || rol == ROL_SUBIRS) {
    float borde = bordeAtaqueS(eq);
    if (dir > 0) tx = min(tx, borde); else tx = max(tx, borde);
  }
  if (rol == ROL_ATAQUES || rol == ROL_SUBIRS) tx = limiteDefensa(k, tx);
  footballS[k][F_OBJXS] = constrain(tx, CX1S + 10, CX2S - 10);
  footballS[k][F_OBJYS] = constrain(ty, CY1S + 14, CY2S - 14);
  footballS[k][F_IRS] = 1;
}

// Fútbol: distancia de un punto a un segmento.
float distPuntoSegmentoS(float px, float py, float ax, float ay, float bx, float by) {
  float vx = bx - ax, vy = by - ay;
  float len2 = vx * vx + vy * vy;
  float u = 0;
  if (len2 > 0) u = constrain(((px - ax) * vx + (py - ay) * vy) / len2, 0, 1);
  return dist(px, py, ax + vx * u, ay + vy * u);
}

// Fútbol: IA del rival con el balón (avanzar, pasar o tirar al arco).
void portadorRivalS(int k) {
  int eq = equipoDeS(k);
  float dir = dirAtaqueS(eq);
  float x = footballS[k][F_XS], y = footballS[k][F_YS];
  int a = -1, b2 = -1;
  float da = 99999, db = 99999;
  int iD = iniEqS(1 - eq);
  for (int q = iD; q < iD + 4; q++) {
    if (footballS[q][F_ESTADOS] != 2) {
      float dd = distJugS(k, q);
      if (dd < da) { b2 = a; db = da; a = q; da = dd; }
      else if (dd < db) { b2 = q; db = dd; }
    }
  }
  for (int q = iD; q < iD + 4; q++) {
    if (footballS[q][F_ESTADOS] == 1 && !(distJugS(k, q) > 110)) {
      if (random(1) < 0.5) {
        float angL = footballS[q][F_ANGS];
        float cruz = cos(angL) * (y - footballS[q][F_YS]) - sin(angL) * (x - footballS[q][F_XS]);
        float ang;
        if (cruz >= 0) ang = angL + HALF_PI; else ang = angL + (-HALF_PI);
        footballS[k][F_OBJXS] = constrain(x + cos(ang) * 120, CX1S + 10, CX2S - 10);
        footballS[k][F_OBJYS] = constrain(y + sin(ang) * 120, CY1S + 14, CY2S - 14);
        footballS[k][F_IRS] = 1;
        return;
      }
    }
  }
  footballS[k][F_DECTS]--;
  if (footballS[k][F_DECTS] <= 0 && x - CX1S < 430 && random(1) < 0.55) {
    float esquina;
    if (footballS[0][F_YS] > CENTRO_YS) esquina = ARCO_Y1S + 14; else esquina = ARCO_Y2S - 14;
    lanzarPaseS(k, CX1S + 4, esquina + random(-34, 34) * (1.4 - picDif * 0.15));
    return;
  }
  if (footballS[k][F_DECTS] <= 0) {
    footballS[k][F_DECTS] = 3;
    float pPase, pHueco;
    if (da >= RADIO_PRESIONS) {
      pPase = 0;
      pHueco = 0.3;
    } else {
      float pr = 1 - da / RADIO_PRESIONS;
      pPase = constrain(0.45 - 0.35 * pr, 0.10, 0.45);
      pHueco = constrain(0.25 + 0.55 * pr, 0.10, 0.80);
    }
    float pRecto = max(0.10, 1 - pPase - pHueco);
    float rr = random(pPase + pHueco + pRecto);
    if (rr < pPase) {
      int rec = mejorReceptorS(k, a, b2);
      if (rec >= 0) {
        pasarAS(k, rec);
        return;
      }
      footballS[k][F_DECS] = DEC_HUECOS;
    } else if (rr < pPase + pHueco) {
      footballS[k][F_DECS] = DEC_HUECOS;
    } else {
      footballS[k][F_DECS] = DEC_RECTOS;
    }
  }
  if (random(1) < 0.5) {
    float ang;
    if (dir > 0) ang = 0; else ang = PI;
    if (footballS[k][F_DECS] == DEC_HUECOS && a >= 0) ang = anguloHuecoS(k, a, b2);
    footballS[k][F_OBJXS] = constrain(x + cos(ang) * 150, CX1S + 10, CX2S - 10);
    footballS[k][F_OBJYS] = constrain(y + sin(ang) * 150, CY1S + 14, CY2S - 14);
    footballS[k][F_IRS] = 1;
  }
}

// Fútbol: ángulo del hueco más libre.
float anguloHuecoS(int k, int a, int b2) {
  float x = footballS[k][F_XS], y = footballS[k][F_YS];
  float dir = dirAtaqueS(equipoDeS(k));
  float empuje = 0;
  int[] dos = {a, b2};
  for (int n = 0; n < 2; n++) {
    int q = dos[n];
    if (q >= 0) {
      float adelante = (footballS[q][F_XS] - x) * dir;
      float dy = footballS[q][F_YS] - y;
      float dd = max(25, distJugS(k, q));
      float peso;
      if (adelante > -20) peso = 1.0; else peso = 0.35;
      float lado;
      if (dy >= 0) lado = 1; else lado = -1;
      empuje -= lado * peso * (RADIO_PRESIONS / dd);
    }
  }
  if (y < CY1S + 90) empuje += (CY1S + 90 - y) / 30;
  if (y > CY2S - 90) empuje -= (y - (CY2S - 90)) / 30;
  float incl = constrain(empuje * 0.2, -1, 1);
  return atan2(incl, dir);
}

// Fútbol: mejor compañero para el pase.
int mejorReceptorS(int k, int a, int b2) {
  int eq = equipoDeS(k), ini = iniEqS(eq);
  float dir = dirAtaqueS(eq);
  int mejor = -1;
  float mejorAv = -99999;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k && footballS[q][F_ESTADOS] != 2) {
      float dd = distJugS(k, q);
      if (!(dd < 60) && !(dd > PASE_MAXS) && !tapaPaseS(a, k, q) && !tapaPaseS(b2, k, q)) {
        float av = footballS[q][F_XS] * dir;
        if (!(esDefensa[k] && esDefensa[q] && delanteroLibre(k) >= 0) && !esArquero(q)) {
          if (av > mejorAv) { mejorAv = av; mejor = q; }
        }
      }
    }
  }
  return mejor;
}

// Fútbol: ¿un defensor tapa el pase?
boolean tapaPaseS(int def, int k, int q) {
  if (def < 0) return false;
  return distPuntoSegmentoS(footballS[def][F_XS], footballS[def][F_YS], footballS[k][F_XS], footballS[k][F_YS], footballS[q][F_XS], footballS[q][F_YS]) < 45;
}

// Fútbol: los defensores cerca intentan quitar el balón.
void intentarTacklesS() {
  int du = duenoS();
  for (int k = 0; k < 8; k++) {
    if (k != controladoS && footballS[k][F_ESTADOS] == 0 && !(esArquero(k) && (du < 0 || abs(footballS[du][F_XS] - lineaArco(equipoDeS(k))) > 140))) {
      boolean seguir5 = true;
      if (du >= 0) {
        if (equipoDeS(du) == equipoDeS(k) || footballS[du][F_INMUNES] > 0) seguir5 = false;
        if (seguir5) {
          float dd = distJugS(k, du);
          int puesto = 0;
          for (int q = iniEqS(equipoDeS(k)); q < iniEqS(equipoDeS(k)) + 4; q++) if (q != k && distJugS(q, du) < dd) puesto++;
          float extra;
          if (puesto == 0) {
            extra = 1.8 * estAgresivo[equipoDeS(k)];
          } else {
            if (puesto == 1) extra = 1.15 * estAgresivo[equipoDeS(k)]; else extra = 0.7 * estAgresivo[equipoDeS(k)];
          }
          if (dd < RADIO_TACKLES && random(1) < chanceTackleS(dd) * extra) {
            float ax = footballS[du][F_XS], ay = footballS[du][F_YS];
            float ox = footballS[k][F_OBJXS], oy = footballS[k][F_OBJYS];
            if (footballS[k][F_ROLS] == ROL_PERSEGUIRS && footballS[k][F_IRS] == 1 && distAS(k, ox, oy) > 10 && dist(ox, oy, ax, ay) < 60) {
              ax = ox;
              ay = oy;
            }
            lanzarseS(k, atan2(ay - footballS[k][F_YS], ax - footballS[k][F_XS]));
          }
        }
      } else if (footballS[k][F_ROLS] == ROL_BALONS) {
        float bx = footballS[BALONS][B_XS], by = footballS[BALONS][B_YS];
        if (footballS[BALONS][B_ESTS] == AIRES) {
          puntoAlcanzableS(k, velDeS(k) * 2, T_LANCES, RADIO_INTERCEPCIONS + 8);
          float[] pc = resPuntoAlcanzableS;
          if (pc == null) seguir5 = false;
          if (seguir5) {
            bx = pc[0];
            by = pc[1];
          }
        }
        if (seguir5) {
          if (distAS(k, bx, by) < RADIO_TACKLES && random(1) < PROB_TACKLE_BALONS) {
            lanzarseS(k, atan2(by - footballS[k][F_YS], bx - footballS[k][F_XS]));
          }
        }
      }
    }
  }
}

// Inercia: 45 grados sin castigo, 90 = 1 ciclo, 135 = 2, 180 = 3 (girando va a media velocidad)
void aplicarInerciaS(int k) {
  if (footballS[k][F_ESTADOS] != 0) return;
  boolean quiere = false;
  float deseado = footballS[k][F_ANGS];
  if (autoRecibeS(k)) {
    float ox = footballS[BALONS][B_DXS], oy = footballS[BALONS][B_DYS];
    if (distAS(k, ox, oy) > 6) {
      quiere = true;
      deseado = atan2(oy - footballS[k][F_YS], ox - footballS[k][F_XS]);
    }
  } else if (k == controladoS) {
    int aux1;
    if (pDer) aux1 = 1; else aux1 = 0;
    int aux2;
    if (pIzq) aux2 = 1; else aux2 = 0;
    float dx = aux1 - aux2;
    int aux3;
    if (pAba) aux3 = 1; else aux3 = 0;
    int aux4;
    if (pArr) aux4 = 1; else aux4 = 0;
    float dy = aux3 - aux4;
    if (dx != 0 || dy != 0) {
      quiere = true;
      deseado = atan2(dy, dx);
    }
  } else if (footballS[k][F_IRS] == 1) {
    float ox = footballS[k][F_OBJXS], oy = footballS[k][F_OBJYS];
    if (distAS(k, ox, oy) > 10) {
      quiere = true;
      deseado = atan2(oy - footballS[k][F_YS], ox - footballS[k][F_XS]);
    }
  }
  if (!quiere) {
    footballS[k][F_MOVS] = 0;
    footballS[k][F_GIROS] = 0;
    footballS[k][F_QUIETOS] = min(footballS[k][F_QUIETOS] + 1, 10);
    return;
  }
  if (footballS[k][F_MOVS] == 0) {
    int castigo = max(0, castigoGiroS(difAngS(footballS[k][F_ANGS], deseado)) - (int) footballS[k][F_QUIETOS]);
    footballS[k][F_ANGS] = deseado;
    footballS[k][F_ANGOBJS] = deseado;
    footballS[k][F_GIROS] = castigo;
    footballS[k][F_MOVS] = 1;
    footballS[k][F_QUIETOS] = 0;
    return;
  }
  footballS[k][F_QUIETOS] = 0;
  float tol = radians(22.5);
  if (footballS[k][F_GIROS] > 0 && difAngS(footballS[k][F_ANGOBJS], deseado) <= tol) {
    footballS[k][F_ANGOBJS] = deseado;
    footballS[k][F_GIROS]--;
    if (footballS[k][F_GIROS] <= 0) {
      footballS[k][F_GIROS] = 0;
      footballS[k][F_ANGS] = deseado;
    }
  } else if (difAngS(footballS[k][F_ANGS], deseado) <= tol) {
    footballS[k][F_ANGS] = deseado;
    footballS[k][F_ANGOBJS] = deseado;
    footballS[k][F_GIROS] = 0;
  } else {
    int castigo = castigoGiroS(difAngS(footballS[k][F_ANGS], deseado));
    footballS[k][F_ANGOBJS] = deseado;
    if (castigo == 0) {
      footballS[k][F_ANGS] = deseado;
      footballS[k][F_GIROS] = 0;
    } else {
      footballS[k][F_GIROS] = castigo;
    }
  }
}

// Fútbol: en el fútbol girar no frena (siempre 0).
int castigoGiroS(float dif) {
  return 0;
}

// Fútbol: diferencia entre dos ángulos.
float difAngS(float a, float b) {
  float dd = abs(a - b) % TWO_PI;
  if (dd > PI) dd = TWO_PI - dd;
  return dd;
}

// Fútbol: mueve a todos los jugadores.
void moverFutbolS() {
  for (int k = 0; k < 8; k++) {
    if (footballS[k][F_INMUNES] > 0) footballS[k][F_INMUNES]--;
    int est = (int) footballS[k][F_ESTADOS];
    if (est == 2) {
      footballS[k][F_TIMERS]--;
      if (footballS[k][F_TIMERS] <= 0) {
        footballS[k][F_ESTADOS] = 0;
        footballS[k][F_MOVS] = 0;
        footballS[k][F_GIROS] = 0;
        footballS[k][F_QUIETOS] = 3;
      }
    } else {
      float v = velDeS(k);
      boolean seguir6 = true;
      if (est == 1) {
        v = v * 2;
        footballS[k][F_TIMERS]--;
      } else {
        if (footballS[k][F_MOVS] == 0 || (k == controladoS && picCargaDesde > 0)) seguir6 = false;
        if (seguir6) {
          if (footballS[k][F_GIROS] > 0) v = v * 0.5;
          if (k != controladoS && footballS[k][F_IRS] == 1 && distAS(k, footballS[k][F_OBJXS], footballS[k][F_OBJYS]) <= v) {
            footballS[k][F_XS] = footballS[k][F_OBJXS];
            footballS[k][F_YS] = footballS[k][F_OBJYS];
            footballS[k][F_MOVS] = 0;
            seguir6 = false;
          }
          if (seguir6) {
            if (autoRecibeS(k) && distAS(k, footballS[BALONS][B_DXS], footballS[BALONS][B_DYS]) <= v) {
              footballS[k][F_XS] = footballS[BALONS][B_DXS];
              footballS[k][F_YS] = footballS[BALONS][B_DYS];
              footballS[k][F_MOVS] = 0;
              seguir6 = false;
            }
          }
        }
      }
      if (seguir6) {
        footballS[k][F_XS] += cos(footballS[k][F_ANGS]) * v;
        footballS[k][F_YS] += sin(footballS[k][F_ANGS]) * v;
        footballS[k][F_XS] = constrain(footballS[k][F_XS], CX1S + 8, CX2S - 8);
        footballS[k][F_YS] = constrain(footballS[k][F_YS], CY1S + 12, CY2S - 12);
        boolean seguir7 = true;
        if (est == 1) {
          if (revisarTackleS(k)) seguir7 = false;
          if (seguir7) {
            if (footballS[k][F_TIMERS] <= 0) {
              footballS[k][F_ESTADOS] = 2;
              footballS[k][F_TIMERS] = T_PISOS;
              footballS[k][F_MOVS] = 0;
            }
          }
        }
      }
    }
  }
  separarJugadoresS();
}

// Fútbol: ¿este jugador le quitó el balón al rival?
boolean revisarTackleS(int k) {
  int du = duenoS();
  if (du < 0 || equipoDeS(du) == equipoDeS(k)) return false;
  if (footballS[du][F_INMUNES] > 0) return false;
  if (distJugS(k, du) > RADIO_CONTACTOS) return false;
  footballS[du][F_ESTADOS] = 2;
  footballS[du][F_TIMERS] = T_DERRIBADOS;
  footballS[du][F_MOVS] = 0;
  footballS[du][F_GIROS] = 0;
  darBalonS(k);
  return true;
}

// Fútbol: separa a los jugadores que se pisan.
void separarJugadoresS() {
  int du = duenoS();
  for (int a = 0; a < 8; a++) {
    for (int q = a + 1; q < 8; q++) {
      if (footballS[a][F_ESTADOS] == 0 && footballS[q][F_ESTADOS] == 0) {
        float dx = footballS[q][F_XS] - footballS[a][F_XS];
        float dy = footballS[q][F_YS] - footballS[a][F_YS];
        float dd = sqrt(dx * dx + dy * dy);
        if (!(dd >= 18)) {
          if (dd < 0.01) {
            dx = random(-1, 1);
            dy = random(-1, 1);
            dd = max(0.01, sqrt(dx * dx + dy * dy));
          }
          float empA = (18 - dd) / 2, empQ = empA;
          if (a == du) { empA = 0; empQ = 18 - dd; }
          if (q == du) { empQ = 0; empA = 18 - dd; }
          footballS[a][F_XS] -= dx / dd * empA;
          footballS[a][F_YS] -= dy / dd * empA;
          footballS[q][F_XS] += dx / dd * empQ;
          footballS[q][F_YS] += dy / dd * empQ;
        }
      }
    }
  }
  for (int k = 0; k < 8; k++) {
    footballS[k][F_XS] = constrain(footballS[k][F_XS], CX1S + 8, CX2S - 8);
    footballS[k][F_YS] = constrain(footballS[k][F_YS], CY1S + 12, CY2S - 12);
  }
}

// Fútbol: mueve el balón.
void moverBalonS() {
  int est = (int) footballS[BALONS][B_ESTS];
  if (est >= 0 && est < 8) {
    footballS[BALONS][B_XS] = footballS[est][F_XS];
    footballS[BALONS][B_YS] = footballS[est][F_YS];
    return;
  }
  if (est == AIRES) {
    float x0 = footballS[BALONS][B_XS], y0 = footballS[BALONS][B_YS];
    footballS[BALONS][B_PS] += footballS[BALONS][B_VPS];
    float p = min(1, footballS[BALONS][B_PS]);
    float ox = footballS[BALONS][B_OXS], oy = footballS[BALONS][B_OYS];
    float dx = footballS[BALONS][B_DXS], dy = footballS[BALONS][B_DYS];
    float largoP = max(1, dist(ox, oy, dx, dy));
    float curva = footballS[BALONS][B_CURVAS] * p * p;
    footballS[BALONS][B_XS] = lerp(ox, dx, p) - (dy - oy) / largoP * curva;
    footballS[BALONS][B_YS] = lerp(oy, dy, p) + (dx - ox) / largoP * curva;
    footballS[BALONS][B_ALTS] = 4 * min(28, dist(ox, oy, dx, dy) * 0.06) * p * (1 - p);
    int q = quienAgarraS(true, x0, y0);
    if (q >= 0) {
      darBalonS(q);
      return;
    }
    if (p >= 1) {
      footballS[BALONS][B_ESTS] = SUELTOS;
      footballS[BALONS][B_ALTS] = 0;

      float largoR = max(1, dist(ox, oy, dx, dy));
      float rueda = 1.2 + max(0, footballS[BALONS][B_POTS] - 1) * 7;
      footballS[BALONS][B_RVXS] = (dx - ox) / largoR * rueda;
      footballS[BALONS][B_RVYS] = (dy - oy) / largoR * rueda;
    }
    return;
  }
  float x0 = footballS[BALONS][B_XS], y0 = footballS[BALONS][B_YS];
  footballS[BALONS][B_XS] += footballS[BALONS][B_RVXS];
  footballS[BALONS][B_YS] += footballS[BALONS][B_RVYS];
  footballS[BALONS][B_RVXS] *= 0.95;
  footballS[BALONS][B_RVYS] *= 0.95;
  int q = quienAgarraS(false, x0, y0);
  if (q >= 0) {
    footballS[BALONS][B_RVXS] = 0;
    footballS[BALONS][B_RVYS] = 0;
    darBalonS(q);
  }
}

// Fútbol: quién se queda con el balón cuando llega.
int quienAgarraS(boolean enAire, float x0, float y0) {
  float bx = footballS[BALONS][B_XS], by = footballS[BALONS][B_YS];
  int pasador = (int) footballS[BALONS][B_PASADORS];
  int eqPase;
  if (pasador >= 0) eqPase = equipoDeS(pasador); else eqPase = -1;
  if (enAire && dist(footballS[BALONS][B_OXS], footballS[BALONS][B_OYS], bx, by) < SALIDA_PASES) return -1;
  int mejor = -1;
  float md = 99999;
  for (int k = 0; k < 8; k++) {
    if (footballS[k][F_ESTADOS] != 2 && !(enAire && k == pasador)) {
      float radio = RADIO_ATRAPES;
      if (enAire && equipoDeS(k) != eqPase) radio = RADIO_INTERCEPCIONS;
      if (esArquero(k)) { if (abs(footballS[k][F_XS] - lineaArco(equipoDeS(k))) < 120) radio = radio + 16 + picDif; else radio = 0; }
      if (footballS[k][F_ESTADOS] == 1) radio += 8;
      float dd = distPuntoSegmentoS(footballS[k][F_XS], footballS[k][F_YS], x0, y0, bx, by);
      if (dd < radio && dd < md) { md = dd; mejor = k; }
    }
  }
  return mejor;
}

// Fútbol: ¿el balón entró al arco?
void revisarAnotacionS() {
  if (fbEstadoS != 0) return;
  float bx = footballS[BALONS][B_XS], by = footballS[BALONS][B_YS];
  boolean enArco = by > ARCO_Y1S && by < ARCO_Y2S;
  int du = duenoS();
  if (enArco && bx >= CX2S - 10 && du != 4) { golesJS++; anotacionS(0); return; }
  if (enArco && bx <= CX1S + 10 && du != 0) { golesES++; anotacionS(1); return; }
  if (du >= 0) return;
  boolean fueraLado = by < CY1S || by > CY2S, fueraFondo = bx < CX1S || bx > CX2S;
  if (!fueraLado && !fueraFondo) return;
  int pasador = (int) footballS[BALONS][B_PASADORS];
  int ultimo;
  if (pasador >= 0) ultimo = equipoDeS(pasador); else ultimo = 0;
  float px = constrain(bx, CX1S + 12, CX2S - 12), py = constrain(by, CY1S + 12, CY2S - 12);
  int saca;
  if (fueraFondo) {
    int ladoArco;
    if (bx > CX2S) ladoArco = 1; else ladoArco = 0;
    if (ultimo == ladoArco) {

      saca = masCercanoS(1 - ladoArco, px, py);
      if (by < CENTRO_YS) py = CY1S + 12; else py = CY2S - 12;
      fbMensajeS = "Tiro de esquina";
    } else {
      if (ladoArco == 1) saca = 4; else saca = 0;
      px = lineaArco(ladoArco);
      py = CENTRO_YS;
      fbMensajeS = "Saque de arco";
    }
  } else {
    saca = masCercanoS(1 - ultimo, px, py);
    fbMensajeS = "Saque de banda";
  }
  if (saca < 0) { if (ultimo == 0) saca = 4; else saca = 0; }
  footballS[saca][F_XS] = px;
  footballS[saca][F_YS] = py;
  footballS[BALONS][B_RVXS] = 0;
  footballS[BALONS][B_RVYS] = 0;
  darBalonS(saca);
  footballS[saca][F_INMUNES] = 40;
  picMensajeHasta = millis() + 1200;
}

// Fútbol: suma el gol y prepara el saque.
void anotacionS(int eq) {
  fbEstadoS = 1;
  fbPausaS = 100;
  fbSaqueS = 1 - eq;
  if (eq == 0) fbMensajeS = "¡GOOOOL!"; else fbMensajeS = "Gol del rival...";
  celebraTu = eq == 0;
  if (golDeOro) fbMensajeS += "  (GOL DE ORO)";
  if (golDeOro || golesJS >= GOLES_GANARS || golesES >= GOLES_GANARS) fbTrasPausaS = 2; else fbTrasPausaS = 1;
}

// ============================ FÚTBOL: lo que se maneja por encima ============================
// Usa el mismo motor del rugby (screen 3): los bots usan los mismos roles, marcas, maniobras,
// pases e inercia. Lo que cambia: hay arco (no línea), un arquero por equipo, y se juega en la cancha D1.
// WASD o flechas: moverte, click: con balón = pase al punto (si es dentro del arco, tiro);
// sin balón = barrida hacia el punto. Gana el primero a 3, o el que vaya ganando al acabar el tiempo.
// Si empatan, desempate por penales.
boolean pArr, pAba, pIzq, pDer;
int picDif = 1, picMensajeHasta = 0, arqueroTiene = 0, picUltimo = 0;
float picTiempo = 0;
boolean celebraTu = false;
boolean fuDesempate = false;
int picGolesTu = 0, picGolesRival = 0;

// Cuántos partidos de fútbol de la Copa ganaste.
int futbolGanados() {
  int n = 0;
  for (int k = 0; k < COPA.length; k++) if (COPA[k][2].equals("Fútbol") && copaEstado[k] == 1) n++;
  return n;
}

// Penales que tiene que superar en el desempate (según la dificultad)
int penalesRival() {
  return min(4, 1 + (picDif + 1) / 2);
}

// Empieza un partido de fútbol (picado o de la Copa) con la dificultad del rival.
void iniciarPicado() {
  cargarSprites9();
  if (copaActual >= 0) picDif = int(COPA[copaActual][4]); else picDif = 1;
  veljS = velFutTu();
  if (copaActual >= 0) {
    veleS = velFutRival() + picDif * 0.12 + (futbolGanados() * 0.12);
  } else {
    veleS = velFutRival() + picDif * 0.12 + 0;
  }
  estRival = estrategiaRival();
  aplicarEstrategia(1, estRival);
  aplicarEstrategia(0, 0);
  for (int k = 0; k < 8; k++) { stamS[k] = 100; sprintS[k] = false; }
  picEligiendo = true;
  picCargaDesde = 0;
  pSprint = false;
  efQ = false;
  efE = false;
  golesJS = 0;
  golesES = 0;
  pArr = pAba = pIzq = pDer = false;
  controladoS = 1;
  equipoAtaqueS = 0;
  fbMarcaTS = 0;
  fbSaqueS = 0;
  formacionS(fbSaqueS);
  fbEstadoS = 1;
  fbPausaS = 60;
  fbTrasPausaS = 0;
  fbMensajeS = "¡A JUGAR!";
  fbCicloS = millis();
  picTiempo = 0;
  golDeOro = false;
  asignarDefensas();
  picUltimo = millis();
  fuDesempate = false;
  empezarActividad(ACT_PICADO);
}

// El arquero con el balón: lo aguanta un momento y se la da al compañero más libre
void arqueroConBalon() {
  int du = duenoS();
  if (du < 0 || !esArquero(du)) { arqueroTiene = 0; return; }
  footballS[du][F_INMUNES] = 5;
  arqueroTiene++;
  if (arqueroTiene < 12) return;
  arqueroTiene = 0;
  if (saqueArqueroS(du)) return;
  int eq = equipoDeS(du), ini = iniEqS(eq);
  int rec = mejorReceptorS(du, -1, -1);
  if (rec < 0 || esArquero(rec)) {
    float libre = -1;
    for (int q = ini + 1; q < ini + 4; q++) {
      float cerca = 99999;
      for (int o = iniEqS(1 - eq); o < iniEqS(1 - eq) + 4; o++) cerca = min(cerca, distJugS(o, q));
      if (cerca > libre) { libre = cerca; rec = q; }
    }
  }
  if (rec >= 0) pasarAS(du, rec);
}

// El arquero saca: a un compañero desmarcado; si no hay, a un punto donde un compañero
// llegue bastante antes que cualquier rival; si tampoco, lejos hacia adelante.
boolean saqueArqueroS(int du) {
  int eq = equipoDeS(du), ini = iniEqS(eq), iO = iniEqS(1 - eq);
  int mejor = -1;
  float mejorLibre = 0;
  for (int q = ini + 1; q < ini + 4; q++) {
    float cerca = 99999;
    for (int o = iO; o < iO + 4; o++) cerca = min(cerca, distJugS(o, q));
    if (cerca > 110 && cerca > mejorLibre && distJugS(du, q) < PASE_MAXS) { mejorLibre = cerca; mejor = q; }
  }
  if (mejor >= 0) { pasarAS(du, mejor); return true; }
  float mx = -1, my = -1, ventaja = 0;
  for (int q = ini + 1; q < ini + 4; q++) {
    for (int a = 0; a < 8; a++) {
      float px = footballS[q][F_XS] + cos(a * QUARTER_PI) * 110, py = footballS[q][F_YS] + sin(a * QUARTER_PI) * 110;
      if (!(px < CX1S + 20) && !(px > CX2S - 20) && !(py < CY1S + 20) && !(py > CY2S - 20) && !(dist(footballS[du][F_XS], footballS[du][F_YS], px, py) > PASE_MAXS)) {
        float miD = 99999, suD = 99999;
        for (int r = ini + 1; r < ini + 4; r++) miD = min(miD, distAS(r, px, py));
        for (int o = iO; o < iO + 4; o++) suD = min(suD, distAS(o, px, py));
        if (suD - miD > 120 && suD - miD > ventaja) { ventaja = suD - miD; mx = px; my = py; }
      }
    }
  }
  if (mx >= 0) { lanzarPaseS(du, mx, my); return true; }
  return false;
}

// Mientras el arquero tiene el balón, los rivales salen de su área
final float AREA_FONDO = 228, AREA_Y1 = 286, AREA_Y2 = 706;
// El arquero despeja el balón lejos.
void despejarArea() {
  int du = duenoS();
  if (du < 0 || !esArquero(du)) return;
  int eq = equipoDeS(du), iO = iniEqS(1 - eq);
  for (int o = iO; o < iO + 4; o++) {
    float x = footballS[o][F_XS], y = footballS[o][F_YS];
    if (!(y < AREA_Y1) && !(y > AREA_Y2)) {
      if (eq == 0 && x < CX1S + AREA_FONDO) footballS[o][F_XS] = CX1S + AREA_FONDO;
      if (eq == 1 && x > CX2S - AREA_FONDO) footballS[o][F_XS] = CX2S - AREA_FONDO;
    }
  }
}

// ¿El de arriba (no defensa, no arquero) está libre? devuelve el más adelantado libre, o -1
int delanteroLibre(int k) {
  int eq = equipoDeS(k), ini = iniEqS(eq), iO = iniEqS(1 - eq);
  float dir = dirAtaqueS(eq), mejorAv = -99999;
  int mejor = -1;
  for (int q = ini + 1; q < ini + 4; q++) {
    if (q != k && !esDefensa[q] && footballS[q][F_ESTADOS] != 2) {
      float cerca = 99999;
      for (int o = iO; o < iO + 4; o++) cerca = min(cerca, distJugS(o, q));
      if (!(cerca < 70) && !(distJugS(k, q) > PASE_MAXS)) {
        float av = footballS[q][F_XS] * dir;
        if (av > mejorAv) { mejorAv = av; mejor = q; }
      }
    }
  }
  return mejor;
}

// Dibuja el partido de fútbol y lleva el tiempo (o la pizarra del entrenador al empezar).
void dibujarPicado() {
  int ahora = millis();
  if (picEligiendo) { picUltimo = ahora; dibujarFutbolS(); dibujarCoach(); return; }
  if (fbEstadoS == 0) {
    picTiempo += ahora - picUltimo;
    if (ahora - fbCicloS >= CICLO_MSS) {
      fbCicloS = ahora;
      cicloFutbolS();
    }
    for (int pc = 0; pc < pasoCuadro && fbEstadoS == 0; pc++) {
      actualizarSprint();
      moverFutbolS();
      despejarArea();
      moverBalonS();
      revisarAnotacionS();
    }
    if (fbEstadoS == 0 && !golDeOro && picTiempo >= FUT_SEGUNDOS * 1000) {
      fbEstadoS = 1;
      fbPausaS = 90;
      if (golesJS != golesES) { fbTrasPausaS = 2; fbMensajeS = "¡FINAL DEL PARTIDO!"; }
      else { golDeOro = true; fbTrasPausaS = 0; fbMensajeS = "¡EMPATE! GOL DE ORO"; }
    }
  } else if (fbEstadoS == 1) {
    fbPausaS = fbPausaS - pasoCuadro;
    if (fbPausaS <= 0) {
      if (fbTrasPausaS == 0) {
        fbEstadoS = 0;
        fbCicloS = ahora;
      } else if (fbTrasPausaS == 1) {
        formacionS(fbSaqueS);
        asignarDefensas();
        fbPausaS = 50;
        fbTrasPausaS = 0;
        fbMensajeS = "¡A JUGAR!";
      } else {
        fbEstadoS = 2;
      }
    }
  }
  picUltimo = ahora;
  dibujarFutbolS();
  if (fbEstadoS == 2) terminarPicado();
}

