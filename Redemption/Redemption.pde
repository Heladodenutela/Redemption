// Texto que se muestra para un stat (con $ para el dinero y horas para la pantalla).
String textoStat(int k) {
  if (k == ST_DINERO) return "$" + dinero;
  if (k == ST_PANTALLA) return (stats[k] / 60) + "h" + nf(stats[k] % 60, 2);
  if (k == ST_ENERGIA) return stats[k] + "/" + energiaMax();
  return "" + stats[k];
}

// ============================ ACTIVIDADES (lo que estás haciendo) ============================
// Mientras hay una actividad el personaje no camina. Sofá y escritorio se dejan con A/D/E/Q.
final int ACT_NINGUNA = 0, ACT_SOFA = 1, ACT_ESTUDIAR = 2, ACT_INSOMNIO = 3, ACT_DESPERTAR = 4,
  ACT_LAVADORA = 5, ACT_CARTELERA = 6, ACT_MAPA = 7, ACT_TIENDA = 8, ACT_INVENTARIO = 9,
  ACT_KARAOKE = 10, ACT_KARAOKE_FIN = 11, ACT_DIALOGO = 12, ACT_NEWTON = 13;
int actividad = ACT_NINGUNA;
int actividadInicio = 0;

// Códigos de acción de los objetos (en objAccion)
final String ACC_CAMA = "CAMA", ACC_SOFA = "SOFA", ACC_ESTUDIAR = "ESTUDIAR", ACC_LAVADORA = "LAVADORA",
  ACC_CARTEL_U = "CARTELERA_U", ACC_CARTEL_DEP = "CARTELERA_DEPORTE", ACC_MAPA = "MAPA", ACC_KARAOKE = "KARAOKE",
  ACC_TIENDA = "TIENDA:";

// Sofá y escritorio dejan usar el celular encima; el resto tapa la pantalla
boolean actividadDeFondo() {
  return actividad == ACT_SOFA || actividad == ACT_ESTUDIAR || actividad == ACT_SENTADO;
}

// Empieza una actividad (minijuego, menú, escena): desde ahí ella maneja teclas, clicks y dibujo.
void empezarActividad(int a) {
  actividad = a;
  actividadInicio = millis();
  teclaIzq = false;
  teclaDer = false;
  correr = false;
  avisoAlEmpezarActividad(a);
}

// Termina la actividad y vuelve al mundo.
void terminarActividad() {
  actividad = ACT_NINGUNA;
  pjQuietoDesde = millis();
}

// Lo que pasa al apretar E frente a un objeto con acción
boolean accionNueva(int o) {
  String a = objAccion[o];
  if (accionNueva3(a)) return true;
  if (accionNueva5(a)) return true;
  if (a.equals(ACC_CAMA)) { acostarseCama(); return true; }
  if (a.equals(ACC_SOFA)) { acostarseSofa(); return true; }
  if (a.equals(ACC_ESTUDIAR)) { estudiar(); return true; }
  if (a.equals(ACC_LAVADORA)) { lavadora(); return true; }
  if (a.equals(ACC_CARTEL_U)) { carteleraColegio(); return true; }
  if (a.equals(ACC_CARTEL_DEP)) { carteleraDeporte(); return true; }
  if (a.equals(ACC_MAPA)) { mapa(); return true; }
  if (a.equals(ACC_KARAOKE)) { karaoke(); return true; }
  if (a.equals(ACC_ARCADE)) { abrirArcade(); return true; }
  if (empiezaCon(a, ACC_TIENDA)) { abrirTienda(a.substring(ACC_TIENDA.length()), objNombre[o]); return true; }
  return false;
}

// Teclas cuando hay una actividad (se llama antes que las teclas del mundo)
void teclasActividad() {
  if (teclasActividadV20()) return;
  boolean cerrar = key == 'q' || key == 'Q' || key == BACKSPACE;
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  boolean izq = key == 'a' || key == 'A' || (key == CODED && keyCode == LEFT);
  boolean der = key == 'd' || key == 'D' || (key == CODED && keyCode == RIGHT);
  switch (actividad) {
  case ACT_SOFA:
  case ACT_ESTUDIAR:
    if (usar && actividad == ACT_ESTUDIAR) { empezarSesionEstudio(); break; }
    if (cerrar || usar || izq || der) {
      terminarActividad();
      if (izq) teclaIzq = true;
      if (der) teclaDer = true;
    }
    break;
  case ACT_INSOMNIO:
    break;
  case ACT_DESPERTAR:
  case ACT_KARAOKE_FIN:
  case ACT_CARTELERA:
  case ACT_MAPA:
    if (cerrar || usar || key == TAB || key == 't' || key == 'T') terminarActividad();
    break;
  case ACT_INVENTARIO:
    if (key == CODED && keyCode == UP) invScroll = max(0, invScroll - 1);
    else if (key == CODED && keyCode == DOWN) invScroll = min(max(0, numInv - INV_VISIBLES), invScroll + 1);
    else if (cerrar || usar || key == TAB || key == 't' || key == 'T') terminarActividad();
    break;
  case ACT_TIENDA:
    if (key >= '1' && key <= '9') intentarComprar(key - '1');
    else if (key == TAB || key == 't' || key == 'T') abrirInventario();
    else if (cerrar || usar) terminarActividad();
    break;
  case ACT_KARAOKE:
    teclaKaraoke();
    break;
  case ACT_DIALOGO:
    if (key >= '1' && key <= '5' && elegirOpcionDialogo(key - '1')) break;
    if (nodoActual() != null) { if (cerrar) terminarActividad(); break; }
    if (key == 'r' || key == 'R' || usar) avanzarDialogo();
    else if (cerrar) terminarActividad();
    break;
  case ACT_NEWTON:
    if (key == 'r' || key == 'R' || usar) acariciarOtraVez();
    else if (cerrar) terminarActividad();
    break;
  default:
    teclasActividad2();
  }
}

// Reparte el click a la actividad que está abierta.
void clickActividad() {
  if (clickActividadV20()) return;
  switch (actividad) {
  case ACT_INSOMNIO: clickInsomnio(); break;
  case ACT_TIENDA: clickTienda(); break;
  case ACT_DIALOGO: {
    int op = opcionBajoMouse();
    if (op >= 0) elegirOpcionDialogo(op);
    else if (op == -1) avanzarDialogo();
    break;
  }
  case ACT_INVENTARIO: clickInventario(); break;
  case ACT_NEWTON: acariciarOtraVez(); break;
  case ACT_KARAOKE: break;
  case ACT_LAVADORA: break;
  default: if (!clickActividad2()) terminarActividad();
  }
}

// Lo que se dibuja encima del mundo (después del HUD)
void dibujarActividad() {
  if (dibujarActividadV20()) return;
  switch (actividad) {
  case ACT_INSOMNIO: dibujarInsomnio(); break;
  case ACT_DESPERTAR: dibujarResumen(); break;
  case ACT_LAVADORA: dibujarLavadora(); break;
  case ACT_CARTELERA: dibujarCartelera(); break;
  case ACT_MAPA: dibujarMapaPlaza(); break;
  case ACT_TIENDA: dibujarTienda(); break;
  case ACT_INVENTARIO: dibujarInventario(); break;
  case ACT_KARAOKE: dibujarKaraoke(); break;
  case ACT_KARAOKE_FIN: dibujarKaraokeFin(); break;
  case ACT_DIALOGO: dibujarDialogo(); break;
  case ACT_NEWTON: dibujarNewton(); break;
  case ACT_ESTUDIAR: cartelito("Sentado · Notas " + stats[ST_NOTAS] + "   [E] estudiar otra sesión · [A/D/Q] levantarse"); break;
  case ACT_SOFA: cartelito("Acostado en el sofá   [A/D/E] levantarse"); break;
  default: dibujarActividad2();
  }
}

