// Grupos de amigos a los que pertenece una persona (para saber de qué temas puede hablar).
String circulosDe(int p) {
  if (p < 0) return "";
  for (int k = 0; k < CIRCULO_CHAT.length; k++) if (CIRCULO_CHAT[k][0].equals(DLG_PERSONA[p])) return " " + CIRCULO_CHAT[k][1] + " ";
  return " ";
}

// ¿Es tarde en la noche (de 9 p. m. a 5 a. m.)?
boolean esDeNocheTarde() {
  int m = minutoAhora();
  return m >= 21 * 60 || m < 5 * 60;
}

// ¿Este tema sirve para escribirle a esta persona ahora?
boolean temaVale(int p, String[] t) {
  String para = " " + t[2] + " ", circ = circulosDe(p);
  boolean le = posicionDe(para, " " + nombreCorto(p) + " ") >= 0 || posicionDe(para, " TODOS ") >= 0;
  partirTokens(t[2], " ");
  String[] cs = resPartirTokens;
  for (int i = 0; i < cs.length && !le; i++) if (posicionDe(circ, " " + cs[i] + " ") >= 0) le = true;
  if (!le) return false;
  partirPorLetra(t[3], '&');
  String[] c = resPartirPorLetra;
  for (int i = 0; i < c.length; i++) {
    String q = quitarBordesProcessing(c[i]);
    if (q.length() != 0) {
      if (q.equals("HOY")) { if (charlaHoy == null || !charlaHoy[p]) return false; }
      else if (q.equals("NOCHE")) { if (!esDeNocheTarde()) return false; }
      else if (q.equals("!NOCHE")) { if (esDeNocheTarde()) return false; }
      else if (empiezaCon(q, "AM>=")) { if (amistad[p] < int(q.substring(4))) return false; }
      else if (!cumple(q)) return false;
    }
  }
  return true;
}

