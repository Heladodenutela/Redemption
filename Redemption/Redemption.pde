float VELE_BASE = 3.0;
float VELE_SUBE = 0.6;
int ENERGIA_PARTIDO = 15;
int ENERGIA_PRACTICA = 10;
int MIN_PARTIDO = 60;
int PEN_TIROS = 5, PEN_PASES = 2;
int NADO_LARGOS = 2;
int NADO_BEAT_MS = 650;
int CASTIGO_TRAJE_ENERGIA = 5;
int CASTIGO_TRAJE_SOCIAL = 3;

/////////////////////////////////////////////////////////////////////////////////////////
