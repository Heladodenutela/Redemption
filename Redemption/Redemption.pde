// ============================ CÁLCULO: TODAS LAS QUE PUEDAS EN 15 SEGUNDOS ============================
// 1-4 o click para responder. Mientras más tiempo pasa y más aciertas, más difíciles;
// si fallas una difícil, vuelves a las fáciles.
final int MJ_CALCULO = 5;
int caAciertos, caFallos, caRacha, caNivelQ, caFin, caInicio, caCorrecta, caFlash;
boolean caUltimaBien;
String caPregunta = "";
String[] caOps = new String[4];
String[] CA_NIVEL = { "Cuentas", "Multiplicar", "Derivadas", "Reglas", "Límites" };

// Empieza el reto de cálculo: cuántas aciertas en 15 segundos.
void iniciarCalculo() {
  caAciertos = 0;
  caFallos = 0;
  caRacha = 0;
  if (nivelClase() >= 3) caNivelQ = 1; else caNivelQ = 0;
  caInicio = millis();
  caFin = caInicio + round(facil(B_CALC_SEGUNDOS) * 1000);
  caFlash = 0;
  nuevaPreguntaCalculo();
}

// Arma una pregunta del nivel caNivelQ con su respuesta y 3 distractores
void nuevaPreguntaCalculo() {
  int nv = constrain(caNivelQ, 0, 4);
  String bien = "";
  String[] malas = new String[3];
  if (nv == 0) {
    int a = int(random(3, 20)), b = int(random(2, 15));
    boolean resta = random(1) < 0.4;
    if (resta) caPregunta = (a + b) + " − " + b + " = ?"; else caPregunta = a + " + " + b + " = ?";
    int r;
    if (resta) r = a; else r = a + b;
    bien = str(r);
    malas[0] = str(r + 1); malas[1] = str(r - 2); malas[2] = str(r + 10);
  } else if (nv == 1) {
    int a = int(random(3, 10)), b = int(random(3, 10));
    boolean div = random(1) < 0.35;
    if (div) caPregunta = (a * b) + " ÷ " + a + " = ?"; else caPregunta = a + " × " + b + " = ?";
    int r;
    if (div) r = b; else r = a * b;
    bien = str(r);
    malas[0] = str(r + a); malas[1] = str(max(1, r - b)); malas[2] = str(r + 1);
  } else if (nv == 2) {
    int n = int(random(2, 6));
    int c = int(random(1, 6));
    if (random(1) < 0.5) {
      caPregunta = "Derivada de  x" + sup(n);
      bien = n + "x" + sup(n - 1);
      malas[0] = "x" + sup(n - 1); malas[1] = n + "x" + sup(n); malas[2] = (n - 1) + "x" + sup(n - 1);
    } else {
      caPregunta = "Derivada de  " + c + "x" + sup(n);
      bien = (c * n) + "x" + sup(n - 1);
      malas[0] = c + "x" + sup(n - 1); malas[1] = (c * n) + "x" + sup(n); malas[2] = (c + n) + "x" + sup(n - 1);
    }
  } else if (nv == 3) {
    int a = int(random(2, 6)), b = int(random(2, 9)), k = int(random(1, 9));
    if (random(1) < 0.5) {
      caPregunta = "Derivada de  " + a + "x² + " + b + "x + " + k;
      bien = (2 * a) + "x + " + b;
      malas[0] = a + "x + " + b; malas[1] = (2 * a) + "x + " + (b + k); malas[2] = (2 * a) + "x";
    } else {
      caPregunta = "Derivada de  (" + a + "x + 1)²";
      bien = (2 * a) + "(" + a + "x + 1)";
      malas[0] = "2(" + a + "x + 1)"; malas[1] = a + "(" + a + "x + 1)"; malas[2] = (2 * a) + "x";
    }
  } else {
    int a = int(random(1, 7));
    if (random(1) < 0.5) {
      caPregunta = "lím x→" + a + "  de  (x² − " + (a * a) + ") / (x − " + a + ")";
      bien = str(2 * a);
      malas[0] = str(a); malas[1] = "0"; malas[2] = "No existe";
    } else {
      caPregunta = "lím x→infinito  de  (" + a + "x + 1) / x";
      bien = str(a);
      malas[0] = "0"; malas[1] = "infinito"; malas[2] = str(a + 1);
    }
  }
  caCorrecta = int(random(4));
  int m = 0;
  for (int i = 0; i < 4; i++) { if (i == caCorrecta) caOps[i] = bien; else caOps[i] = malas[m++]; }
}

// Exponente: x², x³, x^4 (x¹ = x)
String sup(int n) {
  if (n == 1) return "";
  if (n == 2) return "²";
  if (n == 3) return "³";
  return "^" + n;
}

// Responde la operación con la opción i.
void responderCalculo(int i) {
  if (millis() >= caFin || i < 0 || i > 3) return;
  boolean bien = i == caCorrecta;
  caUltimaBien = bien;
  caFlash = millis() + 260;
  if (bien) {
    caAciertos++;
    caRacha++;
    if (caRacha % 2 == 0) caNivelQ = min(4, caNivelQ + 1);
  } else {
    caFallos++;
    caRacha = 0;
    if (caNivelQ >= 3) caNivelQ = max(0, caNivelQ - 2); else caNivelQ = max(0, caNivelQ - 1);
  }

  int pasado = (millis() - caInicio) / 4000;
  if (bien && caNivelQ < pasado) caNivelQ = min(4, pasado);
  nuevaPreguntaCalculo();
}

// Teclas 1 a 4 para responder.
void teclaCalculo() {
  if (key >= '1' && key <= '4') responderCalculo(key - '1');
}

// Click en una de las 4 respuestas.
void clickCalculo() {
  for (int i = 0; i < 4; i++) {
    float x = 310 + (i % 2) * 500, y = 430 + (i / 2) * 150;
    if (mouseX > x && mouseX < x + 480 && mouseY > y && mouseY < y + 130) { responderCalculo(i); return; }
  }
}

// Dibuja la operación, las 4 respuestas y el tiempo.
void dibujarCalculo() {
  noStroke();
  fill(32, 48, 40);
  rect(0, 0, ANCHO, ALTO);
  fill(110, 80, 50);
  rect(0, ALTO - 50, ANCHO, 50);
  int resta = max(0, caFin - millis());
  float t = resta / (float) max(1, caFin - caInicio);
  fill(255);
  textSize(26);
  textAlign(LEFT, BASELINE);
  text("CÁLCULO · todas las que puedas en " + round(facil(B_CALC_SEGUNDOS)) + " s", 40, 54);
  textSize(20);
  fill(210, 230, 210);
  text("1-4 o click · aciertos " + caAciertos + " · racha " + caRacha + " · nivel: " + CA_NIVEL[constrain(caNivelQ, 0, 4)], 40, 88);

  fill(60, 80, 70);
  rect(40, 110, 1520, 18, 8);
  if (t > 0.3) fill(color(120, 220, 140)); else fill(color(240, 120, 90));
  rect(40, 110, 1520 * t, 18, 8);

  fill(245);
  textSize(54);
  textAlign(CENTER, CENTER);
  text(caPregunta, 800, 290);
  for (int i = 0; i < 4; i++) {
    float x = 310 + (i % 2) * 500, y = 430 + (i / 2) * 150;
    boolean enc = mouseX > x && mouseX < x + 480 && mouseY > y && mouseY < y + 130;
    if (enc) fill(color(70, 100, 80)); else fill(color(50, 72, 60));
    rect(x, y, 480, 130, 14);
    fill(255, 240, 160);
    textSize(24);
    text((i + 1) + ")", x + 34, y + 30);
    fill(255);
    textSize(40);
    text(caOps[i], x + 250, y + 66);
  }
  if (millis() < caFlash) {
    if (caUltimaBien) fill(color(120, 255, 140, 70)); else fill(color(255, 90, 90, 70));
    rect(0, 0, ANCHO, ALTO);
  }
  textAlign(LEFT, BASELINE);
  if (resta <= 0) {
    int meta = B_CALC_META[constrain(nivelClase() - 1, 0, 3)];
    int notas;
    if (caAciertos >= meta) notas = 3; else if (caAciertos * 2 >= meta) notas = 1; else notas = -1;
    if (caFallos > 0) {
      terminarMinijuegoClase(notas, caAciertos + " respuestas buenas en " + round(facil(B_CALC_SEGUNDOS)) + " s (meta: " + meta + ")."
      + (" Fallaste " + caFallos + "."));
    } else {
      terminarMinijuegoClase(notas, caAciertos + " respuestas buenas en " + round(facil(B_CALC_SEGUNDOS)) + " s (meta: " + meta + ")."
      + "");
    }
  }
}

// ============================ FÍSICA: cuánto se ve la parábola ============================
// Cuántos puntos de la trayectoria se ven antes de disparar (menos en Difícil).
int pasosPreviaFisica() {
  float f = B_PY_PREVIA[constrain(nivelClase() - 1, 0, 3)] / difMult;
  return max(4, round(22 * min(1, f)));
}

// ============================ NOTAS POR MATERIA (RAMOS) ============================
// Nota de 0,0 a 5,0. Se pasa con 3,0. Faltar a la evaluación final = materia perdida.
String[] RAMOS = { "Física", "Cálculo", "Álgebra", "Programación" };
String[] RAMO_FINAL = { "PARCIAL de Física", "PARCIAL de Cálculo", "PARCIAL de Álgebra", "Programación (entrega final)" };
int[] ramoPuntos = new int[4];
int[] ramoFaltas = new int[4];

// Materia de una clase (0 Física, 1 Cálculo, 2 Álgebra, 3 Programación).
int ramoDe(int c) {
  String m = CLASES[c][3];
  if (posicionDe(m, "Física") >= 0) return 0;
  if (posicionDe(m, "Cálculo") >= 0) return 1;
  if (posicionDe(m, "Álgebra") >= 0) return 2;
  if (posicionDe(m, "Programación") >= 0) return 3;
  return -1;
}

// Suma puntos a una materia.
void registrarNotaRamo(int c, int notas) {
  int r = ramoDe(c);
  if (r >= 0) ramoPuntos[r] += notas;
}

// Cuenta una falta en una materia (baja sus puntos).
void registrarFaltaRamo(int c) {
  int r = ramoDe(c);
  if (r >= 0) { ramoFaltas[r]++; ramoPuntos[r] -= 2; }
}

// Clase del examen final de una materia.
int claseFinalDe(int r) {
  for (int c = 0; c < CLASES.length; c++) if (CLASES[c][3].equals(RAMO_FINAL[r])) return c;
  return -1;
}

// ¿Faltaste a la evaluación final de esa materia?
boolean faltoAlFinal(int r) {
  int c = claseFinalDe(r);
  return c >= 0 && claseEstado[c] == 3;
}

// Nota final de una materia de 0,0 a 5,0 (0 si faltaste al final).
float notaRamo(int r) {
  if (faltoAlFinal(r)) return 0;
  return constrain(1.5 + stats[ST_NOTAS] / 40.0 + ramoPuntos[r] * 0.15, 0, 5);
}

// ¿Perdiste la materia (nota menor que 3,0 o faltaste al final)?
boolean ramoPerdido(int r) {
  return faltoAlFinal(r) || notaRamo(r) < 3.0;
}

// Cuántas materias perdiste.
int ramosPerdidos() {
  int n = 0;
  for (int r = 0; r < 4; r++) if (ramoPerdido(r)) n++;
  return n;
}

// Pasa una nota a texto con coma (3,5).
String notaTexto(float n) {
  return nf(n, 1, 1).replace('.', ',');
}

// Dibuja las notas de las 4 materias (o 'pendiente' antes de los resultados).
void dibujarNotasRamos(float x, float y) {
  fill(40);
  textSize(24);
  if (dia < 10 || minutoAhora() < 12 * 60 + 30) {
    text("Así vas en cada materia (se pasa con 3,0)", x, y + 30);
  } else {
    text("Notas finales del semestre", x, y + 30);
  }
  for (int r = 0; r < 4; r++) {
    float yy = y + 70 + r * 80;
    float n = notaRamo(r);
    boolean perdida = ramoPerdido(r);
    noStroke();
    fill(232, 226, 214);
    rect(x, yy, 1100, 64, 10);
    fill(40);
    textSize(24);
    text(RAMOS[r], x + 20, yy + 40);
    if (perdida) fill(color(190, 60, 50)); else fill(color(50, 140, 70));
    textSize(30);
    if (faltoAlFinal(r)) text("PERDIDA", x + 280, yy + 42); else text(notaTexto(n), x + 280, yy + 42);
    fill(90);
    textSize(17);
    int c = claseFinalDe(r);
    String fin;
    if (c < 0) {
      fin = "";
    } else if (claseEstado[c] == 3) {
      fin = RAMO_FINAL[r] + ": día " + CLASES[c][0] + " a las " + CLASES[c][1]
      + " · NO FUISTE";
    } else if (claseEstado[c] >= 1) {
      fin = RAMO_FINAL[r] + ": día " + CLASES[c][0] + " a las " + CLASES[c][1]
      + " · presentado";
    } else {
      fin = RAMO_FINAL[r] + ": día " + CLASES[c][0] + " a las " + CLASES[c][1]
      + "";
    }
    text(fin + "  ·  faltas en esta materia: " + ramoFaltas[r], x + 460, yy + 40);
  }
  if (ramosPerdidos() >= 2) fill(color(190, 60, 50)); else fill(color(80));
  textSize(19);
  text("Materias perdidas: " + ramosPerdidos() + " de 4. Con 2 o más no pasas el semestre (no te gradúas de primer semestre).", x, y + 420);
  textSize(17);
  fill(110);
  text("Faltar a un parcial (o a la entrega final de Programación) es perder la materia. Así de duro.", x, y + 450);
}

// ============================ PARCIAL ENCADENADO (dos rondas seguidas) ============================
int parcialRonda = 0, parcialNotas1 = 0;
String parcialTexto1 = "";

// Lo llama terminarMinijuegoClase: si es la primera ronda de un parcial, arranca la segunda y devuelve true
boolean parcialEncadenado(int notas, String texto) {
  if (claseActual < 0 || !empiezaCon(CLASES[claseActual][3], "PARCIAL")) return false;
  if (parcialRonda == 1) return false;
  parcialRonda = 1;
  parcialNotas1 = notas;
  parcialTexto1 = texto;
  String m = CLASES[claseActual][3];
  if (posicionDe(m, "Física") >= 0) { mjActual = MJ_PENDULO; iniciarPendulo(); }
  else if (posicionDe(m, "Cálculo") >= 0) { mjActual = MJ_PENDIENTE; iniciarPendiente(); }
  else { mjActual = MJ_BALANZA; iniciarBalanza(); }
  if (notas >= 0) {
    aviso("Parcial · segunda parte: " + MJ_NOMBRE[mjActual] + "  (primera parte: notas " + "+" + notas + ")");
  } else {
    aviso("Parcial · segunda parte: " + MJ_NOMBRE[mjActual] + "  (primera parte: notas " + "" + notas + ")");
  }
  empezarActividad(ACT_CLASE_JUEGO);
  return true;
}

// Junta los puntos de las dos partes del parcial.
int notasParcial(int notas) {
  if (parcialRonda != 1) return notas;
  parcialRonda = 0;
  return notas + parcialNotas1;
}

// Junta el texto de resultado de las dos partes del parcial.
String textoParcial(String texto) {
  if (parcialTexto1.equals("")) return texto;
  String t = "Parte 1: " + parcialTexto1 + "\nParte 2: " + texto;
  parcialTexto1 = "";
  return t;
}

