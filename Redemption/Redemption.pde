  if (cel == 14) dibujarNotas();
  else if (cel == 16) dibujarMapaCel();
  else if (cel == 17) dibujarPlaylist();
  else if (cel == 18) dibujarBateria();

  fill(255);
  textSize(34);
  textAlign(LEFT, CENTER);
  text("<", celX1 + 14, celY1 + MSG_HEAD / 2 - 2);
  textAlign(LEFT, BASELINE);
}

// Clicks en las apps de la cuarta fila: compartir ubicación, elegir lista de música o quitarla.
void clickCelular4() {
  if (mouseX >= celX1 && mouseX <= celX1 + 70 && mouseY >= celY1 && mouseY <= celY1 + MSG_HEAD) { cel = 1; return; }
  if (cel == 16) {
    if (enBoton(celX1 + 40, celY1 + 440, celX2 - celX1 - 80, 70)) {
      ubicacionCompartida = !ubicacionCompartida;
      if (ubicacionCompartida) aviso("Mamá ya ve dónde estás."); else aviso("Dejaste de compartir tu ubicación.");
      if (ubicacionCompartida) {
        anotarDiario("Compartí mi ubicación con Mamá. Ella se queda más tranquila; yo, más vigilado.");
      } else {
        anotarDiario("Dejé de compartir mi ubicación con Mamá.");
      }
      if (ubicacionCompartida) sumarBandera("UBICACION_MAMA", 1);
    }
  } else if (cel == 17) {
    for (int i = 0; i < 3; i++) {
      if (enBoton(celX1 + 40, celY1 + LISTA_Y0 + i * LISTA_PASO, celX2 - celX1 - 80, 80)) ponerPlaylist(i + 1);
    }
    if (enBoton(celX1 + 40, celY1 + LISTA_Y0 + 3 * LISTA_PASO, celX2 - celX1 - 80, 64)) quitarPlaylist();
  }
}

