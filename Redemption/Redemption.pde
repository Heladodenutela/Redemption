// Cada avance del reloj: cada 5 minutos del juego pone a la gente en su lugar según su agenda.
void tickReloj3() {
  if (screen != 1) return;
  if (bloqueCincoMin() != agendaBloque) {
    agendaBloque = bloqueCincoMin();
    actualizarAgenda();
  }
  revisarClases();
  revisarCopa();
  actualizarHorario();
  revisarEventosFijos();
  if (actividad == ACT_SENTADO) {
    sentadoMedios++;
    if (sentadoMedios % (SENTADO_CADA_MIN * 2) == 0) cambiarStat(ST_ENERGIA, SENTADO_ENERGIA);
  }
}

// Al empezar un día: borra lo dicho, los encargos y los avisos del día anterior.
void nuevoDia3() {
  if (dichasHoy != null) for (int f = 0; f < dichasHoy.length; f++) { vaciarTexto(dichasHoy[f]); charlaHoy[f] = false; }
  vaciarTexto(encargosHoy);
  newtonHoy = false;
  redesMinHoy = 0;
  armarFeed();
  actualizarAgenda();
}

// Acciones de los objetos: tomar clase, sentarse, comer en la mesa.
boolean accionNueva3(String a) {
  if (a.equals(ACC_CLASE)) { tomarClase(); return true; }
  if (a.equals(ACC_SENTARSE)) { sentarse(); return true; }
  if (a.equals(ACC_MESA)) { mesaFamilia(); return true; }
  return false;
}

// Teclas de las clases (y pasa a las de deportes si no es una clase).
void teclasActividad3() {
  if (teclasActividad4()) return;
  if (teclasActividad5()) return;
  boolean cerrar = key == 'q' || key == 'Q' || key == BACKSPACE;
  boolean usar = key == 'e' || key == 'E' || key == ' ';
  boolean mover = key == 'a' || key == 'A' || key == 'd' || key == 'D' || (key == CODED && (keyCode == LEFT || keyCode == RIGHT));
  if (actividad == ACT_SENTADO && (cerrar || usar || mover)) {
    terminarActividad();
    if (key == 'a' || key == 'A') teclaIzq = true;
    if (key == 'd' || key == 'D') teclaDer = true;
  }
}

// Clicks de las clases (y pasa a los de deportes).
boolean clickActividad3() {
  if (clickActividad4()) return true;
  if (clickActividad5()) return true;
  return actividad == ACT_CLASE;
}

