// ============================ MENSAJES - funciones ============================
// Deja vacía la tabla de chats al empezar la partida.
void iniciarMensajes() {
  for (int f = 0; f < MSG_FILAS; f++) {
    for (int c = 0; c < MSG_COLS; c++) msg[f][c] = "";
  }
  for (int f = 0; f < baseChats.length && f < MSG_FILAS; f++) {
    for (int c = 0; c < baseChats[f].length && c < MSG_COLS; c++) msg[f][c] = baseChats[f][c];
  }
  msgN = 0;
  for (int f = 0; f < MSG_FILAS; f++) {
    if (!msg[f][0].equals("")) msgN++;
  }
  ordenarChats();
  int[] orden = resOrdenarChats;
  for (int p = 0; p < msgN; p++) msg[orden[p]][2] = str(p);
  chatAbierto = -1;
  msgBarra = 0;
  msgBarraLista = 0;
  msgArrastrando = false;
}

int[] resOrdenarChats;

// Ordena los chats: el del mensaje más reciente arriba (queda en resOrdenarChats).
void ordenarChats() {
  int[] orden = new int[msgN];
  int n = 0;
  for (int f = 0; f < MSG_FILAS && n < msgN; f++) {
    if (!msg[f][0].equals("")) {
      int p = n;
      while (p > 0 && int(msg[orden[p - 1]][2]) > int(msg[f][2])) {
        orden[p] = orden[p - 1];
        p--;
      }
      orden[p] = f;
      n++;
    }
  }
  resOrdenarChats = orden;
}

// "12" = la persona de la fila 2 te escribe, "012" = tu le escribes a la fila 12
void nuevomensaje(String codigo) {
  if (codigo == null || codigo.length() < 2) return;
  char quien = letraEn(codigo, 0);
  int fila = int(codigo.substring(1));
  if ((quien != '0' && quien != '1') || fila < 0 || fila >= MSG_FILAS || msg[fila][0].equals("")) {
    return;
  }
  int col = MSG_INI + msg[fila][1].length();
  if (col >= MSG_COLS || msg[fila][col].equals("")) {
    return;
  }
  boolean abajo = (cel == 6 && chatAbierto == fila && msgBarra >= maxBarra(altoChat(fila)) - 1);
  if (quien == '1' && empiezaCon(msg[fila][col], "[voz]")) { vozPend[fila]++; if (cel == 6 && chatAbierto == fila) escucharVoces(fila); }
  if (quien == '1' && !(cel == 6 && chatAbierto == fila)) celNotificacion = true;
  if (quien == '1' && !(cel == 6 && chatAbierto == fila)) noLeidos[fila]++;
  msg[fila][1] = msg[fila][1] + quien;

  ordenarChats();
  int[] orden = resOrdenarChats;
  int pos = 0;
  while (orden[pos] != fila) pos++;
  for (int p = pos; p > 0; p--) orden[p] = orden[p - 1];
  orden[0] = fila;
  for (int p = 0; p < msgN; p++) msg[orden[p]][2] = str(p);

  if (abajo) msgBarra = maxBarra(altoChat(fila));
}

// Parte un mensaje en renglones que caben en la burbuja del chat.
String partirMensaje(String texto) {
  if (empiezaCon(texto, "[voz]")) texto = textoVoz(texto);
  String resto = quitarBordes(texto);
  String partido = "";
  while (resto.length() > MSG_CARACTERES) {
    int corte = ultimaPosicionDeDesde(resto, " ", MSG_CARACTERES);
    if (corte <= 0) corte = MSG_CARACTERES;
    partido = partido + resto.substring(0, corte) + "\n";
    resto = quitarBordes(resto.substring(corte));
  }
  return partido + resto;
}

// Cuenta cuántos renglones tiene un texto ya partido.
int contarLineas(String partido) {
  int n = 1;
  for (int k = 0; k < partido.length(); k++) {
    if (letraEn(partido, k) == '\n') n++;
  }
  return n;
}

// Alto de una burbuja de mensaje según cuántos renglones tiene.
float altoBurbuja(String texto) {
  return 2 * MSG_PAD_Y + contarLineas(partirMensaje(texto)) * MSG_LINEA;
}

// Alto total de todos los mensajes de un chat (para la barra de desplazamiento).
float altoChat(int fila) {
  String quien = msg[fila][1];
  float alto = MSG_MARGEN_ARRIBA;
  for (int c = MSG_INI; c < MSG_INI + quien.length() && c < MSG_COLS; c++) {
    int n = c - MSG_INI;
    if (n > 0) { if (letraEn(quien, n) == letraEn(quien, n - 1)) alto += MSG_SEP; else alto += MSG_SEP_CAMBIO; }
    alto += altoBurbuja(msg[fila][c]);
  }
  return alto + MSG_MARGEN_ABAJO;
}

// Cuántos chats tienen mensajes.
int chatsVisibles() {
  int n = 0;
  for (int f = 0; f < MSG_FILAS; f++) {
    if (!msg[f][0].equals("") && !msg[f][1].equals("")) n++;
  }
  return n;
}

// Alto de la lista de chats.
float altoLista() {
  return chatsVisibles() * MSG_FILA + MSG_MARGEN_ABAJO;
}

// Alto de lo que se ve en WhatsApp (un chat abierto o la lista).
float altoContenido() {
  if (cel == 6 && chatAbierto >= 0) return altoChat(chatAbierto);
  return altoLista();
}

// Alto de la parte visible del WhatsApp.
float altoVista() { return celY2 - msgVistaY; }
// Dónde empieza la pista de la barra de desplazamiento.
float pistaY() { return msgVistaY + MSG_PISTA_PAD; }
// Alto de la pista de la barra de desplazamiento.
float pistaAlto() { return altoVista() - 2 * MSG_PISTA_PAD; }

// Alto del bloque que se arrastra en la barra de desplazamiento.
float altoBloque(float contenido) {
  return max(50, pistaAlto() * altoVista() / contenido);
}

// Hasta dónde puede bajar la barra de desplazamiento.
float maxBarra(float contenido) {
  if (contenido <= altoVista()) return 0;
  return pistaAlto() - altoBloque(contenido);
}

// Cuánto se mueve el contenido por cada píxel que se mueve la barra.
float multiplicador(float contenido) {
  float mb = maxBarra(contenido);
  if (mb <= 0) return 0;
  return (contenido - altoVista()) / mb;
}

// Si el click fue en la barra de desplazamiento, empieza a arrastrarla.
boolean agarrarBarra() {
  float contenido = altoContenido();
  if (maxBarra(contenido) <= 0) return false;
  if (mouseX < celX2 - MSG_ZONA_BARRA || mouseX > celX2 || mouseY < msgVistaY || mouseY > celY2) return false;
  float bloque = altoBloque(contenido);
  float arriba = pistaY() + msgBarra;
  if (mouseY >= arriba && mouseY <= arriba + bloque) msgAgarre = mouseY - arriba;
  else msgAgarre = bloque / 2;
  msgArrastrando = true;
  moverBarra();
  return true;
}

// Mueve la barra de desplazamiento con el mouse.
void moverBarra() {
  msgBarra = constrain(mouseY - pistaY() - msgAgarre, 0, maxBarra(altoContenido()));
}

// Cuánto está desplazado el contenido según la barra.
float desplazamiento(float contenido) {
  if (msgArrastrando) {
    if (mousePressed) moverBarra();
    else msgArrastrando = false;
  }
  msgBarra = constrain(msgBarra, 0, maxBarra(contenido));
  return msgBarra * multiplicador(contenido);
}

// Dibuja la barra de desplazamiento del WhatsApp.
void dibujarBarra(float contenido) {
  if (maxBarra(contenido) <= 0) return;
  noStroke();
  fill(0, 0, 0, 25);
  rect(celX2 - 12, pistaY(), 8, pistaAlto(), 4);
  if (msgArrastrando) fill(0, 0, 0, 150); else fill(0, 0, 0, 90);
  rect(celX2 - 12, pistaY() + msgBarra, 8, altoBloque(contenido), 4);
}

// Dibuja un degradado abajo para que el contenido no se corte en seco.
void degradadoAbajo(int rojo, int verde, int azul) {
  noStroke();
  for (int k = 0; k < MSG_DEGRADADO; k++) {
    fill(rojo, verde, azul, 255.0 * (k + 1) / MSG_DEGRADADO);
    rect(celX1, celY2 - MSG_DEGRADADO + k, celX2 - celX1, 1);
  }
}

// Elige el color pastel de un chat.
void rellenoPastel(int fila) {
  int[] c = msgPastel[fila % msgPastel.length];
  fill(c[0], c[1], c[2]);
}

// Corta un texto con '...' para que quepa en un ancho dado.
String recortar(String texto, float ancho) {
  if (textWidth(texto) <= ancho) return texto;
  while (texto.length() > 0 && textWidth(texto + "...") > ancho) texto = texto.substring(0, texto.length() - 1);
  return quitarBordes(texto) + "...";
}

// Qué chat está en esa posición de la lista.
int chatEn(float x, float y) {
  if (x < celX1 || x > celX2 || y < msgVistaY || y > celY2) return -1;
  ordenarChats();
  int[] orden = resOrdenarChats;
  float fy = msgVistaY - msgBarra * multiplicador(altoLista());
  for (int p = 0; p < msgN; p++) {
    int f = orden[p];
    if (!msg[f][1].equals("")) {
      if (y >= fy && y < fy + MSG_FILA) return f;
      fy += MSG_FILA;
    }
  }
  return -1;
}

// Dibuja la lista de chats con el último mensaje y los no leídos.
void dibujarChats() {
  float contenido = altoLista();
  float offset = desplazamiento(contenido);
  noStroke();
  fill(255);
  rect(celX1, celY1, celX2 - celX1, celY2 - celY1);
  clip(celX1, msgVistaY, celX2 - celX1, altoVista());
  textAlign(LEFT, TOP);
  ordenarChats();
  int[] orden = resOrdenarChats;
  float y = msgVistaY - offset;
  for (int p = 0; p < msgN; p++) {
    int f = orden[p];
    if (!msg[f][1].equals("")) {
      if (y + MSG_FILA > msgVistaY && y < celY2) {
        rellenoPastel(f);
        ellipse(celX1 + 45, y + MSG_FILA / 2, 58, 58);
        fill(20);
        textSize(26);
        text(recortar(msg[f][0], celX2 - celX1 - 120), celX1 + 90, y + 17);
        burbujaRoja(celX2 - 50, y + MSG_FILA / 2, noLeidos[f]);
        if (vistoSinResponder(f)) { fill(60, 140, 200); textSize(16); text("Visto · sin responder", celX2 - 200, y + 20); }
        fill(120);
        textSize(20);
        String ultimo = msg[f][min(MSG_COLS - 1, MSG_INI + msg[f][1].length() - 1)];
        if (empiezaCon(ultimo, "[voz]")) ultimo = "> Nota de voz";
        text(recortar(ultimo, celX2 - celX1 - 120), celX1 + 90, y + 53);
        fill(228);
        rect(celX1 + 90, y + MSG_FILA - 1, celX2 - celX1 - 90, 1);
      }
      y += MSG_FILA;
    }
  }
  if (chatsVisibles() == 0) {
    fill(150);
    textSize(22);
    textAlign(CENTER, CENTER);
    text("No tienes mensajes", (celX1 + celX2) / 2, (msgVistaY + celY2) / 2);
  }
  noClip();
  degradadoAbajo(255, 255, 255);
  fill(7, 94, 84);
  rect(celX1, celY1, celX2 - celX1, MSG_HEAD);
  fill(255);
  textSize(32);
  textAlign(LEFT, CENTER);
  text("Chats", celX1 + 24, celY1 + MSG_HEAD / 2);
  dibujarBarra(contenido);
  textAlign(LEFT, BASELINE);
}

// Dibuja un chat abierto con sus burbujas.
void dibujarChat() {
  int f = chatAbierto;
  if (f < 0) {
    cel = 5;
    return;
  }
  float contenido = altoChat(f);
  float offset = desplazamiento(contenido);
  noStroke();
  fill(236, 229, 221);
  rect(celX1, celY1, celX2 - celX1, celY2 - celY1);
  clip(celX1, msgVistaY, celX2 - celX1, altoVista());
  textSize(MSG_TEXTO);
  textLeading(MSG_LINEA);
  textAlign(LEFT, TOP);
  String quien = msg[f][1];
  float y = msgVistaY + MSG_MARGEN_ARRIBA - offset;
  for (int c = MSG_INI; c < MSG_INI + quien.length() && c < MSG_COLS; c++) {
    int n = c - MSG_INI;
    boolean primero = (n == 0 || letraEn(quien, n) != letraEn(quien, n - 1));
    if (n > 0) { if (primero) y += MSG_SEP_CAMBIO; else y += MSG_SEP; }
    String texto = partirMensaje(msg[f][c]);
    float alto = 2 * MSG_PAD_Y + contarLineas(texto) * MSG_LINEA;
    if (y + alto > msgVistaY && y < celY2) {
      boolean mio = (letraEn(quien, n) == '0');
      float ancho = textWidth(texto) + 2 * MSG_PAD_X;
      float x;
      if (mio) x = celX2 - MSG_BORDE - ancho; else x = celX1 + MSG_BORDE;
      if (mio) fill(220, 248, 198); else fill(255);
      if (primero && mio) {
        rect(x, y, ancho, alto, 10, 0, 10, 10);
        triangle(x + ancho, y, x + ancho + 10, y, x + ancho, y + 12);
      } else if (primero) {
        rect(x, y, ancho, alto, 0, 10, 10, 10);
        triangle(x, y, x - 10, y, x, y + 12);
      } else {
        rect(x, y, ancho, alto, 10);
      }
      fill(30);
      text(texto, x + MSG_PAD_X, y + MSG_PAD_Y);
    }
    y += alto;
  }
  noClip();
  degradadoAbajo(236, 229, 221);
  fill(7, 94, 84);
  rect(celX1, celY1, celX2 - celX1, MSG_HEAD);
  float fy = celY1 + MSG_HEAD / 2;
  stroke(255);
  strokeWeight(4);
  line(celX1 + 20, fy, celX1 + 44, fy);
  line(celX1 + 20, fy, celX1 + 31, fy - 11);
  line(celX1 + 20, fy, celX1 + 31, fy + 11);
  strokeWeight(1);
  noStroke();
  rellenoPastel(f);
  ellipse(celX1 + 90, fy, 46, 46);
  fill(255);
  textSize(28);
  textAlign(LEFT, CENTER);
  text(recortar(msg[f][0], celX2 - celX1 - 150), celX1 + 126, fy);
  dibujarBarra(contenido);
  textAlign(LEFT, BASELINE);
}

