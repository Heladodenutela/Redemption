// ============================ 3. RITMO (DJ, guitarra, trote, baile) ============================
// Las notas bajan; presiona su tecla cuando pasen por la línea.
int rtCarriles = 4;
float[] rtY = new float[80];
int[] rtCarril = new int[80];
boolean[] rtViva = new boolean[80];
int rtProx, rtFin, rtNotas, rtPuntos, rtRacha;
String rtMsg = "";
int rtMsgHasta = 0;
int[] rtBrillo = new int[4];
final float RT_LINEA = 760;

String[] resTeclasRitmo;

// Teclas de cada carril (D F J K para el DJ, flechas para trote y baile).
// Deja el resultado en resTeclasRitmo.
void teclasRitmo() {
  if (rtCarriles == 4) { resTeclasRitmo = new String[] { "D", "F", "J", "K" }; return; }
  resTeclasRitmo = new String[] { "←", "↓", "→" };
}

// Empieza el minijuego de ritmo (DJ, trote o baile).
void iniciarRitmo(String c) {
  if (c.equals("DJ")) rtCarriles = 4; else rtCarriles = 3;
  for (int i = 0; i < rtY.length; i++) rtViva[i] = false;
  rtProx = millis() + 1200;
  if (c.equals("BAILE")) rtFin = millis() + 22000; else rtFin = millis() + 30000;
  rtNotas = 0;
  rtPuntos = 0;
  rtRacha = 0;
}

// Posición en x de un carril.
float xCarril(int k) {
  return 800 + (k - (rtCarriles - 1) / 2.0) * 170;
}

// Qué carril corresponde a la tecla presionada.
int carrilDeTecla() {
  if (rtCarriles == 4) {
    char k = minuscula(key);
    if (k == 'd' || (key == CODED && keyCode == LEFT)) return 0;
    if (k == 'f' || (key == CODED && keyCode == DOWN)) return 1;
    if (k == 'j' || (key == CODED && keyCode == UP)) return 2;
    if (k == 'k' || (key == CODED && keyCode == RIGHT)) return 3;
    return -1;
  }
  if (key == CODED && keyCode == LEFT) return 0;
  if (key == CODED && keyCode == DOWN) return 1;
  if (key == CODED && keyCode == RIGHT) return 2;
  char k = minuscula(key);
  if (k == 'a') return 0;
  if (k == 's') return 1;
  if (k == 'd') return 2;
  return -1;
}

// Tecla de ritmo: acierto si la nota está en la línea de ese carril.
void teclaRitmo(boolean v) {
  if (!v) return;
  int c = carrilDeTecla();
  if (c < 0) return;
  rtBrillo[c] = millis() + 120;
  int mejor = -1;
  float md = 999;
  for (int i = 0; i < rtY.length; i++) if (rtViva[i] && rtCarril[i] == c && abs(rtY[i] - RT_LINEA) < md) { md = abs(rtY[i] - RT_LINEA); mejor = i; }
  float ventanaBien = facil(80), ventanaPerf = facil(40);
  if (mejor >= 0 && md < ventanaBien) {
    rtViva[mejor] = false;
    boolean perf = md < ventanaPerf;
    if (perf) rtPuntos += 100; else rtPuntos += 60;
    rtRacha++;
    if (perf) rtMsg = "¡Perfecto!"; else rtMsg = "Bien";
  } else {
    rtRacha = 0;
    rtMsg = "Fuera de tiempo";
  }
  rtMsgHasta = millis() + 400;
}

// Dibuja el minijuego de ritmo: carriles, notas que bajan y la racha.
void dibujarRitmo() {
  String t;
  if (mj20.equals("DJ")) {
    t = "DJ EN LA TERRAZA · que no se caiga la fiesta";
  } else if (mj20.equals("TROTE")) {
    t = "TROTE CON ESTEBAN · pisa al ritmo";
  } else {
    if (mj20.equals("BAILE")) t = "RETO DE BAILE PARA CLIPU"; else t = "AL RITMO · toca con Iván";
  }
  teclasRitmo();
  String[] aux1 = resTeclasRitmo;
  fondoMJ(25, 20, 40, t, "Presiona " + juntar(aux1, " ") + " cuando la nota pase por la línea. Racha: " + rtRacha);
  float dt = dt20();
  if (mj20.equals("BAILE")) {
    barraTiempoMJ((rtFin - millis()) / 22000.0);
  } else {
    barraTiempoMJ((rtFin - millis()) / 30000.0);
  }

  for (int i = 0; i < 6; i++) {
    noStroke();
    fill((cuadros * 3 + i * 40) % 255, 80, 200, 40);
    ellipse(200 + i * 240, 200 + 40 * sin(cuadros * 0.05 + i), 220, 220);
  }
  teclasRitmo();
  String[] tc = resTeclasRitmo;
  for (int k = 0; k < rtCarriles; k++) {
    float x = xCarril(k);
    noStroke();
    fill(255, 255, 255, 25);
    rect(x - 70, 130, 140, 700, 10);
    if (millis() < rtBrillo[k]) fill(color(255, 230, 120)); else fill(color(255, 255, 255, 90));
    ellipse(x, RT_LINEA, 120, 50);
    fill(255);
    textSize(24);
    textAlign(CENTER, CENTER);
    text(tc[k], x, RT_LINEA + 50);
  }
  textAlign(LEFT, BASELINE);

  if (millis() > rtProx && millis() < rtFin - 1500) {
    for (int i = 0; i < rtY.length; i++) if (!rtViva[i]) {
      rtViva[i] = true;
      rtY[i] = 130;
      rtCarril[i] = int(random(rtCarriles));
      rtNotas++;
      break;
    }
    int paso;
    if (random(1) < 0.3) paso = 420 + 420; else paso = 420 + 0;
    rtProx = millis() + round(paso * (1 / difMult));
  }
  float vel = dificil(B_DJ_VELOCIDAD);
  int[][] col = { {240, 90, 120}, {90, 200, 240}, {250, 210, 70}, {140, 230, 120} };
  for (int i = 0; i < rtY.length; i++) {
    if (rtViva[i]) {
      rtY[i] += vel * dt;
      if (rtY[i] > RT_LINEA + 90) { rtViva[i] = false; rtRacha = 0; }
      int[] c = col[rtCarril[i] % 4];
      fill(c[0], c[1], c[2]);
      ellipse(xCarril(rtCarril[i]), rtY[i], 90, 40);
    }
  }
  if (millis() < rtMsgHasta) {
    fill(255);
    textSize(30);
    textAlign(CENTER, CENTER);
    text(rtMsg, 800, 640);
    textAlign(LEFT, BASELINE);
  }
  if (millis() > rtFin) {
    int p;
    if (rtNotas == 0) p = 0; else p = round(rtPuntos / (float) rtNotas);
    String txt;
    if (mj20.equals("DJ")) {
      if (p >= 60) {
        txt = "La terraza entera bailando. Marta te grita \"¡DJ!\" desde la cocina.";
      } else {
        txt = "Se te fueron unos cortes, pero nadie dejó de bailar.";
      }
    } else if (mj20.equals("TROTE")) {
      if (p >= 60) {
        txt = "Esteban: \"¡Así se trota! Respira por la nariz.\"";
      } else {
        txt = "Esteban: \"Más suave, más suave...\"";
      }
    } else {
      if (p >= 60) txt = "¡Sonó bonito!"; else txt = "Sonó... a ensayo.";
    }
    finMJ(p, txt);
  }
}

// ============================ 4. VUELTOS (la canasta de Andrés) ============================
// El cliente compra y paga con un billete: dale el vuelto exacto con las monedas y billetes.
String[] VT_PRODUCTOS = { "Bom bom", "Chicle", "Chocolatina", "Galletas", "Maní" };
int[] VT_PRECIO = { 1, 1, 2, 3, 2 };
int[] VT_BILLETES = { 1, 2, 5, 10 };
int vtTotal, vtPaga, vtDado, vtAtendidos, vtBien, vtFin;
String vtCompra = "", vtMsg = "";
int vtMsgHasta = 0;

// Empieza el minijuego de los vueltos en la canasta de Andrés.
void iniciarVueltos() {
  vtAtendidos = 0;
  vtBien = 0;
  vtFin = millis() + round(facil(B_VUELTOS_SEGUNDOS) * factorTurno() * 1000);
  nuevoClienteVueltos();
}

// Llega un cliente con una compra y un billete para pagar.
void nuevoClienteVueltos() {
  vtTotal = 0;
  vtCompra = "";
  int n = 1 + int(random(3));
  vtNProd = n;
  vtDadoN = 0;
  vtCliente = int(random(5));
  vtDesde = millis();
  for (int i = 0; i < n; i++) {
    int k = int(random(VT_PRODUCTOS.length));
    vtProd[i] = k;
    vtTotal += VT_PRECIO[k];
    if (i == 0) {
      vtCompra += "" + VT_PRODUCTOS[k] + " ($" + VT_PRECIO[k] + ")";
    } else {
      vtCompra += ", " + VT_PRODUCTOS[k] + " ($" + VT_PRECIO[k] + ")";
    }
  }
  int[] billetes = { 5, 10, 20 };
  vtPaga = billetes[int(random(3))];
  while (vtPaga <= vtTotal) vtPaga += 5;
  vtDado = 0;
}

// Clicks en las monedas y billetes para armar el vuelto (o en Entregar).
void clickVueltos() {
  for (int i = 0; i < VT_BILLETES.length; i++) if (dentro(560 + i * 190, 560, 170, 110)) {
    vtDado += VT_BILLETES[i];
    if (vtDadoN < vtDadoLista.length) vtDadoLista[vtDadoN++] = i;
    return;
  }
  if (dentro(560, 700, 360, 70)) {
    int falta = vtPaga - vtTotal;
    vtAtendidos++;
    if (vtDado == falta) { vtBien++; vtMsg = "¡Exacto! El cliente se va feliz."; }
    else if (vtDado < falta) vtMsg = "\"¡Me faltan $" + (falta - vtDado) + "!\""; else vtMsg = "Le diste $" + (vtDado - falta) + " de más. Andrés se agarra la cabeza.";
    vtMsgHasta = millis() + 1500;
    nuevoClienteVueltos();
  }
  if (dentro(940, 700, 380, 70)) { vtDado = 0; vtDadoN = 0; }
}

// Dibuja los vueltos: el cliente, la compra, lo que pagó y lo que vas dando.
void dibujarVueltos() {
  cargarSpritesMJ22();
  fondoMJ(70, 50, 30, "LA CANASTA DE ANDRÉS · vueltos", "Da el vuelto exacto con las monedas y billetes. Bien: " + vtBien + " de " + vtAtendidos);
  int resta = vtFin - millis();
  barraTiempoMJ(resta / (facil(B_VUELTOS_SEGUNDOS) * factorTurno() * 1000));
  if (vueltosConSprites()) dibujarVueltosSprites();
  else dibujarVueltosSinSprites();
  botonMJ(560, 700, 360, 70, "Entregar vuelto", color(60, 150, 90));
  botonMJ(940, 700, 380, 70, "Recoger y contar otra vez", color(170, 90, 60));
  if (millis() < vtMsgHasta) {
    fill(0, 0, 0, 170);
    rect(420, 800, 760, 56, 10);
    fill(255);
    textSize(24);
    textAlign(CENTER, CENTER);
    text(vtMsg, 800, 826);
    textAlign(LEFT, BASELINE);
  }
  if (resta <= 0) {
    int p;
    if (vtAtendidos == 0) p = 0; else p = round(100.0 * vtBien / max(metaVueltos(), vtAtendidos));
    finMJ(p, "Atendiste " + vtAtendidos + " clientes; " + vtBien + " con el vuelto exacto.");
  }
}

