  cic_ciclista = cargarSiExiste("minijuegos/ciclismo/ciclista_lento.png");
  cic_botella = cargarSiExiste("minijuegos/ciclismo/botella.png");
}

// Dibuja el cuadro "f" de una tira horizontal de "n" cuadros; false si no hay imagen
boolean tira(PImage img, int n, int f, float x, float y, float w, float h) {
  if (img == null || img.width <= 1) return false;
  int cw = img.width / n;
  image(img, x, y, w, h, f * cw, 0, f * cw + cw, img.height);
  return true;
}

// ¿Esta persona está ahora en este mapa?
boolean personaAqui(String nombre) {
  int f = personaIndice(nombre);
  if (f < 0 || agendaNPC == null || agendaNPC[f] < 0) return false;
  int k = agendaNPC[f];
  return npcMapa[k] == mapaActual && npcPresente(k);
}

// Cuánto tiempo pasó desde el cuadro anterior en el gimnasio (1.0 = un cuadro a 60 FPS), para que todo se mueva igual a cualquier velocidad.
float dtJuego() {
  int ahora = millis();
  float d = constrain((ahora - gymUltimo) / 16.67, 0, 3);
  gymUltimo = ahora;
  return d;
}

