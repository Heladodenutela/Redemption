int llamadaFila = -1, llamadaHasta = 0;
boolean[] llamadaHecha = new boolean[LLAMADAS.length];
String llamadaTexto = "";
int llamadaRespuestaHasta = 0;
int llamadaVista = 0;

// Te entra una llamada cuando llega su hora (si no estás en algo).
void revisarLlamadas() {
  if (llamadaFila >= 0 || finJuego) return;

  if (viajeActivo || menuAbierto || pausado || (actividad != ACT_NINGUNA && !enClase() && !actividadDeFondo())) return;
  int m = minutoAhora();
  for (int k = 0; k < LLAMADAS.length; k++) {
    if (!llamadaHecha[k] && int(LLAMADAS[k][0]) == dia) {
      int h = aMin(LLAMADAS[k][1]);
      if (m >= h && m <= h + 60 && !(LLAMADAS[k][3].equals("clase") && actividad != ACT_CLASE_JUEGO && actividad != ACT_CLASE)) {
        if (!cumple(LLAMADAS[k][4])) { if (m > h + 50) llamadaHecha[k] = true; } else {
          llamadaHecha[k] = true;
          llamadaFila = k;
          llamadaHasta = millis() + 9000;
          llamadaVista = 0;
          return;
        }
      }
    }
  }
}

// ¿Estás en clase?
boolean enClase() {
  return actividad == ACT_CLASE_JUEGO || actividad == ACT_CLASE || actividad == ACT_CLASE_RES;
}

// Contesta o rechaza la llamada y aplica su efecto.
void contestarLlamada(boolean si) {
  if (llamadaFila < 0) return;
  String[] l = LLAMADAS[llamadaFila];
  int f = personaIndice(l[2]);
  String r;
  if (si) {
    r = aplicarEfectos(l[5], f);
    llamadaTexto = nombreCortoSeguro(f) + ": " + l[7];
    llamadaRespuestaHasta = millis() + 6500;
    avanzarTiempo(3);
    if (enClase()) {
      int profe = personaIndice(CLASES[max(0, claseActual)][5]);
      cambiarAmistad(profe, -4);
      cambiarStat(ST_NOTAS, -2);
      r += " · ¡El profe te vio contestar en clase! Notas −2";
    }
  } else {
    r = aplicarEfectos(l[6], f);
    if (f >= 0 && llegaMensaje(nombreChat(f), 1)) { if (enClase()) agregarMensaje(nombreChat(f), '1', "Ay, perdón, se me olvidó que estabas en clase. Me escribes cuando salgas."); else agregarMensaje(nombreChat(f), '1', "Te llamé y no contestaste. ¿Todo bien?"); }
  }
  if (!r.equals("")) aviso(r);
  llamadaFila = -1;
}

// Nombre corto de una persona, o texto vacío si no hay persona.
String nombreCortoSeguro(int f) {
  if (f >= 0) return nombreCorto(f); else return "";
}

// Dibuja la llamada entrante con los botones Contestar y Rechazar.
void dibujarLlamada() {
  if (llamadaFila < 0) {
    if (millis() < llamadaRespuestaHasta) {
      noStroke();
      fill(20, 30, 40, 230);
      rect(900, 640, 660, 120, 14);
      fill(255);
      textSize(19);
      text(llamadaTexto, 920, 660, 620, 90);
    }
    return;
  }

  int ahora = millis();
  if (llamadaVista > 0 && ahora - llamadaVista > 300) llamadaHasta += ahora - llamadaVista;
  llamadaVista = ahora;
  if (viajeActivo || menuAbierto) llamadaHasta = max(llamadaHasta, ahora + 2000);
  if (ahora > llamadaHasta) { contestarLlamada(false); return; }
  String[] l = LLAMADAS[llamadaFila];
  float x = 1100, y = 560;
  float vib = sin(cuadros * 0.9) * 3;
  noStroke();
  fill(25, 30, 45, 240);
  rect(x + vib, y, 460, 200, 18);
  fill(255);
  textSize(22);
  text("Llamada entrante", x + 24 + vib, y + 36);
  textSize(28);
  if (posicionDe(l[2], "(") > 0) {
    text(quitarBordes(l[2].substring(0, posicionDe(l[2], "("))), x + 24 + vib, y + 76);
  } else {
    text(l[2], x + 24 + vib, y + 76);
  }
  if (enClase()) { fill(255, 190, 90); textSize(16); text("Estás en clase...", x + 24, y + 102); }
  PImage ret;
  if (posicionDe(l[2], "(") > 0) {
    ret = retratoDe(personaPorNombre(quitarBordes(l[2].substring(0, posicionDe(l[2], "(")))));
  } else {
    ret = retratoDe(personaPorNombre(l[2]));
  }
  if (hay(ret)) image(ret, x + 352 + vib, y + 14, 92, 92, 0, 0, ret.width / 3, ret.height);
  fill(60, 170, 90);
  rect(x + 24, y + 124, 190, 54, 27);
  fill(200, 60, 60);
  rect(x + 246, y + 124, 190, 54, 27);
  fill(255);
  textSize(20);
  textAlign(CENTER, CENTER);
  text("Contestar", x + 119, y + 149);
  text("Rechazar", x + 341, y + 149);
  textAlign(LEFT, BASELINE);
}

// Click en Contestar o Rechazar.
boolean clickLlamada() {
  if (llamadaFila < 0) return false;
  float x = 1100, y = 560;
  if (mouseY > y + 124 && mouseY < y + 178) {
    if (mouseX > x + 24 && mouseX < x + 214) { contestarLlamada(true); return true; }
    if (mouseX > x + 246 && mouseX < x + 436) { contestarLlamada(false); return true; }
  }
  return false;
}

