    text(("COPA AURORA · " + COPA[copaActual][3] + " · ") + "primero a " + GOLES_GANARS, 800, 58);
  } else {
    text("Práctica · " + "primero a " + GOLES_GANARS, 800, 58);
  }
  textSize(15);
  fill(255);
  text("WASD/flechas mover · SHIFT sprint · click con balón: mantén para la fuerza, suelta para patear (Q/E efecto) · sin balón: barrida", 800, 92);
