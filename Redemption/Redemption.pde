// ============================ CONEXIONES (EL GRAFO) ============================
// Tipo de cambio
final int BORDE_IZQ = 0, BORDE_DER = 1, INTERACCION = 2;

// Cómo se viaja
final int A_PIE = 0, BUS = 1, TAXI = 2, TAQUILLA = 3;

// Columnas de cada conexión
final int CX_ORIGEN = 0, CX_TIPO = 1, CX_OBJ = 2, CX_DESTINO = 3, CX_MIN = 4, CX_MODO = 5, CX_DIA = 6, CX_APARECE = 7;

// CX_DIA: 0 = siempre, 6 = solo el día 6, -6 = todos los días menos el 6
// CX_APARECE: x donde aparece al llegar (-1 = borde contrario, o el paradero si llegas en vehículo)
// Paraderos: los buses, el taxi y las caminatas largas siempre te dejan aquí
final int LLEGA_C1 = 1040, LLEGA_I2 = 1000, LLEGA_I6 = 860, LLEGA_P1 = 280, LLEGA_I7 = 700;

final int MAX_CONEXIONES = 220;
int[][] conexiones = new int[MAX_CONEXIONES][8];
int numConexiones = 0;

// Agrega una conexión al grafo de mapas: de dónde a dónde, cuántos minutos, cómo (a pie, bus, taxi) y dónde apareces.
void con(int origen, int tipo, int o, int destino, int minutos, int modo, int diaCond, int aparece) {
  int[] c = conexiones[numConexiones];
  c[CX_ORIGEN] = origen;
  c[CX_TIPO] = tipo;
  c[CX_OBJ] = o;
  c[CX_DESTINO] = destino;
  c[CX_MIN] = minutos;
  c[CX_MODO] = modo;
  c[CX_DIA] = diaCond;
  c[CX_APARECE] = aparece;
  numConexiones++;
}

// Bordes (aparece = -1: borde contrario)
void izq(int origen, int destino, int minutos, int aparece) { con(origen, BORDE_IZQ, -1, destino, minutos, A_PIE, 0, aparece); }
// Conexión caminando por el borde derecho del mapa.
void der(int origen, int destino, int minutos, int aparece) { con(origen, BORDE_DER, -1, destino, minutos, A_PIE, 0, aparece); }

// Interacciones
void inter(int origen, int o, int destino, int minutos, int aparece) { con(origen, INTERACCION, o, destino, minutos, A_PIE, 0, aparece); }
// Conexión en bus desde un paradero (cuesta plata).
void bus(int origen, int o, int destino, int minutos, int aparece) { con(origen, INTERACCION, o, destino, minutos, BUS, 0, aparece); }
// Conexión en el taxi de Don Beto.
void taxi(int origen, int o, int destino, int minutos, int aparece) { con(origen, INTERACCION, o, destino, minutos, TAXI, 0, aparece); }
// Conexión en bus desde la taquilla de la Terminal (con espera).
void taquilla(int origen, int o, int destino, int minutos, int aparece) { con(origen, INTERACCION, o, destino, minutos, TAQUILLA, 0, aparece); }

