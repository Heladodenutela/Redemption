// Dibuja un botón del tutorial.
void botonTutorial(float x, float y, float w, String t, boolean principal) {
  boolean enc = mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + 56;
  noStroke();
  if (principal) {
    if (enc) fill(80, 115, 190);
    else fill(60, 90, 160);
  } else {
    if (enc) fill(215, 210, 200);
    else fill(230, 226, 218);
  }
  rect(x, y, w, 56, 12);
  if (principal) fill(255);
  else fill(40);
  textSize(22);
  textAlign(CENTER, CENTER);
  text(t, x + w / 2, y + 26);
  textAlign(LEFT, BASELINE);
}

