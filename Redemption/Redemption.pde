// ============================ OBJETOS INTERACTIVOS ============================
// Un objeto = una zona (x desde - x hasta, en píxeles del fondo 1600x900) donde se pulsa E.
// Se crean dentro de definirConexiones() con obj(...), junto con las conexiones del grafo.
final int MAX_OBJ = 160;
int numObjetos = 0;
int[] objMapa = new int[MAX_OBJ];
int[][] objX = new int[MAX_OBJ][2];
String[] objNombre = new String[MAX_OBJ];
String[] objAccion = new String[MAX_OBJ];
final String ACC_PRACTICA = "PRACTICA";

// Crea un objeto y devuelve su número
int obj(int mapa, int xa, int xb, String nombre, String accion) {
  int id = numObjetos;
  objMapa[id] = mapa;
  objX[id][0] = xa;
  objX[id][1] = xb;
  objNombre[id] = nombre;
  objAccion[id] = accion;
  numObjetos++;
  return id;
}

// Lo que pasa con los objetos que no cambian de mapa (dormir, comer, hablar...).
void accionEspecial(int o) {
  if (accionNueva(o)) return;
  if (objAccion[o].equals(ACC_PRACTICA)) {
    partidoRugby();
    iniciarPractica();
    return;
  }
  if (accionDeObjeto(objAccion[o])) return;
  aviso(objAccion[o]);
}

