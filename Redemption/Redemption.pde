// ¿Esta persona está ocupada ese día a esa hora (clase o trabajo)?
boolean ocupadoA(String p, int d, int m) {
  if (agendaFilas == null) return false;
  boolean trabaja = false;
  for (int i = 0; i < TRABAJAN.length; i++) if (TRABAJAN[i].equals(p)) trabaja = true;
  for (int i = 0; i < tamFilas(agendaFilas); i++) {
    String[] a = agendaFilas[i];
    if (a[0].equals(p)) {
      String[] h = { "", "", a[1], a[2], a[3] };
      if (ventanaAbierta(h, d, m)) {
        if (trabaja || posicionDe(CLASES_MAPAS, a[4] + " ") >= 0) return true;
      }
    }
  }
  return false;
}

int[] resHorasPlan;

// Horas que puedes proponer para un plan (desde la próxima hora en adelante).
// Deja el resultado en resHorasPlan.
void horasPlan() {
  int m = minutoAhora();
  int base = (m / 60 + 1) * 60;
  int[] r = new int[0];
  for (int i = 0; i < 3; i++) {
    int h = base + i * 60;
    if (h <= 21 * 60) { alargarEnteros(r, h); r = resAlargarEnteros; }
  }
  resHorasPlan = r;
}

