  if (p < 0) { resTemasV21 = t; return; }
  int n = TEMAS_V21.length;
  for (int j = 0; j < n && tamInt(t) < 4; j++) {
    int k = (j + dia * 3 + p) % n;
    if (!tieneInt(t, k) && temaVale(p, TEMAS_V21[k])) agregarInt(t, k);
  }
  resTemasV21 = t;
}

// Dibuja los temas que puedes escribirle.
void dibujarEscribirV21() {
  if (!puedeEscribirV21()) return;
  int p = personaDeChatV21();
  temasV21(p);
  int[] t = resTemasV21;
  int n = tamInt(t);
  float y0 = celY2 - BARRA_ENV - n * ESC_ALTO - 8;
  noStroke();
  fill(240, 248, 242, 245);
  rect(celX1, y0 - 34, celX2 - celX1, celY2 - y0 + 34);
  fill(90);
  textSize(17);
  textAlign(LEFT, TOP);
  text("Escribirle a " + msg[chatAbierto][0] + ":", celX1 + 16, y0 - 28);
