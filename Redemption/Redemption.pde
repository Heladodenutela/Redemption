// Busca lo próximo que hay en la agenda de hoy.
String proximoEvento() {
  int m = minutoAhora();
  for (int h = m / 60 + 1; h < 24; h++) {
    String n = agendaNombre[dia][h];
    if (n != null && (agendaNombre[dia][h - 1] == null || !agendaNombre[dia][h - 1].equals(n))) {
      int falta = h * 60 - m;
      return "Próximo: " + n + " · en " + (falta / 60) + " h " + nf(falta % 60, 2) + " min";
    }
  }
  return "Hoy no queda nada en el horario";
}

