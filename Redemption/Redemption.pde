// ============================ CASA: DESAYUNO Y CENA EN LA MESA (C4) ============================
// La "Familia" es una persona más del diálogo: su cadena se arma con la tabla CASA.
void mesaFamilia() {
  int m = minutoAhora();
  int fam = personaIndice("Familia");
  if (fam < 0 || dia > CASA.length) return;
  String[] c = CASA[dia - 1];
  for (int i = 1; i < DLG_COLS; i++) { dlg[fam][i] = null; dlgNodo[fam][i] = null; dlgEfecto[fam][i] = null; }
  dlg[fam][1] = "";
  dlgPos[fam] = 0;
  if (m >= 6 * 60 && m < 8 * 60 + 30 && bandera("DESAYUNO_" + dia) == 0) {
    sumarBandera("DESAYUNO_" + dia, 1);
    if (dia == 1 || dia == 8) poner(fam, '0', c[1], null, "MESADA"); else poner(fam, '0', c[1], null, null);
    poner(fam, '1', "Buenos días.", null, null);
  } else if (m >= 19 * 60 && m < 21 * 60 + 30 && bandera("CENA_" + dia) == 0) {
    sumarBandera("CENA_" + dia, 1);
    poner(fam, '0', c[2], "C:" + dia, null);
  } else if (m >= 9 * 60 && m < 23 * 60) {
    // fuera de las comidas, en la mesa se juega parqués con la familia
    iniciarParques();
    return;
  } else {
    aviso("La mesa está vacía. Desayuno de 6:00 a 8:30 a. m. · cena de 7:00 a 9:30 p. m.");
    return;
  }
  avanzarTiempo(COMIDA_CASA_MIN);
  catMedios[CAT_AMIGOS] += COMIDA_CASA_MIN * 2;
  cambiarStat(ST_ENERGIA, 8);
  if (agendaNPC != null && agendaNPC[personaIndice("Mamá (Claudia)")] >= 0) {
    dlgNPC = agendaNPC[personaIndice("Mamá (Claudia)")];
  } else {
    dlgNPC = 0;
  }
  dlgFila = fam;
  dlgSoloDefault = false;
  empezarActividad(ACT_DIALOGO);
}

