}

// Dibuja el aparato del gimnasio que estás usando.
boolean dibujarActividad7() {
  if (dibujarActividad9()) return true;
  if (actividad == ACT_GYM_REPS) { dibujarReps(); return true; }
  if (actividad == ACT_GYM_CAMINADORA) { dibujarCaminadora(); return true; }
  if (actividad == ACT_CICLISMO) { dibujarCiclismo(); return true; }
  if (actividad == ACT_GYM_RES) { dibujarGymRes(); return true; }
  return false;
}

// ============================ ÍCONOS PROPIOS DE CADA PRODUCTO ============================
// Si existe extras/objetos/productos/<nombre_del_producto>.png se usa ese; si no, el de PRODUCTO_IMG.
// "Libro “Cálculo para humanos”" -> libro_calculo_para_humanos.png
final int MAX_ICONOS = 120;
String[] iconoNombre = new String[MAX_ICONOS];
PImage[] iconoImg = new PImage[MAX_ICONOS];

// Convierte el nombre de un producto en nombre de archivo: minúsculas, sin tildes y con _ en vez de espacios.
String nombreArchivo(String p) {
  String s = p.toLowerCase();
  String de = "áéíóúñü", a = "aeiounu";
  for (int i = 0; i < de.length(); i++) s = s.replace(letraEn(de, i), letraEn(a, i));
  String r = "";
  for (int i = 0; i < s.length(); i++) {
    char c = letraEn(s, i);
    if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) r += c;
    else if (r.length() > 0 && letraEn(r, r.length() - 1) != '_') r += '_';
  }
  while (terminaCon(r, "_")) r = r.substring(0, r.length() - 1);
  return r;
}

// Busca (y carga una sola vez) la imagen propia de un producto de la tienda.
PImage iconoPropio(String producto) {
  int n = tamTexto(iconoNombre);
  for (int i = 0; i < n; i++) if (iconoNombre[i].equals(producto)) return iconoImg[i];
  if (n >= MAX_ICONOS) return null;
  PImage img = cargarSiExiste("extras/objetos/productos/" + nombreArchivo(producto) + ".png");
  iconoImg[n] = img;
  agregarTexto(iconoNombre, producto);
  return img;
}

// Dibuja la imagen propia de un producto, si existe; si no, devuelve false para que se dibuje el ícono genérico.
boolean dibujarIconoPropio(String producto, float x, float y, float tam) {
  PImage img = iconoPropio(producto);
  if (img == null || img.width <= 1) return false;
  float e = min(tam / img.width, tam / img.height);
  image(img, x + (tam - img.width * e) / 2, y + (tam - img.height * e) / 2, img.width * e, img.height * e);
  return true;
}

