}

// Leer: el resultado queda en la variable res... (las funciones no devuelven vectores)
int[] resInts;
float[] resFloats;
boolean[] resBools;
String[] resTextos;
char[] resChars;
int[][] resTablaInts;
float[][] resTablaFloats;
boolean[][] resTablaBools;
String[][] resTablaTextos;
char[][] resTablaChars;

// Separa "cuántos:valores", deja los valores en resPartes y devuelve cuántos son (-1 si era null)
String[] resPartes;

// Lee un vector guardado en la partida ('tamaño:valores') y deja las partes en resPartes.
int partesDeVector(String v) {
  resPartes = null;
  if (v.equals("\\N")) return -1;
  int k = posicionDe(v, ":");
  int n = int(v.substring(0, k));
  if (n > 0) { partirPorLetra(v.substring(k + 1), '|'); resPartes = resPartirPorLetra; }
  return n;
}

// Lee un vector de enteros del archivo (queda en resInts).
void leerInts(String v) {
  int n = partesDeVector(v);
  if (n < 0) { resInts = null; return; }
  resInts = new int[n];
  for (int i = 0; i < n && i < resPartes.length; i++) resInts[i] = int(resPartes[i]);
}

// Lee un vector de decimales del archivo (queda en resFloats).
void leerFloats(String v) {
  int n = partesDeVector(v);
  if (n < 0) { resFloats = null; return; }
  resFloats = new float[n];
  for (int i = 0; i < n && i < resPartes.length; i++) resFloats[i] = float(resPartes[i]);
}

// Lee un vector de verdadero/falso del archivo (queda en resBools).
void leerBools(String v) {
  int n = partesDeVector(v);
  if (n < 0) { resBools = null; return; }
  resBools = new boolean[n];
  for (int i = 0; i < n && i < resPartes.length; i++) resBools[i] = resPartes[i].equals("1");
}

// Lee un vector de textos del archivo (queda en resTextos).
void leerTextos(String v) {
  int n = partesDeVector(v);
  if (n < 0) { resTextos = null; return; }
  resTextos = new String[n];
  for (int i = 0; i < n && i < resPartes.length; i++) resTextos[i] = desescaparTexto(resPartes[i]);
}

// Lee un vector de letras del archivo (queda en resChars).
void leerChars(String v) {
  int n = partesDeVector(v);
  if (n < 0) { resChars = null; return; }
  resChars = new char[n];
  for (int i = 0; i < n && i < resPartes.length; i++) resChars[i] = char(int(resPartes[i]));
}

// Lee una tabla de enteros del archivo (queda en resTablaInts).
void leerTablaInts(String v) {
  if (v.equals("\\N")) { resTablaInts = null; return; }
  partirPorLetra(v, ';');
  String[] f = resPartirPorLetra;
  int n = int(f[0]);
  resTablaInts = new int[n][];
  for (int i = 0; i < n; i++) { leerInts(f[i + 1]); resTablaInts[i] = resInts; }
}

// Lee una tabla de decimales del archivo.
void leerTablaFloats(String v) {
  if (v.equals("\\N")) { resTablaFloats = null; return; }
  partirPorLetra(v, ';');
  String[] f = resPartirPorLetra;
  int n = int(f[0]);
  resTablaFloats = new float[n][];
  for (int i = 0; i < n; i++) { leerFloats(f[i + 1]); resTablaFloats[i] = resFloats; }
}

// Lee una tabla de verdadero/falso del archivo.
void leerTablaBools(String v) {
  if (v.equals("\\N")) { resTablaBools = null; return; }
  partirPorLetra(v, ';');
  String[] f = resPartirPorLetra;
  int n = int(f[0]);
  resTablaBools = new boolean[n][];
  for (int i = 0; i < n; i++) { leerBools(f[i + 1]); resTablaBools[i] = resBools; }
}

// Lee una tabla de textos del archivo.
void leerTablaTextos(String v) {
  if (v.equals("\\N")) { resTablaTextos = null; return; }
  partirPorLetra(v, ';');
  String[] f = resPartirPorLetra;
  int n = int(f[0]);
  resTablaTextos = new String[n][];
  for (int i = 0; i < n; i++) { leerTextos(f[i + 1]); resTablaTextos[i] = resTextos; }
