// ---- PIEZAS NUEVAS DE LOS FONDOS: van dentro de la capa del fondo (se dibujan una sola vez) ----
final int MAX_PIEZAS = 10;
int numPiezas = 0;
PImage[] piezaImg = new PImage[MAX_PIEZAS];
int[] piezaMapa = new int[MAX_PIEZAS];
float[] piezaX = new float[MAX_PIEZAS], piezaY = new float[MAX_PIEZAS];

// Agrega una pieza de decoración fija a un mapa.
void pieza(PImage img, int mapa, float x, float y) {
  piezaImg[numPiezas] = img;
  piezaMapa[numPiezas] = mapa;
  piezaX[numPiezas] = x;
  piezaY[numPiezas] = y;
  numPiezas++;
}

// Pone todas las piezas fijas en sus mapas (escalera del puente, señales).
void iniciarPiezas() {
  numPiezas = 0;
  pieza(pz_escaleraPuente, I2, 1230, 150);
  pieza(pz_senalParadero, P1, 250, 500);
  pieza(pz_letreroEscaleras, U4, 1330, 260);
  pieza(pz_letreroCompu, U5, 100, 520);
  pieza(pz_letrero305, U5, 640, 520);
}

// Se llama dentro de armarCapaFondo()
void dibujarPiezas(PGraphics g, int mapa) {
  for (int k = 0; k < numPiezas; k++) {
    if (piezaMapa[k] == mapa && piezaImg[k] != null) {
      PImage im = piezaImg[k];
      g.image(im, aPantallaX(piezaX[k]), aPantallaY(piezaY[k]), im.width * escalaFondo, im.height * escalaFondo);
    }
  }
}

// ---- hojas por nombre (usa la tabla del visor para saber el tamaño y los cuadros de cada fila) ----
// Número de una hoja de sprites en la tabla VISOR_DATOS.
int indiceHoja(String nombre) {
  for (int k = 0; k < VISOR_DATOS.length; k++) {
    if (VISOR_DATOS[k][0].equals(nombre)) return k;
  }
  return -1;
}

int[] resFilaHoja;

// Las filas de cada hoja ya convertidas a números: visFilas[hoja][fila del visor] = { fila en la hoja, columna inicial, cuadros }.
// Se arma una sola vez (prepararFilasHojas) para no partir el texto de VISOR_DATOS en cada cuadro.
int[][][] visFilas;

// Parte una vez el texto de cada hoja ("0;0;4;AFK|1;0;4;AFK acción|...") y guarda los números en visFilas.
void prepararFilasHojas() {
  visFilas = new int[VISOR_DATOS.length][][];
  for (int k = 0; k < VISOR_DATOS.length; k++) {
    partirPorLetra(VISOR_DATOS[k][4], '|');
    String[] filas = resPartirPorLetra;
    visFilas[k] = new int[filas.length][3];
    for (int i = 0; i < filas.length; i++) {
      partirPorLetra(filas[i], ';');
      visFilas[k][i][0] = int(resPartirPorLetra[0]);
      visFilas[k][i][1] = int(resPartirPorLetra[1]);
      visFilas[k][i][2] = int(resPartirPorLetra[2]);
    }
  }
}

// { fila en la hoja, columna inicial, cuadros } de la fila n del visor
// Deja el resultado en resFilaHoja (solo se lee: es la fila guardada en visFilas).
void filaHoja(int idx, int n) {
  if (visFilas == null) prepararFilasHojas();
  resFilaHoja = visFilas[idx][constrain(n, 0, visFilas[idx].length - 1)];
}

// Dibuja la hoja "idx" (fila n del visor) con su esquina de arriba a la izquierda en (x, y) del fondo
void dibujarHojaEn(int idx, int n, float x, float y, int desfase) {
  if (idx < 0) return;
  int cw = int(VISOR_DATOS[idx][2]), ch = int(VISOR_DATOS[idx][3]);
  filaHoja(idx, n);
  int[] f = resFilaHoja;
  int col = f[1] + ((cuadros + desfase) / 12) % max(1, f[2]);
  dibujarHoja(visHojas[idx], cw, ch, f[0], col, aPantallaX(x), aPantallaY(y), escalaFondo);
}

// Alto de cada cuadro de una hoja de sprites.
int altoHoja(int idx) {
  if (idx < 0) return 0; else return int(VISOR_DATOS[idx][3]);
}

// ---- UTILERÍA FIJA POR MAPA (objetos que siempre están) ----
final int MAX_UTI = 40;
int numUti = 0;
int[] utiIdx = new int[MAX_UTI], utiFila = new int[MAX_UTI], utiMapa = new int[MAX_UTI];
float[] utiX = new float[MAX_UTI], utiBase = new float[MAX_UTI];

// yBase = y donde se apoya la base del objeto; -1 = en el piso del mapa
void utileria(String hoja, int fila, int mapa, float x, float yBase) {
  if (numUti >= MAX_UTI) return;
  utiIdx[numUti] = indiceHoja(hoja);
  utiFila[numUti] = fila;
  utiMapa[numUti] = mapa;
  utiX[numUti] = x;
  utiBase[numUti] = yBase;
  numUti++;
}

// Pone los objetos de cada mapa (cafetera, celular cargando, balones...).
void iniciarUtileria() {
  numUti = 0;
  utileria("obj_cafetera_de_la_casa", 0, C4, 20, 500);
  utileria("obj_celular_cargando", 0, C5, 230, 525);
  utileria("obj_libros", 1, C5, 990, 455);
  utileria("obj_pendulo_del_laboratorio", 0, U7, 105, 480);
  utileria("obj_pendulo_del_laboratorio", 0, U7, 355, 480);
  utileria("obj_libros", 1, U11, 830, 640);
  utileria("obj_libros", 1, U11, 1050, 640);
  utileria("obj_almuerzo_de_la_cantina", 0, U12, 300, 585);
  utileria("obj_tinto_de_la_cantina", 0, U12, 950, 635);
  utileria("ef_vapor", 0, U16, 400, 520);
  utileria("obj_cafe_de_grano", 0, P3, 300, 555);
  utileria("obj_cafe_de_grano", 0, P3, 220, 695);
  utileria("obj_cafe_de_grano", 0, P3, 680, 695);
  utileria("obj_nuez_y_bellota", 0, K3, 860, -1);
  utileria("obj_caballete_de_don_aurelio", 0, K7, 200, -1);
}

// Dibuja los objetos del mapa actual.
void dibujarUtileria() {
  for (int k = 0; k < numUti; k++) {
    if (utiMapa[k] == mapaActual) {
      float base;
      if (utiBase[k] < 0) base = pisoMapa[mapaActual]; else base = utiBase[k];
      dibujarHojaEn(utiIdx[k], utiFila[k], utiX[k], base - altoHoja(utiIdx[k]), k * 5);
    }
  }
}

