// ¿Este nodo se puede mostrar en una escena? (raíz de hoy o rama que ya desbloqueaste)
boolean nodoValidoEscena(String n, int f) {
  if (f < 0 || tieneTexto(nodosHechos, n)) return false;
  opcionesDe("A:" + n, f);
  String[][] aux1 = resOpcionesDe;
  if (tamFilas(aux1) == 0) return false;
  if (tieneTexto(nodosAbiertos, n)) return condicionEvaluable(cuandoNodo(n), f);
  return tieneTexto(raicesArbol, n) && condicionArbol(cuandoNodo(n), n, f);
}

// Se llama cada intervalo del reloj: si estás donde pasa algo, empieza la cinemática
void revisarEscenasMapa() {
  if (screen != 1 || actividad != ACT_NINGUNA || cel != 0 || viajeActivo || menuAbierto) return;
