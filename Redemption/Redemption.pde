      if (frac <= 0) corte = 56;
      image(ui_barras_stats, x, y, corte * STATS_ESC, ch, 280, k * 50, 280 + int(corte), k * 50 + 50);
    } else {
      fill(60);
      rect(x + 40, y + 8, cw - 44, ch - 16, 4);
      fill(200, 120, 255);
      rect(x + 40, y + 8, (cw - 44) * frac, ch - 16, 4);
