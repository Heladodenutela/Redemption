// Total del carrito de Pedidazo.
int totalCarrito() {
  int t = 0;
  for (int k = 0; k < PEDIDAZO.length; k++) t += carrito[k] * int(PEDIDAZO[k][1]);
  return t;
}

// Costo del envío de Pedidazo (gratis desde cierto valor o con la oferta del día).
int envioCarrito() {
  int t = totalCarrito();
  if (t == 0 || t >= ENVIO_GRATIS_DESDE || ofertaDia == dia) return 0; else return ENVIO_PEDIDAZO;
}

