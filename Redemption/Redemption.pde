// Llega un cliente con un pedido nuevo al azar.
void nuevoPedido() {
  pdPideA = int(random(pdA.length));
  if (pdMaxB == 1) pdNumB = 1; else pdNumB = 1 + int(random(min(pdMaxB, 1 + pdAtendidos)));
  for (int i = 0; i < pdNumB; i++) pdPideB[i] = int(random(pdB.length));
  pdPideC = int(random(pdC.length));
  pdArmA = -1;
  pdArmC = -1;
  pdArmNumB = 0;
  pdDesde = millis();
  pdCliente = int(random(5));
}

// Cuánto se parece lo que armaste a lo que pidió (0-100)
int exactitudPedido() {
  int p = 0;
  if (pdArmA == pdPideA) p += 25;
  if (pdArmC == pdPideC) p += 25;
  int bien = 0;
  for (int i = 0; i < pdNumB; i++) if (i < pdArmNumB && pdArmB[i] == pdPideB[i]) bien++;
  if (pdArmNumB > pdNumB) bien = max(0, bien - (pdArmNumB - pdNumB));
  p += round(50.0 * bien / pdNumB);
  return p;
}

// Entrega el pedido: la propina depende de qué tan exacto y rápido fue.
void entregarPedido() {
  int e = exactitudPedido();
  int seg = (millis() - pdDesde) / 1000;
  int propina;
  if (e == 100) propina = max(0, 3 - seg / 8); else propina = 0;
  pdSumaExacta += e;
  pdPropinas += propina;
  pdAtendidos++;
  if (e == 100) {
    if (propina > 0) pdMsg = "¡Perfecto!" + (" Propina $" + propina); else pdMsg = "¡Perfecto!" + "";
  } else {
    if (e >= 60) pdMsg = "Casi. El cliente lo acepta."; else pdMsg = "\"Esto no fue lo que pedí...\"";
  }
  pdMsgHasta = millis() + 1300;
  nuevoPedido();
}

// Clicks en los ingredientes y en Entregar.
void clickPedidos() {
