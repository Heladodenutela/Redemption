// Dibuja a las personas del mapa actual con su animación.
void dibujarNPCs() {
  for (int k = 0; k < numNPC; k++) {
    if (npcMapa[k] == mapaActual && npcPresente(k)) {
      int fila, col;
      boolean hablando = (actividad == ACT_DIALOGO && k == dlgNPC);
      if (npcVel[k] > 0 && !hablando) {
        npcX[k] = npcX[k] + npcDir[k] * npcVel[k] * pasoCuadro;
        if (npcX[k] > npcMax[k]) { npcX[k] = npcMax[k]; npcDir[k] = -1; }
        if (npcX[k] < npcMin[k]) { npcX[k] = npcMin[k]; npcDir[k] = 1; }
        if (npcDir[k] > 0) fila = npcFilaDer[k]; else fila = npcFilaIzq[k];
        col = ((cuadros + k * 7) / VEL_CAMINAR) % 4;
      } else {
        if (hablando) fila = npcFilaAFK(k); else fila = npcFila[k];
        if (k == newtonNPC && actividad == ACT_NEWTON) fila = 1;
        col = ((cuadros + k * 5) / VEL_AFK) % 4;
      }
      dibujarPersonaje(npcHoja[k], fila, col, npcX[k], pisoMapa[mapaActual]);
    }
  }
}

// ============================ TECLAS DEL MUNDO ============================
// Teclas del mundo: R para hablar, T para el inventario, E para usar y M para el mapa.
void teclasMundo() {
  if (actividad != ACT_NINGUNA) { teclasActividad(); return; }
  if (key == 'r' || key == 'R') hablar();
  if (key == TAB || key == 't' || key == 'T') abrirInventario();
  if (key == 'a' || key == 'A' || (key == CODED && keyCode == LEFT)) teclaIzq = true;
  if (key == 'd' || key == 'D' || (key == CODED && keyCode == RIGHT)) teclaDer = true;
  if (key == CODED && keyCode == SHIFT) correr = true;
  if (key == 'e' || key == 'E') interactuar();

}

// Teclas soltadas en el mundo: para de caminar o correr.
void soltarTeclasMundo() {
  if (key == 'a' || key == 'A' || (key == CODED && keyCode == LEFT)) teclaIzq = false;
  if (key == 'd' || key == 'D' || (key == CODED && keyCode == RIGHT)) teclaDer = false;
  if (key == CODED && keyCode == SHIFT) correr = false;
}

