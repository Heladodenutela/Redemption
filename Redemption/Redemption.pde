// Retrato de una persona para la caja de diálogo (se carga la primera vez).
PImage retratoDe(int f) {
  if (f < 0) return null;
  if (retratos == null) { retratos = new PImage[DLG_PERSONA.length]; retratoBuscado = new boolean[DLG_PERSONA.length]; }
  if (!retratoBuscado[f]) {
    retratoBuscado[f] = true;
    String h = hojaDePersona(f);
    if (empiezaCon(h, "pj_")) h = h.substring(3);
    if (h.equals("isa_colegio")) h = "iris";
    if (h.length() > 0) retratos[f] = cargarSiExiste("personajes/retratos/" + h + ".png");
  }
  return retratos[f];
}

// Lo llama dibujarCajaDialogo: true si dibujó el retrato con cara
