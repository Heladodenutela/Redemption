boolean mjExterno = false;
// Si la máquina se jugó desde una escena, vuelve a la escena con el resultado.
boolean arcadeDesdeEscena(int puntos, int premio, String mensaje) {
  if (!mjExterno || !(mj20.equals("ROYALE") || mj20.equals("DUELO"))) return false;
  mjExterno = false;
  if (premio > 0) dinero += premio;
  int p;
  if (mj20.equals("ROYALE")) {
    p = constrain(round(puntos * 100.0 / 45), 0, 100);
  } else {
    if (premio > 0) p = 85; else p = 35;
  }
  finMJ(p, mensaje);
  return true;
}

// Todos los minijuegos terminan aquí
void finMJ(int puntaje, String texto) {
  infoMJ(mj20);
  String[] inf = resInfoMJ;
  mj20Puntaje = constrain(puntaje, 0, 100);
  mj20Titulo = inf[1];
  mj20Texto = texto;
  sumarBandera(mj20 + "_HECHO", 1);
  if (mj20Puntaje >= 50) sumarBandera(mj20 + "_BIEN", 1);
  if (mj20Puntaje >= 100) sumarBandera(mj20 + "_PERFECTO", 1);

  int min = int(inf[2]);
  String cat = inf[3];
  if (cat.equals("E")) catMedios[CAT_ESTUDIAR] += min * 2;
  else if (cat.equals("J")) catMedios[CAT_EJERCICIO] += min * 2;
  else if (cat.equals("A")) catMedios[CAT_AMIGOS] += min * 2;
  else if (cat.equals("R")) catMedios[CAT_REDES] += min * 2;
  avanzarTiempo(max(0, min - minutosDesdeInicioMJ()));
  registrarPuntajeMJ(mj20, mj20Puntaje);
  if (mj20Puntaje >= 50) mj20Efecto = aplicarEfectos(inf[4], -1); else mj20Efecto = aplicarEfectos(inf[5], -1);
  empezarActividad(ACT_MJ20_RES);
}

// Cierra el resultado del minijuego y vuelve a la escena o al mundo.
void cerrarResultadoMJ() {
  String cod = mj20;
  mj20 = "";
  terminarActividad();
  if (escVolverDeMJ) volverAEscena(mj20Puntaje);
  else alTerminarMJSuelto(cod, mj20Puntaje);
}

// Dibuja el resultado del minijuego con estrellas y efectos.
void dibujarResultadoMJ() {
  ventana(420, 230, 760, 420, mj20Titulo);
  fill(40);
  textSize(24);
  text(mj20Texto, 460, 320, 680, 150);
  int estrellas;
  if (mj20Puntaje >= 85) {
    estrellas = 3;
  } else {
    if (mj20Puntaje >= 50) estrellas = 2; else if (mj20Puntaje >= 25) estrellas = 1; else estrellas = 0;
  }
  for (int i = 0; i < 3; i++) {
    noStroke();
    if (i < estrellas) fill(color(250, 200, 50)); else fill(color(200));
    estrella(720 + i * 80, 510, 28, 12);
  }
  fill(90);
  textSize(19);
  if (mj20Efecto.equals("")) text("", 460, 572); else text(mj20Efecto, 460, 572);
  fill(120);
  text("Puntaje " + mj20Puntaje + "/100   ·   [E] o click para seguir", 460, 620);
}

// Dibuja una estrella de 5 puntas.
void estrella(float x, float y, float r1, float r2) {
  beginShape();
  for (int i = 0; i < 10; i++) {
    float a = -HALF_PI + i * PI / 5;
    float r;
    if (i % 2 == 0) r = r1; else r = r2;
    vertex(x + cos(a) * r, y + sin(a) * r);
  }
  endShape(CLOSE);
}

// ¿El mouse está dentro del rectángulo (x, y, ancho, alto)?
boolean dentro(float x, float y, float w, float h) {
  return mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + h;
}

// Dibuja un botón de minijuego (se aclara con el mouse encima).
void botonMJ(float x, float y, float w, float h, String t, int c) {
  boolean enc = dentro(x, y, w, h);
  noStroke();
  if (enc) fill(lerpColor(c, color(255), 0.25)); else fill(c);
  rect(x, y, w, h, 10);
  fill(255);
  textSize(20);
  textAlign(CENTER, CENTER);
  text(t, x + w / 2, y + h / 2 - 2);
  textAlign(LEFT, BASELINE);
}

// Fondo opcional de cada minijuego: data/minijuegos/v20/<código en minúscula>.png (1600x900). Si no está, color plano.
PImage[] mjFondoImg = new PImage[40];
String[] mjFondoCod = new String[40];

// Fondo de un minijuego (se carga la primera vez; si falta, usa uno prestado).
PImage fondoDeMJ(String cod) {
  int n = tamTexto(mjFondoCod);
  for (int i = 0; i < n; i++) if (mjFondoCod[i].equals(cod)) return mjFondoImg[i];
  if (n >= mjFondoCod.length) return null;
  PImage img = cargarSiExiste("minijuegos/v20/" + cod.toLowerCase() + ".png");
  if (img == null || img.width <= 1) img = fondoPrestado(cod);
  if (img != null && img.width > 1) mjFondoImg[n] = img; else mjFondoImg[n] = null;
  agregarTexto(mjFondoCod, cod);
  return mjFondoImg[n];
}

// Algunos minijuegos no tienen fondo propio: usan el del lugar donde pasa la escena.
PImage fondoPrestado(String cod) {
  String m;
  if (cod.equals("ESTIRAR")) {
    m = "D1";
  } else if (cod.equals("BARRA")) {
    m = "D5";
  } else {
    if (cod.equals("MACETA")) m = "U15"; else if (cod.equals("NICO")) m = "U16"; else m = "";
  }
  int k;
  if (m.equals("")) k = -1; else k = mapaPorCodigo(m);
  if (k >= 0 && k < fondos.length) return fondos[k]; else return null;
}

// Dibuja el fondo, el título y la ayuda de un minijuego.
void fondoMJ(int r, int g, int b, String titulo, String ayuda) {
  noStroke();
  PImage img = fondoDeMJ(mj20);
  if (img != null) {
    image(img, 0, 0, ANCHO, ALTO);
    fill(0, 0, 0, 130);
    rect(0, 0, ANCHO, 96);
  } else {
    fill(r, g, b);
    rect(0, 0, ANCHO, ALTO);
  }
  fill(255);
  textSize(28);
  textAlign(LEFT, BASELINE);
  text(titulo, 40, 52);
  textSize(19);
  fill(235);
  text(ayuda, 40, 84);
}

// Dibuja la barra de tiempo que queda.
void barraTiempoMJ(float frac) {
  noStroke();
  fill(0, 0, 0, 80);
  rect(40, 100, 1520, 14, 7);
  if (frac > 0.3) fill(color(120, 220, 140)); else fill(color(240, 120, 90));
  rect(40, 100, 1520 * constrain(frac, 0, 1), 14, 7);
}

// ---- enganches (los llama el núcleo) ----
// Teclas de los minijuegos de las escenas y de sus resultados.
boolean teclasMinijuegosV20() {
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  if (actividad == ACT_MJ20_RES) { if (usar) cerrarResultadoMJ(); return true; }
  if (actividad == ACT_RESULTADOS) { if (usar) terminarActividad(); return true; }
  if (actividad != ACT_MJ20) return false;
  teclaMJ(mj20);
  return true;
}

// Clicks de los minijuegos de las escenas y de sus resultados.
boolean clickMinijuegosV20() {
  if (actividad == ACT_MJ20_RES) { cerrarResultadoMJ(); return true; }
  if (actividad == ACT_RESULTADOS) { terminarActividad(); return true; }
  if (actividad != ACT_MJ20) return false;
  clickMJ(mj20);
  return true;
}

// Dibuja el minijuego de escena que esté abierto (o su resultado).
boolean dibujarMinijuegosV20() {
  if (actividad == ACT_MJ20_RES) { dibujarResultadoMJ(); return true; }
  if (actividad == ACT_RESULTADOS) { dibujarResultados(); return true; }
  if (actividad != ACT_MJ20) return false;

  int v = bandera("VICIO");
  pushMatrix();
  if (v >= 2) translate(random(-1, 1) * v * 1.5, random(-1, 1) * v * 1.5);
  dibujarMJ(mj20);
  popMatrix();
  if (v >= 3) {
    noStroke();
    fill(200, 200, 190, 40 + v * 8);
    rect(0, 0, ANCHO, ALTO);
    fill(120, 60, 40);
    textSize(18);
    text("Antojo: te tiemblan las manos (VICIO " + v + ")", 40, ALTO - 20);
  }
  return true;
}

// Tecla soltada en un minijuego de escena.
void soltarMinijuegosV20() {
  if (actividad == ACT_MJ20) soltarTeclaMJ(mj20);
}

// Mouse soltado en un minijuego de escena.
void soltarMouseV20() {
  if (actividad == ACT_MJ20) soltarMouseMJ(mj20);
}

// Un minijuego que no vino de una escena (desde un objeto o el celular)
void alTerminarMJSuelto(String cod, int puntaje) {
  if (cod.equals("FOTO")) terminarFotoSuelta(puntaje);
}

// ---- tabla de minijuegos: aquí se conecta cada uno ----
// Empieza el minijuego con ese código (latte, pedidos, ritmo, vueltos...).
boolean iniciarMJ(String c) {
  if (c.equals("LATTE")) { iniciarLatte(); return true; }
  if (c.equals("HELADO") || c.equals("RAMOS") || c.equals("CANTINA") || c.equals("NICO")) { iniciarPedidos(c); return true; }
  if (c.equals("DJ") || c.equals("RITMO") || c.equals("TROTE") || c.equals("BAILE")) { iniciarRitmo(c); return true; }
  if (c.equals("VUELTOS")) { iniciarVueltos(); return true; }
  if (c.equals("ROYALE") || c.equals("DUELO")) {
    if (c.equals("ROYALE")) arcadeJuego = 0; else arcadeJuego = 2;
    for (int i = 0; i < 4; i++) arcTecla[i] = false;
    if (arcadeJuego == 0) iniciarRoyale(); else iniciarDuelo();
    mjExterno = true;
    return true;
  }
  if (esOrden(c)) { iniciarOrden(c); return true; }
  return iniciarMJ2(c);
}

// Reparte la tecla al minijuego abierto.
void teclaMJ(String c) {
  if (c.equals("DJ") || c.equals("RITMO") || c.equals("TROTE") || c.equals("BAILE")) teclaRitmo(true);
  else teclaMJ2(c, true);
}

// Reparte la tecla soltada al minijuego abierto.
void soltarTeclaMJ(String c) {
  if (c.equals("DJ") || c.equals("RITMO") || c.equals("TROTE") || c.equals("BAILE")) teclaRitmo(false);
  else teclaMJ2(c, false);
}

// Reparte el click al minijuego abierto.
void clickMJ(String c) {
  if (c.equals("HELADO") || c.equals("RAMOS") || c.equals("CANTINA") || c.equals("NICO")) clickPedidos();
  else if (c.equals("VUELTOS")) clickVueltos();
  else if (esOrden(c)) clickOrden();
  else if (c.equals("LATTE")) { }
  else clickMJ2(c);
}

// Reparte el mouse soltado al minijuego abierto.
void soltarMouseMJ(String c) {
  if (c.equals("LATTE")) soltarLatte();
  else soltarMouseMJ2(c);
}

// Dibuja el minijuego abierto.
void dibujarMJ(String c) {
  if (c.equals("LATTE")) dibujarLatte();
  else if (c.equals("HELADO") || c.equals("RAMOS") || c.equals("CANTINA") || c.equals("NICO")) dibujarPedidos();
  else if (c.equals("DJ") || c.equals("RITMO") || c.equals("TROTE") || c.equals("BAILE")) dibujarRitmo();
  else if (c.equals("VUELTOS")) dibujarVueltos();
  else if (esOrden(c)) dibujarOrden();
  else dibujarMJ2(c);
}

// ============================ 1. LATTE ART (trazar con el mouse) ============================
// Mantén el click y sigue la figura punteada sobre la espuma. Se dibuja por donde pasas.
String[] LATTE_FIGURAS = { "Corazón", "Hoja", "Tulipán" };
float[][] ltGuia;
float[] ltX = new float[900], ltY = new float[900];
int ltN = 0, ltFigura = 0, ltFin = 0, ltMuestraHasta = 0, ltSuma = 0;
String ltMsg = "";
boolean ltSoltado = false;
final float LT_CX = 800, LT_CY = 500;

// Empieza el arte latte.
void iniciarLatte() {
  ltFigura = 0;
  ltSuma = 0;
  nuevaFiguraLatte();
}

// Pasa a la siguiente figura del latte.
void nuevaFiguraLatte() {
  ltN = 0;
  ltMsg = "";
  ltMuestraHasta = 0;
  ltFin = millis() + round(facil(B_LATTE_SEGUNDOS) * 1000);
  ltGuia = new float[160][];
  int n = 0;
  if (ltFigura == 0) {
    for (int i = 0; i < 120; i++) {
      float t = TWO_PI * i / 120;
      float x = 16 * pow(sin(t), 3), y = 13 * cos(t) - 5 * cos(2 * t) - 2 * cos(3 * t) - cos(4 * t);
      ltGuia[n++] = new float[] { LT_CX + x * 13, LT_CY - y * 13 + 20 };
    }
  } else if (ltFigura == 1) {
    for (int i = 0; i < 110; i++) {
      float f = i / 110.0;
      float amp = 170 - 120 * f;
      ltGuia[n++] = new float[] { LT_CX + amp * sin(f * TWO_PI * 6), LT_CY - 200 + f * 380 };
    }
    for (int i = 0; i < 30; i++) ltGuia[n++] = new float[] { LT_CX, LT_CY + 190 - i * 13 };
  } else {
    float[] rad = { 150, 115, 80 };
    float[] cy = { 90, -30, -130 };
    for (int a = 0; a < 3; a++) for (int i = 0; i <= 30; i++) {
      float t = PI + PI * i / 30.0;
      ltGuia[n++] = new float[] { LT_CX + cos(t) * rad[a], LT_CY + cy[a] - sin(t) * rad[a] * 0.6 };
    }
    for (int i = 0; i < 20; i++) ltGuia[n++] = new float[] { LT_CX, LT_CY - 200 + i * 20 };
  }
  float[][] g = new float[n][];
  for (int i = 0; i < n; i++) g[i] = ltGuia[i];
  ltGuia = g;
}

// Qué tan bien quedó: cuánto de la figura cubriste y cuánto de tu trazo quedó encima
int evaluarLatte() {
  if (ltN < 10) return 0;
  float tol = facil(B_LATTE_TOLERANCIA);
  int cubiertos = 0;
  for (int i = 0; i < ltGuia.length; i++) {
    for (int j = 0; j < ltN; j++) if (dist(ltGuia[i][0], ltGuia[i][1], ltX[j], ltY[j]) < tol) { cubiertos++; break; }
  }
  int encima = 0;
  for (int j = 0; j < ltN; j++) {
    for (int i = 0; i < ltGuia.length; i++) if (dist(ltGuia[i][0], ltGuia[i][1], ltX[j], ltY[j]) < tol) { encima++; break; }
  }
  float cob = cubiertos / (float) ltGuia.length, pre = encima / (float) ltN;
  return round(100 * (0.6 * cob + 0.4 * pre));
}

// Califica la figura que dibujaste.
void terminarFiguraLatte() {
  int p = evaluarLatte();
  ltSuma += p;
  if (p >= 80) {
    ltMsg = "¡Precioso! Esto se vende solo.";
  } else if (p >= 50) {
    ltMsg = "Bonito. Un cliente feliz.";
  } else {
    if (p >= 25) ltMsg = "Mmm... es arte abstracto."; else ltMsg = "Eso es una mancha con leche.";
  }
  ltMuestraHasta = millis() + 1400;
}

// Al soltar el mouse, termina la figura si dibujaste lo suficiente.
void soltarLatte() {
  if (ltMuestraHasta == 0 && ltN >= 25) terminarFiguraLatte();
}

// Dibuja el latte: la taza, el modelo punteado y lo que vas dibujando.
void dibujarLatte() {
  cargarSpritesMJ22();
  fondoMJ(70, 48, 36, "LATTE ART · " + LATTE_FIGURAS[ltFigura] + " (" + (ltFigura + 1) + "/" + figurasLatte() + ")",
    "Mantén el click y sigue la figura punteada. Suelta cuando termines.");
  if (ltMuestraHasta == 0) barraTiempoMJ((ltFin - millis()) / (facil(B_LATTE_SEGUNDOS) * 1000));

  noStroke();
  if (hay(mjTaza)) {
    dibujarTazaLatte();
    dibujarModeloLatte();
  } else {
    fill(240);
    ellipse(LT_CX, LT_CY + 10, 760, 640);
    fill(190, 130, 80);
    ellipse(LT_CX, LT_CY, 680, 560);
    fill(205, 150, 95);
    ellipse(LT_CX - 30, LT_CY - 20, 560, 440);
  }

  fill(255, 245, 220, 150);
  for (int i = 0; i < ltGuia.length; i += 2) ellipse(ltGuia[i][0], ltGuia[i][1], 7, 7);

  stroke(252, 246, 235);
  strokeWeight(16);
  for (int j = 1; j < ltN; j++) if (dist(ltX[j], ltY[j], ltX[j - 1], ltY[j - 1]) < 60) line(ltX[j - 1], ltY[j - 1], ltX[j], ltY[j]);
  strokeWeight(1);
  noStroke();

  if (ltMuestraHasta == 0) {
    if (mousePressed && ltN < ltX.length) {
      if (ltN == 0 || dist(mouseX, mouseY, ltX[ltN - 1], ltY[ltN - 1]) > 4) { ltX[ltN] = mouseX; ltY[ltN] = mouseY; ltN++; }
    }
    if (millis() > ltFin) terminarFiguraLatte();
    dibujarJarraLatte();
  } else {
    fill(0, 0, 0, 150);
    rect(500, 820, 600, 56, 10);
    fill(255);
    textSize(26);
    textAlign(CENTER, CENTER);
    text(ltMsg, 800, 846);
    textAlign(LEFT, BASELINE);
    if (millis() > ltMuestraHasta) {
      ltFigura++;
      if (ltFigura >= figurasLatte()) {
        int p = ltSuma / figurasLatte();
        if (p >= 70) {
          finMJ(p, "Los clientes le toman foto al café antes de tomárselo.");
        } else if (p >= 40) {
          finMJ(p, "Nadie se queja. Algunos sonríen.");
        } else {
          finMJ(p, "Valentina dice que la práctica hace al barista.");
        }
        return;
      }
      nuevaFiguraLatte();
    }
  }
}

