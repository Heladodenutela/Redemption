int[] claseEstado = new int[CLASES.length];
int asistencias = 0;
int claseActual = -1;

// Clase que hay ahora en ese salón (o -1).
int claseAhoraEn(int mapa) {
  int m = minutoAhora();
  for (int c = 0; c < CLASES.length; c++) {
    if (int(CLASES[c][0]) == dia && mapaPorCodigo(CLASES[c][4]) == mapa) {
      if (m >= aMin(CLASES[c][1]) - 30 && m < aMin(CLASES[c][2])) return c;
    }
  }
  return -1;
}

// La próxima clase de hoy.
String proximaClase() {
  int m = minutoAhora();
  for (int c = 0; c < CLASES.length; c++) {
    if (int(CLASES[c][0]) == dia && aMin(CLASES[c][2]) > m && claseEstado[c] == 0)
      return CLASES[c][3] + " a las " + CLASES[c][1] + " en " + MAPA_NOMBRE[mapaPorCodigo(CLASES[c][4])];
  }
  return "hoy ya no tienes clases";
}

// E en los pupitres
void tomarClase() {
  int c = claseAhoraEn(mapaActual);
  if (c < 0) { aviso("No hay clase aquí ahora · próxima: " + proximaClase()); return; }
  if (claseEstado[c] != 0) { aviso("Ya pasaste por esta clase"); return; }
  int m = minutoAhora();
  if (m > aMin(CLASES[c][1]) + CLASE_TARDE_MIN) claseEstado[c] = 2; else claseEstado[c] = 1;
  claseActual = c;
  empezarMinijuegoClase();
}

// Termina la clase: suma notas, cuenta la falta si llegaste tarde y lanza las escenas de clase.
void terminarClase() {
  hecho("CLASE");
  int c = claseActual;
  int m = minutoAhora();
  int resto = max(0, aMin(CLASES[c][2]) - m);
  avanzarTiempo(resto);
  catMedios[CAT_ESTUDIAR] += resto * 2;
  boolean dormido = deudaSueno >= 3 || stats[ST_ENERGIA] < 15;
  int notas;
  if (dormido) notas = min(notasClase, 0); else notas = notasClase;
  cambiarStat(ST_NOTAS, notas);
  registrarNotaRamo(c, notas);
  asistencias++;
  terminarActividad();
  if (dormido) aviso("Te dormiste en " + CLASES[c][3] + ". " + nombreCorto(personaIndice(CLASES[c][5])) + " lo notó.");
  else if (claseEstado[c] == 2) aviso("Asististe a " + CLASES[c][3] + " (llegaste tarde)" + " · Notas +" + notas); else aviso("Asististe a " + CLASES[c][3] + "" + " · Notas +" + notas);

  asignarDialogo(personaIndice(CLASES[c][5]));
  partirPorLetra(CLASES[c][6], '|');
  String[] van = resPartirPorLetra;
  for (int i = 0; i < van.length; i++) asignarDialogo(personaIndice(van[i]));
}

// Dibuja la clase (el profe hablando y la barra de tiempo).
void dibujarClase() {
  int c = claseActual;
  int t = millis() - actividadInicio;
  ventana(450, 300, 700, 230, CLASES[c][3] + " · " + nombreCorto(personaIndice(CLASES[c][5])));
  fill(40);
  textSize(22);
  if (claseEstado[c] == 2) {
    text("Llegaste tarde, pero te sientas al fondo.", 490, 400);
  } else {
    text("Tomas apuntes hasta las " + CLASES[c][2] + ".", 490, 400);
  }
  fill(200);
  rect(490, 450, 620, 26, 8);
  fill(110, 160, 240);
  rect(490, 450, 620 * constrain(t / (float) CLASE_MS, 0, 1), 26, 8);
  if (t >= CLASE_MS) terminarClase();
}

// Las clases que pasaron sin que fueras son falta
void revisarClases() {
  int m = minutoAhora();
  for (int c = 0; c < CLASES.length; c++) {
    if (int(CLASES[c][0]) == dia && claseEstado[c] == 0 && m >= aMin(CLASES[c][2])) {
      claseEstado[c] = 3;
      faltas++;
      registrarFaltaRamo(c);
      int quita;
      if (dia == 1 && CLASES[c][3].equals("Física")) quita = 5; else quita = CLASE_FALTA_NOTAS;
      if (dia == 1 && CLASES[c][3].equals("Física")) sumarBandera("NOTADO", 1);
      perderEscenasClase(c);
      cambiarStat(ST_NOTAS, -quita);
      aviso("Faltaste a " + CLASES[c][3] + " · Notas −" + quita + " · faltas: " + faltas);
    }
  }
}

// ============================ DIÁLOGOS (tecla R) ============================
// Matriz dlg: una fila por persona, y en las columnas:
// [0] nombre
// [1] quién dice cada línea de la cadena: "0010" -> 0 lo dice el otro, 1 lo dices tú
// [2] lo que dice por defecto según tu estado (cuando ya no tiene nada nuevo)
// [3..] la cadena de diálogo disponible ahora
// La matriz no guarda todo el guion: asignarDialogo(f) la vuelve a llenar desde el código
// al empezar el día, después de cada respuesta y después de los eventos (clases, comidas...).
final int DLG_COLS = 40, DLG_INI = 3;
String[][] dlg;
String[][] dlgNodo;
String[][] dlgEfecto;
int[] dlgPos;
boolean dlgSoloDefault = false;
String[][] dichasHoy;
boolean[] charlaHoy;
final int MAX_NODOS = 600;
String[] nodosHechos = new String[MAX_NODOS];
String[] nodosAbiertos = new String[MAX_NODOS];
String[] elecciones = new String[MAX_NODOS];
String[] raicesArbol = new String[MAX_NODOS];
String[] encargosHoy = new String[60];
int dlgFila = -1, dlgNPC = -1;
boolean[] mesadaDada = new boolean[12];

// Arma los diálogos de toda la gente al empezar la partida.
void iniciarDialogos() {
  guionNPC();
  GUION = resGuionNPC;
  limpiarGuionV21();
  int n = DLG_PERSONA.length;
  dlg = new String[n][DLG_COLS];
  dlgNodo = new String[n][DLG_COLS];
  dlgEfecto = new String[n][DLG_COLS];
  dlgPos = new int[n];
  dichasHoy = new String[n][DLG_COLS * 2];
  charlaHoy = new boolean[n];
  amistad = new int[n];
  for (int f = 0; f < n; f++) {
    dlg[f][0] = DLG_PERSONA[f];
    dlg[f][1] = "";
    amistad[f] = AMISTAD_INICIAL;
  }
  if (!arbolUnido) { unirTablas(ARBOL, ARBOL_NUM); String[][] aux1 = resUnirTablas; unirTablas(aux1, ARBOL_EXTRA); ARBOL = resUnirTablas; arbolUnido = true; }

  String[] hijos = new String[ARBOL.length * 3];
  for (int k = 0; k < ARBOL.length; k++) {
    partirPorLetra(ARBOL[k][8], ' ');
    String[] s = resPartirPorLetra;
    for (int i = 0; i < s.length; i++) if (s[i].length() > 0) agregarTexto(hijos, s[i]);
  }
  for (int k = 0; k < ARBOL.length; k++) {
    String nd = ARBOL[k][1];
    boolean principal = !esMinuscula(letraEn(nd, nd.length() - 1));
    if ((principal || !tieneTexto(hijos, nd)) && !tieneTexto(raicesArbol, nd)) agregarTexto(raicesArbol, nd);
  }
}

// Elige lo que va a decir cada persona hoy.
void cargarDialogosDelDia() {
  if (dlg == null) return;
  for (int f = 0; f < DLG_PERSONA.length; f++) asignarDialogo(f);
}

// Cuántas líneas tiene el diálogo de hoy de una persona.
int largo(int f) {
  return dlg[f][1].length();
}

// Pone una línea al final de la cadena
void poner(int f, char quien, String texto, String nodo, String efecto) {
  if (texto == null) return;
  int n = largo(f);
  if (DLG_INI + n >= DLG_COLS) return;
  dlg[f][DLG_INI + n] = texto;
  dlgNodo[f][DLG_INI + n] = nodo;
  dlgEfecto[f][DLG_INI + n] = efecto;
  dlg[f][1] += quien;
}

// Mete una línea en la posición "pos" corriendo las de atrás
void insertar(int f, int pos, char quien, String texto, String nodo, String efecto) {
  int n = largo(f);
  if (DLG_INI + n >= DLG_COLS) return;
  for (int i = n; i > pos; i--) {
    dlg[f][DLG_INI + i] = dlg[f][DLG_INI + i - 1];
    dlgNodo[f][DLG_INI + i] = dlgNodo[f][DLG_INI + i - 1];
    dlgEfecto[f][DLG_INI + i] = dlgEfecto[f][DLG_INI + i - 1];
  }
  dlg[f][DLG_INI + pos] = texto;
  dlgNodo[f][DLG_INI + pos] = nodo;
  dlgEfecto[f][DLG_INI + pos] = efecto;
  dlg[f][1] = dlg[f][1].substring(0, pos) + quien + dlg[f][1].substring(pos);
}

// Agrega una línea normal al diálogo de una persona (si no la ha dicho hoy).
void agregarNormal(int f, String linea, String efecto) {
  if (linea == null || tieneTexto(dichasHoy[f], linea)) return;
  poner(f, '0', linea, null, efecto);
}

// Vuelve a llenar la cadena de una persona con lo que tiene para decir AHORA
void asignarDialogo(int f) {
  if (f < 0 || dlg == null) return;
  for (int c = 1; c < DLG_COLS; c++) { dlg[f][c] = null; dlgNodo[f][c] = null; dlgEfecto[f][c] = null; }
  dlg[f][1] = "";
  dlgPos[f] = 0;
  String p = DLG_PERSONA[f];
  String nivel = NIVELES[nivelSocial()];
  if (teEvita(f)) { String ev = lineaEvita(f); poner(f, '0', ev, null, null); dlg[f][2] = ev; return; }
  String nodo = nodoDisponible(f);
  int diario;
  if (nodo == null && !arbolHecho(f)) diario = diarioDisponible(f); else diario = -1;
  boolean yaSeConocen = charlaDeHoy(f) > 1 && (nodo != null || diario >= 0);
  boolean nodoConSaludo = nodo != null && empiezaCon(lineaNodo(nodo), "Saludo por nivel");

  if (!nodoConSaludo && !yaSeConocen) agregarNormal(f, buscarLinea(p, "Saludo · " + nivel), null);
  if (yaSeConocen) agregarVariantesHoy(f); else agregarVariantes(f);
  reprocheVisto(f);

  agregarNormal(f, buscarLinea(p, "Día " + dia + " · reencuentro · " + estadoAmistad(amistad[f])), null);

  agregarNormal(f, lineaSueno(p), null);

  for (int k = 0; k < GUION.length; k++) {
    if (GUION[k][0].equals(p) && empiezaCon(GUION[k][1], "Día " + dia + " · casa")) {
      String ef;
      if (terminaCon(GUION[k][1], "desayuno") && (dia == 1 || dia == 8)) ef = "MESADA"; else ef = null;
      agregarNormal(f, GUION[k][2], ef);
    }
  }

  String delDia = buscarLinea(p, "Día " + dia + " · línea del día");
  if (delDia != null && nodo != null && seParecen(delDia, resolverLinea(f, lineaNodo(nodo)))) delDia = null;
  if (delDia != null && repiteTemaV21(f, delDia, nodo, diario)) delDia = null;
  agregarNormal(f, delDia, null);

  for (int k = 0; k < GUION.length; k++) {
    String c = GUION[k][1];
    if (GUION[k][0].equals(p) && empiezaCon(c, "Día " + dia + " · interacción extra · ")) {
      if (condicionExtra(c.substring(ultimaPosicionDe(c, " · ") + 3))) agregarNormal(f, GUION[k][2], null);
    }
  }

  for (int k = 0; k < GUION.length; k++) if (GUION[k][0].equals(p) && empiezaCon(GUION[k][1], "Fondo")) agregarNormal(f, GUION[k][2], null);
  if (tieneEncargo(p) && !tieneTexto(encargosHoy, p)) poner(f, '0', "¿Me ayudas con algo?", "E:" + p, null);

  platicaCorta(f, nodo != null || diario >= 0 || conversaronHoy(f));

  if (nodo != null) poner(f, '0', resolverLinea(f, lineaNodo(nodo)), "A:" + nodo, null);
  else if (diario >= 0) poner(f, '0', dNodoLinea[diario], "D:" + diario, null);

  dlg[f][2] = lineaDefault(f);
}

// ¿Dos líneas dicen casi lo mismo? (comparten un buen pedazo del principio)
boolean seParecen(String a, String b) {
  a = sinComillas(a);
  b = sinComillas(b);
  for (int i = 0; i + 18 <= b.length(); i += 6) if (posicionDe(a, b.substring(i, i + 18)) >= 0) return true;
  return false;
}

// Lo que dice una persona cuando no tiene nada especial (según la amistad y el día).
String lineaDefault(int f) {
  String p = DLG_PERSONA[f];
  if (amistad[f] < 35) return reaccion(f, -1);
  String d = buscarLinea(p, "Día " + dia + " · línea del día");
  if (d != null) return d;
  String s = buscarLinea(p, "Saludo · " + NIVELES[nivelSocial()]);
  if (s != null) return s;
  return reaccion(f, 0);
}

// "Si te reíste", "Cualquiera", "Si NOTADO"... lo que no se entiende se toma como falso
boolean condicionExtra(String c) {
  if (empiezaCon(c, "Cualquiera") || empiezaCon(c, "Primera vez")) return true;
  if (empiezaCon(c, "Si te reíste")) return bandera("RISA_SOFÍA") > 0;
  if (empiezaCon(c, "Si la cubriste") || empiezaCon(c, "Si cubriste")) return tieneTexto(elecciones, "S1:0");
  if (empiezaCon(c, "Si compraste")) return numInv > 0;
  partirPorLetra(c, ' ');
  String[] p = resPartirPorLetra;
  for (int i = 0; i < p.length; i++) if (p[i].length() > 3 && p[i].equals(p[i].toUpperCase()) && bandera(p[i]) > 0) return true;
  return false;
}

// ---- árbol ----
// Texto de un nodo del árbol de diálogo.
String lineaNodo(String nodo) {
  for (int k = 0; k < ARBOL.length; k++) if (ARBOL[k][1].equals(nodo)) return ARBOL[k][4];
  return "";
}

// Día en que sale un nodo del árbol.
int diaNodo(String nodo) {
  for (int k = 0; k < ARBOL.length; k++) if (ARBOL[k][1].equals(nodo)) return int(ARBOL[k][2]);
  return -1;
}

// Condición de cuándo sale un nodo del árbol.
String cuandoNodo(String nodo) {
  for (int k = 0; k < ARBOL.length; k++) if (ARBOL[k][1].equals(nodo)) return ARBOL[k][3];
  return "";
}

// El primer nodo de esta persona que se puede usar hoy
String nodoDisponible(int f) {
  String p = DLG_PERSONA[f];
  String visto = "";
  for (int k = 0; k < ARBOL.length; k++) {
    String n = ARBOL[k][1];
    if (ARBOL[k][0].equals(p) && !n.equals(visto) && !tieneTexto(nodosHechos, n) && !esNodoDeClase(n)) {
      visto = n;
      int d = int(ARBOL[k][2]);
      String cuando = ARBOL[k][3];
      boolean hoy = d == dia || d == 0 || posicionDe(cuando, "o D" + dia) >= 0;
      if (tieneTexto(nodosAbiertos, n)) {
        if ((hoy || (d > 0 && d < dia)) && condicionEvaluable(cuando, f)) return n;
      } else if (tieneTexto(raicesArbol, n) && hoy && condicionArbol(cuando, n, f)) return n;
    }
  }
  return null;
}

// Solo las condiciones que el juego entiende (para nodos que ya desbloqueaste)
boolean condicionEvaluable(String ctx, int f) {
  int i = posicionDe(ctx, "Am ≥ ");
  if (i >= 0) {
    int j = i + 5, n = 0;
    while (j < ctx.length() && letraEn(ctx, j) >= '0' && letraEn(ctx, j) <= '9') { n = n * 10 + (letraEn(ctx, j) - '0'); j++; }
    if (amistad[f] < n) return false;
  }
  if (posicionDe(ctx, "sin número") >= 0 && tieneNumero(f)) return false;
  int ich = posicionDe(ctx, "charlas ≥ ");
  if (ich >= 0 && charlaDeHoy(f) < numeroTras(ctx, ich + 10)) return false;
  i = posicionDe(ctx, "requiere ");
  if (i >= 0) {
    int j = i + 9;
    String b = "";
    while (j < ctx.length() && (esMayuscula(letraEn(ctx, j)) || letraEn(ctx, j) == '_')) { b += letraEn(ctx, j); j++; }
    if (b.length() > 0 && bandera(b) <= 0) return false;
  }
  return true;
}

// Para las raíces: además, sin condiciones raras que no se pueden revisar
boolean condicionArbol(String ctx, String nodo, int f) {
  if (!condicionEvaluable(ctx, f)) return false;
  String resto = ctx;
  int i = posicionDe(resto, "solo si eres ");
  if (i >= 0) {
    if (posicionDe(resto, NIVELES[nivelSocial()]) < 0) return false;
    resto = resto.substring(0, i);
  }
  boolean evaluable = posicionDe(ctx, "Am ≥ ") >= 0 || posicionDe(ctx, "requiere ") >= 0 || i >= 0;
  boolean otra = posicionDe(resto, " si ") >= 0 || posicionDe(resto, "(si") >= 0 || posicionDe(resto, "Día siguiente") >= 0 || posicionDe(resto, "Después de") >= 0;
  return evaluable || !otra;
}

// "Saludo por nivel + “¿Qué te sirvo?”" -> el saludo de verdad + la frase; "Amiga: “..” Molesta: “..”" -> la que toca
String resolverLinea(int f, String t) {
  String p = DLG_PERSONA[f];
  String nivel = NIVELES[nivelSocial()];
  String saludo = buscarLinea(p, "Saludo · " + nivel);
  if (empiezaCon(t, "Saludo por nivel")) {
    int i = posicionDe(t, "+");
    String resto;
    if (i >= 0) resto = sinComillas(quitarBordes(t.substring(i + 1))); else resto = "";
    if (saludo == null) return resto;
    if (resto.length() == 0 || posicionDe(saludo, resto) >= 0 || seParecen(saludo, resto)) return sinComillas(saludo);
    return sinComillas(saludo) + " " + resto;
  }
  if (posicionDe(t, "según nivel") >= 0 || posicionDe(t, "por nivel") >= 0) {
    String clave;
    if (empiezaCon(t, "Invitación")) {
      clave = "invitación";
    } else {
      if (posicionDe(t, "fiesta") >= 0) clave = "en la fiesta"; else clave = null;
    }
    if (clave != null) {
      for (int k = 0; k < GUION.length; k++) {
        String c = GUION[k][1];
        if (GUION[k][0].equals(p) && empiezaCon(c, "Día " + dia) && posicionDe(c, clave) >= 0 && terminaCon(c, nivel)) return GUION[k][2];
      }
    }
    if (saludo != null) return saludo; else return t;
  }

  variantesConEtiqueta(t);
  String[][] v = resVariantesConEtiqueta;
  int nv = tamFilas(v);
  if (nv >= 2) {
    for (int i = 0; i < nv; i++) if (varianteVale(v[i][0], f)) return v[i][1];
    return v[nv - 1][1];
  }
  if (nv == 1) return v[0][1];
  return t;
}

// ¿Esta variante de diálogo (amigo, conocido, molesto...) aplica con esta persona?
boolean varianteVale(String et, int f) {
  String e = et.toLowerCase();
  if (posicionDe(e, "amig") >= 0) return amistad[f] >= 60;
  if (posicionDe(e, "conocid") >= 0) return amistad[f] >= 35 && amistad[f] < 60;
  if (posicionDe(e, "molest") >= 0) return amistad[f] < 35;
  if (posicionDe(e, "nota alta") >= 0) return stats[ST_NOTAS] >= 60;
  if (posicionDe(e, "nota baja") >= 0) return true;
  if (posicionDe(e, "si no") >= 0 || posicionDe(e, "perd") >= 0 || posicionDe(e, "derrota") >= 0 || posicionDe(e, "sin deuda") >= 0) return true;
  if (posicionDe(e, "fuiste") >= 0 || posicionDe(e, "viniste") >= 0) return bandera("FUE_FIESTA") > 0;
  if (posicionDe(e, "gan") >= 0 || posicionDe(e, "victoria") >= 0) return bandera("VICTORIA") > 0;
  if (posicionDe(e, "con deuda") >= 0) return bandera("DEUDA_GIL") > 0;
  if (posicionDe(e, "≥") >= 0) return amistad[f] >= int(quitarBordesProcessing(e.substring(posicionDe(e, "≥") + 1)));
  if (posicionDe(e, "<") >= 0) return amistad[f] < int(quitarBordesProcessing(e.substring(posicionDe(e, "<") + 1)));
  return false;
}

// ---- las opciones de una pregunta: { texto, efecto, siguiente } ----
// ¿Se puede elegir esta respuesta? (algunas piden cierta amistad o algo que ya pasó).
boolean opcionVale(String cond, int f) {
  if (cond == null || cond.equals("")) return true;
  if (empiezaCon(cond, "AM>=")) return amistad[f] >= int(cond.substring(4));
  if (empiezaCon(cond, "AM<")) return amistad[f] < int(cond.substring(3));
  if (empiezaCon(cond, "!F:")) return bandera(cond.substring(3)) <= 0;
  if (empiezaCon(cond, "F:")) return bandera(cond.substring(2)) > 0;
  return true;
}

String[][] resOpcionesDe;

// Deja las opciones como filas { texto, efecto, siguiente } (hasta la primera fila null; usar tamFilas)
// Deja el resultado en resOpcionesDe.
void opcionesDe(String clave, int f) {
  String[][] l = new String[8][];
  if (clave == null) { resOpcionesDe = l; return; }
  if (empiezaCon(clave, "A:")) {
    String n = clave.substring(2);
    for (int k = 0; k < ARBOL.length; k++) {
      if (ARBOL[k][1].equals(n) && !ARBOL[k][5].equals("")) {
        if (opcionVale(ARBOL[k][6], f)) agregarFila(l, new String[] { ARBOL[k][5], ARBOL[k][7], ARBOL[k][8] });
      }
    }
  } else if (empiezaCon(clave, "C:")) {
    String[] c = CASA[int(clave.substring(2)) - 1];
    for (int i = 0; i < 3; i++) if (!c[3 + 2 * i].equals("")) agregarFila(l, new String[] { c[3 + 2 * i], c[4 + 2 * i], "" });
  } else if (empiezaCon(clave, "E:")) {
    String p = clave.substring(2);
    for (int k = 0; k < ENCARGOS.length; k++) {
      if (ENCARGOS[k][0].equals(p)) agregarFila(l, new String[] { "Claro: " + ENCARGOS[k][1].toLowerCase() + ".", ENCARGOS[k][2], "ENCARGO" });
    }
    agregarFila(l, new String[] { "Ahora no puedo, perdón.", "0", "" });
  } else if (empiezaCon(clave, "D:")) {
    opcionesDiario(int(clave.substring(2)), l);
  }
  resOpcionesDe = l;
}

// Clave de la pregunta de la línea actual (null si no hay que elegir)
String nodoActual() {
  if (dlgFila < 0 || dlgSoloDefault || dlgPos[dlgFila] >= largo(dlgFila)) return null;
  String n = dlgNodo[dlgFila][DLG_INI + dlgPos[dlgFila]];
  boolean aux1;
  if (n == null) {
    aux1 = true;
  } else {
    opcionesDe(n, dlgFila);
    String[][] aux2 = resOpcionesDe;
    aux1 = tamFilas(aux2) == 0;
  }
  if (aux1) return null;
  return n;
}

