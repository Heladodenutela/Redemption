// ¿Esta persona se presenta en su primer diálogo diario?
boolean sePresentaEnDiario(int f) {
  for (int i = 0; i < SE_PRESENTAN.length; i++) if (SE_PRESENTAN[i].equals(DLG_PERSONA[f])) return true;
  return false;
}

// El diálogo diario que toca hoy con esta persona (-1 si no hay)
int diarioDisponible(int f) {
  if (diarioHechos == null || dNodoP == null || f < 0) return -1;
  if (diarioDia[f] == dia || amistad[f] < 20) return -1;

  for (int i = 0; i < dN; i++) {
    if (dNodoP[i] == f && !dNodoHito[i].equals("") && bandera("DH_" + dNodoId[i]) <= 0 && hitoAmistad(f, dNodoHito[i]) && cumple(dNodoCond[i])) {
      return i;
    }
  }
  int k = diarioHechos[f] + 1;
  if (k == 1 && charlasCon(f) > 0 && sePresentaEnDiario(f)) k = 2;
  for (int i = 0; i < dN; i++) if (dNodoP[i] == f && dNodoN[i] == k && dNodoHito[i].equals("") && cumple(dNodoCond[i])) return i;
  return -1;
}

// Cuántos diálogos diarios tiene una persona.
int diariosDe(int f) {
  int m = 0;
  for (int i = 0; i < dN; i++) if (dNodoP[i] == f) m = max(m, dNodoN[i]);
  return m;
}

// Respuestas posibles de un diálogo diario (las que cumplen su condición).
void opcionesDiario(int nodo, String[][] l) {
  if (nodo < 0 || nodo >= dN) return;
  for (int i = dOpIni[nodo]; i < dOpFin[nodo]; i++) if (cumple(dOpCond[i])) agregarFila(l, new String[] { dOpTexto[i], dOpEf[i], str(i) });
}

// Elige una respuesta en un diálogo diario y aplica sus efectos.
boolean elegirOpcionDiario(String clave, int i) {
  int f = dlgFila;
  opcionesDe(clave, f);
  String[][] ops = resOpcionesDe;
  if (i < 0 || i >= tamFilas(ops)) return true;
  String[] o = ops[i];
  int pos = dlgPos[f];
  dlgNodo[f][DLG_INI + pos] = null;
  int nodo = int(clave.substring(2));
  int op = int(o[2]);
  if (dNodoHito[nodo].equals("")) diarioHechos[f] = dNodoN[nodo];
  else sumarBandera("DH_" + dNodoId[nodo], 1);
  diarioDia[f] = dia;
  sumarBandera("DX_" + dNodoId[nodo], op - dOpIni[nodo] + 1);
  String res = aplicarEfectosV20(o[1], f);
  int ins = pos + 1;
  insertar(f, ins++, '1', o[0], null, null);
  partir(dOpReac[op], "//");
  String[] r = resPartir;
  for (int k = 0; k < r.length; k++) if (quitarBordesProcessing(r[k]).length() > 0) insertar(f, ins++, '0', quitarBordesProcessing(r[k]), null, null);
  dlgPos[f] = pos + 1;
  if (!res.equals("")) aviso(res);
  return true;
}

