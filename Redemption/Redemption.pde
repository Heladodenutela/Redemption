// Rutas: Sofía, Laura, Marta, Nadia y Valentina.
// 0 nada, 1 coqueteo, 2 cita, 3 pareja, -1 bloqueada para siempre
// Si coqueteas con dos a la vez, a los dos días sale el chisme: se enteran y esas rutas se bloquean.
String[] ROM_PERSONA = { "Sofía", "Laura", "Marta", "Nadia", "Valentina" };
int[] romance = new int[5];
int[] romancePuntos = new int[5];
int dobleDesde = -1;
boolean chismeRomanceSalio = false;

// Número de una persona en la tabla de romances (o -1).
int romIndice(String p) {
  for (int i = 0; i < ROM_PERSONA.length; i++) if (ROM_PERSONA[i].equals(p) || empiezaCon(p, ROM_PERSONA[i])) return i;
  return -1;
}

// Etapa del romance con una persona (0 nada, -1 se acabó, 1 a 3 avanza).
int nivelRomance(String p) {
  int i = romIndice(p);
  if (i < 0) return 0; else return romance[i];
}

// Sube la ruta (nunca baja con esto); revisa si estás con dos a la vez
void subirRomance(String p, int nivel) {
  int i = romIndice(p);
  if (i < 0 || romance[i] < 0) return;
  if (romance[i] >= nivel) return;
  romance[i] = nivel;
  if (nivel >= 3) sumarBandera("PAREJA", 1);
  int activas = 0;
  for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 1) activas++;
  if (activas >= 2 && dobleDesde < 0) {
    dobleDesde = dia;
    aviso("(Estás coqueteando con dos personas a la vez. En la U todo se sabe...)");
  }
}

// Termina el romance con una persona (por chismes o malas decisiones).
void bloquearRomance(String p) {
  int i = romIndice(p);
  if (i < 0) return;
  romance[i] = -1;
  sumarBandera("ROM_BLOQUEADA_" + ROM_PERSONA[i].toUpperCase(), 1);
}

// Puntos ocultos de romance que suma el guion ("Rom +15").
void puntosRomance(int f, int v) {
  if (f < 0) return;
  int i = romIndice(DLG_PERSONA[f]);
  if (i < 0 || romance[i] < 0) return;
  romancePuntos[i] += v;
  if (romancePuntos[i] >= 15 && romance[i] < 1) subirRomance(ROM_PERSONA[i], 1);
}

// El chisme: si empiezas algo con dos personas, al día siguiente sale el chisme:
// amistad -30 y, cuando lees su mensaje, te borra el número y no te vuelve a hablar.
void revisarChismeRomance() {
  if (chismeRomanceSalio || dobleDesde < 0 || dia < dobleDesde + 1) return;
  int activas = 0;
  for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 1) activas++;
  if (activas < 2) { dobleDesde = -1; return; }
  chismeRomanceSalio = true;
  String nombres = "";
  for (int k = 0; k < ROM_PERSONA.length; k++) {
    if (romance[k] >= 1) {
      if (nombres.equals("")) nombres += "" + ROM_PERSONA[k]; else nombres += " y " + ROM_PERSONA[k];
      int f = personaIndice(ROM_PERSONA[k]);
      bloquearRomance(ROM_PERSONA[k]);
      if (f >= 0) {
        cambiarAmistad(f, -30);
        sumarBandera("ENTERADA_" + f, 1);
  
        if (esContacto(f)) agregarMensaje(nombreChat(f), '1', MSG_ENTERADA[k]);
        else bloquear(f);
      }
    }
  }
  sumarBandera("CHISME_ROMANCE", 1);
  aviso("Confesiones Aurora: \"Alguien anda saliendo con " + nombres + " al tiempo...\"");
}

