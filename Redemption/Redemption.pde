// Tiempo desde el cuadro anterior para los minijuegos de las escenas (1.0 = un cuadro a 60 FPS).
float dt20() {
  int ahora = millis();
  float dt = (ahora - mj20Ultimo) / 16.67;
  mj20Ultimo = ahora;
  return constrain(dt, 0, 3);
}

// Segundos desde que empezó el minijuego.
int segundosMJ() {
  return (millis() - mj20Inicio) / 1000;
}

// Arranca el minijuego; false si no existe (la escena sigue como si nada)
boolean iniciarMinijuegoV20(String cod) {
  mj20 = cod;
  mj20Ultimo = millis();
  mj20Inicio = millis();
  mj20HoraInicio = horagp;
  if (cel != 0) cel = 0;
  mjExterno = false;
  boolean ok = iniciarMJ(cod);
  if (!ok) { mj20 = ""; return false; }
  if (!mjExterno) empezarActividad(ACT_MJ20);
  return true;
}

