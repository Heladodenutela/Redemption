// ============================ ESCRIBIR EN EL CHAT: barra + botón de enviar ============================
// Abajo del chat hay una barra como la de WhatsApp. Las opciones solo salen al tocar la barra o el botón
// de enviar; al elegir una, se manda y se cierran. Botón: extras/interfaz/1_celular/boton_enviar.png (56x56).
final float BARRA_ENV = 74;
boolean redactando = false;
int redactandoChat = -1;
PImage ui_btnEnviar = null;
boolean btnEnviarBuscado = false;

// ¿El chat abierto tiene un mensaje esperando respuesta?
boolean hayQueResponder() {
  return chatAbierto >= 0 && msgPendiente[chatAbierto] >= 0;
}

// Dibuja la barra para escribir o responder abajo del chat.
void dibujarRedactar() {
  if (cel != 6 || chatAbierto < 0) return;
  if (redactandoChat != chatAbierto) { redactando = false; redactandoChat = chatAbierto; }
  boolean resp = hayQueResponder(), esc = puedeEscribirV21();
  if (!resp && !esc) redactando = false;
  if (redactando) {
    if (resp) dibujarRespuestasChat();
    else dibujarEscribirV21();
  }
  dibujarBarraEnviar(resp, esc);
}

// Dibuja la barra de enviar con el botón.
void dibujarBarraEnviar(boolean resp, boolean esc) {
  if (!btnEnviarBuscado) { btnEnviarBuscado = true; ui_btnEnviar = cargarSiExiste("extras/interfaz/1_celular/boton_enviar.png"); }
  float y = celY2 - BARRA_ENV;
  boolean activo = resp || esc;
  noStroke();
  fill(238, 236, 232);
  rect(celX1, y, celX2 - celX1, BARRA_ENV);

  float fx = celX1 + 12, fw = celX2 - celX1 - 92;
  boolean enc = activo && enBoton(fx, y + 12, fw, BARRA_ENV - 24);
  if (enc) fill(color(250)); else fill(color(255));
  rect(fx, y + 12, fw, BARRA_ENV - 24, 25);
  String quien;
  if (msg[chatAbierto][0] == null) quien = ""; else quien = msg[chatAbierto][0];
  String t;
  if (redactando) t = "Elige qué responder...";
  else if (resp) t = "Responder a " + quien + "...";
  else if (esc) t = "Escribe un mensaje...";
  else if (escribiendoV21(chatAbierto)) t = quien + " está escribiendo...";
  else if (personaDeChatV21() >= 0) { if (bandera("ESC_" + personaDeChatV21() + "_D" + dia) > 0) t = "Ya le escribiste hoy."; else t = "Ahora no se te ocurre qué escribirle."; }
  else t = "Solo puedes leer este chat.";
  if (activo) fill(color(120)); else fill(color(175));
  textSize(18);
  textAlign(LEFT, CENTER);
  text(recortarA(t, fw - 36), fx + 20, y + BARRA_ENV / 2 - 1);
  if (resp && !redactando) {
    fill(37, 180, 100);
    ellipse(fx + fw - 22, y + BARRA_ENV / 2, 12, 12);
  }

  float bx = celX2 - 44, by = y + BARRA_ENV / 2;
  boolean encB = activo && dist(mouseX, mouseY, bx, by) < 28;
  if (hay(ui_btnEnviar) && !redactando) {
    if (!activo) tint(255, 110);
    image(ui_btnEnviar, bx - 28, by - 28, 56, 56);
    noTint();
  } else {
    if (!activo) fill(color(170)); else if (encB) fill(color(30, 160, 90)); else fill(color(37, 180, 100));
    ellipse(bx, by, 56, 56);
    fill(255);
    if (redactando) {
      stroke(255);
      strokeWeight(4);
      line(bx - 9, by - 9, bx + 9, by + 9);
      line(bx + 9, by - 9, bx - 9, by + 9);
      noStroke();
      strokeWeight(1);
    } else {
      triangle(bx - 13, by - 12, bx + 15, by, bx - 13, by + 12);
      if (!activo) fill(color(170)); else if (encB) fill(color(30, 160, 90)); else fill(color(37, 180, 100));
      triangle(bx - 13, by - 3, bx - 4, by, bx - 13, by + 3);
    }
  }
  textAlign(LEFT, BASELINE);
}

// Click en la barra de escribir o enviar.
boolean clickRedactar() {
  if (cel != 6 || chatAbierto < 0) return false;
  boolean resp = hayQueResponder(), esc = puedeEscribirV21();
  float y = celY2 - BARRA_ENV;
  if (mouseX > celX1 && mouseX < celX2 && mouseY > y && mouseY < celY2) {
    if (resp || esc) redactando = !redactando;
    else if (personaDeChatV21() >= 0 && bandera("ESC_" + personaDeChatV21() + "_D" + dia) > 0) aviso("Ya le escribiste hoy. Mañana puedes volver a escribirle.");
    return true;
  }
  if (!redactando) return false;
  boolean tocado;
  if (resp) tocado = clickRespuestaChat(); else tocado = clickEscribirV21();
  if (resp && !hayQueResponder()) redactando = false;
  if (!resp && esc && !puedeEscribirV21()) redactando = false;
  if (!tocado && mouseY > celY1 + MSG_HEAD) { redactando = false; return true; }
  return tocado;
}

