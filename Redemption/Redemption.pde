}

// 0 abajo, 1 arriba, 2 izquierda, 3 derecha
int dirDeAngulo(float a) {
  float c = cos(a), s = sin(a);
  if (abs(c) >= abs(s)) { if (c > 0) return 3; else return 2; }
  if (s > 0) return 0; else return 1;
}

// Dibuja la cancha de fútbol, los jugadores, el balón y el marcador.
