        boolean alguno = false;
        for (int i = 0; i < nodos.length; i++) if (nodoValidoEscena(nodos[i], personaDeNodo(nodos[i]))) alguno = true;
        if (alguno) {
          cinCola = nodos;
          cinPos = -1;
          cinDeClase = false;
