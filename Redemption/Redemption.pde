// Número de mapa a partir de su código ('U3', 'P2'...).
int mapaPorCodigo(String c) {
  for (int m = 0; m < MAPA_COD.length; m++) if (MAPA_COD[m].equals(c)) return m;
  return -1;
}

// Nombre de la hoja de sprites de una persona.
String hojaDePersona(int f) {
  for (int k = 0; k < HOJA_PERSONA.length; k++) if (HOJA_PERSONA[k][1].equals(DLG_PERSONA[f])) return HOJA_PERSONA[k][0];
  return "";
}

// Arma la agenda de toda la gente (dónde está cada uno cada día y hora), con las clases incluidas.
void iniciarAgendaNPC() {
  agendaFilas = new String[AGENDA.length + CLASES.length * 8 + 300][];

  for (int c = 0; c < CLASES.length; c++) {
    String[] cl = CLASES[c];
    agregarFila(agendaFilas, new String[] { cl[5], cl[0], cl[1], cl[2], cl[4], "1350", "0", "0" });
    partirPorLetra(cl[6], '|');
    String[] van = resPartirPorLetra;
    for (int i = 0; i < van.length; i++) agregarFila(agendaFilas, new String[] { van[i], cl[0], cl[1], cl[2], cl[4], str(260 + i * 230), "0", "0" });
  }
  for (int k = 0; k < AGENDA.length; k++) agregarFila(agendaFilas, AGENDA[k]);
  agregarAgendaV20();
  agregarAgendaFiesta();
  agendaNPC = new int[DLG_PERSONA.length];
  for (int f = 0; f < agendaNPC.length; f++) agendaNPC[f] = -1;
  for (int i = 0; i < tamFilas(agendaFilas); i++) {
    int f = personaIndice(agendaFilas[i][0]);
    if (f >= 0 && agendaNPC[f] < 0) {
      int k = -1;
      for (int n = 0; n < numNPC; n++) {
        if (npcPersona[n] == f) {
          if (k < 0) k = n;
          else npcMapa[n] = -1;
        }
      }
      if (k < 0 && !hojaDePersona(f).equals("")) { npcQuieto(hojaDePersona(f), -1, 0, 0); k = numNPC - 1; }
      if (k >= 0) {
        agendaNPC[f] = k;
        if (npcVel[k] > 0) npcVelBase[k] = npcVel[k]; else npcVelBase[k] = 2;
        if (npcFilaIzq[k] == 0 && npcFilaDer[k] == 0) { npcFilaIzq[k] = 4; npcFilaDer[k] = 5; }
        npcMapa[k] = -1;
      }
    }
  }
  actualizarAgenda();
}

String[] resFilaAgendaAhora;

// Fila de la agenda que le toca a una persona ahora mismo.
// Deja el resultado en resFilaAgendaAhora.
void filaAgendaAhora(String persona) {
  int m = minutoAhora();

  int total = tamFilas(agendaFilas);
  for (int vuelta = 0; vuelta < 2; vuelta++) {
    for (int i = 0; i < total; i++) {
      String[] a = agendaFilas[i];
      if (a[0].equals(persona) && !(vuelta == 0 && !filaDeUnDia(a[1]))) {
        String[] h = { "", "", a[1], a[2], a[3] };
        if (ventanaAbierta(h, dia, m)) { resFilaAgendaAhora = a; return; }
      }
    }
  }
  resFilaAgendaAhora = null;
}

// Mueve a cada persona a donde le toca a esta hora (se llama cada intervalo del reloj)
void actualizarAgenda() {
  if (agendaNPC == null) return;
  for (int f = 0; f < agendaNPC.length; f++) {
    int k = agendaNPC[f];
    if (k >= 0 && !((actividad == ACT_DIALOGO || actividad == ACT_REACCION) && (k == dlgNPC || k == reaccionNPC))) {
      filaEventoAhora(DLG_PERSONA[f]);
      String[] a = resFilaEventoAhora;
      if (a == null) { filaAgendaAhora(DLG_PERSONA[f]); a = resFilaAgendaAhora; }
      if (a != null && ausentePorLluvia(DLG_PERSONA[f])) a = null;
      if (a == null) { npcMapa[k] = -1; npcFilaAgenda[k] = null; } else {
        if (npcFilaAgenda[k] != a) {
          npcFilaAgenda[k] = a;
          npcMapa[k] = mapaPorCodigo(a[4]);
          float x = float(a[5]), x2 = float(a[7]);
          npcX[k] = x;
          npcFila[k] = int(a[6]);
          if (x2 > 0) { npcMin[k] = min(x, x2); npcMax[k] = max(x, x2); npcVel[k] = npcVelBase[k]; }
          else npcVel[k] = 0;
        }
      }
    }
  }
}

// ¿El NPC está en algún mapa ahora?
boolean npcPresente(int k) {
  return npcMapa[k] >= 0;
}

