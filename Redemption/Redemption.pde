// ============================ WHATSAPP: MENSAJES QUE SE ARMAN EN EL JUEGO ============================
// Las charlas y lo que tú escribes van en MSG_DIN (mismo formato que MSG_PROG).
// msgPendiente >= 10000 señala una fila de MSG_DIN.
String[][] MSG_DIN = new String[600][];

String[] resFilaMsg;

// Fila de un mensaje programado o dinámico (queda en resFilaMsg).
void filaMsg(int r) {
  if (r >= 10000) { resFilaMsg = MSG_DIN[r - 10000]; return; } else { resFilaMsg = MSG_PROG[r]; return; }
}

// Parte de una respuesta antes del '»' (lo que se escribe en el chat).
String textoAntesDeFlecha(String op) {
  int i = posicionDe(op, "»");
  if (i >= 0) return op.substring(0, i); else return op;
}

// Fila de un chat si ya existe (o -1, sin crearlo).
int filaChatSiExiste(String nombre) {
  for (int f = 0; f < MSG_FILAS; f++) if (msg[f][0] != null && msg[f][0].equals(nombre)) return f;
  return -1;
}

// Persona del chat que está abierto.
int personaDeChatAbierto() {
  if (chatAbierto < 0 || msg[chatAbierto][0] == null) return -1;
  return personaDelChat(msg[chatAbierto][0]);
}

