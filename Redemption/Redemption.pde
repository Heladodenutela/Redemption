// ============================ HORARIO: TUS PROPIOS BLOQUES ============================
// ACTIVIDADES_PROPIAS es el vector de actividades que puedes poner (nombre y color).
// propioAct[día][hora] guarda cuál pusiste (-1 = nada): es una matriz aparte de la del horario,
// así actualizarHorario() la puede borrar y volver a armar sin perder lo tuyo. Clases y eventos
// tienen prioridad: si chocan, en esa hora se ve la clase.
String[][] ACTIVIDADES_PROPIAS = {
  {"Gimnasio", "93C47D"}, {"Estudiar", "8E7CC3"}, {"Biblioteca", "B4A7D6"}, {"Correr en el parque", "6AA84F"},
  {"Natación", "6FA8DC"}, {"Fútbol", "38761D"}, {"Familia", "F6B26B"}, {"Grano Café", "E69138"},
  {"Descansar", "A2C4C9"}, {"Dormir temprano", "674EA7"}, {"Comer", "FFD966"}, {"Redes", "C27BA0"}
};
int[][] propioAct = new int[11][24];
boolean propioIniciado = false;
boolean horEditor = false;
int horAct = 0, horHora = 7, horDur = 1;
boolean[] horDias = new boolean[11];

// Deja vacío tu horario propio (lo que planeas hacer cada hora).
void iniciarPropios() {
  if (propioIniciado) return;
  propioIniciado = true;
  for (int d = 0; d < 11; d++) for (int h = 0; h < 24; h++) propioAct[d][h] = -1;
}

// Color de una actividad propia del horario.
int colorActividad(int a) {
  return unhex("FF" + ACTIVIDADES_PROPIAS[a][1]);
}

// La llama actualizarHorario() al final: tus bloques van en las horas que quedaron libres
void ponerPropiosEnHorario() {
  iniciarPropios();
  for (int d = 1; d <= 10; d++) {
    for (int h = 0; h < 24; h++) {
      int a = propioAct[d][h];
      if (a >= 0 && agendaNombre[d][h] == null) {
        agendaNombre[d][h] = ACTIVIDADES_PROPIAS[a][0];
        agendaColor[d][h] = colorActividad(a);
      }
    }
  }
}

// ¿Esa hora del horario la pusiste tú?
boolean esBloquePropio(int d, int h) {
  if (!propioIniciado || d < 1 || d > 10 || h < 0 || h > 23) return false;
  int a = propioAct[d][h];
  return a >= 0 && agendaNombre[d][h] != null && agendaNombre[d][h].equals(ACTIVIDADES_PROPIAS[a][0]);
}

// Pone en la agenda los bloques que planeaste (avisa si chocan con clases).
void agregarBloquesPropios() {
  iniciarPropios();
  int puestos = 0, chocan = 0;
  String dias = "";
  for (int d = 1; d <= 10; d++) {
    if (horDias[d]) {
      if (!dias.equals("")) dias = dias + ", ";
      dias = dias + "D" + d;
      for (int h = horHora; h < horHora + horDur && h < 24; h++) {
        propioAct[d][h] = horAct;
        puestos++;
      }
    }
  }
  if (puestos == 0) { aviso("Elige por lo menos un día"); return; }
  actualizarHorario();
  for (int d = 1; d <= 10; d++) {
    if (horDias[d]) {
      for (int h = horHora; h < horHora + horDur && h < 24; h++) if (!esBloquePropio(d, h)) chocan++;
    }
  }
  String txt = ACTIVIDADES_PROPIAS[horAct][0] + " · " + horHora + ":00 a " + min(24, horHora + horDur) + ":00 · " + dias;
  if (chocan > 0) txt = txt + " (" + chocan + " h chocan con clases o eventos)";
  aviso("En tu horario: " + txt);
  horEditor = false;
}

// Quita un bloque que pusiste en el horario.
void quitarBloquePropio(int d, int h) {
  int a = propioAct[d][h];
  if (a < 0) return;
  int i = h;
  while (i >= 0 && propioAct[d][i] == a) i--;
  for (int j = i + 1; j < 24 && propioAct[d][j] == a; j++) propioAct[d][j] = -1;
  actualizarHorario();
  aviso("Quitaste " + ACTIVIDADES_PROPIAS[a][0] + " del día " + d);
}

