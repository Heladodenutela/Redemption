// La gente de los mapas: cada NPC tiene su hoja de sprites, su mapa y su recorrido (o se queda quieto).
// Si está o no a cada hora lo decide la AGENDA (npcPresente).
final int MAX_NPC = 80;
int numNPC = 0;
PImage[] npcHoja = new PImage[MAX_NPC];
int[] npcMapa = new int[MAX_NPC], npcFila = new int[MAX_NPC], npcFilaIzq = new int[MAX_NPC], npcFilaDer = new int[MAX_NPC];
float[] npcX = new float[MAX_NPC], npcMin = new float[MAX_NPC], npcMax = new float[MAX_NPC], npcVel = new float[MAX_NPC];
int[] npcDir = new int[MAX_NPC];
int[] npcPersona = new int[MAX_NPC];

// Imagen de una hoja de sprites a partir de su nombre.
PImage hojaPorNombre(String nombre) {
  for (int k = 0; k < VISOR_DATOS.length; k++) {
    if (VISOR_DATOS[k][0].equals(nombre)) return visHojas[k];
  }
  return null;
}

// Estático: se queda en x con su fila de AFK
void npcQuieto(String hoja, int mapa, float x, int fila) {
  if (numNPC >= MAX_NPC) return;
  npcHoja[numNPC] = hojaPorNombre(hoja);
  npcPersona[numNPC] = personaDeHoja(hoja);
  if (hoja.equals("pj_newton")) newtonNPC = numNPC;
  npcMapa[numNPC] = mapa;
  npcX[numNPC] = x;
  npcFila[numNPC] = fila;
  npcVel[numNPC] = 0;
  numNPC++;
}

// Recorre: va y viene entre xMin y xMax con sus filas de izquierda/derecha
void npcRecorre(String hoja, int mapa, float xMin, float xMax, int filaIzq, int filaDer, float v) {
  if (numNPC >= MAX_NPC) return;
  npcHoja[numNPC] = hojaPorNombre(hoja);
  npcPersona[numNPC] = personaDeHoja(hoja);
  npcMapa[numNPC] = mapa;
  npcX[numNPC] = random(xMin, xMax);
  npcMin[numNPC] = xMin;
  npcMax[numNPC] = xMax;
  npcFilaIzq[numNPC] = filaIzq;
  npcFilaDer[numNPC] = filaDer;
  npcVel[numNPC] = v;
  if (random(1) < 0.5) npcDir[numNPC] = 1; else npcDir[numNPC] = -1;
  numNPC++;
}

