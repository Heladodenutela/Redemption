// X del paradero de un mapa (para buses, taxi y microsueño)
float xParadero(int mapa) {
  if (mapa == C1) return LLEGA_C1;
  if (mapa == I2) return LLEGA_I2;
  if (mapa == I6) return LLEGA_I6;
  if (mapa == P1) return LLEGA_P1;
  if (mapa == I7) return LLEGA_I7;
  return LLEGADA_DEFAULT;
}

// ¿Esta conexión entre mapas está abierta hoy? (algunas solo existen ciertos días).
boolean diaValido(int c) {
  int cond = conexiones[c][CX_DIA];
  if (cond == 0) return true;
  if (cond > 0) return dia == cond;
  return dia != -cond;
}

// Cuánto cuesta usar una conexión (bus, terminal o taxi; caminar es gratis).
int precioDe(int c) {
  int modo = conexiones[c][CX_MODO];
  if (modo == BUS) return PRECIO_BUS;
  if (modo == TAQUILLA) return PRECIO_TERMINAL;
  if (modo == TAXI) return PRECIO_TAXI;
  return 0;
}

// Cuántos minutos del reloj gasta una conexión (con la espera de la Terminal).
int minutosDe(int c) {
  int mn = conexiones[c][CX_MIN];
  if (conexiones[c][CX_MODO] == TAQUILLA) mn += ESPERA_TERMINAL;
  return mn;
}

int[] resOpciones;

// Todas las conexiones que salen de un mapa por un borde o por un objeto (y que valen hoy)
// deja un vector: en [0] cuántas hay, y las conexiones en [1], [2]...
// Deja el resultado en resOpciones.
void opciones(int mapa, int tipo, int o) {
  int[] lista = new int[MAX_CONEXIONES + 1];
  for (int c = 0; c < numConexiones; c++) {
    if (conexiones[c][CX_ORIGEN] == mapa && conexiones[c][CX_TIPO] == tipo && !(tipo == INTERACCION && conexiones[c][CX_OBJ] != o) && diaValido(c)) {
      agregarInt(lista, c);
    }
  }
  resOpciones = lista;
}

// "Lo que dices»lo que te contesta" -> lo que dices
String textoOpcion(int c) {
  int modo = conexiones[c][CX_MODO];
  String dest = MAPA_NOMBRE[conexiones[c][CX_DESTINO]];
  String t = "Caminar";
  if (modo == BUS) t = "Bus";
  if (modo == TAXI) t = "Taxi de Don Beto";
  if (modo == TAQUILLA) t = "Bus de la Terminal";
  String extra = minutosDe(c) + " min";
  if (precioDe(c) > 0) extra = "$" + precioDe(c) + " · " + extra;
  return t + " a " + dest + "  (" + extra + ")";
}

// ============================ ESTADO DEL MUNDO ============================
int mapaActual = C5;
float pjX = 800;
int pjDir = 1;
boolean pjMoviendo = false, correr = false, teclaIzq = false, teclaDer = false;
int pjQuietoDesde = 0, afkAccionFrame = -1;

// Menú de opciones (paradero, caminatas largas con varios destinos...)
boolean menuAbierto = false;
int[] menuOpciones = new int[MAX_CONEXIONES + 1];
String menuTitulo = "";

// Pantalla de viaje (caminata larga, bus, taxi)
boolean viajeActivo = false;
int viajeInicio, viajeOrigen, viajeDestino, viajeTipo, viajeMin, viajeModo;
float viajeAparece = -1;
boolean viajeDormido = false;
String viajeTexto = "";

// Avisos y transición
String avisoTexto = "";
int avisoHasta = 0;
float fadeAlfa = 0;

// Muestra un aviso corto abajo de la pantalla por 2,5 segundos.
void aviso(String t) {
  avisoTexto = t;
  avisoHasta = millis() + 2500;
}

// Pone al protagonista en su cuarto al empezar el mundo.
void iniciarMundo() {
  mapaActual = MAPA_INICIAL;
  pjX = LLEGADA_DEFAULT;
  pjDir = 1;
  pjQuietoDesde = millis();
  menuAbierto = false;
  viajeActivo = false;
  teclaIzq = false;
  teclaDer = false;
  correr = false;
  alIniciarMundo();
}

// Conversión de píxeles del fondo a píxeles de pantalla
float aPantallaX(float x) { return fondoX + x * escalaFondo; }
// Pasa una altura del mapa a la altura en pantalla.
float aPantallaY(float y) { return fondoY + y * escalaFondo; }
// Tamaño con que se dibuja el protagonista en el mapa actual.
float escalaPJ() { return escalaFondo * escalaPersonaje; }

// ============================ TIEMPO ============================
// Adelanta el reloj del juego. El reloj usa intervalos de 500 ms = 30 s de juego,
// así que 1 minuto = 2 intervalos. Se corre "ti" para que cicloTiempo no se frene.
void avanzarTiempo(int minutos) {
  if (minutos <= 0) return;
  int n = minutos * 2;
  horagp = horagp + n;
  ti = ti - n * 500;
  if (minutos >= 30) hdCieloBase = -1;
}

// Pasa una hora en medios minutos a texto 'hh:mm'.
String horaTexto(int hd) {
  return nf(hd / 120, 2) + ":" + nf((hd % 120) / 2, 2);
}

// ============================ DESPLAZAMIENTO ============================
// Te pasa de "origen" a "destino". tipo = BORDE_IZQ, BORDE_DER o INTERACCION (especial).
// - BORDE_DER: apareces en el borde izquierdo del nuevo mapa.
// - BORDE_IZQ: apareces en el borde derecho del nuevo mapa.
// - INTERACCION: apareces frente al objeto que te devuelve (la puerta, la escalera...);
// si llegaste en bus/taxi, frente al paradero del destino; si no hay, en LLEGADA_DEFAULT.
// También descuenta los minutos del viaje y cambia el fondo (el fondo sale de fondos[mapaActual]).
void desplazamientoMapa(int origen, int destino, int tipo, int minutos, int modo, float aparece) {
  if (destino != mapaActual) {
    reiniciarCadenasSinTerminar();
    if (actividad != ACT_NINGUNA) terminarActividad();
  }
  mapaActual = destino;
  revisarRopaAlSalir();
  if (aparece >= 0) {
    pjX = aparece;
    if (tipo == BORDE_IZQ) pjDir = -1; else pjDir = 1;
  } else if (tipo == BORDE_DER) {
    pjX = LLEGADA_IZQ;
    pjDir = 1;
  } else if (tipo == BORDE_IZQ) {
    pjX = LLEGADA_DER;
    pjDir = -1;
  } else if (modo != A_PIE) {
    pjX = xParadero(destino);
  } else {
    pjX = LLEGADA_DEFAULT;
  }
  if (modo == BUS && busLlenoDia == dia) minutos += 8;
  avanzarTiempo(minutos);
  pjQuietoDesde = millis();
  afkAccionFrame = -1;
  fadeAlfa = 255;
  aviso(MAPA_COD[destino] + " · " + MAPA_NOMBRE[destino] + "   (+" + minutos + " min)");
  alEntrarMapa(destino);
}

// Usa una conexión del grafo: cobra, revisa el microsueño y te mueve (con pantalla de viaje si toca)
void usarConexion(int c) {
  String cerrado = motivoCerrado(c);
  if (cerrado != null) { aviso(cerrado); return; }
  avisarSiSoloSalida(c);
  int precio = precioDe(c);
  if (dinero < precio) {
    aviso("No te alcanza: necesitas $" + precio + " y tienes $" + dinero);
    return;
  }
  dinero = dinero - precio;
  int origen = conexiones[c][CX_ORIGEN];
  int destino = conexiones[c][CX_DESTINO];
  int tipo = conexiones[c][CX_TIPO];
  int modo = conexiones[c][CX_MODO];
  int minutos = minutosDe(c);
  float aparece = conexiones[c][CX_APARECE];
  boolean dormido = false;

  if (modo == BUS && deudaSueno >= 3 && random(1) < PROB_MICROSUENO_BUS) {
    dormido = true;
    float rr = random(1);
    if (rr < 0.4) destino = I6;
    else if (rr < 0.7) destino = P1;
    else destino = I7;
    aparece = xParadero(destino);
  }

  if (modo != A_PIE || minutos >= MIN_PANTALLA_VIAJE) {
    viajeActivo = true;
    viajeInicio = millis();
    viajeOrigen = origen;
    viajeDestino = destino;
    viajeTipo = tipo;
    viajeMin = minutos;
    viajeModo = modo;
    viajeAparece = aparece;
    viajeDormido = dormido;
    viajeTexto = textoOpcion(c);
    teclaIzq = false;
    teclaDer = false;
  } else {
    desplazamientoMapa(origen, destino, tipo, minutos, modo, aparece);
  }
}

// Al terminar la animación de un viaje: te pone en el mapa de destino y avanza el reloj.
void terminarViaje() {
  viajeActivo = false;
  desplazamientoMapa(viajeOrigen, viajeDestino, viajeTipo, viajeMin, viajeModo, viajeAparece);
  if (viajeDormido) aviso("Te dormiste en el bus y te pasaste: " + MAPA_NOMBRE[viajeDestino]);
}

// Elige: si hay una sola opción viaja; si hay varias abre el menú
void elegirOpcion(int[] lista, String titulo) {
  if (tamInt(lista) == 1) {
    usarConexion(lista[1]);
  } else if (tamInt(lista) > 1) {
    menuOpciones = lista;
    menuTitulo = titulo;
    menuAbierto = true;
    teclaIzq = false;
    teclaDer = false;
  }
}

// Objeto del mapa actual frente al que está el personaje (-1 si ninguno)
int objetoCercano() {
  for (int o = 0; o < numObjetos; o++) {
    if (objMapa[o] == mapaActual && pjX >= objX[o][0] && pjX <= objX[o][1]) return o;
  }
  return -1;
}

// Tecla E en el mundo: usa el objeto más cercano (puerta, paradero, tienda) o acaricia a Newton.
void interactuar() {
  if (newtonCerca() >= 0) { acariciarNewton(); return; }
  int o = objetoCercano();
  if (o < 0) return;
  String cerrado = motivoObjetoCerrado(o);
  if (cerrado != null) { aviso(cerrado); return; }
  opciones(mapaActual, INTERACCION, o);
  int[] lista = resOpciones;
  if (tamInt(lista) == 0) {
    if (!objAccion[o].equals("")) accionEspecial(o);
    else aviso(objNombre[o] + ": hoy no se puede usar");
    return;
  }
  elegirOpcion(lista, objNombre[o]);
}

// ============================ MOVIMIENTO DEL PERSONAJE ============================
// Mueve al protagonista con A/D o las flechas (SHIFT para correr) y lo pasa de mapa en los bordes.
void moverPersonaje() {
  pjMoviendo = false;
  if (cel != 0 || menuAbierto || viajeActivo || actividad != ACT_NINGUNA) return;
  int aux1;
  if (teclaDer) aux1 = 1; else aux1 = 0;
  int aux2;
  if (teclaIzq) aux2 = 1; else aux2 = 0;
  int dx = aux1 - aux2;
  if (dx == 0) return;
  pjMoviendo = true;
  pjDir = dx;
  pjQuietoDesde = millis();
  afkAccionFrame = -1;
  float v;
  if (correr) v = velCorrer; else v = vel;
  pjX = pjX + dx * v;

  if (pjX <= BORDE_X_IZQ) {
    opciones(mapaActual, BORDE_IZQ, -1);
    int[] lista = resOpciones;
    if (tamInt(lista) == 0) {
      pjX = BORDE_X_IZQ;
    } else {
      pjX = BORDE_X_IZQ + 30;
      elegirOpcion(lista, "¿Hacia dónde caminas?");
    }
  } else if (pjX >= BORDE_X_DER) {
    opciones(mapaActual, BORDE_DER, -1);
    int[] lista = resOpciones;
    if (tamInt(lista) == 0) {
      pjX = BORDE_X_DER;
    } else {
      pjX = BORDE_X_DER - 30;
      elegirOpcion(lista, "¿Hacia dónde caminas?");
    }
  }
}

// ============================ DIBUJO DEL MUNDO (screen 1) ============================
// Dibuja el mapa actual: cielo, fondo, utilería, gente, protagonista y lluvia (o el viaje si vas en bus).
void dibujarMundo() {
  if (viajeActivo) {
    dibujarViaje();
    if (millis() - viajeInicio >= DURACION_VIAJE_MS) terminarViaje();
    return;
  }
  for (int pc = 0; pc < pasoCuadro; pc++) moverPersonaje();
  dibujarFondo(mapaActual, horaDelDia());
  dibujarUtileria();
  dibujarObjetosMundo();
  dibujarDecoraciones(false);
  dibujarNPCs();

  PImage hojaNormal = pj_protagonista;
  if (enTraje && pj_protagonista_natacion != null) pj_protagonista = pj_protagonista_natacion;
  else if (enTraje) tint(150, 205, 255);
  dibujarProtagonista();
  noTint();
  pj_protagonista = hojaNormal;
  dibujarDecoraciones(true);

  dibujarMundoAntesHUD();

  dibujarAvisosInteraccion();

  if (fadeAlfa > 0) {
    noStroke();
    fill(0, fadeAlfa);
    rect(0, 0, ANCHO, ALTO);
    fadeAlfa = fadeAlfa - 25 * pasoCuadro;
  }
  dibujarHUD();
  dibujarActividad();
  dibujarMundoDespues();
  if (menuAbierto) dibujarMenu();
  dibujarMundoV22();
}

// hd = hora del día (en intervalos del reloj) con la que se pinta el cielo.
// Solo se rearma la capa si cambió el cielo, el mapa o la escala; si no, se pega la imagen guardada.
void dibujarFondo(int mapa, int hd) {
  boolean cambio = actualizarCielo(hd);
  if (cambio || fondoSucio || mapa != capaMapa || capaEsc != escalaFondo || capaX != fondoX || capaY != fondoY) {
    armarCapaFondo(mapa);
  }
  image(capaFondo, 0, 0);
}

// Pinta una sola vez el fondo del mapa con sus piezas en una capa, para no redibujarlo cada cuadro.
void armarCapaFondo(int mapa) {
  PGraphics g = capaFondo;
  g.beginDraw();
  g.background(0);
  g.image(cielo, fondoX, fondoY, CIELO_W * 5 * escalaFondo, CIELO_H * 5 * escalaFondo);
  PImage f = fondos[mapa];
  if (f != null) {
    g.image(f, fondoX, fondoY, 1600 * escalaFondo, 900 * escalaFondo);
  } else {
    g.noStroke();
    g.fill(90, 110, 80);
    g.rect(aPantallaX(0), aPantallaY(pisoMapa[mapa]), 1600 * escalaFondo, (900 - pisoMapa[mapa]) * escalaFondo);
    g.fill(255);
    g.textSize(30);
    g.textAlign(CENTER, CENTER);
    g.text("Falta el fondo de " + MAPA_COD[mapa] + " (" + MAPA_NOMBRE[mapa] + ")\nrevisa el nombre del archivo en cargarImagenes()", 800, 300);
  }
  dibujarPiezas(g, mapa);
  g.endDraw();
  capaMapa = mapa;
  capaEsc = escalaFondo;
  capaX = fondoX;
  capaY = fondoY;
  fondoSucio = false;
}

