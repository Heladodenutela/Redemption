final int ACT_CLASE_JUEGO = 40, ACT_CLASE_RES = 41, ACT_CINEMATICA = 42;
final int MJ_PROYECTIL = 0, MJ_PENDIENTE = 1, MJ_BALANZA = 2, MJ_BICHOS = 3, MJ_PENDULO = 4;
