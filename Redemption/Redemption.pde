// #####################################################################################
// #####################################################################################
//   MOTOR DE ESCENAS LARGAS (estilo Stardew Valley)
//   Una escena son varias filas seguidas de la matriz ESCENAS: { id, etiqueta, quién, texto, acción }.
//   La escena pasa en el mapa donde estás (o en un fondo propio si existe la imagen).
// #####################################################################################
// #####################################################################################
// quién:  nombre de la persona como en DLG_PERSONA ("Sofía", "Mamá (Claudia)"...), "Tú",
//         o "*" para narración. Se le puede poner la cara: "Sofía:feliz", "Laura:molesta".
// acción (una por fila):
//   ""                        -> sigue con la fila de abajo
//   "OP:texto#salto#efecto#condición|texto#salto#efecto#condición|..."
//                             -> opciones (1-5 o click). Si la condición no se cumple, la opción no sale.
//                                El salto es la etiqueta a la que va; vacío = la fila de abajo.
//   "IR:etiqueta"             -> salta a esa etiqueta
//   "SI:condición#etiqueta"   -> si se cumple, salta (sin mostrar esta fila si no tiene texto)
//   "EF:efecto"               -> aplica el efecto (mismo formato del guion: "Sofía +5, Social +2, BANDERA")
//   "MJ:CÓDIGO#siGana#siPierde" -> minijuego; al terminar vuelve a la escena en esa etiqueta
//   "CMD:orden;orden"         -> órdenes: TIEMPO n, AMIGOS n, ESTUDIO n, EJERCICIO n, FONDO archivo
//                                ACTOR Persona@x, QUITAR Persona, MAPA COD@x, FIN
//   "FIN"                     -> termina la escena
// Las condiciones usan cumple().
final int ACT_ESCENA = 70;
String[][] ESCENAS;
String escId = "";
int escFila = -1;
int scePersona = -1;
String escHablante = "", escTexto = "", escExpr = "";
boolean escEsperaOpcion = false;
String[][] escOps = new String[8][];
String escSalto = null;
boolean escTermina = false;
String escMJ = null;
String escFondo = "";
PImage escFondoImg = null;
String[] escActores = new String[8];
String escAntes = "";
String[] escenasVistas = new String[300];
String escSiGana = "", escSiPierde = "";
boolean escVolverDeMJ = false;
int escMJPuntaje = 0;

// Fila de la tabla ESCENAS donde empieza una escena (o una etiqueta dentro de ella).
int filaDeEscena(String id, String etiqueta) {
  if (ESCENAS == null) return -1;
  for (int k = 0; k < ESCENAS.length; k++) {
    if (ESCENAS[k][0].equals(id)) {
      if (etiqueta == null || etiqueta.equals("") || ESCENAS[k][1].equals(etiqueta)) return k;
    }
  }
  return -1;
}

// ¿Existe esta escena?
boolean escenaExiste(String id) {
  return filaDeEscena(id, "") >= 0;
}

// ¿Ya viste esta escena?
boolean escenaVista(String id) {
  return tieneTexto(escenasVistas, id);
}

// Arranca una escena desde su primera fila
void empezarEscena(String id) {
  int k = filaDeEscena(id, "");
  if (k < 0) return;
  escId = id;
  escFila = k;
  scePersona = -1;
  escFondo = "";
  escFondoImg = null;
  vaciarTexto(escActores);

  for (int j = k; j < ESCENAS.length && ESCENAS[j][0].equals(id); j++) {
    String q = quienDeFila(j);
    if (!q.equals("Tú") && !q.equals("*") && !q.equals("")) {
      int f = personaIndice(q);
      if (f < 0) f = personaPorNombre(q);
      if (f >= 0) { scePersona = f; break; }
    }
  }
  if (!tieneTexto(escenasVistas, id)) agregarTexto(escenasVistas, id);
  if (cel != 0) cel = 0;
  empezarActividad(ACT_ESCENA);
  procesarFilaEscena();
}

// Quién habla en una fila de la escena.
String quienDeFila(int k) {
  String q = ESCENAS[k][2];
  int i = posicionDe(q, ":");
  if (i >= 0) return q.substring(0, i); else return q;
}

// Expresión de quien habla (feliz, triste...) en una fila de la escena.
String exprDeFila(int k) {
  String q = ESCENAS[k][2];
  int i = posicionDe(q, ":");
  if (i >= 0) return q.substring(i + 1); else return "";
}

// Lee la fila actual: las que no muestran nada se ejecutan solas
void procesarFilaEscena() {
  int vueltas = 0;
  while (vueltas++ < 200) {
    if (escFila < 0 || escFila >= ESCENAS.length || !ESCENAS[escFila][0].equals(escId)) { terminarEscena(); return; }
    String[] f = ESCENAS[escFila];
    String acc = f[4];
    String texto = f[3];
    escSalto = null;
    escTermina = false;
    escMJ = null;
    escEsperaOpcion = false;
    boolean seguir12 = true;
    if (empiezaCon(acc, "SI:")) {
      partirPorLetra(acc.substring(3), '#');
      String[] p = resPartirPorLetra;
      if (cumple(p[0])) {
        if (texto.equals("")) { if (p.length > 1) saltarEscena(p[1]); else saltarEscena(""); seguir12 = false; }
        if (seguir12) {
          if (p.length > 1) escSalto = p[1]; else escSalto = "";
        }
      } else if (texto.equals("")) { escFila++; seguir12 = false; }
    }
    if (seguir12) {
      boolean seguir13 = true;
      if (empiezaCon(acc, "CMD:")) {
        ordenesEscena(acc.substring(4));
        if (escId.equals("") || actividad != ACT_ESCENA) return;
        if (texto.equals("")) { escFila++; seguir13 = false; }
      }
      if (seguir13) {
        boolean seguir14 = true;
        if (empiezaCon(acc, "EF:")) {
          String r = aplicarEfectosV20(acc.substring(3), scePersona);
          if (!r.equals("")) aviso(r);
          if (texto.equals("")) { escFila++; seguir14 = false; }
        }
        if (seguir14) {
          boolean seguir15 = true;
          if (empiezaCon(acc, "IR:")) {
            if (texto.equals("")) { saltarEscena(acc.substring(3)); seguir15 = false; }
            if (seguir15) {
              escSalto = acc.substring(3);
            }
          }
          if (seguir15) {
            if (acc.equals("FIN")) {
              if (texto.equals("")) { terminarEscena(); return; }
              escTermina = true;
            }
            if (empiezaCon(acc, "MJ:")) escMJ = acc.substring(3);
            if (empiezaCon(acc, "OP:")) {
              vaciarFilas(escOps);
              partirPorLetra(acc.substring(3), '|');
              String[] ops = resPartirPorLetra;
              for (int i = 0; i < ops.length; i++) {
                partirPorLetra(ops[i], '#');
                String[] p = resPartirPorLetra;
                String cond;
                if (p.length > 3) cond = p[3]; else cond = "";
                if (cumple(cond)) {
                  String aux1;
                  if (p.length > 1) aux1 = p[1]; else aux1 = "";
                  String aux2;
                  if (p.length > 2) aux2 = p[2]; else aux2 = "";
                  agregarFila(escOps, new String[] { p[0], aux1, aux2 });
                }
              }
              escEsperaOpcion = tamFilas(escOps) > 0;
            }
        
            String q = quienDeFila(escFila);
            escExpr = exprDeFila(escFila);
            escHablante = q;
            escTexto = texto;
            if (texto.equals("") && escEsperaOpcion) {
        
              if (escFila > 0 && ESCENAS[escFila - 1][0].equals(escId)) { escHablante = quienDeFila(escFila - 1); escTexto = ESCENAS[escFila - 1][3]; escExpr = exprDeFila(escFila - 1); }
            }
            if (escTexto.equals("") && !escEsperaOpcion && escMJ == null) { escFila++; } else {
              return;
            }
          }
        }
      }
    }
  }
  terminarEscena();
}

// Salta a una etiqueta de la escena (o la termina con FIN).
void saltarEscena(String etiqueta) {
  if (etiqueta == null || etiqueta.equals("")) { escFila++; return; }
  if (etiqueta.equals("FIN")) { escFila = -1; return; }
  int k = filaDeEscena(escId, etiqueta);
  if (k < 0) { escFila = -1; return; }
  escFila = k;
}

// E, ESPACIO, R o click
void avanzarEscena() {
  if (escEsperaOpcion) return;
  if (escMJ != null) {
    partirPorLetra(escMJ, '#');
    String[] p = resPartirPorLetra;
    if (p.length > 1) escSiGana = p[1]; else escSiGana = "";
    if (p.length > 2) escSiPierde = p[2]; else escSiPierde = escSiGana;
    escMJ = null;
    escVolverDeMJ = true;
    if (!iniciarMinijuegoV20(p[0])) { escVolverDeMJ = false; escFila++; procesarFilaEscena(); }
    return;
  }
  if (escTermina) { terminarEscena(); return; }
  if (escSalto != null) { saltarEscena(escSalto); procesarFilaEscena(); return; }
  escFila++;
  procesarFilaEscena();
}

// Lo llama el minijuego al terminar (puntaje 0-100)
void volverAEscena(int puntaje) {
  if (!escVolverDeMJ) return;
  escVolverDeMJ = false;
  escMJPuntaje = puntaje;
  empezarActividad(ACT_ESCENA);
  if (puntaje >= 50) saltarEscena(escSiGana); else saltarEscena(escSiPierde);
  procesarFilaEscena();
}

// Elige una respuesta en la escena: aplica sus efectos y salta a su etiqueta.
void elegirOpcionEscena(int i) {
  if (!escEsperaOpcion || i < 0 || i >= tamFilas(escOps)) return;
  String[] o = escOps[i];
  agregarTexto(elecciones, escId + ":" + i);
  String r = aplicarEfectosV20(o[2], scePersona);
  if (!r.equals("")) aviso(r);
  escEsperaOpcion = false;
  escHablante = "Tú";
  escExpr = "";
  escTexto = o[0];
  escSalto = o[1];
  escMJ = null;
  escTermina = false;

}

// Termina la escena y avisa a los eventos que la esperaban.
void terminarEscena() {
  escAntes = escId;
  escId = "";
  escFila = -1;
  escEsperaOpcion = false;
  escFondoImg = null;
  vaciarTexto(escActores);
  if (actividad == ACT_ESCENA) terminarActividad();
  if (scePersona >= 0) { registrarCharla(scePersona); asignarDialogo(scePersona); }
  alTerminarEscena(escAntes);
}

// Ejecuta las órdenes de una fila de escena (avanzar el reloj, poner actores, fondo...).
void ordenesEscena(String s) {
  partirPorLetra(s, ';');
  String[] ord = resPartirPorLetra;
  for (int i = 0; i < ord.length; i++) {
    String o = quitarBordesProcessing(ord[i]);
    if (!o.equals("")) {
      partirTokens(o, " ");
      String[] p = resPartirTokens;
      String c = p[0];
      String arg;
      if (o.length() > c.length()) arg = quitarBordesProcessing(o.substring(c.length())); else arg = "";
      if (c.equals("TIEMPO")) avanzarTiempo(int(arg));
      else if (c.equals("AMIGOS")) { catMedios[CAT_AMIGOS] += int(arg) * 2; avanzarTiempo(int(arg)); }
      else if (c.equals("ESTUDIO")) { catMedios[CAT_ESTUDIAR] += int(arg) * 2; avanzarTiempo(int(arg)); }
      else if (c.equals("EJERCICIO")) { catMedios[CAT_EJERCICIO] += int(arg) * 2; avanzarTiempo(int(arg)); }
      else if (c.equals("REDES")) { catMedios[CAT_REDES] += int(arg) * 2; avanzarTiempo(int(arg)); }
      else if (c.equals("FONDO")) { escFondo = arg; escFondoImg = cargarSiExiste("extras/escenas/" + arg + ".png"); }
      else if (c.equals("ACTOR")) { if (!tieneTexto(escActores, arg)) agregarTexto(escActores, arg); }
      else if (c.equals("QUITAR")) {
        for (int k = 0; k < tamTexto(escActores); k++) if (empiezaCon(escActores[k], arg + "@")) { quitarTextoEn(escActores, k); break; }
      }
      else if (c.equals("MAPA")) {
        partirPorLetra(arg, '@');
        String[] m = resPartirPorLetra;
        int dest = mapaPorCodigo(m[0]);
        if (dest >= 0 && dest != mapaActual) {
          int guarda = actividad;
          mapaActual = dest;
          alEntrarMapa(dest);
          actividad = guarda;
          fadeAlfa = 255;
        }
        if (m.length > 1) pjX = float(m[1]);
      }
      else if (c.equals("NODO")) { if (!tieneTexto(nodosHechos, arg)) agregarTexto(nodosHechos, arg); }
      else if (c.equals("RESP")) agregarTexto(respuestasDadas, arg);
      else if (c.equals("ROMANCE")) { partirTokens(arg, " "); String[] r = resPartirTokens; subirRomance(r[0], int(r[1])); }
      else if (c.equals("MENSAJE")) { int k = posicionDe(arg, "»"); if (k > 0) { int f = personaPorNombre(arg.substring(0, k)); if (f >= 0) agregarMensaje(nombreChat(f), '1', arg.substring(k + 1)); } }
      else if (c.equals("BLOQUEAR_ROMANCES")) { for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 1) bloquearRomance(ROM_PERSONA[k]); }
      else if (c.equals("FOTOCTX")) ftContexto = arg;
      else if (c.equals("FIN")) { terminarEscena(); return; }
    }
  }
}

// ---- teclas y mouse ----
// Teclas en una escena: 1 a 5 para responder, E para seguir.
boolean teclasEscena() {
  if (actividad != ACT_ESCENA) return false;
  if (escEsperaOpcion) {
    if (key >= '1' && key <= '5') elegirOpcionEscena(key - '1');
    return true;
  }
  if (key == 'e' || key == 'E' || key == 'r' || key == 'R' || key == ' ' || key == ENTER || key == RETURN) avanzarEscena();
  return true;
}

// Clicks en una escena: elegir respuesta o seguir.
boolean clickEscena() {
  if (actividad != ACT_ESCENA) return false;
  if (escEsperaOpcion) {
    int n = tamFilas(escOps);
    for (int i = 0; i < n; i++) {
      float y = opcY(i, n);
      if (mouseX > OPC_X && mouseX < OPC_X + OPC_W && mouseY > y && mouseY < y + OPC_H) { elegirOpcionEscena(i); return true; }
    }
    return true;
  }
  avanzarEscena();
  return true;
}

// ---- dibujo ----
// Dibuja la escena larga: fondo, actores, caja de texto y respuestas.
boolean dibujarEscena() {
  if (actividad != ACT_ESCENA) return false;
  int col = (cuadros / VEL_AFK) % 4;
  if (escFondoImg != null && escFondoImg.width > 1) {
    image(escFondoImg, 0, 0, ANCHO, ALTO);

    float x0 = 500;
    if (scePersona >= 0) dibujarActorGrande(scePersona, x0, col);
    for (int k = 0; k < tamTexto(escActores); k++) {
      partirPorLetra(escActores[k], '@');
      String[] a = resPartirPorLetra;
      int f = personaIndice(a[0]);
      if (f < 0) f = personaPorNombre(a[0]);
      if (f >= 0) dibujarActorGrande(f, x0 + 320 * (k + 1), col);
    }
  } else {

    for (int k = 0; k < tamTexto(escActores); k++) {
      partirPorLetra(escActores[k], '@');
      String[] a = resPartirPorLetra;
      int f = personaIndice(a[0]);
      if (f < 0) f = personaPorNombre(a[0]);
      if (f >= 0) {
        PImage h = hojaPorNombre(hojaDePersona(f));
        if (h != null) { if (a.length > 1) dibujarPersonaje(h, 0, col, float(a[1]), pisoMapa[mapaActual]); else dibujarPersonaje(h, 0, col, pjX + 200, pisoMapa[mapaActual]); }
      }
    }

    noStroke();
    fill(0, 0, 0, 70);
    rect(0, 560, ANCHO, 340);
  }

  if (escEsperaOpcion) {
    int n = tamFilas(escOps);
    for (int i = 0; i < n; i++) {
      float y = opcY(i, n);
      boolean encima = mouseX > OPC_X && mouseX < OPC_X + OPC_W && mouseY > y && mouseY < y + OPC_H;
      noStroke();
      if (encima) fill(color(255, 235, 180)); else fill(color(250, 246, 235));
      rect(OPC_X, y, OPC_W, OPC_H, 10);
      fill(40);
      textSize(18);
      textAlign(LEFT, CENTER);
      text((i + 1) + ".  " + escOps[i][0], OPC_X + 22, y + 4, OPC_W - 40, OPC_H - 8);
    }
    textAlign(LEFT, BASELINE);
  }

  String q = escHablante;
  String t = escTexto;
  if (q.equals("*") || q.equals("")) {
    dibujarNarracion(t);
  } else if (q.equals("Tú")) {
    retratoExpr = null;
    dibujarCajaDialogo("Tú", t, pj_protagonista, FILA_AFK, col, RETRATO_RECORTE);
  } else {
    int f = personaIndice(q);
    if (f < 0) f = personaPorNombre(q);
    PImage h = null;
    int fila = 0;
    int k;
    if (f >= 0 && agendaNPC != null) k = agendaNPC[f]; else k = -1;
    if (k >= 0) { h = npcHoja[k]; fila = npcFilaAFK(k); }
    else if (f >= 0) h = hojaPorNombre(hojaDePersona(f));
    retratoExpr = retratoDe(f);
    if (escExpr.equals("feliz")) {
      retratoCol = 1;
    } else if (escExpr.equals("molesta") || escExpr.equals("molesto") || escExpr.equals("triste")) {
      retratoCol = 2;
    } else {
      retratoCol = 0;
    }
    String aux1;
    if (f >= 0) aux1 = nombreCorto(f); else aux1 = q;
    float[] aux2;
    if (f == newtonNPC) aux2 = RETRATO_NEWTON; else aux2 = RETRATO_RECORTE;
    dibujarCajaDialogo(aux1, t, h, fila, col, aux2);
    retratoExpr = null;
  }

  fill(255);
  textSize(17);
  textAlign(RIGHT, BASELINE);
  if (escEsperaOpcion) text("Elige una respuesta (1-" + tamFilas(escOps) + " o click)", ANCHO - 40, 600);
  textAlign(LEFT, BASELINE);
  return true;
}

