    pdNomB = "Pan"; pdB = new String[] { "Croissant", "Almojábana", "Buñuelo", "Rollo de canela" };
    pdColB = new int[][] { {225, 160, 70}, {240, 220, 150}, {200, 120, 50}, {210, 150, 90} };
