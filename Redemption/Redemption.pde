  if (bandera("IRIS_COMPLETA") > 0) return;
  if (escenaVista("IRIS1") && escenaVista("IRIS2") && escenaVista("IRIS3") && escenaVista("IRIS4")) sumarBandera("IRIS_COMPLETA", 1);
}

