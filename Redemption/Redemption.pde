// El último día que aparece en una lista de días.
int ultimoDiaDe(String dias) {
  int m = 0;
  partirTokens(dias, ",-");
  String[] p = resPartirTokens;
  for (int i = 0; i < p.length; i++) m = max(m, int(quitarBordesProcessing(p[i])));
  return m;
}

// El primer día que aparece en una lista de días.
int primerDiaDe(String dias) {
  int m = 99;
  partirTokens(dias, ",-");
  String[] p = resPartirTokens;
  for (int i = 0; i < p.length; i++) m = min(m, int(quitarBordesProcessing(p[i])));
  return m;
}

// ¿Este evento está disponible ahora (día, hora, mapa y condiciones)?
boolean eventoActivo(int k) {
  if (evEstado == null || evEstado[k] != 0) return false;
  String[] e = EVENTOS20[k];
  if (!diaEn(e[2], dia)) return false;
  int m = minutoAhora();
  if (m < aMin(e[3]) || m >= aMin(e[4])) return false;
  if (bloqueado(personaIndice(e[1]))) return false;
  return cumple(e[7]);
}

String[] resFilaEventoAhora;

// La agenda pregunta esto antes que la normal: si hay un evento, la persona está ahí
// Deja el resultado en resFilaEventoAhora.
void filaEventoAhora(String persona) {
  if (EVENTOS20 == null) { resFilaEventoAhora = null; return; }
  for (int k = 0; k < EVENTOS20.length; k++) {
    if (evFilaAgenda[k] != null && EVENTOS20[k][1].equals(persona)) {
      if (eventoActivo(k)) { resFilaEventoAhora = evFilaAgenda[k]; return; }
    }
  }
  filaPlanAhora(persona);
  resFilaEventoAhora = resFilaPlanAhora;
}

// Tecla R: si la persona tiene un evento aquí y ahora, empieza su escena
boolean eventoAlHablar(int f) {
  if (EVENTOS20 == null || f < 0) return false;
  for (int k = 0; k < EVENTOS20.length; k++) {
    String[] e = EVENTOS20[k];
    if (e[1].equals(DLG_PERSONA[f]) && e[10].equals("R") && eventoActivo(k) && !(!e[5].equals("") && !e[5].equals("*") && mapaPorCodigo(e[5]) != mapaActual) && escenaExiste(e[8])) {
      evEnCurso = k;
      evLlego[k] = true;
      empezarEscena(e[8]);
      return true;
    }
  }
  return false;
}

// Al llegar a un mapa: los eventos automáticos de ese lugar
void revisarEventosAlEntrar(int m) {
  if (EVENTOS20 == null || actividad == ACT_ESCENA) return;
  for (int k = 0; k < EVENTOS20.length; k++) {
    String[] e = EVENTOS20[k];
    if (e[10].equals("A") && !(!e[5].equals("*") && mapaPorCodigo(e[5]) != m) && eventoActivo(k) && escenaExiste(e[8])) {
      evEnCurso = k;
      evLlego[k] = true;
      empezarEscena(e[8]);
      return;
    }
  }
}

// Al terminar una escena: marca su evento como hecho.
void alTerminarEscena(String id) {
  if (EVENTOS20 == null) return;
  for (int k = 0; k < EVENTOS20.length; k++) {
    if (EVENTOS20[k][8].equals(id) && evEstado[k] == 0) {
      evEstado[k] = 1;
      sumarBandera("EV_" + EVENTOS20[k][0], 1);
    }
  }
  evEnCurso = -1;
  anotarDiarioEscena(id);
  revisarCadenasIris();
  if (id.equals("FERIA")) { feriaHecha = true; terminarJuego(""); }
}

// Cada avance del reloj: avisa los eventos que empiezan y marca los que se perdieron.
void tickEventos() {
  if (EVENTOS20 == null) return;
  int m = minutoAhora();
  for (int k = 0; k < EVENTOS20.length; k++) {
    String[] e = EVENTOS20[k];
    if (evEstado[k] == 0) {
  
      if (!evInvitado[k] && !e[11].equals("") && dia == primerDiaDe(e[2]) && m >= aMin(e[12]) && cumple(e[7])) {
        evInvitado[k] = true;
        int f = personaIndice(e[1]);
        String txt = e[11];
        int sep = posicionDe(txt, "»");
        if (sep > 0) { f = personaPorNombre(txt.substring(0, sep)); txt = txt.substring(sep + 1); }
  
        boolean llego = f >= 0 && llegaMensaje(nombreChat(f), 0);
        if (llego) invitarAEvento(k, f, txt);
        if (llego || esFamilia(personaIndice(e[1]))) {
          diasDe(e[2]);
          int[] dd = resDiasDe;
          for (int i = 0; i < dd.length; i++) ponerEnHorario(dd[i], aMin(e[3]) / 60, max(aMin(e[3]) / 60 + 1, aMin(e[4]) / 60), e[9], color(230, 162, 60));
        }
      }
  
      if (eventoActivo(k) && !e[5].equals("") && !e[5].equals("*") && mapaPorCodigo(e[5]) == mapaActual) evLlego[k] = true;
      if (evEnCurso == k || (actividad == ACT_ESCENA && escId.equals(e[8]))) { evLlego[k] = true; } else {
    
        int ult = ultimoDiaDe(e[2]);
        boolean seguir9 = true;
        if (dia > ult || (dia == ult && m >= aMin(e[4]) && m > 5 * 60)) {
          if (evLlego[k]) { evEstado[k] = 3; seguir9 = false; }
          if (seguir9) {
            evEstado[k] = 2;
            sumarBandera("PERDIÓ_" + e[0], 1);
            int f = personaIndice(e[1]);
            if (!e[13].equals("") && f >= 0 && cumple(e[7]) && bandera("DECLINÓ_" + e[0]) <= 0 && llegaMensaje(nombreChat(f), 1)) agregarMensaje(nombreChat(f), '1', e[13]);
          }
        }
      }
    }
  }

  if (actividad == ACT_NINGUNA && cel == 0 && !finJuego) revisarEventosAlEntrar(mapaActual);
}

int[] resDiasDe;

// Pasa una lista de días en texto a un vector de números (queda en resDiasDe).
void diasDe(String dias) {
  int[] r = new int[0];
  for (int d = 1; d <= 10; d++) if (diaEn(dias, d)) { alargarEnteros(r, d); r = resAlargarEnteros; }
  resDiasDe = r;
}

