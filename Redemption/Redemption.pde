// ¿La imagen existe y se cargó bien? (si falta el archivo, el juego dibuja una figura en su lugar).
boolean hay(PImage img) {
  return img != null && img.width > 1;
}

// Dibuja el cuadro f de una tira, volteado de lado si espejo = true
void tiraEspejo(PImage img, int n, int f, float x, float y, float w, float h, boolean espejo) {
  if (!espejo) { tira(img, n, f, x, y, w, h); return; }
  pushMatrix();
  translate(x + w, y);
  scale(-1, 1);
  tira(img, n, f, 0, 0, w, h);
  popMatrix();
}

int ultimoFrame9 = 0;
// Tiempo desde el cuadro anterior para el press y las mancuernas (1.0 = un cuadro a 60 FPS).
float dt9() {
  int ahora = millis();
  float d = constrain((ahora - ultimoFrame9) / 16.67, 0, 3);
  ultimoFrame9 = ahora;
  return d;
}

// ============================ GIMNASIO: PRESS CON EQUILIBRIO (la barra) ============================
// Machaca ESPACIO para subir la barra. La aguja se va sola hacia un lado: izquierda y derecha para centrarla.
// Si machacas con la aguja torcida, te inclinas; si te inclinas demasiado, se cae la barra.
// Arriba hay que aguantar 1 s con la aguja en el centro: eso es una repetición.
float psAltura, psAguja, psDeriva, psInclina, psSostener;
int psReps, psMeta, psCaidas, psCaidaHasta, psFin, psGolpes;
boolean psIzq, psDer;

// Empieza el press de banca.
void iniciarPress() {
  cargarSprites9();
  psAltura = 0;
  psAguja = 0;
  psDeriva = 0.004;
  psInclina = 0;
  psSostener = 0;
  psReps = 0;
  if (gymSesion) psMeta = 2; else psMeta = PRESS_REPS;
  psCaidas = 0;
  psCaidaHasta = 0;
  psFin = 0;
  psGolpes = 0;
  psIzq = false;
  psDer = false;
  ultimoFrame9 = millis();
  empezarActividad(ACT_GYM_PRESS);
}

// Cuánto se mueve la aguja del press (más con cansancio).
float fuerzaAguja() {
  float cansancio = 1.6 - constrain(stats[ST_ENERGIA] / 100.0, 0.3, 1);
  return (0.0016 + psReps * 0.0009) * cansancio;
}

// Dibuja el press: mantén la aguja en el centro y sube la barra.
void dibujarPress() {
  float dt = dt9();
  dibujarFondoGym();
  boolean cayendo = millis() < psCaidaHasta;
  if (psFin == 0 && !cayendo) {

    int aux1;
    if (random(1) < 0.5) aux1 = -1; else aux1 = 1;
    int aux2;
    if (psAguja > 0) aux2 = 1; else aux2 = -1;
    psDeriva += aux1 * fuerzaAguja() * dt + aux2 * fuerzaAguja() * 0.3 * dt;
    psDeriva = constrain(psDeriva, -0.02, 0.02);
    if (psIzq) psAguja -= 0.028 * dt;
    if (psDer) psAguja += 0.028 * dt;
    psAguja = constrain(psAguja + psDeriva * dt, -1, 1);
    if (abs(psAguja) >= 1) psDeriva *= -0.5;

    float gravedad = PRESS_GRAVEDAD * (1.4 - constrain(stats[ST_ENERGIA] / 100.0, 0.3, 1) * 0.4);
    if (psAltura < 0.97) psAltura = max(0, psAltura - gravedad * dt);

    if (abs(psAguja) < 0.35) psInclina = max(0, psInclina - 0.006 * dt);

    if (psAltura >= 0.97) {
      if (abs(psAguja) < 0.3) psSostener += dt * 16.67;
      else psSostener = max(0, psSostener - dt * 30);
      if (psSostener >= PRESS_SOSTENER_MS) {
        psReps++;
        psAltura = 0;
        psSostener = 0;
        psInclina = 0;
        gritarTanque(true);
        if (psReps >= psMeta) psFin = millis() + 900;
      }
    }
    if (psInclina >= 1) {
      psCaidas++;
      psCaidaHasta = millis() + 1300;
      psAltura = 0;
      psInclina = 0;
      psSostener = 0;
      psAguja = 0;
      psDeriva = 0.004;
      gritarTanque(false);
      aviso("¡Se te va la barra! El soporte la ataja.");
      if (psCaidas >= PRESS_CAIDAS_MAX) psFin = millis() + 1300;
    }
  }

  int f;
  if (cayendo) {
    f = 5;
  } else if (psAguja < -0.45) {
    f = 3;
  } else {
    if (psAguja > 0.45) f = 4; else if (psAltura < 0.33) f = 0; else if (psAltura < 0.8) f = 1; else f = 2;
  }
  float cx = 620, piso = 800;
  if (hay(gym_soporte)) image(gym_soporte, cx - 300, piso - 240, 600, 240);
  if (!tira(gym_press, 6, f, cx - 195, piso - 494, 390, 494)) {
    noStroke();
    fill(230, 70, 70);
    rect(cx - 55, piso - 290, 110, 160, 16);
    fill(230, 180, 140);
    ellipse(cx, piso - 320, 64, 64);
    fill(150);
    float by;
    if (cayendo) by = piso - 120; else by = piso - 260 - psAltura * 160;
    pushMatrix();
    translate(cx, by);
    rotate(psAguja * 0.3);
    rect(-260, -6, 520, 12, 6);
    fill(200, 40, 50);
    rect(-250, -50, 34, 100, 6);
    rect(216, -50, 34, 100, 6);
    popMatrix();
  }

  float bx = 930, by = 220, bh = 440;
  noStroke();
  fill(50, 50, 60, 220);
  rect(bx - 10, by - 10, 70, bh + 20, 12);
  fill(80);
  rect(bx, by, 50, bh, 8);
  if (psAltura >= 0.97) fill(color(80, 210, 100)); else fill(color(240, 200, 60));
  rect(bx, by + bh * (1 - psAltura), 50, bh * psAltura, 8);
  fill(80, 210, 100, 120);
  rect(bx, by, 50, bh * 0.03 + 6);

  float dx = 1180, dy = 330;
  if (hay(gym_dial)) image(gym_dial, dx - 120, dy - 120, 240, 240);
  else {
    fill(240);
    arc(dx, dy, 240, 240, PI, TWO_PI);
    fill(220, 70, 60);
    arc(dx, dy, 240, 240, PI, PI + 0.9);
    arc(dx, dy, 240, 240, TWO_PI - 0.9, TWO_PI);
    fill(80, 200, 100);
    arc(dx, dy, 240, 240, PI + HALF_PI - 0.35, PI + HALF_PI + 0.35);
  }
  pushMatrix();
  translate(dx, dy);
  rotate(psAguja * radians(75));
  if (hay(gym_aguja)) image(gym_aguja, -12, -170, 24, 180);
  else { stroke(200, 30, 30); strokeWeight(5); line(0, 0, 0, -105); noStroke(); }
  popMatrix();

  fill(255);
  textSize(18);
  textAlign(LEFT, TOP);
  text("inclinación", 1060, 380);
  fill(70);
  rect(1060, 405, 240, 18, 8);
  if (psInclina > 0.7) fill(color(220, 70, 60)); else fill(color(250, 170, 60));
  rect(1060, 405, 240 * psInclina, 18, 8);
  if (psAltura >= 0.97) {
    fill(255);
    text("¡AGUANTA!", 1060, 440);
    fill(70);
    rect(1060, 465, 240, 18, 8);
    fill(80, 210, 100);
    rect(1060, 465, 240 * psSostener / PRESS_SOSTENER_MS, 18, 8);
  }
  fill(255);
  textSize(30);
  text("PRESS  " + psReps + " / " + psMeta, 1060, 520);
  textSize(18);
  text("ESPACIO: machaca para subir\n← →: centra la aguja\nArriba: aguanta 1 s", 1060, 565);
  for (int i = 0; i < PRESS_CAIDAS_MAX; i++) { if (i < psCaidas) fill(color(220, 70, 60)); else fill(color(90)); ellipse(1075 + i * 34, 670, 24, 24); }
  textAlign(LEFT, BASELINE);
  dibujarGritoTanque();
  if (psFin > 0 && millis() > psFin) terminarPress();
}

// Teclas del press: izquierda y derecha para la aguja, ESPACIO para subir.
void teclaPress(boolean v) {
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') psIzq = v;
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') psDer = v;
  if (!v || key != ' ' || psFin > 0 || millis() < psCaidaHasta) return;
  psGolpes++;
  float torcida = abs(psAguja);
  psAltura = min(1, psAltura + PRESS_EMPUJE * (1 - torcida * 0.6));
  if (torcida > 0.35) psInclina += 0.07 * torcida;
}

// Termina el press y calcula los puntos.
void terminarPress() {
  boolean completo = psReps >= psMeta;
  int puntos = constrain(psReps * 100 / psMeta - psCaidas * 15, 0, 100);
  if (gymSesion) { rondaTerminada(puntos); return; }
  if (completo) { hecho("GYM"); if (bandera("RECORD_BARRA") <= 0) sumarBandera("RECORD_BARRA", 1); }
  int minutos = 15 + psReps * 5;
  String ef = "Ejercicio +" + minutos + " min · Energía −" + (6 + psReps) + " · Tiempo +" + minutos + " min";
  if (completo) ef += " · Social +1";
  String aux1;
  if (completo) aux1 = "¡Press completo!"; else aux1 = "La barra ganó esta vez";
  String aux2;
  if (psCaidas > 0) {
    if (psCaidas > 1) aux2 = ", " + psCaidas + " caída" + "s"; else aux2 = ", " + psCaidas + " caída" + "";
  } else {
    aux2 = "";
  }
  String aux3;
  if (completo) {
    aux3 = "El equilibrio es todo. El Tanque estaría orgulloso.";
  } else {
    aux3 = "Machacar sin equilibrio no sirve. La próxima, ojo a la aguja.";
  }
  resultadoGym(aux1,
    psReps + " de " + psMeta + " repeticiones arriba" + aux2 + ".\n" +
    aux3, ef, -1);
}

// ============================ GIMNASIO: MANCUERNAS DOBLES ============================
// Dos marcas, una por brazo, suben y bajan a destiempo. Izquierda (o A) = brazo izquierdo, derecha (o D o ESPACIO) = derecho.
// Cada acierto mueve esa zona verde a otra altura, la achica y acelera su marca.
float[] mcMarca = new float[2], mcVel = new float[2], mcZona = new float[2], mcAncho = new float[2];
int[] mcArriba = new int[2];
int mcReps, mcMeta, mcFallos, mcFallosTotal, mcFin, mcError;

// Empieza las mancuernas (dos brazos, cada uno con su ritmo).
void iniciarMancuernas() {
  cargarSprites9();
  float cansancio = constrain(stats[ST_ENERGIA] / 100.0, 0.3, 1);
  for (int i = 0; i < 2; i++) {
    if (i == 0) mcMarca[i] = 0.1; else mcMarca[i] = 0.6;
    if (i == 0) mcVel[i] = 0.011; else mcVel[i] = 0.013;
    if (i == 0) mcZona[i] = 0.7; else mcZona[i] = 0.4;
    mcAncho[i] = 0.24 * (0.6 + 0.4 * cansancio);
    mcArriba[i] = 0;
  }
  mcReps = 0;
  if (gymSesion) mcMeta = 10; else mcMeta = MANC_REPS;
  mcFallos = 0;
  mcFallosTotal = 0;
  mcFin = 0;
  ultimoFrame9 = millis();
  empezarActividad(ACT_GYM_MANC);
}

// Dibuja las mancuernas con las barras de cada brazo.
void dibujarMancuernas() {
  float dt = dt9();
  dibujarFondoGym();
  if (mcFin == 0) {
    for (int i = 0; i < 2; i++) {
      mcMarca[i] += mcVel[i] * dt;
      if (mcMarca[i] > 1) { mcMarca[i] = 1; mcVel[i] = -abs(mcVel[i]); }
      if (mcMarca[i] < 0) { mcMarca[i] = 0; mcVel[i] = abs(mcVel[i]); }
    }
  }
  boolean izqArriba = millis() < mcArriba[0], derArriba = millis() < mcArriba[1];
  int f;
  if (izqArriba && derArriba) f = 3; else if (derArriba) f = 1; else if (izqArriba) f = 2; else f = 0;
  float cx = 800, piso = 800;
  if (!tira(gym_manc, 4, f, cx - 195, piso - 494, 390, 494)) {
    noStroke();
    fill(230, 70, 70);
    rect(cx - 55, piso - 290, 110, 160, 16);
    fill(230, 180, 140);
    ellipse(cx, piso - 320, 64, 64);
    fill(30);
    if (izqArriba) rect(cx - 140, piso - 400, 60, 28, 8); else rect(cx - 140, piso - 250, 60, 28, 8);
    if (derArriba) rect(cx + 80, piso - 400, 60, 28, 8); else rect(cx + 80, piso - 250, 60, 28, 8);
  }

  for (int i = 0; i < 2; i++) {
    float bx;
    if (i == 0) bx = 470; else bx = 1080;
    float by = 220;
    float bh = 480;
    noStroke();
    fill(50, 50, 60, 220);
    rect(bx - 10, by - 50, 70, bh + 60, 12);
    fill(240, 200, 60);
    rect(bx, by, 50, bh, 8);
    fill(80, 200, 90);
    rect(bx, by + bh * (1 - mcZona[i] - mcAncho[i] / 2), 50, bh * mcAncho[i]);
    if (millis() < mcError) fill(color(220, 60, 60)); else fill(color(20));
    rect(bx - 12, by + bh * (1 - mcMarca[i]) - 4, 74, 8, 4);
    fill(255);
    textSize(22);
    textAlign(CENTER, TOP);
    if (i == 0) text("← izq.", bx + 25, by - 42); else text("der. →", bx + 25, by - 42);
  }
  fill(255);
  textAlign(LEFT, TOP);
  textSize(30);
  text("MANCUERNAS  " + mcReps + " / " + mcMeta, 1180, 260);
  textSize(18);
  text("Cada brazo en su zona verde.\nLa zona cambia de lugar\ny la marca va más rápido.", 1180, 305);
  for (int i = 0; i < GYM_FALLOS_MAX; i++) { if (i < mcFallos) fill(color(220, 70, 60)); else fill(color(90)); ellipse(1195 + i * 34, 410, 24, 24); }
  fill(200);
  textSize(16);
  text("fallos seguidos", 1180, 432);
  textAlign(LEFT, BASELINE);
  dibujarGritoTanque();
  if (mcFin > 0 && millis() > mcFin) terminarMancuernas();
}

// Izquierda o derecha para subir cada brazo a tiempo.
void teclaMancuernas() {
  if (mcFin > 0) return;
  int b = -1;
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') b = 0;
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D' || key == ' ') b = 1;
  if (b < 0) return;
  if (abs(mcMarca[b] - mcZona[b]) <= mcAncho[b] / 2) {
    mcReps++;
    mcFallos = 0;
    mcArriba[b] = millis() + 380;
    mcZona[b] = 0.2 + random(0.65);
    if (abs(mcZona[b] - mcMarca[b]) < 0.2) { if (mcMarca[b] > 0.5) mcZona[b] = mcMarca[b] - 0.35; else mcZona[b] = mcMarca[b] + 0.35; }
    mcAncho[b] = max(0.09, mcAncho[b] * 0.94);
    mcVel[b] *= 1.07;
    gritarTanque(true);
    if (mcReps >= mcMeta) mcFin = millis() + 700;
  } else {
    mcFallos++;
    mcFallosTotal++;
    mcError = millis() + 250;
    gritarTanque(false);
    if (mcFallos >= GYM_FALLOS_MAX) { mcFin = millis() + 700; aviso("Se te resbala la mancuerna. Nadie vio... ¿o sí?"); }
  }
}

// Termina las mancuernas y calcula los puntos.
void terminarMancuernas() {
  int puntos = constrain(mcReps * 100 / mcMeta - mcFallosTotal * 4, 0, 100);
  if (gymSesion) { rondaTerminada(puntos); return; }
  boolean completo = mcReps >= mcMeta;
  if (completo) { hecho("GYM"); if (bandera("RECORD_PESAS") <= 0) sumarBandera("RECORD_PESAS", 1); }
  int minutos = 10 + mcReps * 2;
  String ef = "Ejercicio +" + minutos + " min · Energía −4 · Tiempo +" + minutos + " min";
  if (completo) ef += " · Social +1";
  String aux1;
  if (completo) aux1 = "¡Serie completa!"; else aux1 = "Serie a medias";
  String aux2;
  if (mcFallosTotal > 0) aux2 = " (" + mcFallosTotal + " fallos)"; else aux2 = "";
  String aux3;
  if (completo) aux3 = "Mañana te van a doler hasta las pestañas."; else aux3 = "La próxima sale. Respira y vuelve.";
  resultadoGym(aux1,
    mcReps + " de " + mcMeta + " repeticiones" + aux2 + ".\n" +
    aux3, ef, -1);
}

