// Empieza el minijuego de ordenar pasos.
void iniciarOrden(String c) {
  datosOrden(c);
  ORD_SETS = resDatosOrden;
  orSet = 0;
  orErrores = 0;
  orAciertos = 0;
  orTotal = 0;
  if (c.equals("RECETA")) {
    orFin = millis() + round(facil(B_PASOS_SEGUNDOS) * 1000) + (ORD_SETS.length * B_RECETA_VER_MS);
  } else {
    orFin = millis() + round(facil(B_PASOS_SEGUNDOS) * 1000) + 0;
  }
  prepararSetOrden();
}

// Revuelve los pasos del grupo actual.
void prepararSetOrden() {
  int n = ORD_SETS[orSet].length - 1;
  for (int i = 0; i < n; i++) { orOrden[i] = i; orPuesta[i] = false; }
  for (int i = n - 1; i > 0; i--) { int j = int(random(i + 1)); int t = orOrden[i]; orOrden[i] = orOrden[j]; orOrden[j] = t; }
  orSig = 0;
  if (mj20.equals("RECETA")) orVerHasta = millis() + B_RECETA_VER_MS; else orVerHasta = 0;
}

// Click en el paso que va siguiente.
void clickOrden() {
  if (millis() < orVerHasta) return;
  int n = ORD_SETS[orSet].length - 1;
  for (int i = 0; i < n; i++) {
    if (!orPuesta[orOrden[i]] && dentro(100, 180 + i * 95, 620, 80)) {
      int paso = orOrden[i];
      if (paso == orSig) {
        orPuesta[paso] = true;
        orSig++;
        orAciertos++;
        orTotal++;
        if (orSig >= n) {
          orSet++;
          orMsg = "¡Listo!";
          orMsgHasta = millis() + 900;
          if (orSet < ORD_SETS.length) prepararSetOrden();
        }
      } else {
        orErrores++;
        orTotal++;
        orMsg = "Ese no va todavía";
        orMsgHasta = millis() + 700;
      }
      return;
    }
  }
}

// Dibuja los pasos revueltos y los que ya pusiste en orden.
void dibujarOrden() {
  String c = mj20;
  String t;
  if (c.equals("PASOS")) {
    t = "TUTORÍA · ordena los pasos del ejercicio";
  } else if (c.equals("AUXILIOS")) {
    t = "PRIMEROS AUXILIOS · ¿qué va primero?";
  } else if (c.equals("PIZARRA")) {
    t = "PIZARRA TÁCTICA DE OCHOA";
  } else if (c.equals("BICI")) {
    t = "EL TALLER DE PAPÁ";
  } else if (c.equals("ESTIRAR")) {
    t = "ESTIRAMIENTO CON MARCELA · en orden, sin saltarse ninguno";
  } else if (c.equals("BARRA")) {
    t = "LA BARRA DEL TANQUE · pies, cadera, espalda, brazos";
  } else if (c.equals("MACETA")) {
    t = "LAS MATAS DE DON PABLO · primero el hueco, al final el agua";
  } else {
    t = "COCINANDO CON MAMÁ";
  }
  if (c.equals("RECETA")) {
    fondoMJ(40, 60, 70, t, "Primero mira la receta en orden. Después toca los pasos en el mismo orden.");
  } else {
    fondoMJ(40, 60, 70, t, "Toca las tarjetas en el orden correcto. Errores: " + orErrores);
  }
  int resta = orFin - millis();
  if (c.equals("RECETA")) {
    barraTiempoMJ(resta / (float) (facil(B_PASOS_SEGUNDOS) * 1000 + (ORD_SETS.length * B_RECETA_VER_MS)));
  } else {
    barraTiempoMJ(resta / (float) (facil(B_PASOS_SEGUNDOS) * 1000 + 0));
  }
  if (orSet >= ORD_SETS.length || resta <= 0) {
    int p;
    if (orTotal == 0) {
      p = 0;
    } else {
      p = round(100.0 * orAciertos / max(1, orTotal) * min(1, orSet / (float) ORD_SETS.length + 0.001));
    }
    if (orSet >= ORD_SETS.length) p = max(p, 100 - orErrores * 10);
    finMJ(constrain(p, 0, 100), "Terminaste " + min(orSet, ORD_SETS.length) + " de " + ORD_SETS.length + " con " + orErrores + " errores.");
    return;
  }
  String[] s = ORD_SETS[orSet];
  int n = s.length - 1;
  fill(255, 230, 150);
  textSize(26);
  text(s[0], 100, 160);
  boolean viendo = millis() < orVerHasta;
  for (int i = 0; i < n; i++) {
    int paso;
    if (viendo) paso = i; else paso = orOrden[i];
    float y = 180 + i * 95;
    boolean puesta = !viendo && orPuesta[paso];
    noStroke();
    if (puesta) {
      fill(color(70, 90, 80));
    } else {
      if (dentro(100, y, 620, 80) && !viendo) fill(color(255, 248, 225)); else fill(color(240, 234, 214));
    }
    rect(100, y, 620, 80, 10);
    if (puesta) fill(150); else fill(40);
    textSize(21);
    if (viendo) text((i + 1) + ". " + s[i + 1], 124, y + 48); else text(s[paso + 1], 124, y + 48);
  }

  fill(255);
  textSize(22);
  if (viendo) text("Memoriza el orden...", 820, 160); else text("Tu orden:", 820, 160);
  for (int i = 0; i < orSig && !viendo; i++) {
    fill(120, 210, 150);
    textSize(20);
    text((i + 1) + ". " + s[i + 1], 820, 220 + i * 50);
  }
  if (millis() < orMsgHasta) {
    fill(0, 0, 0, 160);
    rect(820, 760, 520, 54, 10);
    fill(255);
    textSize(24);
    text(orMsg, 850, 796);
  }
}

