    rect(tx - textWidth(s) / 2 - 10, ty - 30, textWidth(s) + 20, 36, 6);
    fill(255);
    textAlign(CENTER, BASELINE);
    text(s, tx, ty - 4);
    ty -= 42;
  }
  textAlign(LEFT, BASELINE);
}

