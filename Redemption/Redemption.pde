  fill(40, 190, 180);
  rect(80, yb + 16, min(700, stats[ST_SEGUIDORES] * 1.4), 30, 6);
  fill(230, 80, 120);
  rect(80, yb + 56, min(700, amigosDeVerdad() * 70), 30, 6);
  fill(40);
  textSize(19);
  text(stats[ST_SEGUIDORES] + " seguidores", 90 + min(700, stats[ST_SEGUIDORES] * 1.4), yb + 38);
  text(amigosDeVerdad() + " amigos de verdad (amistad 60+)", 90 + min(700, amigosDeVerdad() * 70), yb + 78);
  float x2 = 900;
  textSize(20);
  fill(50);
  String[] r = {
    "Perfil de tiempo: " + perfilDeTiempo(),
    "Días equilibrados: " + diasEquilibrados() + " de 10",
    "Tiempo total en el celular: " + nf(totalPantalla() / 60.0, 0, 1) + " h",
    "Deuda de sueño al final: " + nf(deudaSueno, 0, 1),
