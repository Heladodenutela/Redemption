// Se llama al armar el diálogo del día: si no tiene nada que decir, saca un tema
void platicaCorta(int f, boolean hayNodo) {
  if (DLG_PERSONA[f].equals("Familia")) return;
  if (hayNodo || largo(f) > 1) return;
  String p = DLG_PERSONA[f];
  int n = 0;
  for (int k = 0; k < PLATICA.length; k++) if (PLATICA[k][0].equals(p)) n++;
  if (n == 0) return;
  int toca = (dia + f) % n, i = 0;
  for (int k = 0; k < PLATICA.length; k++) {
    if (PLATICA[k][0].equals(p) && i++ == toca) {
      if (tieneTexto(dichasHoy[f], PLATICA[k][1])) return;
      poner(f, '0', PLATICA[k][1], null, null);
      poner(f, '1', PLATICA[k][2], null, null);
      poner(f, '0', PLATICA[k][3], null, null);
      return;
    }
  }
}

