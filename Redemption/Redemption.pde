  String aux2;
  if (claseEstado[claseActual] == 2) aux2 = "  (llegaste tarde)"; else aux2 = "";
  text("Notas " + aux1 + notasClase + aux2, 490, 470);
  fill(110);
  textSize(20);
  text("[E] o click para seguir", 490, 545);
}

// Después del resultado: arma la cola de escenas de la clase.
void despuesDelResultado() {
  escenasDeClase(claseActual);
  String[] e = resEscenasDeClase;
  cinCola = new String[e.length];
  for (int i = 0; i < e.length; i++) cinCola[i] = e[i];
  cinPos = -1;
  cinDeClase = true;
  siguienteEscena();
}

// ============================ CINEMÁTICA DE LA CLASE ============================
// Barras negras arriba y abajo, el personaje en grande, lo que pasa narrado y tus opciones.
String[] cinCola = new String[0];
int cinPos = -1;
int cinPersona = -1;
boolean cinRespondida = false;
String cinTexto = "", cinTu = "", cinReaccion = "";

// Pasa a la siguiente escena de la cola de la clase.
void siguienteEscena() {
  cinPos++;
  while (cinPos < cinCola.length) {
    String n = cinCola[cinPos];
    int f = personaDeNodo(n);
    boolean vale;
    if (cinDeClase) {
      boolean aux1;
      if (f >= 0 && !tieneTexto(nodosHechos, n) && condicionArbol(cuandoNodo(n), n, f)) {
        opcionesDe("A:" + n, f);
        String[][] aux2 = resOpcionesDe;
        aux1 = tamFilas(aux2) > 0;
      } else {
        aux1 = false;
      }
      vale = aux1;
    } else {
      vale = nodoValidoEscena(n, f);
    }
    if (vale) {
      cinPersona = f;
      cinRespondida = false;
      cinTexto = narrar(f, resolverLinea(f, lineaNodo(n)));
      empezarActividad(ACT_CINEMATICA);
      return;
    }
    cinPos++;
  }
  if (cinDeClase) terminarClase();
  else terminarActividad();
}

// "[Se duerme sobre el cuaderno.]" -> "Sofía se duerme sobre el cuaderno."
String narrar(int f, String t) {
  t = quitarBordes(t);
  if (empiezaCon(t, "[") && terminaCon(t, "]")) {
    String adentro = t.substring(1, t.length() - 1);
    String quien = nombreCorto(f);
    if (empiezaCon(adentro, quien)) return adentro;
    return quien + " " + adentro.substring(0, 1).toLowerCase() + adentro.substring(1);
  }
  return nombreCorto(f) + ": “" + sinComillas(t) + "”";
}

// Elige una respuesta en una escena de clase.
void elegirEnCinematica(int i) {
  String n = cinCola[cinPos];
  int f = cinPersona;
  opcionesDe("A:" + n, f);
  String[][] ops = resOpcionesDe;
  if (i < 0 || i >= tamFilas(ops)) return;
  String[] o = ops[i];
  agregarTexto(nodosHechos, n);
  agregarTexto(elecciones, n + ":" + i);
  agregarTexto(respuestasDadas, n + ":" + o[0]);
  String res = aplicarEfectos(o[1], f);
  partirPorLetra(o[2], ' ');
  String[] sig = resPartirPorLetra;
  for (int k = 0; k < sig.length; k++) if (sig[k].length() > 0 && !tieneTexto(nodosAbiertos, sig[k])) agregarTexto(nodosAbiertos, sig[k]);
  cinTu = o[0];
  cinReaccion = reaccionDeOpcion("A:" + n, o, f);
  cinRespondida = true;
  if (!res.equals("")) aviso(res);
  asignarDialogo(f);
}

final float CIN_OPC_X = 470, CIN_OPC_W = 660, CIN_OPC_H = 56;

// Altura de la respuesta i en una escena de clase.
float cinOpcY(int i, int n) {
  return 780 - (n - i) * (CIN_OPC_H + 6);
}

// Dibuja una escena de clase con su texto y respuestas.
void dibujarCinematica() {
  noStroke();
  fill(0, 0, 0, 160);
  rect(0, 0, ANCHO, ALTO);
  fill(0);
  rect(0, 0, ANCHO, 100);
  rect(0, 800, ANCHO, 100);

  int k;
  if (agendaNPC != null && cinPersona >= 0) k = agendaNPC[cinPersona]; else k = -1;
  PImage h;
  if (k >= 0) h = npcHoja[k]; else h = hojaPorNombre(hojaDePersona(cinPersona));
  int col = (cuadros / VEL_AFK) % 4;
  float esc = 2.3;
  dibujarHoja(h, PJ_CW, PJ_CH, 0, col, 250 - PJ_CENTRO * esc, 790 - PJ_PIES * esc, esc);

  fill(255);
  textSize(30);
  textAlign(CENTER, TOP);
  text(cinTexto, 420, 130, 1100, 170);
  if (!cinRespondida) {
    opcionesDe("A:" + cinCola[cinPos], cinPersona);
    String[][] ops = resOpcionesDe;
    int n = tamFilas(ops);
    for (int i = 0; i < n; i++) {
      float y = cinOpcY(i, n);
      boolean encima = mouseX > CIN_OPC_X && mouseX < CIN_OPC_X + CIN_OPC_W && mouseY > y && mouseY < y + CIN_OPC_H;
      if (encima) fill(color(255, 235, 180)); else fill(color(250, 246, 235, 235));
      rect(CIN_OPC_X, y, CIN_OPC_W, CIN_OPC_H, 10);
      fill(30);
      textSize(18);
      textAlign(LEFT, CENTER);
      text((i + 1) + ".  " + ops[i][0], CIN_OPC_X + 18, y + 2, CIN_OPC_W - 30, CIN_OPC_H - 4);
    }
  } else {
    fill(200, 230, 255);
    textSize(24);
    textAlign(CENTER, TOP);
    text("Tú: " + cinTu, 420, 360, 1100, 120);
    fill(255, 235, 180);
    text(nombreCorto(cinPersona) + ": " + sinComillas(cinReaccion), 420, 500, 1100, 120);
    fill(170);
    textSize(18);
    text("[E] o click para seguir", 970, 830);
  }
  textAlign(LEFT, BASELINE);
}

// Qué respuesta de la escena de clase está bajo el mouse.
int cinOpcionBajoMouse() {
  opcionesDe("A:" + cinCola[cinPos], cinPersona);
  String[][] aux1 = resOpcionesDe;
  int n = tamFilas(aux1);
  for (int i = 0; i < n; i++) {
    float y = cinOpcY(i, n);
    if (mouseX > CIN_OPC_X && mouseX < CIN_OPC_X + CIN_OPC_W && mouseY > y && mouseY < y + CIN_OPC_H) return i;
  }
  return -1;
}

// ============================ 1. PROYECTIL (Física) ============================
// Flechas o WASD: arriba/abajo el ángulo, izquierda/derecha la fuerza. ESPACIO dispara. 3 tiros.
// Nivel 2: viento, nivel 3+: el blanco se mueve.
float pyAng, pyPot, pyBX, pyBY, pyVX, pyVY, pyBlancoX, pyBlancoDir, pyViento;
int pyTiros, pyAciertos, pyFinMs;
boolean pyVolando;
String pyMensaje = "";

// Empieza el tiro parabólico: ángulo, potencia y tiros.
void iniciarProyectil() {
  pyAng = 45;
  pyPot = 15;
  pyTiros = 0;
  pyAciertos = 0;
  pyVolando = false;
  pyFinMs = 0;
  pyBlancoX = random(850, 1350);
  pyBlancoDir = 1;
  if (nivelClase() >= 2) pyViento = random(-0.06, 0.06); else pyViento = 0;
  pyMensaje = "Ajusta el ángulo y la fuerza";
}

// Dibuja el tiro parabólico: cañón, trayectoria y la diana.
void dibujarProyectil() {
  noStroke();
  fill(225, 235, 250);
  rect(0, 0, ANCHO, ALTO);
  fill(120, 170, 110);
  rect(0, PY_SUELO, ANCHO, ALTO - PY_SUELO);

  if (nivelClase() >= 3 && !pyVolando) {
    pyBlancoX += pyBlancoDir * 2 * pasoCuadro;
    if (pyBlancoX < 800 || pyBlancoX > 1450) pyBlancoDir *= -1;
  }

  fill(220, 60, 60);
  rect(pyBlancoX, PY_SUELO - 14, 90, 14);
  fill(255);
  rect(pyBlancoX + 30, PY_SUELO - 14, 30, 14);
  fill(220, 60, 60, 60);
  rect(pyBlancoX - 8, PY_SUELO, 106, 8);

  float a = radians(pyAng);
  dibujarCanonCuadros(a);

  if (!pyVolando) {
    float x = PY_CANON_X, y = PY_SUELO - 20, vx = cos(a) * pyPot, vy = -sin(a) * pyPot;
    fill(80, 80, 80, 120);
    for (int i = 0; i < pasosPreviaFisica(); i++) {
      for (int j = 0; j < 3; j++) { vx += pyViento; vy += PY_GRAVEDAD; x += vx; y += vy; }
      if (y > PY_SUELO) break;
      ellipse(x, y, 6, 6);
    }
  }

  if (pyVolando) {
    for (int pc = 0; pc < pasoCuadro && pyBY < PY_SUELO; pc++) {
      pyVX += pyViento;
      pyVY += PY_GRAVEDAD;
      pyBX += pyVX;
      pyBY += pyVY;
    }
    fill(40);
    ellipse(pyBX, pyBY, 18, 18);
    if (pyBY >= PY_SUELO || pyBX > ANCHO + 50) {
      pyVolando = false;
      pyTiros++;
      boolean acierto = pyBX >= pyBlancoX - 8 && pyBX <= pyBlancoX + 98;
      if (acierto) pyAciertos++;
      if (acierto) {
        pyMensaje = "¡En el blanco!";
      } else {
        if (pyBX < pyBlancoX) pyMensaje = "Te quedaste corto"; else pyMensaje = "Te pasaste";
      }
      if (pyTiros < PY_TIROS) pyBlancoX = random(800, 1400);
      if (pyTiros >= PY_TIROS) pyFinMs = millis() + 1200;
    }
  }
  fill(30);
  textSize(24);
  textAlign(LEFT, BASELINE);
  text("PROYECTIL · ángulo " + int(pyAng) + "°  ·  fuerza " + int(pyPot) + "  ·  tiros " + pyTiros + "/" + PY_TIROS + "  ·  aciertos " + pyAciertos, 40, 50);
  textSize(20);
  if (pyViento != 0) {
    if (pyViento > 0) {
      text("↑↓ ángulo · ←→ fuerza · ESPACIO disparar" + ("   ·   viento " + "→"), 40, 85);
    } else {
      text("↑↓ ángulo · ←→ fuerza · ESPACIO disparar" + ("   ·   viento " + "←"), 40, 85);
    }
  } else {
    text("↑↓ ángulo · ←→ fuerza · ESPACIO disparar" + "", 40, 85);
  }
  textAlign(CENTER, BASELINE);
  textSize(28);
  text(pyMensaje, 800, 200);
  textAlign(LEFT, BASELINE);
  if (pyFinMs > 0 && millis() > pyFinMs) {
    int notas;
    if (pyAciertos >= 2) notas = 3; else if (pyAciertos == 1) notas = 1; else notas = -1;
    terminarMinijuegoClase(notas, pyAciertos + " de " + PY_TIROS + " tiros en el blanco.");
  }
}

final float CUADRO = 12;

// Dibuja el cañón con cuadros (si no hay sprite).
void dibujarCanonCuadros(float a) {
  noStroke();

  for (int i = 0; i < 6; i++) {
    for (int j = -1; j <= 0; j++) {
      float cx = PY_CANON_X + cos(a) * (i * CUADRO + 6) - sin(a) * (j * CUADRO + 6);
      float cy = PY_SUELO - 34 - sin(a) * (i * CUADRO + 6) - cos(a) * (j * CUADRO + 6);
      if (i == 5) fill(40); else if ((i + j) % 2 == 0) fill(70); else fill(90);
      pushMatrix();
      translate(cx, cy);
      rotate(-a);
      rect(-CUADRO / 2, -CUADRO / 2, CUADRO, CUADRO);
      popMatrix();
    }
  }

  for (int i = -2; i <= 1; i++) for (int j = 0; j < 2; j++) {
    if ((i + j) % 2 == 0) fill(110, 80, 50); else fill(130, 80, 50);
    rect(PY_CANON_X + i * CUADRO, PY_SUELO - 34 + j * CUADRO, CUADRO, CUADRO);
  }

  fill(50);
  rect(PY_CANON_X - 30, PY_SUELO - 12, CUADRO, CUADRO);
  rect(PY_CANON_X + 18, PY_SUELO - 12, CUADRO, CUADRO);
}

// Flechas para cambiar ángulo y potencia, ESPACIO para disparar.
void teclaProyectil() {
  if (pyVolando || pyTiros >= PY_TIROS) return;
  if ((key == CODED && keyCode == UP) || key == 'w' || key == 'W') pyAng = min(85, pyAng + 3);
  if ((key == CODED && keyCode == DOWN) || key == 's' || key == 'S') pyAng = max(5, pyAng - 3);
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') pyPot = min(30, pyPot + 1);
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') pyPot = max(5, pyPot - 1);
  if (key == ' ') {
    float a = radians(pyAng);
    pyBX = PY_CANON_X + cos(a) * 78;
    pyBY = PY_SUELO - 34 - sin(a) * 78;
    pyVX = cos(a) * pyPot;
    pyVY = -sin(a) * pyPot;
    pyVolando = true;
    pyMensaje = "";
  }
}

