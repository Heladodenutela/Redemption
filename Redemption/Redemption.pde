}

// Click en un tema para escribirle.
boolean clickEscribirV21() {
  if (!puedeEscribirV21()) return false;
  int p = personaDeChatV21();
  temasV21(p);
  int[] t = resTemasV21;
  int n = tamInt(t);
  float y0 = celY2 - BARRA_ENV - n * ESC_ALTO - 8;
  for (int i = 0; i < n; i++) {
    float y = y0 + i * ESC_ALTO;
    if (mouseX > celX1 + 12 && mouseX < celX2 - 12 && mouseY > y && mouseY < y + ESC_ALTO - 8) {
      escribirV21(p, t[i + 1]);
