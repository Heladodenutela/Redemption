  int k = retoDeHoy();
  if (k < 0) return;
  String[] r = { "Retos Aurora · " + RETOS[k][1], RETOS[k][2] + "\n\nPremio: " + RETOS[k][4], "reto", "-1", null };
  int n = tamFilas(feed);
  if (n >= feed.length) return;
  if (minutoAhora() < HORA_RETO_PRIMERO) {
    for (int i = n; i > feedPos; i--) feed[i] = feed[i - 1];
    feed[feedPos] = r;
  } else feed[n] = r;
}

// Si aceptaste el reto de hoy y lo cumpliste, da la recompensa.
void revisarRetos() {
  int k = retoDeHoy();
  if (k < 0 || bandera("RETO_ACEPTADO_D" + dia) <= 0 || bandera("RETO_CUMPLIDO_D" + dia) > 0) return;
  if (!hechoHoy(RETOS[k][3])) return;
  sumarBandera("RETO_CUMPLIDO_D" + dia, 1);
  String res = aplicarEfectos(RETOS[k][4], -1);
  aviso("¡Reto cumplido! " + RETOS[k][1] + "  " + res);
}

