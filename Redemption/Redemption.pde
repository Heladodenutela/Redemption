// Revisa si llegó la hora de un plan y si fuiste.
void revisarPlanes() {
  revisarRespuestaPlan();
  int m = minutoAhora();
  for (int i = 0; i < planN; i++) {
    if (planEstado[i] == 1) {
  
      if (dia == planDia[i] && m >= planMin[i] - 10 && m < planMin[i] + 60 && mapaPorCodigo(LUGARES_PLAN[planLugar[i]][1]) == mapaActual) planLlego[i] = true;
      boolean seguir10 = true;
      if (dia > planDia[i] || (dia == planDia[i] && m >= planMin[i] + 60)) {
        if (planLlego[i]) { planEstado[i] = 2; seguir10 = false; }
        if (seguir10) {
          planEstado[i] = 3;
          int f = personaIndice(planPersona[i]);
          if (f >= 0) { cambiarAmistad(f, -6); if (llegaMensaje(nombreChat(f), 1)) agregarMensaje(nombreChat(f), '1', "Te esperé una hora en " + LUGARES_PLAN[planLugar[i]][0] + ". Ni un mensaje."); }
        }
      }
    }
  }
}

// R: si hay un plan con esta persona aquí y ahora, la charla del plan
boolean planAlHablar(int f) {
  if (f < 0) return false;
  int m = minutoAhora();
  for (int i = 0; i < planN; i++) {
    if (planEstado[i] == 1 && planPersona[i].equals(DLG_PERSONA[f]) && planDia[i] == dia && mapaPorCodigo(LUGARES_PLAN[planLugar[i]][1]) == mapaActual && m >= planMin[i] - 10) {
      planEstado[i] = 2;
      boolean tarde = m > planMin[i] + 20;
      armarEscenaPlan(f, tarde);
      empezarEscena("PLAN");
      return true;
    }
  }
  return false;
}

