}

// Minutos totales de pantalla en los 10 días.
int totalPantalla() {
  int n = 0;
  for (int d = 1; d <= 10; d++) n += pantallaHist[d];
  if (!diaGuardado[dia]) n += stats[ST_PANTALLA];
  return n;
}

// Tu perfil de tiempo según la categoría en que más te pasaste.
String perfilDeTiempo() {
  int mejor = 0;
  float mejorFrac = -1;
  for (int c = 0; c < 5; c++) {
    float frac = totalCategoria(c) / (float) max(1, idealMax(c, 3) * 10);
    if (frac > mejorFrac) { mejorFrac = frac; mejor = c; }
  }
  String[] p = { "Estudioso", "Dormilón", "Deportista", "Sociable", "Conectado" };
  if (diasEquilibrados() >= 5) return "Equilibrado (y un poco " + p[mejor].toLowerCase() + ")";
  return p[mejor];
}

