// #####################################################################################
//   VECTORES (en vez de listas)
//   int[]:    en la posición [0] va cuántos elementos hay; los datos van de [1] en adelante
//             (se trata como si empezara en 1).
//   String[]: los datos van desde [0] y se agrega en el primer lugar vacío (null) que haya.
//   String[][]: igual, se agrega una fila en la primera fila vacía (null).
//   Todos se declaran lo bastante grandes para el peor caso; si se llenan, lo nuevo no entra.
// #####################################################################################

// ---- int[] con la cantidad en [0] ----
// Agrega un número al final de un vector de enteros (la casilla 0 guarda cuántos hay).
void agregarInt(int[] v, int x) {
  if (v[0] + 1 < v.length) {
    v[0]++;
    v[v[0]] = x;
  }
}

// Cuántos números tiene un vector de enteros.
int tamInt(int[] v) {
  return v[0];
}

// ¿El vector de enteros tiene este número?
boolean tieneInt(int[] v, int x) {
  for (int i = 1; i <= v[0]; i++) if (v[i] == x) return true;
  return false;
}

// Quita el elemento i (de 1 a tamInt) corriendo los de atrás
void quitarIntEn(int[] v, int i) {
  for (int j = i; j < v[0]; j++) v[j] = v[j + 1];
  v[0]--;
}

// Deja vacío un vector de enteros.
void vaciarInt(int[] v) {
  v[0] = 0;
}

// Revuelve los elementos (de 1 a tamInt)
void barajarInt(int[] v) {
  for (int i = v[0]; i > 1; i--) {
    int j = 1 + int(random(i));
    int t = v[i];
    v[i] = v[j];
    v[j] = t;
  }
}

// ---- String[]: se llena hasta el primer null ----
// Agrega un texto en la primera casilla vacía (null) de un vector de textos.
void agregarTexto(String[] v, String x) {
  for (int i = 0; i < v.length; i++) {
    if (v[i] == null) {
      v[i] = x;
      return;
    }
  }
}

// Cuántos textos tiene un vector (hasta la primera casilla vacía).
int tamTexto(String[] v) {
  int n = 0;
  while (n < v.length && v[n] != null) n++;
  return n;
}

// ¿El vector de textos tiene este texto?
boolean tieneTexto(String[] v, String x) {
  for (int i = 0; i < v.length && v[i] != null; i++) if (v[i].equals(x)) return true;
  return false;
}

// Quita el elemento i corriendo los de atrás
void quitarTextoEn(String[] v, int i) {
  int n = tamTexto(v);
  for (int j = i; j < n - 1; j++) v[j] = v[j + 1];
  if (n > 0) v[n - 1] = null;
}

// Deja vacío un vector de textos.
void vaciarTexto(String[] v) {
  for (int i = 0; i < v.length; i++) v[i] = null;
}

// ---- String[][]: filas hasta la primera null ----
// Agrega una fila en la primera casilla vacía de una tabla de textos.
void agregarFila(String[][] m, String[] fila) {
  for (int i = 0; i < m.length; i++) {
    if (m[i] == null) {
      m[i] = fila;
      return;
    }
  }
}

// Cuántas filas tiene una tabla de textos.
int tamFilas(String[][] m) {
  int n = 0;
  while (n < m.length && m[n] != null) n++;
  return n;
}

// Deja vacía una tabla de textos.
void vaciarFilas(String[][] m) {
  for (int i = 0; i < m.length; i++) m[i] = null;
}

