}

// Qué respuesta está debajo del mouse.
int opcionBajoMouse() {
  String clave = nodoActual();
  if (clave == null) return -1;
  opcionesDe(clave, dlgFila);
  String[][] aux1 = resOpcionesDe;
  int n = tamFilas(aux1);
  for (int i = 0; i < n; i++) {
    float y = opcY(i, n);
    if (mouseX > OPC_X && mouseX < OPC_X + OPC_W && mouseY > y && mouseY < y + OPC_H) return i;
  }
  return -2;
}

// Dibuja la caja de diálogo con el retrato, el nombre y el texto.
void dibujarDialogo() {
  int col = (cuadros / VEL_AFK) % 4;
  dibujarOpcionesDialogo();
  if (quienActual() == '1') {
    dibujarCajaDialogo("Tú", lineaActual(), pj_protagonista, FILA_AFK, col, RETRATO_RECORTE);
  } else {
    boolean gato = dlgNPC == newtonNPC;
    retratoExpr = retratoDe(dlgFila);
    if (amistad[dlgFila] >= 70) {
      retratoCol = 1;
    } else {
      if (amistad[dlgFila] < 25 || teEvita(dlgFila)) retratoCol = 2; else retratoCol = 0;
    }
    if (gato) {
      dibujarCajaDialogo(nombreCorto(dlgFila), lineaActual(), npcHoja[dlgNPC], npcFilaAFK(dlgNPC), col, RETRATO_NEWTON);
    } else {
      dibujarCajaDialogo(nombreCorto(dlgFila), lineaActual(), npcHoja[dlgNPC], npcFilaAFK(dlgNPC), col, RETRATO_RECORTE);
    }
    retratoExpr = null;
  }
}

