// Carga las imágenes del fútbol la primera vez que se juega.
void cargarSprites11() {
  if (sprites11Cargados) return;
  sprites11Cargados = true;
  fu_azulBarrida = cargarSiExiste("minijuegos/futbol/jugador_azul_barrida.png");
  fu_rivalBarrida = cargarSiExiste("minijuegos/futbol/jugador_rival_barrida.png");
