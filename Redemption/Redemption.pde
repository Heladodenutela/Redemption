  {"Profa. Valdés", "Recuerden: la entrega del proyecto es por la plataforma de la U, no por correo.", "0", "Es información de la clase, sin enlaces raros ni datos personales."}
};
int trI, trBien;
int[] trOrden = new int[9];
String trExplica = "";
int trExplicaHasta = 0;
boolean trUltBien;

// Empieza el minijuego de mensajes trampa con los mensajes revueltos.
void iniciarTrampa() {
  vaciarInt(trOrden);
  for (int k = 0; k < TR_MSGS.length; k++) agregarInt(trOrden, k);
  barajarInt(trOrden);
  trI = 0;
  trBien = 0;
  trExplicaHasta = 0;
}

// Dices si el mensaje es confiable o trampa, y se explica por qué.
void responderTrampa(boolean esTrampa) {
  if (millis() < trExplicaHasta || trI >= 6) return;
  String[] m = TR_MSGS[trOrden[trI + 1]];
  trUltBien = (m[2].equals("1")) == esTrampa;
  if (trUltBien) trBien++;
  trExplica = m[3];
  trExplicaHasta = millis() + 2600;
  trI++;
}

// Click en Confiable o en Trampa.
void clickTrampa() {
  if (dentro(420, 640, 340, 80)) responderTrampa(false);
  if (dentro(840, 640, 340, 80)) responderTrampa(true);
}

// Dibuja el mensaje, los botones y la explicación.
void dibujarTrampa() {
  fondoMJ(20, 70, 60, "¿CONFIABLE O TRAMPA?  (" + min(trI + 1, 6) + "/6)", "Lee el mensaje. 1 = confiable · 2 = trampa (o click).");
  if (trI >= 6 && millis() > trExplicaHasta) {
    int p = round(100.0 * trBien / 6);
    finMJ(p, "Acertaste " + trBien + " de 6.\nPistas de una trampa: urgencia, enlaces raros, te piden contraseña o plata, y premios que no jugaste.");
    return;
  }
  if (millis() < trExplicaHasta) {
    noStroke();
    if (trUltBien) fill(color(60, 160, 90)); else fill(color(190, 70, 60));
    rect(300, 300, 1000, 260, 16);
    fill(255);
    textSize(30);
    if (trUltBien) text("¡Bien!", 340, 360); else text("Ojo...", 340, 360);
    textSize(24);
    text(trExplica, 340, 390, 920, 150);
    return;
  }
  String[] m = TR_MSGS[trOrden[trI + 1]];
  noStroke();
  fill(240, 250, 245);
  rect(300, 200, 1000, 360, 16);
  fill(20, 110, 80);
  textSize(24);
  text(m[0], 340, 250);
  fill(40);
  textSize(26);
  text(m[1], 340, 280, 920, 240);
  botonMJ(420, 640, 340, 80, "1 · Confiable", color(60, 140, 90));
  botonMJ(840, 640, 340, 80, "2 · Trampa", color(190, 70, 60));
}

// ============================ 11. CARTEL (pintar el gato astronauta) ============================
String[] CARTEL_MODELO = {
  "0000220000",
  "0002442000",
  "0024114200",
  "0241111420",
  "0241331420",
  "0024114200",
  "0002442000"
};
int[][] CE_COL = { {30, 30, 60}, {250, 230, 200}, {230, 90, 70}, {80, 90, 110}, {250, 200, 60} };
String[] CE_NOM = { "Espacio", "Gato", "Casco", "Ojos", "Estrellas" };
int[][] cePint = new int[7][10];
int ceColor = 1, ceFin;

// Empieza el minijuego del cartel para Lili.
void iniciarCartel() {
  for (int f = 0; f < 7; f++) for (int c = 0; c < 10; c++) cePint[f][c] = 0;
  ceColor = 1;
  ceFin = millis() + round(facil(45) * 1000);
}

// Elegir un color o pintar una casilla del cartel.
void clickCartel() {
  for (int i = 0; i < 5; i++) if (dentro(1250, 200 + i * 90, 260, 76)) { ceColor = i; return; }
  if (dentro(1250, 700, 260, 70)) { terminarCartel(); return; }
  int c = int((mouseX - 200) / 90), f = int((mouseY - 180) / 90);
  if (c >= 0 && c < 10 && f >= 0 && f < 7 && mouseX >= 200 && mouseY >= 180) cePint[f][c] = ceColor;
}

// Califica el cartel según cuántas casillas quedaron como el modelo.
void terminarCartel() {
  int bien = 0;
  for (int f = 0; f < 7; f++) for (int c = 0; c < 10; c++) if (cePint[f][c] == letraEn(CARTEL_MODELO[f], c) - '0') bien++;
  int p = round(100.0 * bien / 70);
  if (p >= 80) {
    finMJ(p, "Un gato astronauta perfecto. Iris aplaude.");
  } else if (p >= 50) {
    finMJ(p, "Se entiende que es un gato... en el espacio... más o menos.");
  } else {
    finMJ(p, "Es arte moderno. Lili lo va a amar igual.");
  }
}

// Dibuja el cartel, el modelo y los colores.
void dibujarCartel() {
  fondoMJ(60, 50, 80, "EL CARTEL PARA LILI", "Elige un color a la derecha y pinta las casillas igual que el modelo (arriba a la derecha).");
  int resta = ceFin - millis();
  barraTiempoMJ(resta / (facil(45) * 1000));
  noStroke();
  for (int f = 0; f < 7; f++) for (int c = 0; c < 10; c++) {
    int[] k = CE_COL[cePint[f][c]];
    fill(k[0], k[1], k[2]);
    rect(200 + c * 90, 180 + f * 90, 86, 86, 6);
  }

  for (int f = 0; f < 7; f++) for (int c = 0; c < 10; c++) {
    int[] k = CE_COL[letraEn(CARTEL_MODELO[f], c) - '0'];
    fill(k[0], k[1], k[2]);
    rect(1250 + c * 22, 40 + f * 18, 21, 17);
  }
  for (int i = 0; i < 5; i++) {
    int[] k = CE_COL[i];
    if (i == ceColor) fill(color(255)); else fill(color(0, 0, 0, 0));
    rect(1244, 194 + i * 90, 272, 88, 12);
    fill(k[0], k[1], k[2]);
    rect(1250, 200 + i * 90, 260, 76, 10);
    if (i == 1 || i == 4) fill(30); else fill(255);
    textSize(20);
    text(CE_NOM[i], 1270, 246 + i * 90);
  }
  botonMJ(1250, 700, 260, 70, "¡Listo!", color(60, 150, 90));
  if (resta <= 0) terminarCartel();
}

