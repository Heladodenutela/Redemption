// ---- Nadie se queda encerrado ----
// Un lugar cerrado no deja ENTRAR, pero siempre deja SALIR hacia la casa. "Hacia la casa" = el mapa
// de llegada está más cerca de tu cuarto (en pasos) que el mapa donde estás. Las distancias se sacan
// con las conexiones que valen ese día (algunas cambian, como el parque el día 6).
int[] distCasa = new int[NUM_MAPAS];
int distCasaDia = -1;

// Cuántos mapas hay desde cada lugar hasta tu cuarto (para mandarte a casa si te duermes en la calle).
void calcularDistanciaCasa() {
  for (int m = 0; m < NUM_MAPAS; m++) distCasa[m] = -1;
  distCasa[C5] = 0;
  boolean cambio = true;
  while (cambio) {
    cambio = false;
    for (int c = 0; c < numConexiones; c++) {
      if (diaValido(c)) {
        int a = conexiones[c][CX_ORIGEN];
        int b = conexiones[c][CX_DESTINO];
        if (distCasa[b] >= 0 && (distCasa[a] < 0 || distCasa[b] + 1 < distCasa[a])) {
          distCasa[a] = distCasa[b] + 1;
          cambio = true;
        }
      }
    }
  }
  distCasaDia = dia;
}

// ¿Esta conexión te deja más cerca de tu cuarto?
boolean vaHaciaLaCasa(int c) {
  if (distCasaDia != dia) calcularDistanciaCasa();
  int a = conexiones[c][CX_ORIGEN];
  int b = conexiones[c][CX_DESTINO];
  if (distCasa[b] < 0) return false;
  return distCasa[a] < 0 || distCasa[b] < distCasa[a];
}

// Al pasar por un lugar que ya cerró, se avisa que solo es de salida
void avisarSiSoloSalida(int c) {
  int b = conexiones[c][CX_DESTINO];
  if (!abierto("MAPA", MAPA_COD[b])) aviso(MAPA_NOMBRE[b] + " ya cerró: puedes pasar, pero solo hacia la salida.");
}

// #####################################################################################
//   LIMITAR A 30 CUADROS POR SEGUNDO
//   - En Pausa > Ajustes hay un interruptor "Limitar a 30 FPS". Se guarda en cuenta.txt
//     (fps30=true/false), así que vale para todas las partidas.
//   - El reloj del juego y los minijuegos de las escenas usan millis(), así que no cambian.
//   - Lo que se mueve "un poquito en cada cuadro" (caminar, la gente, la lluvia, el rugby,
//     el fútbol, Flappy, Pong, el Royale, la Torre, el cañón, los bichos, las notificaciones...)
//     usa pasoCuadro: vale 1 a 60 FPS y 2 a 30 FPS. Así, a 30 FPS cada cosa avanza el doble
//     en cada cuadro y en un segundo recorre lo mismo.
//   - Las animaciones de los sprites cuentan "cuadros" en vez de frameCount: sube 1 por
//     cuadro a 60 FPS y 2 por cuadro a 30 FPS, así caminan igual de rápido en los dos.
// #####################################################################################
boolean limitar30 = false;
int pasoCuadro = 1;
int cuadros = 0;

// Lo llama setup() después de leer la cuenta
void iniciarV25() {
  aplicarFPS();
}

// Pone la velocidad de draw() y el paso que corresponde
void aplicarFPS() {
  if (limitar30) {
    frameRate(30);
    pasoCuadro = 2;
  } else {
    frameRate(60);
    pasoCuadro = 1;
  }
}

// Prende o apaga el límite de 30 cuadros por segundo y lo guarda en la cuenta.
void cambiarLimiteFPS() {
  limitar30 = !limitar30;
  aplicarFPS();
  guardarCuenta();
}

// El interruptor en Pausa > Ajustes
void dibujarOpcionFPS(float x, float y) {
  fill(40);
  textSize(24);
  text("Rendimiento", x, y - 14);
  interruptor(x, y, limitar30, "Limitar a 30 FPS (menos trabajo para el computador)");
  fill(110);
  textSize(16);
  text("Úsalo si el juego se traba en tu computador. Todo se mueve a la misma velocidad; solo se ve un poco menos suave. "
    + "Ahora: " + round(frameRate) + " cuadros por segundo.", x + INT_W + 30, y + 8, 520, 70);
}

// Click en el interruptor de 30 cuadros por segundo.
boolean clickOpcionFPS(float x, float y) {
  if (mouseX > x && mouseX < x + INT_W && mouseY > y && mouseY < y + INT_H) {
    cambiarLimiteFPS();
    return true;
  }
  return false;
}

// ============================ AHORRO DE TRABAJO ============================
// El reloj avanza medio minuto de juego cada medio segundo. La agenda de las personas, la
// Galería y los logros no cambian a cada rato: se revisan una vez por bloque de 5 minutos.
int agendaBloque = -1;
int galeriaBloque = -1, galeriaMapa = -1;
int logrosBloque = -1, logrosDinero = 0, logrosSeg = 0, logrosSocial = 0;

// Número del bloque de 5 minutos del juego en el que vamos (horagp sube 10 cada 5 minutos)
int bloqueCincoMin() {
  return (horagp + 2880) / 10;
}

