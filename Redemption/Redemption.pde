String avisoMJ = "";
int avisoMJDesde = 0;
boolean avisoMJTapa = true;

// ¿Está abierto el cartel de cómo se juega?
boolean avisoMJActivo() {
  return !avisoMJ.equals("");
}

// Fila del cartel de un minijuego en la tabla AVISOS_MJ.
int filaAvisoMJ(String c) {
  for (int k = 0; k < AVISOS_MJ.length; k++) if (AVISOS_MJ[k][0].equals(c)) return k;
  return -1;
}

// Abre el cartel de cómo se juega antes de un minijuego (el reloj se detiene mientras tanto).
void pedirAvisoMJ(String c) {
  if (filaAvisoMJ(c) < 0) return;
  avisoMJ = c;
  avisoMJDesde = millis();
  avisoMJTapa = true;
}

// Abre el cartel de un juego del celular.
void pedirAvisoCelular(String c) {
  pedirAvisoMJ(c);
  avisoMJTapa = false;
}

// Cierra el cartel y corre los tiempos del minijuego lo que estuvo abierto.
void cerrarAvisoMJ() {
  if (!avisoMJActivo()) return;
  int d = millis() - avisoMJDesde;
  avisoMJ = "";
  desplazarTiempos(d);
}

// El código del minijuego de cada actividad (los de las escenas usan su propio código: mj20)
String codigoAvisoActividad(int a) {
  if (a == ACT_MJ20) return mj20;
  if (a == ACT_INSOMNIO) return "INSOMNIO";
  if (a == ACT_KARAOKE) return "KARAOKE";
  if (a == ACT_ESTUDIO_JUEGO) return "ESTUDIO";
  if (a == ACT_ARC_ROYALE) return "ROYALE";
  if (a == ACT_ARC_TORRE) return "TORRE";
  if (a == ACT_ARC_DUELO) return "DUELO";
  if (a == ACT_FUTBOL) return "PENALES";
  if (a == ACT_NATACION) return "NATACION";
  if (a == ACT_GYM_REPS) return "REPS";
  if (a == ACT_GYM_CAMINADORA) return "CAMINADORA";
  if (a == ACT_CICLISMO) return "CICLISMO";
  if (a == ACT_GYM_PRESS) return "PRESS";
  if (a == ACT_GYM_MANC) return "MANCUERNAS";
  if (a == ACT_PICADO) return "PICADO";
  if (a == ACT_CLASE_JUEGO) {
    if (mjActual == MJ_PROYECTIL) return "PROYECTIL";
    if (mjActual == MJ_PENDIENTE) return "PENDIENTE";
    if (mjActual == MJ_BALANZA) return "BALANZA";
    if (mjActual == MJ_BICHOS) return "BICHOS";
    if (mjActual == MJ_CALCULO) return "CALCULO";
    return "PENDULO";
  }
  return "";
}

// Lo llama empezarActividad(): si la actividad es un minijuego, primero sale su cartel
void avisoAlEmpezarActividad(int a) {
  String c = codigoAvisoActividad(a);
  if (!c.equals("")) pedirAvisoMJ(c);
}

// ¿Esta actividad es un minijuego?
boolean esActividadMinijuego(int a) {
  return !codigoAvisoActividad(a).equals("");
}

