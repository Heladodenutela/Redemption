// ¿Están las imágenes de los billetes y monedas?
boolean vueltosConSprites() {
  return hay(mjDinero[0]) && hay(mjDinero[3]);
}

// Qué imagen corresponde a cada valor de billete o moneda.
int imagenDeBillete(int valor) {
  if (valor == 1) return 0;
  if (valor == 2) return 1;
  if (valor == 5) return 2;
  if (valor == 10) return 3;
  return 4;
}

// Dibuja los vueltos con sprites: cliente, canasta y dinero.
void dibujarVueltosSprites() {
  boolean impaciente = millis() - vtDesde > 12000;
  dibujarClienteMJ(vtCliente, impaciente, 130, 230);
  if (hay(mjCanasta)) image(mjCanasta, 40, 640);
  noStroke();
  fill(255, 250, 235);
  rect(320, 160, 960, 330, 14);
  fill(40);
  textSize(24);
  text("El cliente lleva:", 360, 200);
  for (int i = 0; i < vtNProd; i++) {
    float x = 360 + i * 170;
    int k = vtProd[i];
    if (hay(mjProductos[k])) image(mjProductos[k], x + 25, 212);
    fill(60);
    textSize(17);
    textAlign(CENTER, BASELINE);
    text(VT_PRODUCTOS[k] + " $" + VT_PRECIO[k], x + 65, 316);
    textAlign(LEFT, BASELINE);
  }
  fill(40);
  textSize(24);
  text("Paga con:", 900, 200);
  int b = imagenDeBillete(vtPaga);
  if (b < mjDinero.length && hay(mjDinero[b])) image(mjDinero[b], 1060, 172);
  else text("$" + vtPaga, 1060, 200);
  textSize(32);
  text("Total: $" + vtTotal, 360, 385);
  fill(30, 110, 60);
  textSize(28);
  text("Vuelto que vas dando: $" + vtDado, 360, 450);
  if (hay(mjPlatico)) image(mjPlatico, 900, 345);
  for (int i = 0; i < vtDadoN; i++) {
    int k = vtDadoLista[i];
    if (k >= 0 && k < mjDinero.length && hay(mjDinero[k])) {
      float x = 925 + (i % 8) * 34, y = 365 + (i / 8) * 14;
      image(mjDinero[k], x, y, 71, 46);
    }
  }
  for (int i = 0; i < VT_BILLETES.length; i++) {
    float x = 560 + i * 190;
    boolean enc = dentro(x, 560, 170, 110);
    float sube = 0;
    if (enc) {
      sube = 8;
      noStroke();
      fill(0, 0, 0, 60);
      ellipse(x + 85, 674, 150, 18);
    }
    image(mjDinero[i], x, 560 - sube);
  }
}

// ============================ 2. TURNOS MÁS CORTOS (Cantina, Heladería, Flores, Vueltos y Latte) ============================
// Fácil: un tercio del tiempo, Normal: la mitad, Difícil: el tiempo completo.
// El minijuego dura menos, pero el reloj del juego avanza lo mismo: al terminar se suman a mano los
// minutos que faltan para completar los de la tabla MJ_INFO (ver finMJ).
float[] TURNO_FRACCION = { 1.0 / 3, 0.5, 1.0 };
int[] LATTE_FIGURAS_DIF = { 1, 2, 3 };

// Cuánto dura un turno según la dificultad (Fácil un tercio, Normal la mitad).
float factorTurno() {
  return TURNO_FRACCION[constrain(dificultad, 0, 2)];
}

// Cuántos pedidos hay que atender para sacar el puntaje completo (según la dificultad).
int metaPedidos() {
  return max(2, round(5 * factorTurno()));
}

// Cuántos clientes hay que atender según la dificultad.
int metaVueltos() {
  return max(2, round(6 * factorTurno()));
}

// Cuántas figuras toca dibujar según la dificultad.
int figurasLatte() {
  return LATTE_FIGURAS_DIF[constrain(dificultad, 0, 2)];
}

// Minutos del juego que ya pasaron desde que empezó el minijuego (el reloj corre mientras juegas)
int mj20HoraInicio = 0;

// Minutos del juego desde que empezó el minijuego.
int minutosDesdeInicioMJ() {
  return max(0, (horagp - mj20HoraInicio) / 2);
}

