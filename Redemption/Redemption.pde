  fondoMJ(246, 244, 250, "", "");
  fill(40);
  textSize(30);
  textAlign(LEFT, BASELINE);
  text("Aurora+ · Subir foto", 60, 58);
  float anchoTit = textWidth("Aurora+ · Subir foto");
  if (ftPaso > 0) {
    fill(120);
    textSize(20);
    text(nombreFoto(ftFoto), 60 + anchoTit + 28, 58);
  }

  for (int i = 0; i < FT_PASOS.length; i++) {
    float x = 60 + i * 230, y = 82;
    boolean act = ftPaso == i + 1, listo = ftPaso > i + 1;
    noStroke();
    if (act) fill(color(110, 80, 200)); else if (listo) fill(color(205, 195, 240)); else fill(color(228, 226, 234));
    rect(x, y, 216, 40, 20);
    if (act) fill(255); else if (listo) fill(color(70, 50, 140)); else fill(140);
    textSize(18);
    textAlign(CENTER, CENTER);
    text((i + 1) + ". " + FT_PASOS[i], x + 108, y + 18);
  }
  textAlign(LEFT, BASELINE);
  if (ftPaso == 0) { dibujarElegirFoto(); botonesFoto(); return; }
  dibujarVistaPrevia();

  fill(40);
  textSize(24);
  textAlign(LEFT, TOP);
  if (ftPaso <= 4) text(FT_PASOS[ftPaso - 1], FT_OX, 150); else text("¿Todo bien?", FT_OX, 150);
  fill(110);
  textSize(16);
  text(FT_AYUDA[ftPaso], FT_OX, 182, FT_OW, 44);
  textAlign(LEFT, BASELINE);
  if (ftPaso == 5) dibujarResumenFoto();
  else {
    opcionesFoto();
    String[] ops = resOpcionesFoto;
    for (int i = 0; i < ops.length; i++) {
      float y = FT_OY + i * FT_OSEP;
      boolean enc = dentro(FT_OX, y, FT_OW, FT_OH), el = elegidaEnPaso(i) == 1;
      noStroke();
      if (el) fill(color(222, 214, 252)); else if (enc) fill(color(236, 232, 255)); else fill(color(255));
      rect(FT_OX, y, FT_OW, FT_OH, 14);
      if (el) { noFill(); stroke(110, 80, 200); strokeWeight(3); rect(FT_OX, y, FT_OW, FT_OH, 14); noStroke(); strokeWeight(1); }
      fill(110, 80, 200);
      ellipse(FT_OX + 34, y + FT_OH / 2, 34, 34);
      fill(255);
      textSize(18);
      textAlign(CENTER, CENTER);
      text(str(i + 1), FT_OX + 34, y + FT_OH / 2 - 2);
      fill(40);
      textSize(20);
      textAlign(LEFT, CENTER);
      text(ops[i], FT_OX + 66, y + 6, FT_OW - 86, FT_OH - 12);
    }
    textAlign(LEFT, BASELINE);
  }
  botonesFoto();
}

// Dibuja los botones Atrás y Salir sin subir.
void botonesFoto() {
  if (puedeAtrasFoto()) botonMJ(80, 816, 190, 56, "< Atrás", color(120, 115, 140));
  if (puedeSalirFoto()) botonMJ(290, 816, 250, 56, "Salir sin subir", color(190, 80, 90));
}

// Dibuja las fotos para elegir cuál subir.
void dibujarElegirFoto() {
  for (int i = 1; i <= tamInt(ftOpciones); i++) {
    float x = 100 + ((i - 1) % 4) * 360, y = 170 + ((i - 1) / 4) * 210;
    miniatura(ftOpciones[i], x, y, 340, 191);
    if (dentro(x, y, 340, 191)) { noFill(); stroke(110, 80, 200); strokeWeight(4); rect(x - 3, y - 3, 346, 197, 8); noStroke(); strokeWeight(1); }
