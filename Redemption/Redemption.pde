// ============================ HISTORIAL POR DÍA (para el informe final) ============================
int[][] catHist = new int[12][5];
int[] rangoHist = new int[12];
int[] pantallaHist = new int[12];
boolean[] diaGuardado = new boolean[12];

// Lo llama guardarDespuesDeDormir (con lo que hiciste ayer) o el cambio de día si no dormiste
void registrarDiaV20(int d, int[] cats, int enRango, int pantalla) {
  if (d < 1 || d > 11 || diaGuardado[d]) return;
  diaGuardado[d] = true;
  for (int c = 0; c < 5; c++) catHist[d][c] = cats[c];
  rangoHist[d] = enRango;
  pantallaHist[d] = pantalla;
  if (enRango == 5) sumarBandera("DIA_PERFECTO", 1);
  if (pantalla < 30) sumarBandera("DIA_DESCONECTADO", 1);
}

// Si el día cambió sin dormir (noche en vela), igual queda registrado
void registrarDiaSinDormir(int d) {
  if (d < 1 || d > 11 || diaGuardado[d]) return;
  int[] cats = new int[5];
  int r = 0;
  for (int c = 0; c < 5; c++) {
    cats[c] = catMedios[c] / 2;
    if (cats[c] >= idealMin(c, d) && cats[c] <= idealMax(c, d)) r++;
  }
  registrarDiaV20(d, cats, r, stats[ST_PANTALLA]);
}

// Cuántos días tuvieron al menos 4 de las 5 categorías en su rango ideal.
int diasEquilibrados() {
  int n = 0;
  for (int d = 1; d <= 10; d++) if (diaGuardado[d] && rangoHist[d] >= 4) n++;
  return n;
}

// Puntos de equilibrio: suma de categorías en rango de todos los días (0 a 50).
int puntosEquilibrio() {
  int n = 0;
  for (int d = 1; d <= 10; d++) if (diaGuardado[d]) n += rangoHist[d];
  return n;
}

// Minutos totales de una categoría en los 10 días.
int totalCategoria(int c) {
  int n = 0;
  for (int d = 1; d <= 10; d++) n += catHist[d][c];
  if (!diaGuardado[dia]) n += catMedios[c] / 2;
  return n;
}

// ============================ PUNTAJE (sale en la pausa y en el final) ============================
// 2*Notas + 2*Social + 10 por hora de ejercicio (máximo 200) + 5*equilibrio - 40*VICIO + 5 por logro
int puntaje() {
  return ptsNotas() + ptsSocial() + ptsEjercicio() + ptsEquilibrio() - ptsVicio() + ptsLogros();
}
// Parte del puntaje final que viene de las notas.
int ptsNotas() { return 2 * stats[ST_NOTAS]; }
// Parte del puntaje final que viene de lo social.
int ptsSocial() { return 2 * stats[ST_SOCIAL]; }
// Parte del puntaje final que viene del ejercicio.
int ptsEjercicio() { return min(200, totalCategoria(CAT_EJERCICIO) / 6); }
// Parte del puntaje final que viene del equilibrio.
int ptsEquilibrio() { return 5 * puntosEquilibrio(); }
// Lo que resta del puntaje final el vicio.
int ptsVicio() { return 40 * bandera("VICIO"); }
// Parte del puntaje final que viene de los logros.
int ptsLogros() { return 5 * logrosHechos(); }

