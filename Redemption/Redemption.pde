// ============================ GIMNASIO: SESIÓN CON EL TANQUE ============================
// Si el Tanque está en el gym (una vez al día), cualquier aparato arranca su sesión:
// mancuernas, luego caminadora y luego barra, con él gritando. Al final te pone nota.
boolean gymSesion = false;
int gymRonda = 0, gymPuntosSesion = 0;
String gymGrito = "";
int gymGritoHasta = 0;

String[] GRITOS_BIEN = {
  "¡ESO ES, MIJO!", "¡Así se entrena!", "¡Una más! ¡Una más!", "¡Esos brazos ya no son de papel!",
  "¡Respire y empuje!", "¡Esto es la Copa Aurora, no un paseo!", "¡Vamos que se puede!"
};
String[] GRITOS_MAL = {
  "¡¿Qué fue eso?!", "¡Mi abuela levanta más que usted!", "¡Concéntrese!", "¡No me haga quedar mal!",
  "¡Arriba, arriba, ARRIBA!", "¡Con la espalda recta, por Dios!"
};

// El Tanque (entrenador) grita algo bueno o malo durante la sesión.
void gritarTanque(boolean bien) {
  if (!gymSesion) return;
  String[] g;
  if (bien) g = GRITOS_BIEN; else g = GRITOS_MAL;
  gymGrito = g[int(random(g.length))];
  gymGritoBien = bien;
  gymGritoHasta = millis() + 1400;
}

// Dibuja al Tanque con su grito.
void dibujarGritoTanque() {
  if (!gymSesion) return;
  dibujarTanqueSesion();
  noStroke();
  fill(250, 246, 235, 240);
  rect(1060, 120, 480, 120, 16);
  triangle(1100, 240, 1140, 240, 1090, 280);
  fill(30);
  textSize(16);
  textAlign(LEFT, TOP);
  text("TANQUE · ronda " + (gymRonda + 1) + " de 3", 1080, 132);
  textSize(24);
  if (millis() < gymGritoHasta) text(gymGrito, 1080, 165, 440, 70); else text("¡Vamos, vamos!", 1080, 165, 440, 70);
  textAlign(LEFT, BASELINE);
}

// Usar un aparato: si está el Tanque, empieza la sesión de 4 rondas; si no, solo ese aparato.
void usarAparato(String acc) {
  cargarSpritesGym();
  String hoy = "TANQUE_SESION_D" + dia;
  if (personaAqui("Entrenador Bermúdez “Tanque”") && bandera(hoy) <= 0 && stats[ST_ENERGIA] >= 20) {
    sumarBandera(hoy, 1);
    gymSesion = true;
    gymRonda = 0;
    gymPuntosSesion = 0;
    aviso("El Tanque te ve entrar: “¡Usted! Hoy entrena conmigo. Tres rondas, sin quejarse.”");
    siguienteRondaTanque();
    return;
  }
  gymSesion = false;
  if (acc.equals(ACC_GYM_CAMINADORA)) iniciarCaminadora();
  else if (acc.equals(ACC_GYM_BARRA)) iniciarPress();
  else iniciarMancuernas();
}

// Pasa al siguiente aparato de la sesión con el Tanque.
void siguienteRondaTanque() {
  if (gymRonda == 0) iniciarMancuernas();
  else if (gymRonda == 1) iniciarCaminadora();
  else if (gymRonda == 2) iniciarPress();
  else terminarSesionTanque();
}

// Cada ronda da 0 a 100 puntos
void rondaTerminada(int puntos) {
  gymPuntosSesion += puntos;
  gymRonda++;
  siguienteRondaTanque();
}

// Termina la sesión con el Tanque y da los efectos según el puntaje.
void terminarSesionTanque() {
  gymSesion = false;
  hecho("GYM");
  int p = gymPuntosSesion / 3;
  String nota;
  if (p >= 85) {
    nota = "A";
  } else {
    if (p >= 70) nota = "B"; else if (p >= 50) nota = "C"; else if (p >= 30) nota = "D"; else nota = "F";
  }
  String frase;
  if (p >= 85) {
    frase = "“Usted tiene madera. Lo quiero en mi equipo.”";
  } else if (p >= 50) {
    frase = "“Nada mal para un novato. Vuelva mañana.”";
  } else {
    frase = "“Hay mucho trabajo por hacer. Pero vino, y eso cuenta.”";
  }
  int am;
  if (p >= 85) am = 8; else if (p >= 50) am = 5; else am = 2;
  String ef = "Am +" + am + " · Ejercicio +60 min · Energía −" + (12 + p / 10) + " · Tiempo +60 min";
  if (p >= 85) ef += " · Social +2 · TANQUE_APRUEBA";
  resultadoGym("Sesión con el Tanque: " + nota, "El Tanque cruza los brazos. " + frase + "\n(" + p + " de 100 puntos)", ef, personaIndice("Entrenador Bermúdez “Tanque”"));
}

// ============================ GIMNASIO: REPETICIONES (barra y mancuernas) ============================
// Una marca sube y baja por la barra. ESPACIO cuando esté en la zona verde = una repetición.
// Cada repetición la marca va más rápido. Si fallas varias seguidas, se te cae.
boolean repsBarra;
int repsHechas, repsMeta, repsFallos, repsFallosTotal, repsAnim, repsFin;
float repsMarca, repsVel, repsZona;
int gymUltimo;

// Empieza las repeticiones (barra o pesas).
void iniciarReps(boolean barra) {
  repsBarra = barra;
  repsHechas = 0;
  repsFallos = 0;
  repsFallosTotal = 0;
  repsMarca = 0;
  if (gymSesion) {
    if (barra) repsMeta = 8; else repsMeta = 10;
  } else {
    if (barra) repsMeta = GYM_REPS_BARRA; else repsMeta = GYM_REPS_PESAS;
  }
  if (barra) repsVel = 0.016; else repsVel = 0.013;
  float cansancio = constrain(stats[ST_ENERGIA] / 100.0, 0.3, 1);
  if (barra) {
    repsZona = (GYM_ZONA_BASE - 0.05) * (0.6 + 0.4 * cansancio);
  } else {
    repsZona = (GYM_ZONA_BASE - 0) * (0.6 + 0.4 * cansancio);
  }
  repsAnim = 0;
  repsFin = 0;
  gymUltimo = millis();
  empezarActividad(ACT_GYM_REPS);
}

// Dibuja el fondo del gimnasio.
void dibujarFondoGym() {
  if (gym_fondo != null && gym_fondo.width > 1) { image(gym_fondo, 0, 0, ANCHO, ALTO); return; }
  noStroke();
  fill(55, 58, 70);
  rect(0, 0, ANCHO, ALTO);
  fill(150, 175, 195, 70);
  rect(80, 90, 1440, 420);
  fill(255, 255, 255, 30);
  for (int i = 0; i < 6; i++) quad(200 + i * 260, 90, 260 + i * 260, 90, 140 + i * 260, 510, 80 + i * 260, 510);
  fill(40, 40, 48);
  rect(0, 640, ANCHO, 260);
  stroke(60, 60, 70);
  for (int x = 0; x < ANCHO; x += 80) line(x, 640, x, 900);
  noStroke();
  fill(200, 40, 60);
  textSize(26);
  textAlign(CENTER, CENTER);
  text("“EL DOLOR ES TEMPORAL” — T. Bermúdez", 800, 60);
  textAlign(LEFT, BASELINE);
}

// Dibuja las repeticiones: la marca sube y baja y hay que presionar en la zona.
void dibujarReps() {
  float dt = dtJuego();
  dibujarFondoGym();

  if (repsFin == 0) {
    if (repsHechas % 2 == 0) repsMarca += repsVel * dt * 1; else repsMarca += repsVel * dt * 1;
    if (repsMarca > 1) { repsMarca = 1; repsVel = -abs(repsVel); }
    if (repsMarca < 0) { repsMarca = 0; repsVel = abs(repsVel); }
  }
  float zonaCentro = 0.82;

  boolean arriba = millis() < repsAnim;
  float cx = 620, piso = 760;
  PImage aux1;
  if (repsBarra) aux1 = gym_barra; else aux1 = gym_pesas;
  int aux2;
  if (arriba) aux2 = 1; else aux2 = 0;
  if (!tira(aux1, 2, aux2, cx - 150, piso - 380, 300, 380)) {
    noStroke();
    fill(40, 60, 120);
    rect(cx - 40, piso - 140, 30, 140, 6);
    rect(cx + 10, piso - 140, 30, 140, 6);
    fill(230, 70, 70);
    rect(cx - 55, piso - 290, 110, 160, 16);
    fill(230, 180, 140);
    ellipse(cx, piso - 320, 64, 64);
    float manoY;
    if (arriba) manoY = piso - 400; else manoY = piso - 260;
    stroke(230, 180, 140);
    strokeWeight(20);
    line(cx - 50, piso - 270, cx - 90, manoY);
    line(cx + 50, piso - 270, cx + 90, manoY);
    strokeWeight(1);
    noStroke();
    if (repsBarra) {
      fill(150);
      rect(cx - 260, manoY - 6, 520, 12, 6);
      fill(30);
      rect(cx - 250, manoY - 50, 34, 100, 6);
      rect(cx + 216, manoY - 50, 34, 100, 6);
    } else {
      fill(30);
      rect(cx - 120, manoY - 14, 60, 28, 8);
      rect(cx + 60, manoY - 14, 60, 28, 8);
    }
  }

  float bx = 900, by = 200, bh = 480;
  noStroke();
  fill(240, 200, 60);
  rect(bx, by, 50, bh, 10);
  fill(80, 200, 90);
  rect(bx, by + bh * (1 - zonaCentro - repsZona / 2), 50, bh * repsZona);
  fill(20);
  rect(bx - 12, by + bh * (1 - repsMarca) - 4, 74, 8, 4);

  fill(255);
  textSize(30);
  textAlign(LEFT, TOP);
  if (repsBarra) {
    text("BARRA" + "  " + repsHechas + " / " + repsMeta, 1000, 300);
  } else {
    text("MANCUERNAS" + "  " + repsHechas + " / " + repsMeta, 1000, 300);
  }
  textSize(20);
  text("ESPACIO cuando la marca\nesté en lo verde", 1000, 350);
  for (int i = 0; i < GYM_FALLOS_MAX; i++) {
    if (i < repsFallos) fill(color(220, 70, 60)); else fill(color(90));
    ellipse(1015 + i * 34, 440, 24, 24);
  }
  fill(200);
  textSize(16);
  text("fallos seguidos", 1000, 462);
  textAlign(LEFT, BASELINE);
  dibujarGritoTanque();
  if (repsFin > 0 && millis() > repsFin) terminarReps();
}

// ESPACIO: repetición buena si la marca está en la zona.
void teclaReps() {
  if (repsFin > 0 || key != ' ') return;
  float zonaCentro = 0.82;
  boolean bien = abs(repsMarca - zonaCentro) <= repsZona / 2;
  if (bien) {
    repsHechas++;
    repsFallos = 0;
    repsAnim = millis() + 350;
    repsVel = abs(repsVel) * -1.06;
    gritarTanque(true);
    if (repsHechas >= repsMeta) repsFin = millis() + 600;
  } else {
    repsFallos++;
    repsFallosTotal++;
    gritarTanque(false);
    if (repsFallos >= GYM_FALLOS_MAX) { repsFin = millis() + 600; if (repsBarra) aviso("¡Se te cae la barra! Por suerte estaba el soporte."); else aviso("Se te resbala la mancuerna. Nadie vio... ¿o sí?"); }
  }
}

// Termina las repeticiones y calcula los puntos.
void terminarReps() {
  int puntos = constrain(repsHechas * 100 / repsMeta - repsFallosTotal * 5, 0, 100);
  if (gymSesion) { rondaTerminada(puntos); return; }
  boolean completo = repsHechas >= repsMeta;
  if (completo) hecho("GYM");
  String nombre;
  if (repsBarra) nombre = "BARRA"; else nombre = "PESAS";
  if (completo && bandera("RECORD_" + nombre) <= 0) sumarBandera("RECORD_" + nombre, 1);
  int minutos = 10 + repsHechas * 2;
  String ef;
  if (repsBarra) {
    ef = "Ejercicio +" + minutos + " min · Energía −" + 6 + " · Tiempo +" + minutos + " min";
  } else {
    ef = "Ejercicio +" + minutos + " min · Energía −" + 4 + " · Tiempo +" + minutos + " min";
  }
  if (completo) ef += " · Social +1";
  String aux1;
  if (completo) aux1 = "¡Serie completa!"; else aux1 = "Serie a medias";
  String aux2;
  if (repsFallosTotal > 0) aux2 = " (" + repsFallosTotal + " fallos)"; else aux2 = "";
  String aux3;
  if (completo) aux3 = "Mañana te van a doler hasta las pestañas."; else aux3 = "La próxima sale. Respira y vuelve.";
  resultadoGym(aux1,
    repsHechas + " de " + repsMeta + " repeticiones" + aux2 + ".\n" +
    aux3, ef, -1);
}

// ============================ GIMNASIO: CAMINADORA ============================
// Alterna izquierda y derecha para correr. La franja verde de velocidad va cambiando (la caminadora sube y baja).
// Si te quedas por debajo un rato, te sales de la caminadora. Por encima se gasta el aire.
float camVel, camLo, camHi, camAire, camMetros;
int camFin, camDebajoDesde, camUltTecla, camCaida, camFase;
float camCinta;

// Empieza la caminadora.
void iniciarCaminadora() {
  camVel = 4;
  camLo = 3;
  camHi = 6;
  camAire = 100;
  camMetros = 0;
  camCinta = 0;
  camDebajoDesde = 0;
  camUltTecla = 0;
  camCaida = 0;
  camFase = 0;
  if (gymSesion) camFin = millis() + 18000; else camFin = millis() + GYM_CAMINADORA_MS;
  gymUltimo = millis();
  empezarActividad(ACT_GYM_CAMINADORA);
}

// Dibuja la caminadora: hay que mantener la velocidad en la zona.
void dibujarCaminadora() {
  float dt = dtJuego();
  dibujarFondoGym();
  boolean cayendo = camCaida > 0;
  if (!cayendo) {

    float t = (camFin - millis()) / 1000.0;
    float centro;
    if (gymSesion) centro = 6 + 2.5 * sin(t * 0.45) + 1; else centro = 6 + 2.5 * sin(t * 0.45) + 0;
    float ancho = 2.4 - min(1.0, (GYM_CAMINADORA_MS - (camFin - millis())) / 30000.0);
    camLo = centro - ancho / 2;
    camHi = centro + ancho / 2;
    camVel = max(0, camVel - 0.035 * dt);
    if (camVel > camHi) camAire = max(0, camAire - 0.5 * dt);
    else camAire = min(100, camAire + 0.15 * dt);
    if (camAire <= 0) camVel = min(camVel, camLo - 0.3);
    if (camVel >= camLo && camVel <= camHi) camMetros += camVel * dt * 0.06;
    if (camVel < camLo) {
      if (camDebajoDesde == 0) camDebajoDesde = millis();
      if (millis() - camDebajoDesde > GYM_CAIDA_MS) { camCaida = millis() + 1200; gritarTanque(false); aviso("¡Te sales de la caminadora! Alguien se ríe al fondo."); }
    } else camDebajoDesde = 0;
  }
  camCinta = (camCinta + camVel * dt * 2) % 60;

  noStroke();
  cargarSprites11();
  if (hay(gym_caminadoraMaq)) image(gym_caminadoraMaq, 380, 420, 620, 300);
  else {
    fill(30);
    rect(380, 640, 620, 60, 12);
    fill(60);
    for (float x = 390 - camCinta; x < 990; x += 60) if (x > 385) rect(x, 650, 30, 40);
    fill(80);
    rect(940, 380, 30, 270, 6);
    rect(880, 360, 150, 50, 8);
  }
  fill(120, 255, 140);
  textSize(18);
  textAlign(CENTER, CENTER);
  text(nf(camVel, 0, 1) + " km/h", 955, 385);

  int cuadro = (millis() / max(60, int(400 - camVel * 25))) % 4;
  float px;
  if (cayendo) px = 640 - (1200 - (camCaida - millis())) * 0.5; else px = 640;
  float rot;
  if (cayendo) rot = -0.8; else rot = 0;
  pushMatrix();
  translate(px, 640);
  rotate(rot);
  if (!tira(gym_caminadora, 4, cuadro, -120, -330, 240, 330)) {
    fill(40, 60, 120);
    float pierna = sin(cuadro * HALF_PI) * 30;
    rect(-30 + pierna, -140, 26, 140, 6);
    rect(4 - pierna, -140, 26, 140, 6);
    fill(230, 70, 70);
    rect(-50, -290, 100, 160, 16);
    fill(230, 180, 140);
    ellipse(0, -320, 60, 60);
  }
  popMatrix();

  float gx = 1080, gy = 560, gw = 420;
  fill(70);
  rect(gx, gy, gw, 34, 10);
  fill(80, 200, 90);
  rect(gx + gw * camLo / 14, gy, gw * (camHi - camLo) / 14, 34);
  fill(255);
  rect(gx + gw * constrain(camVel, 0, 14) / 14 - 3, gy - 10, 6, 54);

  fill(70);
  rect(gx, gy + 70, gw, 18, 8);
  if (camAire > 30) fill(color(120, 190, 255)); else fill(color(220, 70, 60));
  rect(gx, gy + 70, gw * camAire / 100, 18, 8);
  fill(255);
  textAlign(LEFT, TOP);
  textSize(28);
  text("CAMINADORA · " + max(0, (camFin - millis()) / 1000) + " s", gx, 300);
  textSize(20);
  text("Alterna ← → para correr.\nQuédate en la franja verde.\nMetros buenos: " + int(camMetros), gx, 345);
  textSize(16);
  text("aire", gx, gy + 92);
  textAlign(LEFT, BASELINE);
  dibujarGritoTanque();
  if ((cayendo && millis() > camCaida) || (!cayendo && millis() > camFin)) terminarCaminadora(cayendo);
}

// Izquierda y derecha alternadas para mantener el paso.
void teclaCaminadora() {
  if (camCaida > 0) return;
  int t = 0;
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') t = 1;
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') t = 2;
  if (t == 0) return;
  if (t != camUltTecla) { if (camAire > 0) camVel = min(14, camVel + 0.55); else camVel = min(14, camVel + 0.15); }
  else camVel = max(0, camVel - 0.3);
  camUltTecla = t;
  if (gymSesion && random(1) < 0.06) gritarTanque(camVel >= camLo && camVel <= camHi);
}

// Termina la caminadora (o te caes) y calcula los puntos.
void terminarCaminadora(boolean seCayo) {
  if (seCayo) sumarBandera("SALIÓ_CAMINADORA", 1);
  else if (!gymSesion) hecho("GYM");
  int puntos;
  if (seCayo) {
    puntos = constrain(int(camMetros / 3.5) - 30, 0, 100);
  } else {
    puntos = constrain(int(camMetros / 3.5) - 0, 0, 100);
  }
  if (gymSesion) { rondaTerminada(puntos); return; }
  String ef;
  if (seCayo) {
    ef = "Ejercicio +30 min · Energía −" + 3 + " · Tiempo +30 min";
  } else {
    ef = "Ejercicio +30 min · Energía −" + 5 + " · Tiempo +30 min";
  }
  if (seCayo) ef += " · Social −1";
  String aux1;
  if (seCayo) aux1 = "Te saliste de la caminadora"; else aux1 = "¡Media hora corriendo!";
  String aux2;
  if (seCayo) aux2 = "Te levantas como si nada. Como si nadie hubiera visto."; else aux2 = "Sudas hasta las ideas.";
  resultadoGym(aux1,
    int(camMetros) + " metros en la franja buena.\n" + aux2, ef, -1);
}

// ============================ CICLISMO (pista D4) ============================
// La pista se mueve hacia la izquierda. Arriba y abajo para cambiar de carril, derecha para pedalear más fuerte, izquierda para frenar.
// Esquiva conos, palomas y ciclistas lentos; los charcos te frenan; las botellas te devuelven el aire.
// Si Joaquín está en la pista, te reta a una carrera.
final int CIC_MAX_OBS = 24;
final float[] CIC_CARRIL = { 560, 680, 800 };
float[] cicObsX = new float[CIC_MAX_OBS];
int[] cicObsCarril = new int[CIC_MAX_OBS], cicObsTipo = new int[CIC_MAX_OBS];
boolean[] cicObsVivo = new boolean[CIC_MAX_OBS];

// Tipos: 0 cono, 1 charco, 2 paloma, 3 ciclista lento, 4 botella
float cicVel, cicDist, cicY, cicAire, cicProxObs, cicFondo, cicJoaquin;
int cicCarril, cicCaidas, cicInvul, cicFin, cicSpawn;
boolean cicDer, cicIzq, cicContraJoaquin, cicGano;
String cicMensaje = "";
int cicMensajeHasta = 0;

// Empieza el ciclismo en la pista (si tienes energía).
void iniciarCiclismo() {
  cargarSpritesGym();
  if (stats[ST_ENERGIA] < 10) { aviso("Estás demasiado cansado para pedalear."); return; }
  for (int i = 0; i < CIC_MAX_OBS; i++) cicObsVivo[i] = false;
  cicVel = 6;
  cicDist = 0;
  cicCarril = 1;
  cicY = CIC_CARRIL[1];
  cicAire = 100;
  cicProxObs = 400;
  cicCaidas = 0;
  cicInvul = 0;
  cicFin = 0;
  cicSpawn = 0;
  cicFondo = 0;
  cicJoaquin = 0;
  cicDer = false;
  cicIzq = false;
  cicGano = false;
  cicContraJoaquin = personaAqui("Joaquín, ciclista");
  if (cicContraJoaquin) {
    cicMensaje = "Joaquín: “¿Una carrera? El que pierda invita el jugo.”";
  } else {
    cicMensaje = "→ pedalear · ← frenar · ↑ ↓ carril";
  }
  cicMensajeHasta = millis() + 3000;
  gymUltimo = millis();
  empezarActividad(ACT_CICLISMO);
}

// Muestra un mensaje corto en el ciclismo.
void mensajeCiclismo(String m) {
  cicMensaje = m;
  cicMensajeHasta = millis() + 1400;
}

// Pone un obstáculo en la pista (cono, charco o bache).
void ponerObstaculo() {
  for (int i = 0; i < CIC_MAX_OBS; i++) {
    if (!cicObsVivo[i]) {
      cicObsVivo[i] = true;
      cicObsX[i] = ANCHO + 60;
      cicObsCarril[i] = (cicSpawn * 2 + int(random(3))) % 3;
      float r = random(1);
      if (r < 0.32) {
        cicObsTipo[i] = 0;
      } else if (r < 0.5) {
        cicObsTipo[i] = 1;
      } else {
        if (r < 0.68) cicObsTipo[i] = 2; else if (r < 0.86) cicObsTipo[i] = 3; else cicObsTipo[i] = 4;
      }
      cicSpawn++;
      return;
    }
  }
}

// Dibuja el ciclismo: pista, bici, obstáculos y metros.
void dibujarCiclismo() {
  float dt = dtJuego();
  boolean fin = cicFin > 0;
  if (!fin) {

    if (cicDer && cicAire > 0) { cicVel = min(14, cicVel + 0.12 * dt); cicAire = max(0, cicAire - 0.35 * dt); }
    else if (cicIzq) cicVel = max(3, cicVel - 0.25 * dt);
    else { cicVel += (7 - cicVel) * 0.01 * dt; cicAire = min(100, cicAire + 0.12 * dt); }
    if (cicAire <= 0) cicVel = min(cicVel, 6);
    cicDist += cicVel * dt;
    cicFondo = (cicFondo + cicVel * dt) % 120;
    if (cicContraJoaquin) cicJoaquin += (CIC_VEL_JOAQUIN + dia * 0.08) * dt;
    cicY += (CIC_CARRIL[cicCarril] - cicY) * min(1, 0.25 * dt);

    cicProxObs -= cicVel * dt;
    if (cicProxObs <= 0) { ponerObstaculo(); cicProxObs = max(170, 420 - cicDist / 40) + random(0, 120); }
    for (int i = 0; i < CIC_MAX_OBS; i++) {
      if (cicObsVivo[i]) {
        float propia;
        if (cicObsTipo[i] == 3) propia = 4; else propia = 0;
        cicObsX[i] -= (cicVel - propia) * dt;
  
        if (cicObsTipo[i] == 2 && cicObsX[i] < 620 && cicObsX[i] > 600) { if (cicObsCarril[i] == 1) cicObsCarril[i] = cicCarril; else cicObsCarril[i] = 1; }
        if (cicObsX[i] < -100) { cicObsVivo[i] = false; } else {
          if (cicObsCarril[i] == cicCarril && !(abs(cicObsX[i] - 320) > 45)) {
            int t = cicObsTipo[i];
            if (t == 4) { cicAire = min(100, cicAire + 40); cicObsVivo[i] = false; mensajeCiclismo("¡Agua! El aire vuelve."); }
            else if (t == 1) { cicVel = max(3, cicVel * 0.55); cicObsVivo[i] = false; mensajeCiclismo("¡Charco! Te salpicas hasta las orejas."); }
            else if (millis() > cicInvul) {
              cicCaidas++;
              cicVel = 2;
              cicInvul = millis() + 1500;
              cicObsVivo[i] = false;
              if (t == 0) {
                mensajeCiclismo("¡Te llevas el cono!");
              } else if (t == 2) {
                mensajeCiclismo("¡La paloma! Plumas por todos lados.");
              } else {
                mensajeCiclismo("¡Chocas con el ciclista! “¡Mire por dónde va!”");
              }
              if (cicCaidas >= CIC_CAIDAS_MAX) cicFin = millis() + 1200;
            }
          }
        }
      }
    }
    if (cicDist / 10 >= CIC_META) { cicGano = !cicContraJoaquin || cicDist >= cicJoaquin; cicFin = millis() + 1200; }
    else if (cicContraJoaquin && cicJoaquin / 10 >= CIC_META && cicFin == 0) { cicGano = false; cicFin = millis() + 1200; mensajeCiclismo("Joaquín cruza la meta primero."); }
  }
  dibujarPistaCiclismo();
  if (fin && millis() > cicFin) terminarCiclismo();
}

// Dibuja la pista que se mueve.
void dibujarPistaCiclismo() {
  noStroke();
  if (cic_fondo != null && cic_fondo.width > 1) {
    float fx = -(cicDist * 0.3) % ANCHO;
    image(cic_fondo, fx, 0, ANCHO, 500);
    image(cic_fondo, fx + ANCHO, 0, ANCHO, 500);
  } else {
    for (int y = 0; y < 300; y += 6) { fill(lerpColor(color(120, 180, 240), color(200, 225, 245), y / 300.0)); rect(0, y, ANCHO, 6); }
    fill(110, 160, 90);
    for (int i = -1; i < 6; i++) { float x = i * 400 - (cicDist * 0.15) % 400; ellipse(x + 200, 330, 520, 200); }
    fill(70, 130, 70);
    rect(0, 330, ANCHO, 170);
    fill(150, 140, 130);
    for (int i = -1; i < 10; i++) { float x = i * 200 - (cicDist * 0.4) % 200; rect(x + 20, 360, 160, 90); fill(120, 110, 100); rect(x + 20, 360, 160, 14); fill(150, 140, 130); }
  }

  fill(185, 75, 55);
  rect(0, 500, ANCHO, 360);
  stroke(255, 255, 255, 200);
  strokeWeight(4);
  for (int c = 0; c < 2; c++) {
    float y = (CIC_CARRIL[c] + CIC_CARRIL[c + 1]) / 2 + 40;
    for (float x = -cicFondo; x < ANCHO; x += 120) line(x, y, x + 60, y);
  }
  strokeWeight(1);
  noStroke();
  fill(240);
  rect(0, 500, ANCHO, 8);
  rect(0, 852, ANCHO, 8);

  float metaX = 320 + (CIC_META * 10 - cicDist);
  if (metaX < ANCHO + 40) {
    for (int i = 0; i < 18; i++) { if (i % 2 == 0) fill(255); else fill(20); rect(metaX, 508 + i * 19.6, 20, 19.6); }
  }

  for (int i = 0; i < CIC_MAX_OBS; i++) if (cicObsVivo[i]) dibujarObstaculo(cicObsTipo[i], cicObsX[i], CIC_CARRIL[cicObsCarril[i]]);

  if (cicContraJoaquin) {
    float jx = 320 + (cicJoaquin - cicDist);
    if (jx > -150 && jx < ANCHO + 150) {
      int col = (cuadros / 6) % 4;
      if (pj_joaquin_ciclista != null && pj_joaquin_ciclista.width > 1) dibujarHoja(pj_joaquin_ciclista, 160, 240, 1, col, jx - 80, CIC_CARRIL[0] - 250, 1.0);
      else dibujarCiclistaFigura(jx, CIC_CARRIL[0] - 40, color(40, 120, 220), col);
    }
  }

  if (millis() > cicInvul || (millis() / 100) % 2 == 0) {
    int col = (millis() / max(50, int(260 - cicVel * 14))) % 4;
    if (!tira(cic_bici, 4, col, 320 - 110, cicY - 210, 220, 240)) dibujarCiclistaFigura(320, cicY, color(230, 70, 70), col);
  }

  fill(15, 20, 35, 220);
  rect(300, 18, 1000, 90, 14);
  float pw = 760, px = 330;
  fill(80);
  rect(px, 40, pw, 14, 7);
  fill(255, 200, 60);
  rect(px, 40, pw * constrain(cicDist / 10 / CIC_META, 0, 1), 14, 7);
  fill(230, 70, 70);
  ellipse(px + pw * constrain(cicDist / 10 / CIC_META, 0, 1), 47, 22, 22);
  if (cicContraJoaquin) { fill(40, 120, 220); ellipse(px + pw * constrain(cicJoaquin / 10 / CIC_META, 0, 1), 47, 22, 22); }
  fill(255);
  textSize(16);
  textAlign(LEFT, CENTER);
  if (cicContraJoaquin) {
    text(int(cicDist / 10) + " / " + CIC_META + " m" + "   (rojo: tú · azul: Joaquín)", px, 82);
  } else {
    text(int(cicDist / 10) + " / " + CIC_META + " m" + "", px, 82);
  }
  text("aire", 1110, 40);
  fill(80);
  rect(1150, 33, 120, 14, 7);
  if (cicAire > 30) fill(color(120, 190, 255)); else fill(color(220, 70, 60));
  rect(1150, 33, 120 * cicAire / 100, 14, 7);
  for (int i = 0; i < CIC_CAIDAS_MAX; i++) { if (i < cicCaidas) fill(color(220, 70, 60)); else fill(color(90)); ellipse(1160 + i * 30, 80, 18, 18); }
  fill(255);
  textAlign(CENTER, CENTER);
  textSize(26);
  if (millis() < cicMensajeHasta) text(cicMensaje, 800, 150);
  textSize(18);
  text(nf(cicVel * 3.6, 0, 0) + " km/h", 320, cicY + 60);
  textAlign(LEFT, BASELINE);
}

// Dibuja al ciclista con figuras (si no hay sprite).
void dibujarCiclistaFigura(float x, float y, int c, int col) {
  noFill();
  stroke(30);
  strokeWeight(5);
  ellipse(x - 45, y, 60, 60);
  ellipse(x + 45, y, 60, 60);
  line(x - 45, y, x, y - 40);
  line(x, y - 40, x + 45, y);
  line(x, y - 40, x + 30, y - 55);
  strokeWeight(1);
  noStroke();
  fill(c);
  rect(x - 22, y - 110, 40, 64, 12);
  fill(230, 180, 140);
  ellipse(x + 4, y - 128, 34, 34);
  fill(c);
  arc(x + 4, y - 134, 38, 30, PI, TWO_PI);
  fill(40, 60, 120);
  float p = sin(col * HALF_PI) * 12;
  rect(x - 8 + p, y - 50, 14, 40, 5);
}

// Dibuja un obstáculo de la pista.
void dibujarObstaculo(int t, float x, float y) {
  noStroke();
  if (t == 0) {
    if (!tira(cic_cono, 1, 0, x - 30, y - 70, 60, 80)) { fill(255, 120, 20); triangle(x - 26, y + 10, x + 26, y + 10, x, y - 60); fill(255); rect(x - 14, y - 30, 28, 10); }
  } else if (t == 1) {
    if (!tira(cic_charco, 1, 0, x - 60, y - 10, 120, 40)) { fill(90, 140, 200, 180); ellipse(x, y + 10, 120, 34); fill(200, 230, 255, 160); ellipse(x - 20, y + 6, 40, 10); }
  } else if (t == 2) {
    int f = (cuadros / 8) % 2;
    if (!tira(cic_paloma, 2, f, x - 35, y - 60, 70, 70)) { fill(140, 140, 155); ellipse(x, y - 20, 50, 34); ellipse(x + 22, y - 38, 24, 24); fill(255, 170, 40); triangle(x + 33, y - 38, x + 44, y - 35, x + 33, y - 32); fill(120, 120, 135); ellipse(x - 6, y - 26 - f * 14, 34, 14); }
  } else if (t == 3) {
    int col = (cuadros / 10) % 4;
    if (!tira(cic_ciclista, 4, col, x - 100, y - 210, 200, 220)) dibujarCiclistaFigura(x, y, color(120, 200, 90), col);
  } else {
    if (!tira(cic_botella, 1, 0, x - 18, y - 60, 36, 64)) { fill(80, 170, 240); rect(x - 14, y - 50, 28, 56, 8); fill(255); rect(x - 6, y - 60, 12, 12, 3); }
  }
}

// Teclas del ciclismo: derecha para pedalear, izquierda para frenar, ESPACIO para saltar.
void teclaCiclismo(boolean v) {
  if ((key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D') cicDer = v;
  if ((key == CODED && keyCode == LEFT) || key == 'a' || key == 'A') cicIzq = v;
  if (!v || cicFin > 0) return;
  if (((key == CODED && keyCode == UP) || key == 'w' || key == 'W') && cicCarril > 0) cicCarril--;
  if (((key == CODED && keyCode == DOWN) || key == 's' || key == 'S') && cicCarril < 2) cicCarril++;
}

// Termina el ciclismo y da los efectos según los metros.
void terminarCiclismo() {
  int metros = int(min(cicDist / 10, CIC_META));
  boolean llego = metros >= CIC_META;
  if (llego) hecho("PISTA");
  String ef = "Ejercicio +" + (10 + metros / 50) + " min · Energía −" + (4 + metros / 300) + " · Tiempo +" + (10 + metros / 50) + " min";
  int persona = -1;
  String titulo, texto;
  if (cicContraJoaquin) {
    persona = personaIndice("Joaquín, ciclista");
    if (cicGano) {
      titulo = "¡Le ganaste a Joaquín!";
      texto = "Joaquín llega resoplando: “¡No puede ser! Bueno... el jugo va por mi cuenta.”";
      ef += " · Am +6 · Social +2 · $ +1 · LE_GANASTE_A_JOAQUIN";
    } else {
      titulo = "Joaquín ganó";
      if (llego) {
        texto = "Llegas segundo. Joaquín: “Nada mal. Mañana te doy ventaja.”";
      } else {
        texto = "Joaquín se devuelve a buscarte: “¿Todo bien? Ese cono no perdona.”";
      }
      ef += " · Am +3";
    }
  } else {
    if (llego) titulo = "¡Vuelta completa!"; else titulo = "Te bajaste de la bici";
    if (llego) {
      texto = metros + " metros sin parar. El viento en la cara ayuda a pensar.";
    } else {
      texto = "Llevabas " + metros + " metros. Tres caídas son suficientes por hoy.";
    }
  }
  if (cicCaidas >= CIC_CAIDAS_MAX) ef += " · Social −1";
  cicDer = false;
  cicIzq = false;
  resultadoGym(titulo, texto, ef, persona);
}

