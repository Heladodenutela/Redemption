// #####################################################################################
// #####################################################################################
//   TIEMPO, TUTORIAL, HORARIO PROPIO, AVISOS GRANDES, FIESTA Y CHISMES
//   - La velocidad del reloj depende de la dificultad y de lo que estás haciendo.
//   - Tutorial al empezar (teclas + mecánicas), con imágenes en extras/tutorial/.
//   - Bloques propios en el Horario (gimnasio, estudiar...) guardados en otra matriz.
//   - Aviso grande al comprar y al usar algo.
//   - Más gente en la fiesta de Marta, y gente caminando.
//   - Si te pillan coqueteando con varias: al leer su mensaje te borran el número.
// #####################################################################################
// #####################################################################################

// ============================ VELOCIDAD DEL RELOJ ============================
// Una hora del juego dura MIN_POR_HORA[dificultad] minutos reales (Fácil 3, Normal 1:30, Difícil 1).
// Va a la MITAD comiendo, en un evento y con el tutorial abierto; 3 veces más RÁPIDO con el celular.
// Cómo: el reloj avanza cuando millis() - ti pasa de (horagp + 1) * 500. En cada cuadro se corre "ti"
// para que ese tiempo pase más lento o más rápido (sin tocar lo demás que usa ti).
float[] MIN_POR_HORA = { 3.0, 1.5, 1.0 };
final float CEL_RAPIDO = 3;
final int COMER_MIN = 20;
int comiendoHasta = -99999;
int ultimoCicloV22 = -1;
float restoTiV22 = 0;

// Cuántos minutos reales dura una hora del juego (más rápido con el celular abierto, más lento comiendo o en eventos).
float lentitudReloj() {
  float f = MIN_POR_HORA[dificultad];
  if (relojAMitad()) f = f * 2;
  if (cel != 0 && screen == 1) f = f / CEL_RAPIDO;
  return f;
}

// ¿Estás comiendo?
boolean comiendo() {
  return horagp < comiendoHasta;
}

// ¿El reloj va a mitad de velocidad (tutorial, comiendo o en un evento)?
boolean relojAMitad() {
  if (tutorialAbierto || comiendo()) return true;
  return enEventoV22();
}

// Estás en un evento: una escena, un evento al que llegaste y sigue, la fiesta de Marta o la Feria
boolean enEventoV22() {
  if (actividad == ACT_ESCENA || actividad == ACT_CINEMATICA) return true;
  if (EVENTOS20 != null && evEstado != null) {
    for (int k = 0; k < EVENTOS20.length; k++) {
      if (evEnCurso == k) return true;
      String lugar = EVENTOS20[k][5];
      if (evLlego != null && evLlego[k] && eventoActivo(k) && !lugar.equals("") && !lugar.equals("*") && mapaPorCodigo(lugar) == mapaActual) return true;
    }
  }
  int m = minutoAhora();
  if (dia == 5 && mapaActual == F5 && (m >= 20 * 60 || m < 2 * 60)) return true;
  if (dia == 10 && m >= 21 * 60 && mapaActual == mapaPorCodigo("U3")) return true;
  return false;
}

// Se llama al principio de cicloTiempo()
void ajustarRelojV22() {
  int ahora = millis();
  if (ultimoCicloV22 < 0) {
    ultimoCicloV22 = ahora;
    return;
  }
  int dt = ahora - ultimoCicloV22;
  ultimoCicloV22 = ahora;
  if (dt <= 0 || dt > 1000) return;
  restoTiV22 = restoTiV22 + dt * (1 - 1 / lentitudReloj());
  int n = int(restoTiV22);
  ti = ti + n;
  restoTiV22 = restoTiV22 - n;
}

// Empiezas a comer: el reloj va más lento un rato.
void empezarAComer() {
  comiendoHasta = horagp + COMER_MIN * 2;
}

// Al lado de la hora, en el HUD
void dibujarVelocidadReloj() {
  String t = "";
  if (cel != 0) t = "celular: tiempo ×3";
  else if (tutorialAbierto) t = "tutorial: tiempo ×½";
  else if (comiendo()) t = "comiendo: tiempo ×½";
  else if (enEventoV22()) t = "evento: tiempo ×½";
  if (t.equals("")) return;
  textSize(15);
  textAlign(RIGHT, BASELINE);
  if (cel != 0) fill(255, 170, 120);
  else fill(160, 230, 170);
  text(t, 556, 40);
  textAlign(LEFT, BASELINE);
}

// ============================ ENERGÍA ============================
// Todo lo que gasta energía gasta más (lo usa cambiarStat). Lo que la recupera queda igual.
float ENERGIA_GASTO = 1.5;

// Cuánta energía gasta algo según la dificultad.
int gastoEnergia(int d) {
  if (d >= 0) return d;
  return floor(d * ENERGIA_GASTO);
}

// ============================ AVISO GRANDE (compras y cosas usadas) ============================
String agTitulo = "", agCosa = "", agIcono = "", agDetalle = "";
int agDesde = -99999, agColor = 0;
final int AG_MS = 3000;

// Muestra un aviso grande en el centro (compraste algo, ganaste algo).
void avisoGrande(String titulo, String cosa, String detalle, int col) {
  avisoGrandeConIcono(titulo, cosa, cosa, detalle, col);
}

// icono = el producto cuyo dibujo sale a la izquierda (puede ser distinto del texto)
void avisoGrandeConIcono(String titulo, String cosa, String icono, String detalle, int col) {
  agTitulo = titulo;
  agCosa = cosa;
  agIcono = icono;
  agDetalle = detalle;
  agColor = col;
  agDesde = millis();
}

// Dibuja el aviso grande con su animación de entrada.
void dibujarAvisoGrande() {
  int t = millis() - agDesde;
  if (t < 0 || t > AG_MS) return;
  float entra = constrain(t / 200.0, 0, 1);
  float sale = constrain((AG_MS - t) / 350.0, 0, 1);
  float w = 640, h = 136;
  float x = 800 - w / 2;
  float y = 150 - (1 - entra) * 50 - (1 - sale) * 30;
  noStroke();
  fill(0, 0, 0, 90 * sale);
  rect(x + 6, y + 8, w, h, 20);
  fill(255, 252, 244, 250 * sale);
  rect(x, y, w, h, 20);
  fill(agColor);
  rect(x, y, 16, h, 20, 0, 0, 20);
  fill(240, 236, 226);
  rect(x + 30, y + 18, 100, 100, 14);
  dibujarIconoProducto(agIcono, x + 32, y + 20, 96);
  fill(agColor);
  textAlign(LEFT, TOP);
  textSize(30);
  text(agTitulo, x + 150, y + 14);
  text(agTitulo, x + 151, y + 14);
  fill(30);
  textSize(25);
  text(agCosa, x + 150, y + 54, w - 170, 34);
  fill(90);
  textSize(19);
  text(agDetalle, x + 150, y + 92, w - 170, 40);
  textAlign(LEFT, BASELINE);
}

