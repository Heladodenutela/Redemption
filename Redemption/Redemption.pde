// Guarda la partida en su archivo: una línea 'nombre=valor' por cada variable del juego (saveStrings).
boolean guardarPartida(int r) {
  if (r < 1 || r > RANURAS) return false;
  String[] l = new String[VARIABLES_GUARDADAS + 40];
  agregarTexto(l, "#Redemption=v24");
  agregarTexto(l, "#fecha=" + fechaHoy());
  agregarTexto(l, "#resumen=" + escaparTexto(resumenPartida()));
  agregarTexto(l, "#terminada=" + finJuego);
  escribirVariables(l);
  String[] t = new String[tamTexto(l)];
  copiarTextos(l, 0, t, 0, t.length);
  saveStrings(archivoPartida(r), t);
  ranuraResumen[r] = resumenPartida();
  ranuraFecha[r] = fechaHoy();
  ranuraTerminada[r] = finJuego;
  ranuraNueva[r] = false;
  guardarCuenta();
  return true;
}

// Lee la primera parte (las líneas que empiezan con #) de las 3 partidas para el menú
void leerRanuras() {
  ranurasLeidas = true;
  for (int r = 1; r <= RANURAS; r++) {
    ranuraResumen[r] = "";
    ranuraFecha[r] = "";
    ranuraTerminada[r] = false;
    ranuraNueva[r] = false;
    if (existeArchivo(archivoPartida(r))) {
      String[] l = loadStrings(archivoPartida(r));
      if (l != null) {
        for (int i = 0; i < l.length && i < 8; i++) {
          if (empiezaCon(l[i], "#resumen=")) ranuraResumen[r] = desescaparTexto(l[i].substring(9));
          if (empiezaCon(l[i], "#fecha=")) ranuraFecha[r] = l[i].substring(7);
          if (empiezaCon(l[i], "#terminada=")) ranuraTerminada[r] = l[i].substring(11).equals("true");
          if (empiezaCon(l[i], "#nueva=")) ranuraNueva[r] = l[i].substring(7).equals("true");
        }
        if (ranuraResumen[r].equals("")) ranuraResumen[r] = "Partida guardada";
      }
    }
  }
}

// ¿Hay alguna partida guardada?
boolean hayPartidas() {
  if (!ranurasLeidas) leerRanuras();
  for (int r = 1; r <= RANURAS; r++) if (!ranuraResumen[r].equals("")) return true;
  return false;
}

// La llama el mundo apenas se arma (draw, pantalla 1): si se pidió cargar una partida, aquí se lee
void alEntrarAlMundoV23() {
  copiarCuentaAlJuego();
  if (cargaPendiente <= 0) return;
  int r = cargaPendiente;
  cargaPendiente = 0;
  cargarPartida(r);
}

// Carga una partida de su archivo (loadStrings) y pone cada variable como estaba.
void cargarPartida(int r) {
  String[] l = null;
  if (existeArchivo(archivoPartida(r))) l = loadStrings(archivoPartida(r));
  if (l == null) { aviso("No se pudo leer la partida " + r); return; }
  int leidas = 0;
  for (int i = 0; i < l.length; i++) {
    String s = l[i];
    if (!empiezaCon(s, "#")) {
      int k = posicionDe(s, "=");
      if (k > 0) {
        if (leerVariable(s.substring(0, k), s.substring(k + 1))) leidas++;
      }
    }
  }
  ranuraActual = r;
  despuesDeCargar();
  avisoGrande("Partida " + r + " cargada", resumenPartida(), "Se leyeron " + leidas + " datos del archivo", color(60, 150, 90));
}

// Lo que no se guarda (pantalla, teclas, imágenes en memoria) se deja listo para seguir jugando
void despuesDeCargar() {
  screen = 1;
  cargado = 1;
  mundoIniciado = true;
  pausado = false;
  cel = 0;
  menuAbierto = false;
  teclaIzq = false;
  teclaDer = false;
  correr = false;
  fondoSucio = true;
  hdCieloBase = -1;
  avisoMJ = "";
  aplicarBalance();
  copiarCuentaAlJuego();
  actualizarAgenda();
  autoguardadoMarca = marcaDosAM();
  cuentaUltimoDia = dia;
}

// Se guarda solo cada noche a las 2:00 a. m. del juego (o apenas no estés haciendo nada
// después de esa hora, por ejemplo al despertar). Así la trabadita de guardar no cae en pleno día.
void revisarAutoguardado() {
  if (ranuraActual < 1 || marcaDosAM() <= autoguardadoMarca || !estadoSeguroGuardar()) return;
  autoguardadoMarca = marcaDosAM();
  if (guardarPartida(ranuraActual)) mensajeGuardado("Partida " + ranuraActual + " guardada (automático, 2:00 a. m.)");
}

// Cuántas veces el reloj ha pasado por las 2:00 a. m. (horaDelDia 240 = 2:00) desde el comienzo
int marcaDosAM() {
  return (horagp + 480) / 2880;
}

// Al empezar una partida nueva su espacio queda apartado (sin guardar todavía nada pesado)
void apartarRanuraNueva(int r) {
  String[] l = new String[5];
  l[0] = "#Redemption=v24";
  l[1] = "#fecha=" + fechaHoy();
  l[2] = "#resumen=" + escaparTexto("Partida nueva · todavía sin guardar");
  l[3] = "#terminada=false";
  l[4] = "#nueva=true";
  saveStrings(archivoPartida(r), l);
  ranuraResumen[r] = "Partida nueva · todavía sin guardar";
  ranuraFecha[r] = fechaHoy();
  ranuraTerminada[r] = false;
  ranuraNueva[r] = true;
}

// Muestra el aviso 'Partida guardada'.
void mensajeGuardado(String t) {
  guardadoMsg = t;
  guardadoMsgHasta = millis() + 2500;
}

// Dibuja el aviso de partida guardada abajo a la derecha.
void dibujarMensajeGuardado() {
  if (millis() > guardadoMsgHasta) return;
  textSize(18);
  float w = textWidth(guardadoMsg) + 70;
  float x = ANCHO - w - 20, y = ALTO - 64;
  noStroke();
  fill(20, 30, 40, 220);
  rect(x, y, w, 44, 12);
  fill(120, 220, 150);
  ellipse(x + 26, y + 22, 16, 16);
  fill(255);
  textAlign(LEFT, CENTER);
  text(guardadoMsg, x + 46, y + 20);
  textAlign(LEFT, BASELINE);
}

// Botón "Guardar partida" de la pausa
void guardarDesdePausa() {
  if (ranuraActual < 1) ranuraActual = 1;
  if (!estadoSeguroGuardar()) {
    mensajeGuardado("Termina lo que estás haciendo para guardar");
    return;
  }
  if (guardarPartida(ranuraActual)) mensajeGuardado("Partida " + ranuraActual + " guardada");
}

// ---- cuenta: lo que vale para todas las partidas ----
boolean[] cuentaLogro = new boolean[LOGROS.length];
String[] cuentaLogroFecha = new String[LOGROS.length];
int[] cuentaArcade = new int[3];
int cuentaPartidas = 0, cuentaTerminadas = 0, cuentaDias = 0, cuentaMinijuegos = 0, cuentaMinutos = 0, cuentaMejorPuntaje = 0;
String[] cuentaMJCodigo = new String[80];
int[] cuentaMJMejor = new int[80];
int[] cuentaMJVeces = new int[80];
int cuentaRelojDesde = 0;
int cuentaUltimoDia = 0;

// Lee el archivo de la cuenta: logros de todas las partidas, récords y ajustes.
void cargarCuenta() {
  for (int i = 0; i < cuentaLogroFecha.length; i++) cuentaLogroFecha[i] = "";
  if (!existeArchivo(ARCHIVO_CUENTA)) return;
  String[] l = loadStrings(ARCHIVO_CUENTA);
  if (l == null) return;
  for (int i = 0; i < l.length; i++) {
    int k = posicionDe(l[i], "=");
    if (k > 0) {
      String c = l[i].substring(0, k), v = l[i].substring(k + 1);
      if (c.equals("logros")) {
        for (int j = 0; j < cuentaLogro.length && j < v.length(); j++) cuentaLogro[j] = letraEn(v, j) == '1';
      } else if (empiezaCon(c, "logro_")) {
        int j = int(c.substring(6));
        if (j >= 0 && j < cuentaLogroFecha.length) cuentaLogroFecha[j] = v;
      } else if (c.equals("arcade")) {
        leerInts(v);
        if (resInts != null) for (int j = 0; j < 3 && j < resInts.length; j++) cuentaArcade[j] = resInts[j];
      } else if (empiezaCon(c, "mj_")) {
        partirPorLetra(v, '|');
        String[] p = resPartirPorLetra;
        int j = filaRecord(c.substring(3));
        if (j >= 0 && p.length >= 2) { cuentaMJMejor[j] = int(p[0]); cuentaMJVeces[j] = int(p[1]); }
      }
      else if (c.equals("partidas")) cuentaPartidas = int(v);
      else if (c.equals("terminadas")) cuentaTerminadas = int(v);
      else if (c.equals("dias")) cuentaDias = int(v);
      else if (c.equals("minijuegos")) cuentaMinijuegos = int(v);
      else if (c.equals("minutosReales")) cuentaMinutos = int(v);
      else if (c.equals("mejorPuntaje")) cuentaMejorPuntaje = int(v);
      else if (c.equals("musica")) musicaOn = v.equals("true");
      else if (c.equals("sonidos")) sonidosOn = v.equals("true");
      else if (c.equals("volumen")) volumenMusica = constrain(float(v), 0, 1);
      else if (c.equals("ventana")) leerTamanoVentana(v);
      else if (c.equals("fps30")) limitar30 = v.equals("true");
    }
  }
}

// Guarda el archivo de la cuenta: logros, récords, estadísticas y ajustes.
void guardarCuenta() {
  sumarMinutosReales();
  String[] l = new String[LOGROS.length + 120];
  agregarTexto(l, "#Redemption · cuenta (logros, récords y estadísticas de todas las partidas)");
  String lg = "";
  for (int i = 0; i < cuentaLogro.length; i++) {
    if (cuentaLogro[i]) lg = lg + "1";
    else lg = lg + "0";
  }
  agregarTexto(l, "logros=" + lg);
  for (int i = 0; i < cuentaLogroFecha.length; i++) if (cuentaLogroFecha[i] != null && !cuentaLogroFecha[i].equals("")) agregarTexto(l, "logro_" + i + "=" + cuentaLogroFecha[i]);
  agregarTexto(l, "arcade=" + guardarInts(cuentaArcade));
  agregarTexto(l, "partidas=" + cuentaPartidas);
  agregarTexto(l, "terminadas=" + cuentaTerminadas);
  agregarTexto(l, "dias=" + cuentaDias);
  agregarTexto(l, "minijuegos=" + cuentaMinijuegos);
  agregarTexto(l, "minutosReales=" + cuentaMinutos);
  agregarTexto(l, "mejorPuntaje=" + cuentaMejorPuntaje);
  agregarTexto(l, "musica=" + musicaOn);
  agregarTexto(l, "sonidos=" + sonidosOn);
  agregarTexto(l, "volumen=" + volumenMusica);
  agregarTexto(l, "ventana=" + ventanaW + "," + ventanaH);
  agregarTexto(l, "fps30=" + limitar30);
  for (int i = 0; i < tamTexto(cuentaMJCodigo); i++) agregarTexto(l, "mj_" + cuentaMJCodigo[i] + "=" + cuentaMJMejor[i] + "|" + cuentaMJVeces[i]);
  String[] t = new String[tamTexto(l)];
  copiarTextos(l, 0, t, 0, t.length);
  saveStrings(ARCHIVO_CUENTA, t);
}

// Suma a la cuenta los minutos reales que llevas jugando.
void sumarMinutosReales() {
  int m = (millis() - cuentaRelojDesde) / 60000;
  if (m <= 0) return;
  cuentaMinutos += m;
  cuentaRelojDesde = cuentaRelojDesde + m * 60000;
}

// Fila del récord de un minijuego en la cuenta (la crea si no existe).
int filaRecord(String cod) {
  int n = tamTexto(cuentaMJCodigo);
  for (int i = 0; i < n; i++) if (cuentaMJCodigo[i].equals(cod)) return i;
  if (n >= cuentaMJCodigo.length) return -1;
  agregarTexto(cuentaMJCodigo, cod);
  cuentaMJMejor[n] = 0;
  cuentaMJVeces[n] = 0;
  return n;
}

// Los logros y récords de la cuenta pasan al juego (al empezar o cargar una partida)
void copiarCuentaAlJuego() {
  for (int i = 0; i < logroHecho.length && i < cuentaLogro.length; i++) if (cuentaLogro[i]) logroHecho[i] = true;
  for (int i = 0; i < 3; i++) arcadeRecord[i] = cuentaArcade[i];
}

// La llama revisarLogros() cuando ganas uno
void logroGanadoV23(int i) {
  if (i < 0 || i >= cuentaLogro.length || cuentaLogro[i]) return;
  cuentaLogro[i] = true;
  cuentaLogroFecha[i] = fechaHoy();
  guardarCuenta();
}

// La llama terminarArcade()
void guardarRecordsArcade() {
  for (int i = 0; i < 3; i++) cuentaArcade[i] = arcadeRecord[i];
  guardarCuenta();
}

// La llama finMJ(): el mejor puntaje de cada minijuego y cuántas veces lo jugaste
void registrarPuntajeMJ(String cod, int p) {
  int j = filaRecord(cod);
  cuentaMinijuegos++;
  if (j >= 0) {
    cuentaMJVeces[j]++;
    if (p > cuentaMJMejor[j]) {
      cuentaMJMejor[j] = p;
      if (cuentaMJVeces[j] > 1) { infoMJ(cod); String[] aux1 = resInfoMJ; aviso("¡Nuevo récord en " + aux1[1] + "! " + p + "/100"); }
    }
  }
  guardarCuenta();
}

// Cada día nuevo cuenta en las estadísticas
void contarDiaCuenta() {
  if (!mundoIniciado || dia == cuentaUltimoDia) return;
  cuentaUltimoDia = dia;
  cuentaDias++;
}

// La llama terminarJuego(): puntaje al historial (puntajes.txt) y la partida queda como terminada
void alTerminarJuegoV23() {
  cuentaTerminadas++;
  int p = puntaje();
  if (p > cuentaMejorPuntaje) cuentaMejorPuntaje = p;
  String[] viejos = null;
  if (existeArchivo(ARCHIVO_PUNTAJES)) viejos = loadStrings(ARCHIVO_PUNTAJES);
  int n = 0;
  if (viejos != null) n = viejos.length;
  String[] t = new String[n + 1];
  for (int i = 0; i < n; i++) t[i] = viejos[i];
  t[n] = fechaHoy() + ";" + DIF_NOMBRE[dificultad] + ";" + p + ";" + escaparTexto(finTitulo) + ";" + ranuraActual;
  saveStrings(ARCHIVO_PUNTAJES, t);
  if (ranuraActual > 0) guardarPartida(ranuraActual);
  else guardarCuenta();
}

