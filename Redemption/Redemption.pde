// El círculo va centrado en la pantalla del celular, entre el encabezado y la leyenda
final float REL_CX = 800, REL_CY = 425, REL_RX = 212, REL_RY = 205;
String[] REL_CIRCULO = { "Sofía", "Laura", "Marta", "Camilo", "Andrés", "Nadia", "Iris", "Lili", "Mamá (Claudia)", "Papá (Ernesto)", "Valentina", "Kevin", "Paola, heladería", "Chato" };

float[] resPosRelacion;

// Posición de una persona en el círculo de Relaciones.
// Deja el resultado en resPosRelacion.
void posRelacion(String p) {
  for (int i = 0; i < REL_CIRCULO.length; i++) {
    if (REL_CIRCULO[i].equals(p)) {
      float a = -HALF_PI + TWO_PI * i / REL_CIRCULO.length;
      resPosRelacion = new float[] { REL_CX + cos(a) * REL_RX, REL_CY + sin(a) * REL_RY };
      return;
    }
  }
  resPosRelacion = null;
}

