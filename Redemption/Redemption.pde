// Arma los epílogos: romance, familia, rumor, club y demás.
void armarEpilogos() {
  vaciarTexto(finEpilogos);
  if (!finMotivo.equals("")) agregarTexto(finEpilogos, finMotivo);
  String rom = epilogoRomance();
  if (rom != null) agregarTexto(finEpilogos, rom);
  int lili = personaIndice("Lili"), mama = personaIndice("Mamá (Claudia)"), papa = personaIndice("Papá (Ernesto)");
  if (bandera("IRIS_COMPLETA") > 0) agregarTexto(finEpilogos, "Iris y Lili siguen siendo inseparables. En el colegio ya nadie se mete con ellas: saben que tienen un hermano mayor que les cubre la espalda.");
  else if (lili >= 0 && amistad[lili] >= 70) agregarTexto(finEpilogos, "Lili pegó tu foto en la puerta de su cuarto. Dice que es para asustar a los ladrones. Mentira.");
  if (mama >= 0 && amistad[mama] >= 70) agregarTexto(finEpilogos, "Mamá imprimió la foto final y la puso en la nevera, al lado de la lista del mercado.");
  else if (mama >= 0 && amistad[mama] < 35) agregarTexto(finEpilogos, "En la casa hay más silencio que antes. Mamá todavía espera que le cuentes las cosas antes de verlas en el celular.");
  if (papa >= 0 && bandera("MENTIRA_PAPÁ") > 0 && amistad[papa] < 50) agregarTexto(finEpilogos, "Papá no volvió a preguntar por Cálculo. Eso dolió más que un regaño.");
  if (bandera("RUMOR_RESUELTO") > 0) agregarTexto(finEpilogos, "El rumor del parcial se apagó porque alguien buscó la verdad en vez de compartir el chisme. Ese alguien fuiste tú.");
  else if (bandera("RUMOR_CULPA_FALSA") > 0) agregarTexto(finEpilogos, "Acusaste a la persona equivocada del rumor. Pediste perdón tarde. En redes, una mentira corre más que cualquier disculpa.");
  if (bandera("DEUDA_GIL") > 0 && bandera("GIL_PAGADO") <= 0) agregarTexto(finEpilogos, "Don Gil todavía tiene tu nombre en la libreta. Cada vez que pasas por la esquina, se acuerda.");
  if (bandera("CLUB_DEPORTE") > 0) agregarTexto(finEpilogos, "Tu carnet del Club del Deporte ya tiene sellos de los cuatro entrenadores.");
  if (bandera("CHATO_VUELVE") > 0 || tieneTexto(elecciones, "CH3:0")) agregarTexto(finEpilogos, "En enero, Chato aparece en la fila de inscripciones de la U. Te saluda de lejos.");
  if (bandera("VALDÉS_HUMANA") > 0) agregarTexto(finEpilogos, "La profesora Valdés cambió su perfil de ProRed. Ahora dice la verdad. Tiene más seguidores que antes.");
  if (bandera("VICIO") >= 2 && !finId.equals("QUEMADO")) agregarTexto(finEpilogos, "El cigarro y la esquina se volvieron costumbre. Todavía estás a tiempo de que sea solo una etapa.");
  if (bandera("RECHAZOS") >= 3) agregarTexto(finEpilogos, "Dijiste que no " + bandera("RECHAZOS") + " veces cuando era más fácil decir que sí. Eso también es un trofeo.");
  if (finalSecretoAnimales()) agregarTexto(finEpilogos, "SECRETO: Canela duerme a los pies de tu cama, Newton te espera en la banca y Tuerca te devolvió tu llavero... con una bellota. Los únicos que nunca miraron tu número de seguidores.");
}

// ¿Lograste el final secreto de los animales?
boolean finalSecretoAnimales() {
  int ca = personaIndice("Canela"), tu = personaIndice("Tuerca"), ne = personaIndice("Newton");
  return bandera("CANELA_ADOPTADA") > 0 && tu >= 0 && ne >= 0 && amistad[tu] >= 60 && amistad[ne] >= 60 && ca >= 0;
}

