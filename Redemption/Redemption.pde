String[] puntajesCache = null;
int puntajesCacheFrame = -1;

// Lee puntajes.txt una sola vez cada vez que se abre la pantalla de récords
void leerPuntajes() {
  if (puntajesCacheFrame >= 0) return;
  puntajesCacheFrame = cuadros;
  puntajesCache = null;
  if (existeArchivo(ARCHIVO_PUNTAJES)) puntajesCache = loadStrings(ARCHIVO_PUNTAJES);
}

// Cuántos logros tiene la cuenta (de todas las partidas).
int logrosCuenta() {
  int n = 0;
  for (int i = 0; i < cuentaLogro.length; i++) if (cuentaLogro[i]) n++;
  return n;
}

// Clicks del título: true si los usó el menú de partidas
boolean clickMenuV23() {
  if (menuRanuras == 4) return clickMenuPantalla();
  if (menuRanuras == 3) {
    if (mouseX > 1120 && mouseX < 1380 && mouseY > 760 && mouseY < 814) { menuRanuras = 0; puntajesCacheFrame = -1; }
    return true;
  }
  if (menuRanuras > 0) {
    if (mouseX > MR_X + MR_W / 2 - 150 && mouseX < MR_X + MR_W / 2 + 150 && mouseY > MR_Y + MR_H - 80 && mouseY < MR_Y + MR_H - 26) {
      menuRanuras = 0;
      ranuraConfirmar = 0;
      return true;
    }
    for (int r = 1; r <= RANURAS; r++) {
      float y = MR_Y + 120 + (r - 1) * 140;
      if (mouseX > MR_X + 40 && mouseX < MR_X + MR_W - 40 && mouseY > y && mouseY < y + 120) {
        boolean vacia = ranuraResumen[r].equals("");
        if (menuRanuras == 2) {
          if (!vacia) empezarPartidaGuardada(r);
        } else {
          if (vacia || ranuraConfirmar == r) empezarPartidaNueva(r);
          else ranuraConfirmar = r;
        }
        return true;
      }
    }
    return true;
  }
  if (mouseX > 1360 && mouseX < 1570 && mouseY > 815 && mouseY < 865) { menuRanuras = 4; return true; }
  if (mouseY > 610 && mouseY < 670) {
    if (mouseX > 990 && mouseX < 1240 && hayPartidas()) { menuRanuras = 2; ranuraConfirmar = 0; return true; }
    if (mouseX > 360 && mouseX < 610) { menuRanuras = 3; puntajesCacheFrame = -1; return true; }
  }
  if (mouseX >= 650 && mouseX <= 950 && mouseY >= 600 && mouseY <= 680) {
    menuRanuras = 1;
    ranuraConfirmar = 0;
    return true;
  }
  return false;
}

// Empieza una partida nueva en una ranura.
void empezarPartidaNueva(int r) {
  cuentaPartidas++;
  guardarCuenta();
  apartarRanuraNueva(r);
  arrancarPartidaNueva(r);
}

// Deja todo listo para jugar una partida nueva en esa ranura.
void arrancarPartidaNueva(int r) {
  ranuraActual = r;
  cargaPendiente = 0;
  autoguardadoMarca = 0;
  menuRanuras = 0;
  cargado = 0;
  screen = 1;
  ti = millis();
}

// Entra al mundo y carga la partida de esa ranura.
void empezarPartidaGuardada(int r) {
  if (ranuraNueva[r]) { arrancarPartidaNueva(r); return; }
  ranuraActual = r;
  cargaPendiente = r;
  menuRanuras = 0;
  cargado = 0;
  screen = 1;
  ti = millis();
}

// ESC en el título cierra la ventanita del menú
boolean teclaMenuV23() {
  if (screen != 0 || menuRanuras == 0) return false;
  menuRanuras = 0;
  ranuraConfirmar = 0;
  return true;
}

// ============================ 5. MÚSICA POR ZONA Y SONIDO DE CLICK ============================
// Las pistas están en data/musica/ (WAV mono). Qué suena depende de dónde estés:
// - título y pantalla final: menu
// - minijuegos: minijuego
// - dentro de la casa: manana (5:00-12:00), tarde (12:00-18:30), noche (18:30-5:00)
// - en el resto del mundo, el tema de la zona (temaDeMapa)
// - si pusiste una lista en la app Playlist del celular, suena esa lista por 3 horas
// Al cambiar de zona, una pista baja de volumen y la otra sube. La Playlist, en cambio, corta en seco.
// Cada pista se carga la primera vez que hace falta, para no gastar memoria en las que no suenan.
// Usa la biblioteca Sound de Processing (Sketch > Importar biblioteca > Sound).
String[] PISTAS = { "menu", "manana", "tarde", "noche", "minijuego",
  "area_1_paradero", "area_2_espacios_intermedios", "area_3_universidad", "area_4_plaza_aurora",
  "area_5_parque_cerezos", "area_6_zona_deportes", "area_7_fuera_de_la_u" };
final int PISTA_MENU = 0, PISTA_MANANA = 1, PISTA_TARDE = 2, PISTA_NOCHE = 3, PISTA_MINIJUEGO = 4;
final int PISTA_ZONA = 5;
SoundFile[] pistas = new SoundFile[PISTAS.length];
boolean[] pistaBuscada = new boolean[PISTAS.length];
float[] pistaVol = new float[PISTAS.length];
boolean musicaOn = true, sonidosOn = true;
float volumenMusica = 0.55;
boolean cortarMusica = false;
SoundFile sonidoClick;
boolean clickBuscado = false;

// Carga una pista de música la primera vez que se necesita (si el archivo existe).
void cargarPista(int i) {
  if (pistaBuscada[i]) return;
  pistaBuscada[i] = true;
  String ruta = "musica/" + PISTAS[i] + ".wav";
  if (createInput(ruta) == null) return;
  pistas[i] = new SoundFile(this, ruta);
}

// Hace el sonido de click (si los sonidos están prendidos).
void sonarClick() {
  if (!sonidosOn) return;
  if (!clickBuscado) {
    clickBuscado = true;
    if (createInput("musica/click.wav") != null) sonidoClick = new SoundFile(this, "musica/click.wav");
  }
  if (sonidoClick == null) return;
  sonidoClick.amp(0.5);
  sonidoClick.play();
}

// Tema de zona de un mapa (0 a 6), o -1 si es dentro de la casa
// 0 paradero, 1 espacios intermedios, 2 universidad, 3 plaza, 4 parque, 5 deportes, 6 fuera de la U
int temaDeMapa(int m) {
  if (m == C1 || m == I1 || m == I2 || m == I6 || m == I7) return 0;
  if (m >= I1 && m <= I8) return 1;
  if (m >= U1 && m <= U16) return 2;
  if (m >= P1 && m <= P7) return 3;
  if (m >= K1 && m <= K9) return 4;
  if (m >= D1 && m <= D7) return 5;
  if (m >= F1 && m <= F5) return 6;
  return -1;
}

// La pista que debería sonar ahora mismo
int pistaDeseada() {
  if (screen == 0) return PISTA_MENU;
  if (finJuego) return PISTA_MENU;
  if (listaSuena()) return PISTA_ZONA + LISTAS_TEMA[listaSonando - 1];
  if (screen == 3) return PISTA_MINIJUEGO;
  if (actividad == ACT_MJ20 || esActividadMinijuego(actividad) || avisoMJActivo()) return PISTA_MINIJUEGO;
  if (cel == 2 || cel == 3 || cel == 4) return PISTA_MINIJUEGO;
  int t = temaDeMapa(mapaActual);
  if (t >= 0) return PISTA_ZONA + t;
  int m = minutoAhora();
  if (m >= 5 * 60 && m < 12 * 60) return PISTA_MANANA;
  if (m >= 12 * 60 && m < 18 * 60 + 30) return PISTA_TARDE;
  return PISTA_NOCHE;
}

// Cada cuadro: sube el volumen de la pista que toca y baja el de las demás (en casi un segundo).
// Si cortarMusica está prendido, apaga todas de una y pone la nueva desde el principio.
void actualizarMusica() {
  int q = pistaDeseada();
  if (cortarMusica) {
    cortarMusica = false;
    for (int i = 0; i < PISTAS.length; i++) {
      pistaVol[i] = 0;
      if (pistas[i] != null && pistas[i].isPlaying()) pistas[i].stop();
    }
    if (musicaOn) {
      cargarPista(q);
      if (pistas[q] != null) {
        pistaVol[q] = volumenMusica;
        pistas[q].amp(max(0.01, volumenMusica));
        pistas[q].loop();
      }
    }
  }
  for (int i = 0; i < PISTAS.length; i++) {
    float objetivo = 0;
    if (musicaOn && i == q) {
      objetivo = volumenMusica;
      if (pausado) objetivo = volumenMusica * 0.45;
    }
    if (objetivo > 0) cargarPista(i);
    if (pistas[i] != null) {
      if (objetivo > 0 && !pistas[i].isPlaying()) {
        pistaVol[i] = 0;
        pistas[i].amp(0.01);
        pistas[i].loop();
      }
      if (pistaVol[i] < objetivo) pistaVol[i] = min(objetivo, pistaVol[i] + 0.02 * pasoCuadro);
      else if (pistaVol[i] > objetivo) pistaVol[i] = max(objetivo, pistaVol[i] - 0.02 * pasoCuadro);
      if (pistaVol[i] <= 0 && objetivo <= 0) {
        if (pistas[i].isPlaying()) pistas[i].stop();
      } else if (pistas[i].isPlaying()) {
        pistas[i].amp(max(0.01, pistaVol[i]));
      }
    }
  }
}

// En la pausa (pestaña Ajustes): música, volumen y clicks
final float MUS_Y = 290;

// Dibuja en Ajustes el interruptor de música, el volumen y el de los clicks.
void dibujarAjustesMusica(float y) {
  float x = PZ_X + 40;
  interruptor(x, y + MUS_Y, musicaOn, "Música");
  fill(60);
  textSize(18);
  textAlign(CENTER, CENTER);
  text(round(volumenMusica * 100) + " %", x + 380, y + MUS_Y + 30);
  textAlign(LEFT, BASELINE);
  botonPausa(x + 300, y + MUS_Y + 12, 40, 40, "−", color(120, 110, 140));
  botonPausa(x + 420, y + MUS_Y + 12, 40, 40, "+", color(120, 110, 140));
  interruptor(x + 560, y + MUS_Y, sonidosOn, "Sonido de los clicks");
}

// Clicks en los ajustes de música: prender, apagar y cambiar el volumen.
boolean clickAjustesMusica(float y) {
  float x = PZ_X + 40;
  float yy = y + MUS_Y;
  if (mouseY < yy || mouseY > yy + INT_H) return false;
  if (mouseX > x + 300 && mouseX < x + 340) { volumenMusica = max(0, volumenMusica - 0.1); guardarCuenta(); return true; }
  if (mouseX > x + 420 && mouseX < x + 460) { volumenMusica = min(1, volumenMusica + 0.1); guardarCuenta(); return true; }
  if (mouseX > x && mouseX < x + 290) { musicaOn = !musicaOn; guardarCuenta(); return true; }
  if (mouseX > x + 560 && mouseX < x + 560 + INT_W) { sonidosOn = !sonidosOn; guardarCuenta(); return true; }
  return false;
}

// ============================ 6. ENGANCHES (los llaman setup, draw y los eventos) ============================
// Al abrir el juego: lee la cuenta, pone el tamaño de ventana y carga la música del título.
void iniciarV23() {
  cargarCuenta();
  iniciarVentana();
  cuentaRelojDesde = millis();
  cargarPista(PISTA_MENU);
}

// Cada cuadro del mundo
void tickMundoV23() {
  contarDiaCuenta();
  revisarAutoguardado();
}

// Al final de draw(), encima de todo
void dibujarEncimaV23() {
  if (screen == 0) dibujarMenuV23();
  dibujarAvisoMJ();
  if (screen == 1) dibujarMensajeGuardado();
  actualizarMusica();
}

