    else pqDado(x, y, v, usado && pqFase == PQ_MOVER);
    noTint();
  }
  fill(90);
  textSize(14);
  if (pqTurno == 0 && pqFase == PQ_MOVER) text("Escoge un dado y luego la ficha\nque brilla.", 1420, 340);
  pqBoton("tirar", 1200, 440, 340, 70, "Tirar dados", color(60, 150, 90), pqTurno == 0 && pqFase == PQ_TIRAR, 24);
  // lo último que pasó
  fill(60);
  textSize(13);
  textAlign(LEFT, TOP);
  for (int i = 0; i < pqLog.length; i++) text(pqLog[i], 1194, 522 + i * 26, 356, 26);
}

// Un dado dibujado con puntos
void pqDado(float x, float y, int v, boolean apagado) {
  noStroke();
  if (apagado) fill(200); else fill(255);
  rect(x, y, 90, 90, 14);
  fill(40);
  float c = 45, o = 24;
  if (v % 2 == 1) ellipse(x + c, y + c, 16, 16);
  if (v >= 2) { ellipse(x + c - o, y + c - o, 16, 16); ellipse(x + c + o, y + c + o, 16, 16); }
  if (v >= 4) { ellipse(x + c + o, y + c - o, 16, 16); ellipse(x + c - o, y + c + o, 16, 16); }
  if (v == 6) { ellipse(x + c - o, y + c, 16, 16); ellipse(x + c + o, y + c, 16, 16); }
}

void pqDibujarFinal() {
  noStroke();
  fill(0, 0, 0, 150);
  rect(0, 64, ANCHO, ALTO - 64);
  fill(250, 244, 232);
  rect(500, 300, 600, 300, 18);
  fill(40);
  textAlign(CENTER, CENTER);
  textSize(42);
  if (pqGanador == 0) text("¡Ganaste!", 800, 370); else text("Ganó " + PQ_NOMBRE[pqGanador], 800, 370);
  textSize(20);
  fill(90);
  text("Metiste " + pqEnMeta(0) + " de tus 4 fichas.", 800, 430);
  pqBoton("volver", 640, 490, 320, 80, "Volver al juego", color(60, 150, 90), true, 24);
}


// ---------------------------------------------------------------------
//  Mouse
// ---------------------------------------------------------------------
void clickParques() {
  if (pqDentro(1430, 10, 150, 44)) { salirParques(); return; }
  if (pqFase == PQ_FIN) {
    if (pqDentro(640, 490, 320, 80)) salirParques();
    return;
  }
  if (pqTurno != 0) return;
  if (pqFase == PQ_TIRAR) {
    if (pqDentro(1200, 440, 340, 70)) pqTirar();
    return;
  }
  // escoger dado
  for (int k = 1; k <= 2; k++) {
    float x = 1200 + (k - 1) * 110;
    boolean usado = pqUsado1;
    if (k == 2) usado = pqUsado2;
    if (pqDentro(x, 330, 90, 90) && !usado) { pqSelDado = k; return; }
  }
  // escoger ficha
  for (int f = 0; f < PQ_F; f++) {
    pqPosicionFicha(0, f);
    if (dist(mouseX, mouseY, resPqX, resPqY) < 24 && pqFichaMovible(f)) { pqMover(f, pqSelDado); return; }
  }
}


// ============================ FÚTBOL: PENALES Y PASES LARGOS ============================
// 5 penales: haz click en la parte del arco donde quieres patear y luego ESPACIO para la fuerza
// (verde = fuerte, amarillo = suave, rojo = se va por encima). El portero adivina más en cada tiro.
// Luego 2 pases largos: ESPACIO cuando la marca pase por la zona del compañero.
int fuFase = 0;
int fuTiro = 0, fuGoles = 0, fuPase = 0, fuPasesBien = 0, fuDif = 1;
int fuZona = -1, fuPortero = -1, fuAnimFin = 0;
float fuFuerza = 0, fuDirFuerza = 1, fuMarca = 0, fuDirMarca = 1;
String fuMensaje = "";
final float AR_X = 500, AR_Y = 200, AR_W = 600, AR_H = 260;

// Empieza los penales con la dificultad del rival.
void iniciarPenales() {
  if (copaActual >= 0) fuDif = int(COPA[copaActual][4]); else fuDif = 1;
  fuFase = 0;
  fuTiro = 0;
  fuGoles = 0;
  fuPase = 0;
  fuPasesBien = 0;
  vaciarInt(fuHistorial);
  fuMensaje = "Haz click donde quieres patear";
  empezarActividad(ACT_FUTBOL);
}

// Dibuja los penales: el estadio, el arco o el pase.
void dibujarPenales() {
  dibujarEstadio();
  if (fuFase <= 2) dibujarPenal();
  else dibujarPase();
  dibujarMarcadorPenales();
  noStroke();
  fill(15, 20, 35, 220);
  rect(400, 822, 800, 56, 14);
  if (empiezaCon(fuMensaje, "¡GOO") || empiezaCon(fuMensaje, "¡Pase")) fill(color(255, 230, 90)); else fill(color(255));
  textAlign(CENTER, CENTER);
  if (fuFase == 2 && empiezaCon(fuMensaje, "¡GOO")) textSize(34); else textSize(26);
  text(fuMensaje, 800, 848);
  textAlign(LEFT, BASELINE);
}

// Dibuja el arco con su red y las 6 zonas para apuntar.
void dibujarPenal() {

  noStroke();
  fill(20, 60, 25, 120);
  rect(AR_X, AR_Y, AR_W, AR_H);
  dibujarArcoRed();
  stroke(255, 255, 255, 40);
  for (int i = 1; i < 3; i++) line(AR_X + i * AR_W / 3, AR_Y, AR_X + i * AR_W / 3, AR_Y + AR_H);
  line(AR_X, AR_Y + AR_H / 2, AR_X + AR_W, AR_Y + AR_H / 2);
  noStroke();
  if (fuFase == 0) {
    int z = zonaArco(mouseX, mouseY);
    if (z >= 0) { fill(255, 255, 255, 50); rect(zonaX(z), zonaY(z), AR_W / 3, AR_H / 2); }
  }
  if (fuZona >= 0) { fill(255, 230, 0, 70); rect(zonaX(fuZona), zonaY(fuZona), AR_W / 3, AR_H / 2); }

  float px = AR_X + AR_W / 2 - 30, py = AR_Y + AR_H - 120;
  if (fuFase == 2 && fuPortero >= 0) { px = zonaX(fuPortero) + AR_W / 6 - 30; py = zonaY(fuPortero) + 10; }
  if (fuFase != 2) px += sin(millis() / 250.0) * 40;
  dibujarPortero(px, py, fuFase == 2, fuPortero);

  float bx = 800, by = 760;
  if (fuFase == 2) {
    float t = constrain(1 - (fuAnimFin - millis()) / 600.0, 0, 1);
    bx = lerp(800, zonaX(fuZona) + AR_W / 6, t);
    if (fuFuerza > 0.9) {
      by = lerp(760, zonaY(fuZona) + AR_H / 4 - (160 * t), t);
    } else {
      by = lerp(760, zonaY(fuZona) + AR_H / 4 - 0, t);
    }
  }
  float t2;
  if (fuFase == 2) t2 = constrain(1 - (fuAnimFin - millis()) / 600.0, 0, 1); else t2 = 0;
  dibujarBalon(bx, by, lerp(40, 24, t2));

  if (fuFase == 1) {
    fuFuerza += fuDirFuerza * (0.018 + fuDif * 0.004) * pasoCuadro;
    if (fuFuerza > 1 || fuFuerza < 0) fuDirFuerza *= -1;
    fuFuerza = constrain(fuFuerza, 0, 1);

    float verde = 0.28 - fuDif * 0.025;
    fill(240, 200, 60);
    rect(1250, 300, 40, 400);
    fill(80, 200, 90);
    rect(1250, 700 - 400 * 0.9, 40, 400 * verde);
    fill(220, 70, 60);
    rect(1250, 300, 40, 400 * 0.1);
    fill(30);
    rect(1240, 700 - 400 * fuFuerza - 3, 60, 6);
    fill(255);
    textSize(16);
    textAlign(LEFT, CENTER);
    text("POR ENCIMA", 1300, 320);
    text("FUERTE", 1300, 700 - 400 * (0.9 - verde / 2));
    text("SUAVE", 1300, 680);
    textAlign(LEFT, BASELINE);
  }
  if (fuFase == 2 && millis() > fuAnimFin) {
    fuTiro++;
    fuFase = 0;
    fuZona = -1;
    if (fuTiro >= PEN_TIROS && fuDesempate) terminarPenales();
    else if (fuTiro >= PEN_TIROS) { fuFase = 3; fuMarca = 0; fuMensaje = "Pase largo: ESPACIO cuando la marca pase por tu compañero"; }
  }
}

// Qué zona del arco (0 a 5) está en esa posición.
int zonaArco(float x, float y) {
  if (x < AR_X || x > AR_X + AR_W || y < AR_Y || y > AR_Y + AR_H) return -1;
  int c = int((x - AR_X) / (AR_W / 3)), f = int((y - AR_Y) / (AR_H / 2));
  return f * 3 + c;
}

// Centro en x de una zona del arco.
float zonaX(int z) { return AR_X + (z % 3) * AR_W / 3; }
// Centro en y de una zona del arco.
float zonaY(int z) { return AR_Y + (z / 3) * AR_H / 2; }

// Patea el penal: gol si la fuerza está en la zona verde y el arquero no adivina.
void patear() {
  float verde = 0.28 - fuDif * 0.025;
  boolean fuerte = fuFuerza <= 0.9 && fuFuerza >= 0.9 - verde;
  boolean afuera = fuFuerza > 0.9;

  float adivina = 0.15 + fuDif * 0.06 + fuTiro * 0.05;
  if (random(1) < adivina) fuPortero = fuZona; else fuPortero = int(random(6));
  boolean atajo = !afuera && (fuPortero % 3 == fuZona % 3) && (!fuerte || fuPortero == fuZona);
  if (afuera) fuMensaje = "¡Se fue por encima!";
  else if (atajo) fuMensaje = "¡Lo atajó!";
  else { fuMensaje = "¡GOOOL!"; fuGoles++; }
  if (afuera || atajo) agregarInt(fuHistorial, 2); else agregarInt(fuHistorial, 1);
  fuFase = 2;
  fuAnimFin = millis() + 700;
}

// Dibuja el pase: el compañero corriendo y la barra de tiempo.
void dibujarPase() {

  float zona = 0.18 - fuDif * 0.015;
  float centro = 0.7;
  if (fuFase == 3) {
    fuMarca += fuDirMarca * (0.012 + fuDif * 0.003) * pasoCuadro;
    if (fuMarca > 1 || fuMarca < 0) fuDirMarca *= -1;
    fuMarca = constrain(fuMarca, 0, 1);
  }
  float x0 = 300, w = 1000;
  fill(255, 255, 255, 80);
  rect(x0, 420, w, 30, 10);
  fill(80, 200, 90);
  rect(x0 + (centro - zona / 2) * w, 420, zona * w, 30);
  fill(30);
  rect(x0 + fuMarca * w - 3, 410, 6, 50);
  fill(255);
  textSize(18);
  textAlign(CENTER, BASELINE);
  text("PASE LARGO " + (fuPase + 1) + " de " + PEN_PASES, 800, 400);
  textAlign(LEFT, BASELINE);
  fill(40, 90, 200);
  ellipse(x0 + centro * w + sin(millis() / 200.0) * 6, 340, 44, 44);
  fill(255);
  textSize(16);
  text("compañero", x0 + centro * w - 38, 310);
  fill(200, 40, 60);
  ellipse(x0 + centro * w - 130 + sin(millis() / 300.0) * 60, 360, 40, 40);
  fill(230, 70, 70);
  ellipse(320, 640, 46, 46);
  float bt;
  if (fuFase == 4) bt = constrain(1 - (fuAnimFin - millis()) / 700.0, 0, 1); else bt = 0;
  dibujarBalon(lerp(350, x0 + fuMarca * w, bt), lerp(660, 380, bt) - sin(bt * PI) * 160, 30);
  if (fuFase == 4 && millis() > fuAnimFin) {
    fuPase++;
    fuFase = 3;
    if (fuPase >= PEN_PASES) terminarPenales();
  }
}

// Da el pase: bien si la marca está en la zona.
void pasar() {
  float zona = 0.18 - fuDif * 0.015;
  boolean bien = abs(fuMarca - 0.7) < zona / 2;
  if (bien) fuPasesBien++;
  if (bien) fuMensaje = "¡Pase perfecto!"; else fuMensaje = "Se te fue largo...";
  fuFase = 4;
  fuAnimFin = millis() + 700;
}

// Termina los penales (o va al desempate).
void terminarPenales() {
  hecho("PENALES");
  if (fuDesempate) {
    fuDesempate = false;
    int rp = penalesRival();
    boolean ganoPen = fuGoles >= rp;
    registrarPartido(ganoPen, "Picado " + picGolesTu + " - " + picGolesRival + " · penales " + fuGoles + " - " + rp);
    empezarActividad(ACT_DEPORTE_RES);
    return;
  }
  int puntos = fuGoles * 15 + fuPasesBien * 25 / 2;
  int dif;
  if (copaActual >= 0) dif = int(COPA[copaActual][4]); else dif = 1;
  boolean gano = puntos >= umbralCopa(dif);
  registrarPartido(gano, fuGoles + " goles de " + PEN_TIROS + ", " + fuPasesBien + " pases buenos · " + puntos + " puntos (necesitabas " + umbralCopa(dif) + ")");
  empezarActividad(ACT_DEPORTE_RES);
}

// Click en una zona del arco para apuntar.
void clickFutbolPenal() {
  if (fuFase == 0) {
    int z = zonaArco(mouseX, mouseY);
    if (z >= 0) { fuZona = z; fuFase = 1; fuFuerza = 0; fuMensaje = "ESPACIO para la fuerza (verde = fuerte, rojo = por encima)"; }
  }
}

// ESPACIO para patear o pasar.
void teclaPenales() {
  if (key != ' ') return;
  if (fuFase == 1) patear();
  else if (fuFase == 3) pasar();
}

// ============================ NATACIÓN: RITMO DE BRAZADAS ============================
// Toca IZQUIERDA y DERECHA (flechas o A D) alternando, justo cuando la marca llega al centro.
// 2 largos contra el rival. Con Energía baja puede darte un calambre.
float naYo, naRival, naVelRival;
int naBeat, naInicio, naUltimoFrame, naCalambreHasta, naBrazadas, naBuenas;
boolean naToca = false;
boolean naCalambreDado = false;
String naMensaje = "";

// Empieza la natación simple (versión vieja) con la dificultad del rival.
void iniciarNatacion() {
  int dif;
  if (copaActual >= 0) dif = int(COPA[copaActual][4]); else dif = 1;
  naYo = 0;
  naRival = 0;
  naVelRival = 3.5 + dif * 0.5;
  naBeat = max(330, NADO_BEAT_MS - dif * 45);
  naInicio = millis();
  naUltimoFrame = millis();
  naBrazadas = 0;
  naBuenas = 0;
  naToca = false;
  naCalambreDado = false;
  naMensaje = "← → alternando al ritmo";
  empezarActividad(ACT_NATACION);
}

// Dibuja la natación simple.
void dibujarNatacion() {
  noStroke();
  fill(70, 160, 220);
  rect(0, 0, ANCHO, ALTO);

  for (int i = 0; i < 4; i++) {
    if (i % 2 == 0) fill(color(80, 175, 230)); else fill(color(65, 155, 215));
    rect(100, 200 + i * 110, 1400, 110);
  }
  stroke(255, 60, 60);
  strokeWeight(3);
  for (int i = 1; i < 4; i++) line(100, 200 + i * 110, 1500, 200 + i * 110);
  strokeWeight(1);
  noStroke();

  float dt = (millis() - naUltimoFrame) / 1000.0;
  naUltimoFrame = millis();
  naRival += naVelRival * dt;
  if (millis() > naCalambreHasta) naYo += 1.2 * dt;
  if (!naCalambreDado && stats[ST_ENERGIA] < 25 && naYo > NADO_LARGOS * 50) {
    naCalambreDado = true;
    naCalambreHasta = millis() + 1800;
    naMensaje = "¡Calambre!";
  }
  dibujarNadador(posNado(naYo), 200 + 55 + 110, color(255, 220, 60), true);
  dibujarNadador(posNado(naRival), 200 + 55 + 220, color(240, 90, 90), false);

  float fase = ((millis() - naInicio) % naBeat) / (float) naBeat;
  fill(255, 255, 255, 90);
  rect(500, 700, 600, 40, 12);
  fill(80, 220, 120);
  rect(800 - 40, 700, 80, 40);
  fill(30);
  rect(500 + fase * 600 - 3, 690, 6, 60);
  fill(255);
  textSize(40);
  textAlign(CENTER, CENTER);
  if (naToca) text("→", 800, 650); else text("←", 800, 650);
  textSize(24);
  text(naMensaje, 800, 790);
  text("Largo " + min(NADO_LARGOS, int(naYo / 100) + 1) + " de " + NADO_LARGOS + "   ·   brazadas buenas " + naBuenas + "/" + naBrazadas, 800, 140);
  textAlign(LEFT, BASELINE);
  textSize(22);
  if (copaActual >= 0) {
    text("COPA · Natación " + COPA[copaActual][3] + " vs " + COPA[copaActual][5], 40, 50);
  } else {
    text("PRÁCTICA de natación", 40, 50);
  }
  if (naYo >= NADO_LARGOS * 100 || naRival >= NADO_LARGOS * 100) terminarNatacion();
}

// Convierte el avance (0 a 200 %) en x: ida y vuelta
float posNado(float p) {
  float largo = p % 200;
  if (p >= NADO_LARGOS * 100) { if (NADO_LARGOS % 2 == 0) largo = 0; else largo = 100; }
  if (largo <= 100) return 140 + largo * 13.2; else return 140 + (200 - largo) * 13.2;
}

// Dibuja un nadador con figuras (si no hay sprite).
void dibujarNadador(float x, float y, int c, boolean tu) {
  fill(c);
  ellipse(x, y, 46, 30);
  fill(230, 190, 150);
  ellipse(x + 20, y, 22, 22);
  fill(255, 255, 255, 120);
  ellipse(x - 30, y, 30, 12);
  if (tu) { fill(255); textSize(16); textAlign(CENTER, CENTER); text("TÚ", x, y - 30); textAlign(LEFT, BASELINE); }
}

// Brazadas alternando izquierda y derecha en la natación simple.
void teclaNatacion() {
  boolean izq = (key == CODED && keyCode == LEFT) || key == 'a' || key == 'A';
  boolean der = (key == CODED && keyCode == RIGHT) || key == 'd' || key == 'D';
  if (!izq && !der) return;
  if (millis() < naCalambreHasta) return;
  naBrazadas++;
  float fase = ((millis() - naInicio) % naBeat) / (float) naBeat;
  boolean aTiempo = abs(fase - 0.5) < 0.12;
  boolean ladoBien = (der == naToca);
  if (aTiempo && ladoBien) { naYo += 3.2; naBuenas++; naMensaje = "¡Bien!"; naToca = !naToca; }
  else if (ladoBien) { naYo += 1.2; naMensaje = "Fuera de ritmo"; naToca = !naToca; }
  else { naYo += 0.3; naMensaje = "¡El otro brazo!"; }
}

// Termina la carrera de natación y da los efectos.
void terminarNatacion() {
  hecho("NADAR");
  boolean llegasteTu = naYo >= naRival;
  int dif;
  if (copaActual >= 0) dif = int(COPA[copaActual][4]); else dif = 1;
  int puntos = constrain(round(100 * naBuenas / (float) max(1, naBrazadas)), 0, 100);
  boolean gano = llegasteTu;
  mojado = true;
  duchado = false;
  if (llegasteTu) {
    registrarPartido(gano, "Llegaste primero" + " · ritmo " + puntos + " %");
  } else {
    registrarPartido(gano, "El rival llegó primero" + " · ritmo " + puntos + " %");
  }
  empezarActividad(ACT_DEPORTE_RES);
}

// ============================ VESTUARIOS Y PISCINA ============================
// Para entrar a la piscina: cambiarte en los casilleros (traje de baño) y ducharte.
// Al salir: ducharte y cambiarte. Si sales de Deportes en traje de baño: Energía y Social bajan.
boolean enTraje = false, duchado = false, mojado = false;
PImage pj_protagonista_natacion;

// Casilleros: ponerte o quitarte el traje de baño.
void casilleros() {
  enTraje = !enTraje;
  if (enTraje) {
    aviso("Te pusiste el traje de baño. Ahora, a la ducha.");
  } else if (mojado) {
    aviso("Te cambiaste de ropa." + " (Todavía hueles a cloro: dúchate)");
  } else {
    aviso("Te cambiaste de ropa." + "");
  }
  if (!enTraje) duchado = false;
}

// Duchas: antes de entrar a la piscina o para quitarte el cloro.
void duchas() {
  if (mojado) { mojado = false; aviso("Te quitaste el cloro. Ahora cámbiate en los casilleros."); }
  else { duchado = true; if (enTraje) aviso("Ducha lista. Ya puedes entrar a la piscina."); else aviso("Te duchaste."); }
  avanzarTiempo(10);
}

// ¿Te dejan entrar a la piscina?
boolean puedeNadar() {
  if (!enTraje) { aviso("Entrenadora Paz: “Así no entras a mi piscina. Cámbiate en los vestuarios.”"); return false; }
  if (!duchado) { aviso("Entrenadora Paz: “Primero la ducha. Reglas de la piscina.”"); return false; }
  return true;
}

// Entrar a la piscina: empieza la carrera si ya te cambiaste y te duchaste.
void nadar() {
  if (!puedeNadar()) return;
  empezarPartido("Natación");
  iniciarNatacion2();
}

// Lo llama desplazamientoMapa(): salir de Deportes en traje de baño tiene castigo
void revisarRopaAlSalir() {
  String cod = MAPA_COD[mapaActual];
  if (empiezaCon(cod, "C") && enTraje) {
    enTraje = false;
    mojado = false;
    aviso("Llegaste a casa y te cambiaste.");
    return;
  }
  if (!enTraje || empiezaCon(cod, "D")) return;
  if (mojado) {
    cambiarStat(ST_ENERGIA, -CASTIGO_TRAJE_ENERGIA - 3);
  } else {
    cambiarStat(ST_ENERGIA, -CASTIGO_TRAJE_ENERGIA - 0);
  }
  cambiarStat(ST_SOCIAL, -CASTIGO_TRAJE_SOCIAL);
  sumarBandera("TRAJE_AFUERA", 1);
  String aux1;
  if (mojado) aux1 = " y mojado"; else aux1 = "";
  int aux2;
  if (mojado) aux2 = 3; else aux2 = 0;
  aviso("Andas en traje de baño" + aux1 + " fuera de la piscina: Energía −" + (CASTIGO_TRAJE_ENERGIA + aux2) + " · Social −" + CASTIGO_TRAJE_SOCIAL);
}

// ============================ ENGANCHES (los llama el núcleo) ============================
// Acciones de deportes: fútbol, natación, casilleros.
boolean accionNueva5(String a) {
  if (a.equals(ACC_FUTBOL)) { empezarPartido("Fútbol"); iniciarPicado(); return true; }
  if (a.equals(ACC_NADAR)) { nadar(); return true; }
  if (a.equals(ACC_CASILLEROS)) { casilleros(); return true; }
  if (a.equals(ACC_DUCHAS)) { duchas(); return true; }
  return accionNueva7(a);
}

// Teclas de los deportes (penales, natación).
boolean teclasActividad5() {
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  if (teclasActividad7()) return true;
  if (actividad == ACT_FUTBOL) { teclaPenales(); return true; }
  if (actividad == ACT_NATACION) { teclaNatacion2(); return true; }
  if (actividad == ACT_DEPORTE_RES) { if (usar) terminarActividad(); return true; }
  return false;
}

// Clicks de los deportes.
boolean clickActividad5() {
  if (clickActividad7()) return true;
  if (actividad == ACT_FUTBOL) { clickFutbolPenal(); return true; }
  if (actividad == ACT_NATACION) return true;
  if (actividad == ACT_DEPORTE_RES) { terminarActividad(); return true; }
  return false;
}

// Dibuja el deporte que esté abierto.
boolean dibujarActividad5() {
  if (dibujarActividad7()) return true;
  if (actividad == ACT_FUTBOL) { dibujarPenales(); return true; }
  if (actividad == ACT_NATACION) { dibujarNatacion2(); return true; }
  if (actividad == ACT_DEPORTE_RES) { dibujarDeporteRes(); return true; }
  return false;
}

