// Dibuja un jugador de fútbol con su sprite (corriendo, barriéndose o con el balón).
void dibujarJugadorFutbol(int k, int du) {
  float x = footballS[k][F_XS], y = footballS[k][F_YS];
  int est = (int) footballS[k][F_ESTADOS];
  boolean azul = k < 4;
  noStroke();
  fill(0, 0, 0, 50);
  ellipse(x, y + 14, 34, 12);
  if (k == controladoS) {
    noFill();
    stroke(255, 230, 0);
    strokeWeight(3);
    ellipse(x, y + 14, 40, 14);
    strokeWeight(1);
    noStroke();

    fill(20, 20, 20, 180);
    rect(x - 22, y - 62, 44, 7, 3);
    if (stamS[k] > 30) fill(color(90, 200, 255)); else fill(color(240, 120, 60));
    rect(x - 22, y - 62, 44 * stamS[k] / 100, 7, 3);

    if (picCargaDesde > 0 && duenoS() == k) {
      float pot = potenciaCarga();
      fill(20, 20, 20, 180);
      rect(x - 30, y - 74, 60, 8, 3);
      if (pot > 2.0) {
        fill(color(230, 60, 60));
      } else {
        if (pot > 1.3) fill(color(90, 210, 100)); else fill(color(240, 200, 60));
      }
      rect(x - 30, y - 74, 60 * (pot - 0.7) / 1.7, 8, 3);
      if (efQ != efE) {
        fill(255);
        textSize(14);
        textAlign(CENTER, CENTER);
        if (efQ) {
          text("↺" + " efecto " + int(fuerzaEfecto() * 100 / 120) + "%", x, y - 88);
        } else {
          text("↻" + " efecto " + int(fuerzaEfecto() * 100 / 120) + "%", x, y - 88);
        }
        textAlign(LEFT, BASELINE);
      }
    }
  }
  float s = 64;
  if (esArquero(k)) {

    int f = 0;
    if (du == k) f = 3;
    else if (est == 1) { if (sin(footballS[k][F_ANGS]) < 0) f = 1; else f = 2; }
    else if (fbEstadoS == 1 && empiezaCon(fbMensajeS, "¡GOO") == !azul) f = 4;
    if (!tira(fu_portero, 5, f, x - s / 2, y - s + 16, s, s)) { fill(240, 200, 40); rect(x - 10, y - 14, 20, 28); }
    return;
  }
  int d = dirDeAngulo(footballS[k][F_ANGS]);
  cargarSprites11();
  boolean aux1;
  if (est == 2) {
    if (azul) aux1 = hay(fu_azulPiso); else aux1 = hay(fu_rivalPiso);
  } else {
    aux1 = false;
  }
  if (aux1) {
    int fp;
    if (footballS[k][F_TIMERS] < 10) fp = 1; else fp = 0;
    if (azul) {
      tira(fu_azulPiso, 2, fp, x - s / 2, y - s + 16, s, s);
    } else {
      tira(fu_rivalPiso, 2, fp, x - s / 2, y - s + 16, s, s);
    }
    return;
  }
  boolean aux2;
  if (est == 1) {
    if (azul) aux2 = hay(fu_azulBarrida); else aux2 = hay(fu_rivalBarrida);
  } else {
    aux2 = false;
  }
  if (aux2) {
    if (azul) {
      tira(fu_azulBarrida, 4, d, x - s / 2, y - s + 16, s, s);
    } else {
      tira(fu_rivalBarrida, 4, d, x - s / 2, y - s + 16, s, s);
    }
    return;
  }
  if (est == 2) {

    pushMatrix();
    translate(x, y);
    rotate(HALF_PI);
    tint(200);
    PImage aux3;
    if (azul) aux3 = fu_azul; else aux3 = fu_rival;
    if (!tira(aux3, 8, d * 2, -s / 2, -s / 2, s, s)) { if (azul) fill(color(25, 50, 130)); else fill(color(120, 30, 30)); rect(-13, -6, 26, 12); }
    noTint();
    popMatrix();
    return;
  }
  boolean corre = footballS[k][F_MOVS] == 1;
  int f;
  if (corre) f = d * 2 + ((millis() / 140) % 2); else f = d * 2 + 0;
  boolean ok;
  if (est == 1 && azul && hay(fu_patea)) ok = tira(fu_patea, 4, d, x - s / 2, y - s + 16, s, s);
  else if (azul) ok = tira(fu_azul, 8, f, x - s / 2, y - s + 16, s, s); else ok = tira(fu_rival, 8, f, x - s / 2, y - s + 16, s, s);
  if (!ok) { if (azul) fill(color(40, 90, 230)); else fill(color(220, 50, 50)); rect(x - 8, y - 12, 16, 24); }
}

// Flechas para moverte en el fútbol.
void teclaPicado(boolean v) {
  if (key == CODED) {
    if (keyCode == UP) pArr = v;
    if (keyCode == DOWN) pAba = v;
    if (keyCode == LEFT) pIzq = v;
    if (keyCode == RIGHT) pDer = v;
  }
  if (key == 'w' || key == 'W') pArr = v;
  if (key == 's' || key == 'S') pAba = v;
  if (key == 'a' || key == 'A') pIzq = v;
  if (key == 'd' || key == 'D') pDer = v;
  if (key == CODED && keyCode == SHIFT) pSprint = v;
  if (key == 'q' || key == 'Q') { if (v && !efQ) efDesde = millis(); efQ = v; }
  if (key == 'e' || key == 'E') { if (v && !efE) efDesde = millis(); efE = v; }
  if (v && picEligiendo && key >= '1' && key <= '4') elegirEstrategia(key - '1');
}

// Termina el partido: registra el resultado y da los efectos.
void terminarPicado() {
  hecho("PENALES");
  if (golDeOro) {
    registrarPartido(golesJS > golesES, golesJS + " - " + golesES + " (gol de oro)");
  } else {
    registrarPartido(golesJS > golesES, golesJS + " - " + golesES + "");
  }
  empezarActividad(ACT_DEPORTE_RES);
}

// ============================ FÚTBOL: ESTRATEGIAS, DEFENSAS, SPRINT, FUERZA Y EFECTO ============================
// { nombre, lo que dice el entrenador, defensas, línea del defensa (fracción de la cancha), agresividad, profundidad }
String[][] ESTRATEGIAS = {
  {"Equilibrada", "Un defensa hasta la mitad, los otros dos atacan. Presión normal.", "1", "0.5", "1.0", "1.0"},
  {"Defensiva", "Dos defensas que no pasan de su campo. Pocos goles en contra, pero cuesta llegar.", "2", "0.42", "0.85", "0.8"},
  {"Ofensiva", "Presión alta: van de a dos al que tiene el balón y el defensa sube más.", "1", "0.62", "1.5", "1.3"},
  {"Contragolpe", "Dos atrás y el de adelante siempre bien al fondo esperando el pase largo.", "2", "0.45", "1.0", "1.7"}
};
int[] estDefensas = new int[2];
float[] estLinea = new float[2], estAgresivo = { 1, 1 }, estProfundo = { 1, 1 };
boolean[] esDefensa = new boolean[8];
int estRival = 0;
boolean picEligiendo = false;

// Stamina y sprint (de cada jugador; solo se ve la tuya)
float[] stamS = new float[8];
boolean[] sprintS = new boolean[8];
final float SPRINT_VEL = 1.4, STAM_GASTO = 0.7, STAM_RECUPERA = 0.3;
boolean pSprint, efQ, efE;
int efDesde = 0;
boolean golDeOro = false;

// El efecto crece mientras mantienes Q o E (hasta 1,2 s)
float fuerzaEfecto() {
  if (efQ == efE) return 0;
  return 20 + min(millis() - efDesde, 1200) / 1200.0 * 100;
}

// Patear: entre más mantienes el click, más fuerte (y más lejos rueda después); Q/E = efecto
int picCargaDesde = 0;
float picPotencia = 1, picCurva = 0;

// Estrategia del rival según la ronda de la Copa.
int estrategiaRival() {
  if (copaActual < 0) return dia % 4;
  String r = COPA[copaActual][3];
  if (r.equals("Cuartos")) return 1; else if (r.equals("Semifinal")) return 3; else return 2;
}

// Aplica una estrategia (defensas, línea, agresividad) a un equipo.
void aplicarEstrategia(int eq, int e) {
  estDefensas[eq] = int(ESTRATEGIAS[e][2]);
  estLinea[eq] = float(ESTRATEGIAS[e][3]);
  estAgresivo[eq] = float(ESTRATEGIAS[e][4]);
  estProfundo[eq] = float(ESTRATEGIAS[e][5]);
}

// Eliges tu estrategia en la pizarra del entrenador.
void elegirEstrategia(int e) {
  aplicarEstrategia(0, e);
  picEligiendo = false;
  formacionS(fbSaqueS);
  asignarDefensas();
  fbCicloS = millis();
  picUltimo = millis();
}

// Defensas: con 1, el del medio; con 2, los de las puntas
void asignarDefensas() {
  for (int k = 0; k < 8; k++) esDefensa[k] = false;
  for (int eq = 0; eq < 2; eq++) {
    int ini = iniEqS(eq);
    if (estDefensas[eq] == 1) esDefensa[ini + 2] = true;
    if (estDefensas[eq] >= 2) { esDefensa[ini + 1] = true; esDefensa[ini + 3] = true; }
  }
}

// Dónde se para la línea de defensas de un equipo.
float lineaDefensa(int eq) {
  float ancho = CX2S - CX1S;
  if (eq == 0) return CX1S + ancho * estLinea[0]; else return CX2S - ancho * estLinea[1];
}

// El defensa (si no lo manejas tú) no pasa de su línea
float limiteDefensa(int k, float tx) {
  if (!esDefensa[k] || k == controladoS) return tx;
  if (equipoDeS(k) == 0) return min(tx, lineaDefensa(0)); else return max(tx, lineaDefensa(1));
}

// Si tú eres el defensa y das un pase, la condición de defensa pasa al compañero que esté más atrás
void pasarDefensa(int k, int receptor) {
  if (!esDefensa[k]) return;
  int mejor = -1;
  float atras = 99999;
  for (int q = 1; q < 4; q++) {
    if (q != k && q != receptor && !esDefensa[q]) {
      if (footballS[q][F_XS] < atras) { atras = footballS[q][F_XS]; mejor = q; }
    }
  }
  if (mejor < 0 && receptor >= 1 && receptor <= 3 && !esDefensa[receptor]) mejor = receptor;
  if (mejor < 0) return;
  esDefensa[k] = false;
  esDefensa[mejor] = true;
}

// Decide qué jugadores corren más rápido (sprint) en este momento.
void actualizarSprint() {
  int du = duenoS();
  for (int k = 0; k < 8; k++) {
    boolean quiere;
    if (k == controladoS) quiere = pSprint && (pArr || pAba || pIzq || pDer);
    else {
      int rol = (int) footballS[k][F_ROLS];
      quiere = rol == ROL_PERSEGUIRS || rol == ROL_BALONS || rol == ROL_RECEPTORS
        || footballS[k][F_MANIOBRAS] == MAN_PROFUNDOS || (k == du && k >= 4);
      if (esArquero(k)) quiere = false;
    }
    boolean aux1;
    if (quiere) {
      if (sprintS[k]) aux1 = stamS[k] > 0; else aux1 = stamS[k] > 30;
    } else {
      aux1 = false;
    }
    if (aux1) {
      sprintS[k] = true;
      stamS[k] = max(0, stamS[k] - STAM_GASTO);
      if (stamS[k] <= 0) sprintS[k] = false;
    } else {
      sprintS[k] = false;
      stamS[k] = min(100, stamS[k] + STAM_RECUPERA);
    }
  }
}

// Potencia del tiro según cuánto tiempo mantienes el click.
float potenciaCarga() {
  return constrain(0.7 + (millis() - picCargaDesde) / 500.0, 0.7, 2.4);
}

// Lo llama mouseReleased(): patea con la fuerza cargada
void soltarClickPicado() {
  if (actividad != ACT_PICADO || picCargaDesde == 0) return;
  float pot = potenciaCarga();
  picCargaDesde = 0;
  int k = controladoS;
  if (duenoS() != k || fbEstadoS != 0) return;
  picPotencia = pot;
  int aux1;
  if (efE) aux1 = 1; else aux1 = 0;
  int aux2;
  if (efQ) aux2 = 1; else aux2 = 0;
  int lado = aux1 - aux2;
  picCurva = lado * fuerzaEfecto();

  float mx = mouseX, my = mouseY;
  if (pot > 1.4) {
    float desvio;
    if (random(1) < 0.5) {
      desvio = (pot - 1.4) * 70 * (-1) * random(0.3, 1);
    } else {
      desvio = (pot - 1.4) * 70 * 1 * random(0.3, 1);
    }
    my += desvio;
  }
  lanzarPaseS(k, mx, my);
  if (duenoS() != k) pasarDefensa(k, (int) footballS[BALONS][B_RECEPTORS]);
}

