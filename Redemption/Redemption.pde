// Categoría de un producto (comida, estudio, deporte...).
String categoriaItem(String it) {
  for (int k = 0; k < ITEM_CAT.length; k++) if (ITEM_CAT[k][0].equals(it)) return ITEM_CAT[k][1];
  return "";
}

// Usar un ítem del inventario
void usarItem(int fila) {
  if (fila < 0 || fila >= numInv) return;
  String it = inventario[fila][0];
  for (int k = 0; k < ITEM_USO.length; k++) {
    if (ITEM_USO[k][0].equals(it)) {
      if (it.equals("Pack de café en lata ×6")) { quitarInventario(it, 1); agregarInventario("Café en lata", 6); return; }
      String r = aplicarEfectos(ITEM_USO[k][1], -1);
      if (ITEM_USO[k][2].equals("1")) quitarInventario(it, 1);
      String catUso = categoriaItem(it);
      if (catUso.equals("comida") || catUso.equals("bebida")) empezarAComer();
      avisoGrande("Usaste", it, ITEM_USO[k][3] + "  " + r, color(70, 110, 190));
      return;
    }
  }
  if (it.equals("Pack de café en lata ×6")) { quitarInventario(it, 1); agregarInventario("Café en lata", 6); aviso("Abres el pack: 6 cafés en lata"); return; }
  String cat = categoriaItem(it);
  if (cat.equals("sueño") || cat.equals("deporte") || cat.equals("tecnologia")) aviso(it + ": lo llevas contigo (funciona solo)");
  else if (cat.equals("regalo")) aviso(it + " es para regalar: abre el inventario cerca de esa persona");
  else aviso("No puedes usar " + it + " ahora");
}

// Regalar: le encanta (amistad del guion), le gusta (+3), neutral (+1), no le sirve (no lo recibe)
void regalar(int fila) {
  if (regaloNPC < 0 || fila < 0 || fila >= numInv) return;
  hecho("REGALO");
  int f = npcPersona[regaloNPC];
  if (regaloHoy == null) regaloHoy = new boolean[DLG_PERSONA.length];
  String it = inventario[fila][0];
  reaccionNPC = regaloNPC;
  if (regaloHoy[f]) {
    reaccionTexto = "Ya me diste algo hoy. Guárdalo para otro día.";
    empezarActividad(ACT_REACCION);
    return;
  }
  int tipo = 1, val = 1;
  String cat = categoriaItem(it);
  for (int k = 0; k < GUSTOS.length; k++) {
    if (GUSTOS[k][0].equals(DLG_PERSONA[f])) {
      partirPorLetra(GUSTOS[k][1], '|');
      String[] enc = resPartirPorLetra;
      for (int i = 0; i < enc.length; i++) {
        partirPorLetra(enc[i], ':');
        String[] par = resPartirPorLetra;
        if (par.length == 2 && par[0].equals(it)) { tipo = 3; val = int(par[1]); }
      }
      if (tipo != 3) {
        if (posicionDe(("|" + GUSTOS[k][2] + "|"), "|" + cat + "|") >= 0) { tipo = 2; val = 3; }
        else if (posicionDe(("|" + GUSTOS[k][3] + "|"), "|" + cat + "|") >= 0) { tipo = 0; val = 0; }
      }
    }
  }
  reaccionTexto = lineaRegalo(f, tipo);
  if (tipo == 0) {
    aviso(nombreCorto(f) + " no lo quiso. Lo guardas.");
  } else {
    quitarInventario(it, 1);
    cambiarAmistad(f, val);
    regaloHoy[f] = true;
    aviso("Le regalaste " + it + " a " + nombreCorto(f) + " · amistad +" + val);
  }
  empezarActividad(ACT_REACCION);
}

// Lo que dice una persona cuando le das un regalo (según si le gusta).
String lineaRegalo(int f, int tipo) {
  for (int k = 0; k < REGALO_LINEAS.length; k++) {
    if (REGALO_LINEAS[k][0].equals(DLG_PERSONA[f])) {
      if (tipo == 3) return REGALO_LINEAS[k][1];
      if (tipo == 0) return REGALO_LINEAS[k][3];
      return REGALO_LINEAS[k][2];
    }
  }
  if (tipo == 3) {
    return "¡Justo lo que quería! Gracias.";
  } else {
    if (tipo == 0) return "Eh... no, gracias. Eso no me sirve."; else return "Gracias, qué detalle.";
  }
}

// ---- inventario: [Usar] y [Regalar] en cada fila ----
final float INV_X = 430, INV_Y = 100, INV_W = 740, INV_FILA = 50;
final int INV_VISIBLES = 12;
int invScroll = 0;

// Abre el inventario (para usar algo o regalárselo a quien tienes al lado).
void abrirInventario() {
  regaloNPC = npcParaHablar();
  empezarActividad(ACT_INVENTARIO);
}

// Dibuja el inventario con lo que tienes y los botones Usar y Regalar.
void dibujarInventario() {
  int filas = max(1, numInv);
  int vis = min(filas, INV_VISIBLES);
  invScroll = constrain(invScroll, 0, max(0, numInv - INV_VISIBLES));
  float alto = 150 + vis * INV_FILA + 40;
  if (numInv > INV_VISIBLES) {
    ventana(INV_X, INV_Y, INV_W, alto, "Inventario" + ("  (" + numInv + " cosas)"));
  } else {
    ventana(INV_X, INV_Y, INV_W, alto, "Inventario" + "");
  }
  if (regaloNPC >= 0) fill(color(150, 70, 140)); else fill(color(110));
  textSize(19);
  if (regaloNPC >= 0) {
    text("Puedes regalarle algo a " + nombreCorto(npcPersona[regaloNPC]), INV_X + 30, INV_Y + 88);
  } else {
    text("Acércate a alguien para regalarle algo", INV_X + 30, INV_Y + 88);
  }
  if (numInv == 0) { fill(40); textSize(22); text("Vacío. Compra algo en las tiendas o en Pedidazo.", INV_X + 30, INV_Y + 150); }
  for (int i = 0; i < vis && invScroll + i < numInv; i++) {
    int k = invScroll + i;
    float y = INV_Y + 110 + i * INV_FILA;
    noStroke();
    fill(232, 228, 215);
    rect(INV_X + 20, y, INV_W - 40, INV_FILA - 4, 8);
    dibujarIconoProducto(inventario[k][0], INV_X + 26, y + 2, INV_FILA - 8);
    fill(40);
    textSize(20);
    text(inventario[k][0] + "  x" + inventario[k][1], INV_X + 30 + INV_FILA, y + 31);
    botonInv(INV_X + INV_W - 230, y + 7, "Usar", true);
    botonInv(INV_X + INV_W - 125, y + 7, "Regalar", regaloNPC >= 0);
  }
  fill(110);
  textSize(18);
  if (numInv > INV_VISIBLES) {
    text("[TAB], [E] o [Q] cerrar" + "   ·   rueda o flechas (arriba/abajo) para ver más", INV_X + 30, INV_Y + alto - 18);
  } else {
    text("[TAB], [E] o [Q] cerrar" + "", INV_X + 30, INV_Y + alto - 18);
  }
  if (numInv > INV_VISIBLES) {
    float h = vis * INV_FILA, bh = max(30, h * INV_VISIBLES / numInv);
    fill(220);
    rect(INV_X + INV_W - 14, INV_Y + 110, 6, h, 3);
    fill(140);
    rect(INV_X + INV_W - 14, INV_Y + 110 + (h - bh) * invScroll / max(1, numInv - INV_VISIBLES), 6, bh, 3);
  }
}

// Dibuja un botón del inventario.
void botonInv(float x, float y, String t, boolean activo) {
  boolean encima = activo && mouseX > x && mouseX < x + 95 && mouseY > y && mouseY < y + 32;
  if (!activo) fill(color(210)); else if (encima) fill(color(150, 200, 255)); else fill(color(190, 215, 250));
  rect(x, y, 95, 32, 8);
  if (activo) fill(30); else fill(150);
  textSize(16);
  textAlign(CENTER, CENTER);
  text(t, x + 47, y + 15);
  textAlign(LEFT, BASELINE);
}

// Clicks en el inventario: usar o regalar.
void clickInventario() {
  for (int i = 0; i < min(numInv - invScroll, INV_VISIBLES); i++) {
    int k = invScroll + i;
    float y = INV_Y + 110 + i * INV_FILA + 7;
    if (!(mouseY < y) && !(mouseY > y + 32)) {
      if (mouseX > INV_X + INV_W - 230 && mouseX < INV_X + INV_W - 135) { usarItem(k); return; }
      if (mouseX > INV_X + INV_W - 125 && mouseX < INV_X + INV_W - 30 && regaloNPC >= 0) { regalar(k); return; }
      return;
    }
  }
  float alto = 150 + min(max(1, numInv), INV_VISIBLES) * INV_FILA + 40;
  if (mouseX < INV_X || mouseX > INV_X + INV_W || mouseY < INV_Y || mouseY > INV_Y + alto) terminarActividad();
}

