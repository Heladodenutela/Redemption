// Click en una estrategia de la pizarra.
boolean clickCoach() {
  if (!picEligiendo) return false;
  for (int i = 0; i < ESTRATEGIAS.length; i++) {
    float x = 300 + (i % 2) * 510, y = 310 + (i / 2) * 200;
    if (mouseX > x && mouseX < x + 490 && mouseY > y && mouseY < y + 180) elegirEstrategia(i);
  }
  return true;
}

