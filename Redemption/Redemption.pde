// Número de una persona a partir de su nombre (o -1 si no existe).
int personaIndice(String nombre) {
  for (int f = 0; f < DLG_PERSONA.length; f++) if (DLG_PERSONA[f].equals(nombre)) return f;
  return -1;
}

// Persona a la que pertenece una hoja de sprites.
int personaDeHoja(String hoja) {
  for (int k = 0; k < HOJA_PERSONA.length; k++) if (HOJA_PERSONA[k][0].equals(hoja)) return personaIndice(HOJA_PERSONA[k][1]);
  return -1;
}

// Nombre para la etiqueta: "Mamá (Claudia)" -> "Mamá", "Nico, el del café" -> "Nico"
String nombreCorto(int f) {
  String n = DLG_PERSONA[f];
  int c = posicionDe(n, ",");
  if (c > 0) n = n.substring(0, c);
  int p = posicionDe(n, " (");
  if (p > 0) n = n.substring(0, p);
  return n;
}

// Nombre del nivel de amistad: Amigo, Conocido o Molesto.
String estadoAmistad(int a) {
  if (a >= 60) return "Amigo";
  if (a >= 35) return "Conocido";
  return "Molesto";
}

// Primera línea de esa persona con ese contexto exacto (null si no hay)
String buscarLinea(String persona, String contexto) {
  if (!lineaGuionVale(persona, contexto)) return null;
  for (int k = 0; k < GUION.length; k++) {
    if (GUION[k][0].equals(persona) && GUION[k][1].equals(contexto)) return GUION[k][2];
  }
  return null;
}

// Línea de sueño que le toca según tu deuda ("Sueño, ... deuda de sueño 2 ..."): la de número más alto que alcances
String lineaSueno(String persona) {
  String mejor = null;
  int mejorN = 0;
  for (int k = 0; k < GUION.length; k++) {
    String c = GUION[k][1];
    if (GUION[k][0].equals(persona) && empiezaCon(c, "Sueño") && !(posicionDe(c, "deuda") < 0) && !(posicionDe(c, "otra vez") >= 0) && !(posicionDe(c, "bus") >= 0)) {
      int n = 0;
      for (int i = posicionDe(c, "deuda"); i < c.length(); i++) {
        char ch = letraEn(c, i);
        if (ch >= '0' && ch <= '9') { n = ch - '0'; break; }
      }
      if (n > 0 && deudaSueno >= n && n > mejorN) { mejor = GUION[k][2]; mejorN = n; }
    }
  }
  return mejor;
}

// NPC con diálogo más cercano en este mapa (-1 si nadie)
int npcParaHablar() {
  int mejor = -1;
  float md = DIST_HABLAR;
  for (int k = 0; k < numNPC; k++) {
    if (npcMapa[k] == mapaActual && npcPersona[k] >= 0 && npcPresente(k)) {
      float d = abs(npcX[k] - pjX);
      if (d < md) { md = d; mejor = k; }
    }
  }
  return mejor;
}

// Fila del NPC que se usa para el retrato (los que caminan usan su fila 0 = AFK)
int npcFilaAFK(int k) {
  if (npcVel[k] > 0) return 0; else return npcFila[k];
}


