    } else if (v[5].equals("AHORA")) {
      agregarMensaje(v[3], '0', "Va. Una y ya.");
      String r = aplicarEfectos(v[8], f);
      if (!r.equals("")) aviso(r);
    } else {
      agregarMensaje(v[3], '0', "Va, ya lo hago.");
      aplicarEfectos(v[8], f);
      cel = 0;
      iniciarMinijuegoV20(v[6]);
    }
    return true;
  }
  if (enBoton(celX1 + 246, y + 40, 200, 44)) {
    invEstado[k] = 2;
    if (v[5].equals("AHORA")) {
      agregarMensaje(v[3], '0', "Hoy no, mañana madrugo.");
    } else {
      agregarMensaje(v[3], '0', "Hoy no puedo, perdón.");
    }
    String r = aplicarEfectos(v[9], f);
    if (!r.equals("")) aviso(r);
    return true;
  }
  return false;
}

