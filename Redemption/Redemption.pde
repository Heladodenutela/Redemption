// (el fútbol de la Copa está más abajo: usa el mismo motor del rugby, con arco)

// ============================ NATACIÓN POR TRAMOS ============================
// La carrera es de 100 m (dos largos). Cada ~9 s cambia el estilo (te avisan 1 s antes):
// CROL: izquierda y derecha alternando al ritmo. PECHO: repite la secuencia de flechas. ESPALDA: la flecha que sale
// (si es roja, la contraria). RESPIRACIÓN: ESPACIO cuando el anillo cierra la burbuja.
// MARIPOSA (desde el día 6): machaca ESPACIO y flecha arriba para respirar cada 5 brazadas.
// En la pared (50 m): VIRAJE, ESPACIO en el momento justo.
final int NE_CROL = 0, NE_PECHO = 1, NE_ESPALDA = 2, NE_RESPIRA = 3, NE_MARIPOSA = 4, NE_VIRAJE = 5;
final String[] NE_NOMBRE = { "CROL", "PECHO", "ESPALDA", "RESPIRACIÓN", "MARIPOSA", "VIRAJE" };
float neM, neRivalM, neVel, neVelRival, neAnillo;
int neEstilo, neSiguiente, neTramoFin, neUltimo, neFin, neDif, neCalambreHasta;
int neBeat, neBeatInicio, neBrazadasMar, neFlechaHasta, neBurbujaDesde, neViraDesde, neFeedHasta;
boolean neToca, neRoja, neRespirar, neViro, neCalambreDado;
int neFlecha;
int[] neSecuencia = new int[8];
int neSecPos;
String neFeed = "";

// Empieza la carrera de natación por estilos con la dificultad del rival.
void iniciarNatacion2() {
  cargarSprites9();
  if (copaActual >= 0) neDif = int(COPA[copaActual][4]); else neDif = 1;
  int ganadas = 0;
  for (int k = 0; k < COPA.length; k++) if (COPA[k][2].equals("Natación") && copaEstado[k] == 1) ganadas++;
  neVelRival = NADO_RIVAL * NADO_METROS / (60.0 - neDif * 2.8 - ganadas * 1.0);
  neM = 0;
  neRivalM = 0;
  neVel = 0.6;
  neBeat = max(380, NADO_BEAT_MS - neDif * 40);
  neBeatInicio = millis();
  neViro = false;
  neCalambreDado = false;
  neCalambreHasta = 0;
  neFin = 0;
  naBrazadas = 0;
  naBuenas = 0;
  neEstilo = NE_CROL;
  neSiguiente = elegirEstilo(NE_CROL);
  neTramoFin = millis() + NADO_TRAMO_MS;
  prepararEstilo();
  neUltimo = millis();
  empezarActividad(ACT_NATACION);
}

// Elige el siguiente estilo de nado (la mariposa sale desde cierto día).
int elegirEstilo(int actual) {
  int n;
  if (dia >= NADO_MARIPOSA_DIA) n = 5; else n = 4;
  int e = (actual + 1 + int(random(n - 1))) % n;
  if (e == actual) return (e + 1) % n; else return e;
}

// Prepara el estilo nuevo: secuencia de teclas o flechas.
void prepararEstilo() {
  neToca = false;
  neSecPos = 0;
  neBrazadasMar = 0;
  neRespirar = false;
  if (neEstilo == NE_PECHO) nuevaSecuencia();
  if (neEstilo == NE_ESPALDA) nuevaFlecha();
  if (neEstilo == NE_RESPIRA) neBurbujaDesde = millis() + 300;
}

// Inventa la secuencia de flechas que hay que repetir.
void nuevaSecuencia() {
  int largo = min(7, 3 + neDif / 2);
  neSecuencia[0] = largo;
  for (int i = 1; i <= largo; i++) neSecuencia[i] = int(random(4)) % 4;
  neSecPos = 0;
}

// Saca la siguiente flecha (algunas rojas que no hay que presionar).
void nuevaFlecha() {
  neFlecha = int(random(4)) % 4;
  neRoja = random(1) < 0.2 + neDif * 0.04;
  neFlechaHasta = millis() + max(650, 1300 - neDif * 90);
}

// Muestra un mensaje corto mientras nadas ('¡Bien!', 'Fallo').
void feedNado(String s) {
  neFeed = s;
  neFeedHasta = millis() + 700;
}

// Suma o quita velocidad según si la brazada fue buena.
void impulso(float v, boolean bueno) {
  naBrazadas++;
  if (bueno) naBuenas++;
  if (v > 0) neVel = constrain(neVel + (v * NADO_IMPULSO), 0.25, 3.0); else neVel = constrain(neVel + v, 0.25, 3.0);
}

// Dibuja la carrera: piscina, nadadores, flechas y metros.
void dibujarNatacion2() {
  float dt = (millis() - neUltimo) / 1000.0;
  neUltimo = millis();
  dt = min(dt, 0.05);
  boolean calambre = millis() < neCalambreHasta;
  if (neFin == 0) {
    neRivalM += neVelRival * dt;

    neVel += (0.6 - neVel) * 0.5 * dt;
    if (!calambre) neM += neVel * dt;
    if (!neCalambreDado && stats[ST_ENERGIA] < 25 && neM > 70) { neCalambreDado = true; neCalambreHasta = millis() + 1800; feedNado("¡Calambre!"); }

    if (!neViro && neM >= NADO_METROS / 2.0 - 1.2 && neEstilo != NE_VIRAJE) {
      neEstilo = NE_VIRAJE;
      neViraDesde = millis();
    }
    if (neEstilo == NE_VIRAJE && millis() - neViraDesde > 1600) {
      neViro = true;
      neVel = 0.35;
      feedNado("Viraje tarde...");
      neEstilo = neSiguiente;
      neSiguiente = elegirEstilo(neEstilo);
      neTramoFin = millis() + NADO_TRAMO_MS;
      prepararEstilo();
    }

    if (neEstilo != NE_VIRAJE && millis() > neTramoFin) {
      neEstilo = neSiguiente;
      neSiguiente = elegirEstilo(neEstilo);
      neTramoFin = millis() + NADO_TRAMO_MS;
      prepararEstilo();
    }

    if (neEstilo == NE_ESPALDA && millis() > neFlechaHasta) { impulso(-0.25, false); feedNado("¡Tarde!"); nuevaFlecha(); }

    if (neEstilo == NE_RESPIRA && millis() - neBurbujaDesde > 1150) { impulso(-0.3, false); feedNado("¡Sin aire!"); neBurbujaDesde = millis() + 250; }
    if (neM >= NADO_METROS || neRivalM >= NADO_METROS) {
      neFin = millis() + 1200;
      if (neM >= neRivalM) feedNado("¡Primero!"); else feedNado("El rival tocó primero");
    }
  }
  dibujarPiscina2();
  dibujarControlesNado();
  if (neFin > 0 && millis() > neFin) {
    naYo = neM;
    naRival = neRivalM;
    terminarNatacion();
  }
}

// Posición en pantalla según los metros nadados (ida y vuelta).
float xEnPiscina(float m) {
  float largo = NADO_METROS / 2.0;
  float p;
  if (m <= largo) p = m / largo; else p = 1 - (m - largo) / largo;
  return 70 + constrain(p, 0, 1) * 1460;
}

// Dibuja la piscina con su sprite o con figuras.
void dibujarPiscina2() {
  if (hay(na_piscina)) image(na_piscina, 0, 0, ANCHO, ALTO);
  else {
    noStroke();
    fill(225, 230, 240);
    rect(0, 0, ANCHO, ALTO);
    fill(70, 160, 220);
    rect(20, 360, 1560, 500);
    stroke(255, 60, 60);
    strokeWeight(3);
    line(20, 524, 1580, 524);
    line(20, 694, 1580, 694);
    strokeWeight(1);
    noStroke();
  }

  boolean vuelta = neM > NADO_METROS / 2.0;
  dibujarNadador2(xEnPiscina(neM), 610, true, vuelta);
  dibujarNadador2(xEnPiscina(neRivalM), 780, false, neRivalM > NADO_METROS / 2.0);
}

// Dibuja un nadador con su sprite y animación.
void dibujarNadador2(float x, float y, boolean tu, boolean vuelta) {
  int f;
  if (tu) {
    f = (millis() / max(90, int(260 - neVel * 50))) % 4;
  } else {
    f = (millis() / max(90, int(260 - neVelRival * 50))) % 4;
  }
  float w = 288, h = 144;
  boolean ok;
  if (tu) {
    if (neEstilo == NE_VIRAJE) {
      float t = (millis() - neViraDesde) / 1600.0;
      ok = hay(na_viraje);
      if (ok) tiraEspejo(na_viraje, 3, min(2, int(t * 3)), x - w / 2, y - h / 2, w * 0.75, h, false);
    } else if (millis() < neFeedHasta && neEstilo == NE_RESPIRA && empiezaCon(neFeed, "¡Aire")) {
      ok = hay(na_respira);
      if (ok) tiraEspejo(na_respira, 1, 0, x - w / 2, y - h / 2, w, h, vuelta);
    } else {
      PImage img;
      if (neEstilo == NE_PECHO) {
        img = na_pecho;
      } else if (neEstilo == NE_ESPALDA) {
        img = na_espalda;
      } else {
        if (neEstilo == NE_MARIPOSA) img = na_mariposa; else img = na_crol;
      }
      ok = hay(img);
      if (ok) tiraEspejo(img, 4, f, x - w / 2, y - h / 2, w, h, vuelta);
    }
  } else {
    ok = hay(na_rival);
    if (ok) tiraEspejo(na_rival, 4, f, x - w / 2, y - h / 2, w, h, vuelta);
  }
  if (!ok) {
    noStroke();
    if (tu) fill(color(255, 220, 60)); else fill(color(240, 90, 90));
    ellipse(x, y, 90, 34);
    fill(230, 190, 150);
    if (vuelta) ellipse(x + (-40), y, 28, 28); else ellipse(x + 40, y, 28, 28);
  }
  if (tu) { fill(255); textSize(18); textAlign(CENTER, CENTER); text("TÚ", x, y - 60); textAlign(LEFT, BASELINE); }

  if (tu && neEstilo == NE_RESPIRA) {
    float t = constrain((millis() - neBurbujaDesde) / 900.0, 0, 1.3);
    float bxx;
    if (vuelta) bxx = x + (-70); else bxx = x + 70;
    float byy = y - 90;
    if (hay(na_burbuja)) image(na_burbuja, bxx - 32, byy - 32, 64, 64);
    else { fill(200, 230, 255); ellipse(bxx, byy, 60, 60); }
    noFill();
    if (abs(t - 1) < 0.18) stroke(color(80, 230, 110)); else stroke(color(255));
    strokeWeight(4);
    float r = lerp(180, 60, min(t, 1.3));
    ellipse(bxx, byy, r, r);
    strokeWeight(1);
    noStroke();
  }
}

// Los controles, arriba (sobre la pared de la piscina)
void dibujarControlesNado() {
  noStroke();
  fill(15, 20, 35, 225);
  rect(200, 20, 1200, 310, 18);
  fill(255);
  textAlign(CENTER, TOP);
  textSize(22);
  String titulo;
  if (copaActual >= 0) {
    titulo = "COPA · Natación " + COPA[copaActual][3] + " vs " + COPA[copaActual][5];
  } else {
    titulo = "Natación de práctica";
  }
  text(titulo + "   ·   " + int(neM) + " m de " + NADO_METROS + "   ·   rival " + int(neRivalM) + " m", 800, 32);

  fill(70);
  rect(260, 68, 1080, 10, 5);
  fill(255, 220, 60);
  ellipse(260 + 1080 * constrain(neM / NADO_METROS, 0, 1), 73, 18, 18);
  fill(240, 90, 90);
  ellipse(260 + 1080 * constrain(neRivalM / NADO_METROS, 0, 1), 73, 14, 14);

  textSize(34);
  fill(255, 230, 80);
  text(NE_NOMBRE[neEstilo], 800, 92);
  int falta = neTramoFin - millis();
  if (neEstilo != NE_VIRAJE && falta < 1000 && falta > 0) {
    fill(255, 120, 120);
    textSize(20);
    text("Siguiente: " + NE_NOMBRE[neSiguiente] + "!", 800, 134);
  }
  float cy = 210;
  if (neEstilo == NE_CROL) {
    float fase = ((millis() - neBeatInicio) % neBeat) / (float) neBeat;
    fill(255, 255, 255, 60);
    rect(500, cy, 600, 34, 12);
    fill(80, 220, 120);
    rect(760, cy, 80, 34);
    fill(255);
    rect(500 + fase * 600 - 3, cy - 8, 6, 50);
    if (neToca) dibujarFlechaNado(3, false, 800, cy - 40, 64); else dibujarFlechaNado(2, false, 800, cy - 40, 64);
    textSize(16);
    text("← → alternando, cuando la marca pase por el verde", 800, cy + 50);
  } else if (neEstilo == NE_PECHO) {
    int n = neSecuencia[0];
    for (int i = 1; i <= n; i++) {
      float x = 800 + (i - 1 - (n - 1) / 2.0) * 90;
      if (i <= neSecPos) tint(255, 90);
      dibujarFlechaNado(neSecuencia[i], false, x, cy, 76);
      noTint();
    }
    fill(255);
    textSize(16);
    text("Repite la secuencia en orden", 800, cy + 50);
  } else if (neEstilo == NE_ESPALDA) {
    dibujarFlechaNado(neFlecha, neRoja, 800, cy - 10, 96);
    float t = constrain((neFlechaHasta - millis()) / (float) max(650, 1300 - neDif * 90), 0, 1);
    fill(70);
    rect(700, cy + 46, 200, 8, 4);
    fill(255, 200, 60);
    rect(700, cy + 46, 200 * t, 8, 4);
    fill(255);
    textSize(16);
    if (neRoja) text("¡ROJA: la contraria!", 800, cy + 62); else text("Toca esa flecha", 800, cy + 62);
  } else if (neEstilo == NE_RESPIRA) {
    textSize(18);
    text("ESPACIO cuando el anillo cierre la burbuja", 800, cy);
  } else if (neEstilo == NE_MARIPOSA) {
    textSize(20);
    if (neRespirar) fill(color(255, 120, 120)); else fill(color(255));
    if (neRespirar) {
      text("¡↑ RESPIRA!", 800, cy);
    } else {
      text("Machaca ESPACIO  (" + (5 - neBrazadasMar % 5) + " para respirar)", 800, cy);
    }
  } else if (neEstilo == NE_VIRAJE) {
    float t = constrain((millis() - neViraDesde) / 1600.0, 0, 1);
    fill(255, 255, 255, 60);
    rect(500, cy, 600, 34, 12);
    fill(80, 220, 120);
    rect(500 + 0.55 * 600, cy, 0.2 * 600, 34);
    fill(255);
    rect(500 + t * 600 - 3, cy - 8, 6, 50);
    textSize(18);
    text("¡La pared! ESPACIO en el verde para impulsarte", 800, cy + 50);
  }
  if (millis() < neFeedHasta) {
    fill(255, 255, 255);
    textSize(24);
    text(neFeed, 800, 290);
  }
  if (millis() < neCalambreHasta) { fill(255, 120, 120); textSize(28); text("¡CALAMBRE!", 800, 160); }
  textAlign(LEFT, BASELINE);
}

// 0 arriba, 1 abajo, 2 izquierda, 3 derecha (las rojas son los cuadros 4-7)
void dibujarFlechaNado(int d, boolean roja, float x, float y, float s) {
  int aux1;
  if (roja) aux1 = 4; else aux1 = 0;
  if (tira(na_flechas, 8, d + aux1, x - s / 2, y - s / 2, s, s)) return;
  noStroke();
  if (roja) fill(color(220, 60, 60)); else fill(color(60, 120, 220));
  rect(x - s / 2, y - s / 2, s, s, 10);
  fill(255);
  textSize(s * 0.6);
  textAlign(CENTER, CENTER);
  if (d == 0) {
    text("↑", x, y - 4);
  } else {
    if (d == 1) text("↓", x, y - 4); else if (d == 2) text("←", x, y - 4); else text("→", x, y - 4);
  }
  textAlign(CENTER, TOP);
}

// Qué flecha (0 a 3) es la tecla presionada.
int flechaDeTecla() {
  if (key == CODED) {
    if (keyCode == UP) return 0;
    if (keyCode == DOWN) return 1;
    if (keyCode == LEFT) return 2;
    if (keyCode == RIGHT) return 3;
  }
  if (key == 'w' || key == 'W') return 0;
  if (key == 's' || key == 'S') return 1;
  if (key == 'a' || key == 'A') return 2;
  if (key == 'd' || key == 'D') return 3;
  return -1;
}

// Teclas de la natación: flechas para la secuencia y ESPACIO para la vuelta.
void teclaNatacion2() {
  if (neFin > 0 || millis() < neCalambreHasta) return;
  int fl = flechaDeTecla();
  boolean esp = key == ' ';
  if (neEstilo == NE_CROL) {
    if (fl != 2 && fl != 3) return;
    float fase = ((millis() - neBeatInicio) % neBeat) / (float) neBeat;
    boolean aTiempo = abs(fase - 0.5) < 0.12;
    boolean ladoBien = (fl == 3) == neToca;
    if (aTiempo && ladoBien) { impulso(0.55, true); neToca = !neToca; feedNado("¡Bien!"); }
    else if (ladoBien) { impulso(0.22, false); neToca = !neToca; feedNado("Fuera de ritmo"); }
    else { impulso(-0.2, false); feedNado("¡El otro brazo!"); }
  } else if (neEstilo == NE_PECHO) {
    if (fl < 0) return;
    if (fl == neSecuencia[neSecPos + 1]) {
      neSecPos++;
      impulso(0.18, true);
      if (neSecPos >= neSecuencia[0]) { impulso(0.55, true); feedNado("¡Secuencia completa!"); nuevaSecuencia(); }
    } else { impulso(-0.3, false); feedNado("¡Te equivocaste!"); neSecPos = 0; }
  } else if (neEstilo == NE_ESPALDA) {
    if (fl < 0) return;
    int correcta;
    if (neRoja) {
      if (neFlecha == 0) {
        correcta = 1;
      } else {
        if (neFlecha == 1) correcta = 0; else if (neFlecha == 2) correcta = 3; else correcta = 2;
      }
    } else {
      correcta = neFlecha;
    }
    if (fl == correcta) { impulso(0.45, true); if (neRoja) feedNado("¡Bien leída!"); else feedNado("¡Bien!"); }
    else { impulso(-0.3, false); if (neRoja) feedNado("¡Era la contraria!"); else feedNado("¡Esa no!"); }
    nuevaFlecha();
  } else if (neEstilo == NE_RESPIRA) {
    if (!esp) return;
    float t = (millis() - neBurbujaDesde) / 900.0;
    if (t < 0) return;
    if (abs(t - 1) < 0.18) { impulso(0.7, true); feedNado("¡Aire!"); }
    else { impulso(-0.2, false); if (t < 1) feedNado("Muy pronto"); else feedNado("Muy tarde"); }
    neBurbujaDesde = millis() + 350;
  } else if (neEstilo == NE_MARIPOSA) {
    if (neRespirar) {
      if (fl == 0) { neRespirar = false; impulso(0.3, true); feedNado("¡Respiraste!"); }
      else if (esp) { impulso(-0.12, false); feedNado("¡Respira primero!"); }
      return;
    }
    if (!esp) return;
    neBrazadasMar++;
    impulso(0.13, true);
    if (neBrazadasMar % 5 == 0) neRespirar = true;
  } else if (neEstilo == NE_VIRAJE) {
    if (!esp) return;
    float t = (millis() - neViraDesde) / 1600.0;
    boolean bien = t >= 0.55 && t <= 0.75;
    if (bien) neVel = min(3.0, neVel + 1.2); else neVel = max(0.35, neVel * 0.6);
    naBrazadas++;
    if (bien) naBuenas++;
    if (bien) {
      feedNado("¡Viraje perfecto!");
    } else {
      if (t < 0.55) feedNado("Viraje muy pronto"); else feedNado("Viraje tarde");
    }
    neViro = true;
    neEstilo = neSiguiente;
    neSiguiente = elegirEstilo(neEstilo);
    neTramoFin = millis() + NADO_TRAMO_MS;
    prepararEstilo();
  }
}

