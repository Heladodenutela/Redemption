// Arma el feed de Aurora+ con las publicaciones del día.
void armarFeed() {
  vaciarFilas(feed);
  feedPos = 0;

  agregarPostsDelDia();

  int[] orden = new int[POSTS_GENERICOS.length + 1];
  for (int k = 0; k < POSTS_GENERICOS.length; k++) agregarInt(orden, k);
  barajarInt(orden);
  for (int i = 1; i <= min(8, tamInt(orden)); i++) {
    String[] p = POSTS_GENERICOS[orden[i]];
    agregarFila(feed, new String[] { p[0], p[1], p[2], "-1" });
  }
  agregarChismes();
}

int[] resMisPostsHoy;

// Tú publicas: las de hoy marcadas "Tú" en el guion
// Deja el resultado en resMisPostsHoy.
void misPostsHoy() {
  int[] l = new int[REDES_DIA.length + 1];
  for (int k = 0; k < REDES_DIA.length; k++) if (int(REDES_DIA[k][0]) == dia && REDES_DIA[k][1].equals("Tú") && !tieneTexto(publicados, str(k)) && postDisponible(k)) agregarInt(l, k);
  resMisPostsHoy = l;
}

// 0 me gusta, 1 no me gusta, 2 pasar
void reaccionarPost(int accion) {
  if (feedPos >= tamFilas(feed)) return;
  String[] p = feed[feedPos];
  String tipo = p[2];
  int f = int(p[3]);
  String ef = "";
  if (tipo.equals("tuyo")) { feedPos++; return; }
  if (tipo.equals("reto")) {
    if (accion == 0) { sumarBandera("RETO_ACEPTADO_D" + dia, 1); aviso("Reto aceptado: " + p[0].substring(posicionDe(p[0], "#"))); }
    feedPos++;
    return;
  }
  if (accion == 0) {
    if (tipo.equals("amigo")) ef = "Social +1 · Seg +1";
    else if (tipo.equals("chisme")) ef = "Seg +2 · Social −1";
    else if (tipo.equals("toxico")) { ef = "Seg +3 · Social −2"; sumarBandera("MALA_REPUTACIÓN", 1); }
    else if (tipo.equals("meme")) ef = "Seg +1";
    else if (tipo.equals("util")) ef = "Notas +1";
    if (f >= 0) cambiarAmistad(f, 2);
  } else if (accion == 1) {
    if (tipo.equals("toxico")) ef = "Social +2";
    else if (tipo.equals("chisme")) ef = "Social +1";
    else if (tipo.equals("amigo")) ef = "Social −1";
    if (f >= 0) cambiarAmistad(f, -4);
  }
  int minutos;
  if (accion == 2) minutos = 2; else minutos = REDES_MIN_POST;
  avanzarTiempo(minutos);
  catMedios[CAT_REDES] += minutos * 2;
  redesMinHoy += minutos;
  String r = aplicarEfectos(ef, -1);
  if (!r.equals("")) aviso(r);
  feedPos++;
}

// Publica en Aurora+ lo que hiciste hoy.
void publicar() {
  misPostsHoy();
  int[] l = resMisPostsHoy;
  if (tamInt(l) == 0) { aviso("Hoy no tienes nada para publicar"); return; }
  int k = l[1];
  agregarTexto(publicados, str(k));
  avanzarTiempo(REDES_MIN_POST * 2);
  catMedios[CAT_REDES] += REDES_MIN_POST * 4;
  String r = aplicarEfectos(REDES_DIA[k][5], -1);
  if (r.equals("")) {
    aviso("Publicaste: " + REDES_DIA[k][3] + "");
  } else {
    aviso("Publicaste: " + REDES_DIA[k][3] + ("  " + r));
  }
}

