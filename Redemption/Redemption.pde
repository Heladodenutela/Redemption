// Acariciar a Newton: maúlla y te sube el ánimo.
void acariciarNewton() {
  empezarActividad(ACT_NEWTON);
  newtonMaullidos = 1;
  newtonTexto = MAULLIDOS[int(random(MAULLIDOS.length))];
  if (!newtonHoy) {
    newtonHoy = true;
    cambiarStat(ST_ENERGIA, 2);
    cambiarAmistad(personaIndice("Newton"), 2);
  }
}

// Seguir acariciando a Newton (hasta que se aburre).
void acariciarOtraVez() {
  if (newtonMaullidos >= NEWTON_MAULLIDOS) { terminarActividad(); return; }
  newtonMaullidos++;
  int i = 0;
  for (int k = 0; k < MAULLIDOS.length; k++) if (MAULLIDOS[k].equals(newtonTexto)) i = k;
  newtonTexto = MAULLIDOS[(i + 1 + int(random(MAULLIDOS.length - 1))) % MAULLIDOS.length];
}

