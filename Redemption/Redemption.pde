// ¿Esta línea del guion cumple su condición (tabla GUION_COND_V21)?
boolean lineaGuionVale(String persona, String contexto) {
  for (int i = 0; i < GUION_COND_V21.length; i++) {
    if (GUION_COND_V21[i][0].equals(persona) && GUION_COND_V21[i][1].equals(contexto)) return cumple(GUION_COND_V21[i][2]);
  }
  return true;
}

// Quita de una línea lo que no es diálogo: "(Ojo: es la trampa.)", "(+10 Energía)", "[Acción] ..."
void limpiarGuionV21() {
  for (int k = 0; k < GUION.length; k++) {
    String t = GUION[k][2];
    int o = posicionDe(t, " (Ojo:");
    if (o > 0) t = t.substring(0, o);
    o = posicionDe(t, " (+");
    if (o > 0 && terminaCon(t, ")")) t = t.substring(0, o);
    if (empiezaCon(t, "[Acción] ")) {
      t = t.substring(9);
      if (!terminaCon(t, "]")) t = "[" + t + "]";
    }
    GUION[k][2] = t;
  }
}

// ============================ QUE NO SE REPITA LO MISMO TODOS LOS DÍAS ============================
// Una variante (hábitos, lo de hoy, amistad) que ya te dijo vuelve a salir solo después de VARIANTE_DIAS días.
// Nombre de la bandera que recuerda cuándo se dijo una variante.
String claveVariante(int f, String l) {
  return "VX_" + f + "_" + l.replace(":", "").replace("|", "");
}

// ¿Hace suficientes días que no se dice esta variante?
boolean varianteFresca(int f, String l) {
  int d = bandera(claveVariante(f, l));
  return d == 0 || dia - (d - 1) >= VARIANTE_DIAS;
}

// Anota el día en que se dijo una variante (para no repetirla pronto).
void recordarVariante(int f, String l) {
  if (f < 0 || l == null) return;
  String k = claveVariante(f, l);
  banderaValor0(k);
  sumarBandera(k, dia + 1);
}

// La "línea del día" no se dice si en la misma charla ya va algo que habla de lo mismo
String normalV21(String s) {
  String r = "";
  s = s.toLowerCase();
  for (int i = 0; i < s.length(); i++) {
    char c = letraEn(s, i);
    if (esDigito(c) || esLetra(c)) r += c;
    else if (r.length() > 0 && letraEn(r, r.length() - 1) != ' ') r += ' ';
  }
  return quitarBordes(r);
}

// ¿Dos líneas son casi iguales (sin contar mayúsculas ni signos)?
boolean parecidasV21(String a, String b) {
  if (a == null || b == null) return false;
  a = normalV21(a);
  b = normalV21(b);
  if (a.length() < 16 || b.length() < 16) return a.equals(b);
  for (int i = 0; i + 16 <= b.length(); i += 4) if (posicionDe(a, b.substring(i, i + 16)) >= 0) return true;
  return false;
}

// ¿Esta línea repite algo que la persona ya dijo hoy?
boolean repiteTemaV21(int f, String l, String nodo, int diario) {
  for (int i = 0; i < largo(f); i++) {
    String x = dlg[f][DLG_INI + i];
    if (parecidasV21(l, x) || parecidasV21(x, l)) return true;
  }
  if (nodo != null && parecidasV21(l, resolverLinea(f, lineaNodo(nodo)))) return true;
  if (diario >= 0 && (parecidasV21(l, dNodoLinea[diario]) || parecidasV21(dNodoLinea[diario], l))) return true;
  return false;
}

