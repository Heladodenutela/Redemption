String[] STAT_NOMBRE = { "Social", "Notas", "Energía", "Dinero", "Seguidores", "Pantalla" };

// Rango ideal en minutos de cada categoría; el fin de semana se estudia menos
int idealMin(int c, int d) {
  int[] m = { 240, 420, 60, 120, 30 };
  if (c == CAT_ESTUDIAR && (d == 6 || d == 7)) return 120;
  return m[c];
}

// Cuántos minutos es lo ideal como máximo para cada categoría (el sábado y domingo se estudia menos).
int idealMax(int c, int d) {
  int[] m = { 360, 540, 180, 240, 120 };
  if (c == CAT_ESTUDIAR && (d == 6 || d == 7)) return 180;
  return m[c];
}

// Se llama justo antes de dormir
void guardarAntesDeDormir() {
  for (int k = 0; k < 6; k++) statsAntes[k] = stats[k];
  statsAntes[ST_DINERO] = dinero;
  for (int k = 0; k < 5; k++) catAyer[k] = catMedios[k] / 2;
  diaResumen = dia;
}

// Se llama al despertar: completa el sueño, cuenta categorías en rango y da los premios
void guardarDespuesDeDormir(int minutosSueno) {
  catAyer[CAT_DORMIR] += minutosSueno;
  enRangoAyer = 0;
  for (int c = 0; c < 5; c++) if (catAyer[c] >= idealMin(c, diaResumen) && catAyer[c] <= idealMax(c, diaResumen)) enRangoAyer++;
  if (enRangoAyer >= 4) { cambiarStat(ST_ENERGIA, 10); cambiarStat(ST_SOCIAL, 2); }
  if (enRangoAyer == 5) for (int f = 0; f < amistad.length; f++) if (amistad[f] >= 60) cambiarAmistad(f, 1);
  for (int k = 0; k < 6; k++) statsDespues[k] = stats[k];
  statsDespues[ST_DINERO] = dinero;
  registrarDiaV20(diaResumen, catAyer, enRangoAyer, statsAntes[ST_PANTALLA]);
}

