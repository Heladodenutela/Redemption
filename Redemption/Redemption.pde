// Dibuja la pantalla que toca según 'screen' (título, mundo, fútbol...).
void dibujarJuego() {
  switch (screen)
  {
    case 0:
    if(cargado == 0)
    {
      background(255);
      hora=0;
      cargado =1;
      lux=1;
      i=0;
      while(i<30)
      {
        if(i<10)
      {
      stars[i][0]=random(720, 880);stars[i][1]=random(220, 400);
      j=0;
      stars[i][2]=random(6, 8);stars[i][3]=(random(-1,1)+stars[i][2]);
      ms=0;
      while(j<i)
      {if(((abs(stars[i][0]-stars[j][0])<(stars[i][2]+10) && abs(stars[i][1]-stars[j][1])<(stars[i][3]+10))||abs(stars[i][0]-800)<10||abs(stars[i][1]-309)<11)&& ms<1000000)
      {stars[i][0]=random(720, 880);stars[i][1]=random(220, 400);j=0;ms=ms+1;} else{j=j+1;}}
      stars[i][4]=random(0.03,0.1);stars[i][7]=stars[i][2];stars[i][8]=stars[i][3];
      stars[i][5]=(int) random(0,10);stars[i][6]=1;
      } else
        {

        }
        i=i+1;
      }
    }
    if ((millis() - (hora*100))>100)
    {
    hora = hora+1;
    if(hora>240){hora=0;lux=1; dc=0;}
    if(hora>=45&&hora<65)
    {
      d[dc]=lux;
      dc=dc+1;
      lux=lux*(1.28-(lux/170));
    } else if(hora>=65&&hora<=90)
    {
      lux= lux+2.5;
    }else if(hora>=150&&hora<=175)
    {
      lux= lux-2.5;
    }else if(hora>175&&hora<=195)
    {
      dc= dc-1;
      lux=lux/(1.28-(d[dc]/170));
    }
    i=0;
    while(i<30)
    {
    if(i<10)
    {
    stars[i][5]= stars[i][5]+stars[i][6];
    if(stars[i][5]<0 || stars[i][5]>10)
    {
    stars[i][6]=stars[i][6]*-1;
    }
    stars[i][2]= stars[i][2]+(stars[i][7]*stars[i][4]*stars[i][6]);
    stars[i][3]= stars[i][3]+(stars[i][8]*stars[i][4]*stars[i][6]);

    }else{}i=i+1;}
    }
      background(0);
      fill(50+(lux), 60+lux*1.1, 100+lux*1.1);
      rect(700, 210, 200, 200);
      i=0;
        while(i<50) {if(i<20) {
      fill(256, 256, 256, 120-lux*2);
      noStroke();
      beginShape();
      vertex(stars[i][0]+stars[i][2], stars[i][1]);
      vertex(stars[i][0], stars[i][1]+stars[i][3]);
      vertex(stars[i][0]-stars[i][2], stars[i][1]);
      vertex(stars[i][0], stars[i][1]-stars[i][3]);
      endShape(CLOSE);
      } else
      {}i=i+1;}

      if (tituloVentana != null) image(tituloVentana, 0, 0, 1600, 900);
      else if (cuarto != null) image(cuarto, 0, 0, 1600, 900);
      fill(0, 0, 0, 120-lux);
      rect(0, 0, 1600, 900);
      fill(256, 240, 220, lux/2-22);
      noStroke();
      beginShape();
      vertex(0, 900);
      vertex(1800, 900);
      vertex(870, 387);
      vertex(728, 387);
      endShape(CLOSE);
      dibujarLogoTitulo();
      dibujarBotonJugar();
      dibujarSelectorDificultad();
    break;

    case 1:

    if(cargado == 0)
    {
      if (!mundoIniciado) { iniciarMundo(); mundoIniciado = true; alEntrarAlMundoV23(); }
      cargado = 1;
    }
    if (pausado) { dibujarPausa(); break; }
    if (finJuego) { dibujarFinJuego(); break; }
    if (avisoMJActivo()) { dibujarFondoAvisoMJ(); break; }
    cicloTiempo();
    dibujarMundo();
    break;

    case 2:
    if(cargado == 0)
    {
      posicion[0]=100; posicion[1]=400;
      lims=1240;limi=-250;
      cargado =1;
      background(255);
    }
    cicloTiempo();
    break;

    case 3:
    if(cargado == 0)
    {
      cargado = 1;
      cel = 0;
      golesJ = 0;
      golesE = 0;
      tW = false; tA = false; tS = false; tD = false;
      controlado = 1;
      equipoAtaque = 0;
      fbMarcaT = 0;
      fbSaque = 0;
      formacion(fbSaque);
      fbEstado = 1;
