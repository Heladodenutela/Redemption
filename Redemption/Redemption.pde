boolean finJuego = false;
int finPagina = 0;
String finMotivo = "";
String finId = "", finTitulo = "", finTexto = "";
String[] finEpilogos = new String[16];
boolean feriaHecha = false;

// El día 10 a las 23:30, si duermes el día 10 o si el reloj pasa al día 11
void revisarFinDelJuego() {
  if (finJuego) return;
  if (diaDelReloj() > 10 || (dia == 10 && minutoAhora() >= 23 * 60 + 30)) { if (feriaHecha) terminarJuego(""); else terminarJuego("No fuiste a la Feria."); }
}

// Termina el juego: elige el final, arma los epílogos y guarda el puntaje.
void terminarJuego(String motivo) {
  if (finJuego) return;
  finJuego = true;
  finMotivo = motivo;
  finPagina = 0;
  if (!resultadosVistos && ramosPerdidos() == 0) sumarBandera("GRADUADO", 1);
  resultadosVistos = true;
  sumarBandera("JUEGO_TERMINADO", 1);
  revisarLogros();
  elegirFinal();
  cel = 0;
  if (actividad != ACT_NINGUNA) terminarActividad();
  alTerminarJuegoV23();
}

// ---- cuál final te toca (en orden de prioridad) ----
// Elige cuál de los 10 finales te tocó según lo que hiciste (reprobar, quemado, campeón...).
void elegirFinal() {
  int amigos = amigosDeVerdad();
  int aux1;
  if (bandera("TROFEO_RUGBY") > 0) aux1 = 1; else aux1 = 0;
  int aux2;
  if (bandera("TROFEO_FÚTBOL") > 0) aux2 = 1; else aux2 = 0;
  int aux3;
  if (bandera("TROFEO_NATACIÓN") > 0) aux3 = 1; else aux3 = 0;
  int trofeos = aux1 + aux2 + aux3;
  if (ramosPerdidos() >= 2) {
    finId = "REPROBADO";
    finTitulo = "No te graduaste";
    finTexto = "Perdiste " + ramosPerdidos() + " materias. El semestre no cuenta: en enero vuelves a primero.\n"
      + "No fue un solo día: fueron las clases que se cruzaron con otra cosa, una tras otra. El tiempo no se pierde de golpe, se pierde de a poquitos.";
  } else if (bandera("VICIO") >= 4 || deudaSueno >= 3.5) {
    finId = "QUEMADO";
    finTitulo = "Quemado";
    if (bandera("VICIO") >= 4) {
      finTexto = "Llegaste al final, pero arrastrándote. Noches cortas, " + "la esquina cada vez más seguido, "
      + "y un cuerpo que ya no da más.\nNadie te lo quitó: lo fuiste gastando. La buena noticia: el cuerpo perdona si le das tiempo.";
    } else {
      finTexto = "Llegaste al final, pero arrastrándote. Noches cortas, " + ""
      + "y un cuerpo que ya no da más.\nNadie te lo quitó: lo fuiste gastando. La buena noticia: el cuerpo perdona si le das tiempo.";
    }
  } else if (trofeos >= 2 || (trofeos == 1 && bandera("CLUB_DEPORTE") > 0)) {
    finId = "CAMPEON";
    finTitulo = "Campeón de la Copa Aurora";
    finTexto = "Trofeos en la repisa (" + trofeos + "), tu nombre en la cartelera de deportes y un equipo que te espera el próximo semestre.\n"
      + "Lo lograste entrenando, durmiendo y llegando a tiempo. El talento ayuda; la rutina gana.";
  } else if (stats[ST_NOTAS] >= 85 && amigos <= 2) {
    finId = "CEREBRITO";
    finTitulo = "Cerebrito";
    finTexto = "Las mejores notas del salón. Los profes te saludan por tu nombre.\n"
      + "Pero en la foto de la Feria hay pocas caras conocidas. Estudiar es importante... y la gente también.";
  } else if (stats[ST_SEGUIDORES] >= 250 && amigos <= 2) {
    finId = "ESTRELLA";
    finTitulo = "Estrella de Aurora+";
    finTexto = stats[ST_SEGUIDORES] + " seguidores y " + amigos + " amigos de verdad.\n"
      + "Tu foto final tiene cientos de me gusta. Pero cuando se apagan los flashes, ¿a quién llamas?";
  } else if (parejaFinal() >= 0 && bandera("CHISME_ROMANCE") <= 0) {
    String ella = nombreCorto(parejaFinal());
    finId = "ROMANCE";
    finTitulo = "Con " + ella + ", en la foto";
    finTexto = "No fue solo la Feria ni el parcial: fue que alguien se quedó cuando se apagó la música.\n"
      + "La foto final la comparten " + ella + " y tú. Los diez días fueron de ustedes dos... y de lo que hicieron con el tiempo que les tocaba.";
  } else if (bandera("IRIS_COMPLETA") > 0 && personaIndice("Lili") >= 0 && amistad[personaIndice("Lili")] >= 70 && personaIndice("Mamá (Claudia)") >= 0 && amistad[personaIndice("Mamá (Claudia)")] >= 70) {
    finId = "FAMILIAR";
    finTitulo = "La casa llena";
    finTexto = "Mamá imprimió la foto, Papá la enmarcó y Lili e Iris la pegaron en el colegio con un cartel gigante.\n"
      + "Mientras todos corrían detrás de las redes, tú cenabas sin celular. Esa fue tu mejor jugada.";
  } else if (dinero >= 120) {
    finId = "EMPRENDEDOR";
    finTitulo = "Emprendedor";
    finTexto = "Terminaste con $" + dinero + ". Turnos, ventas, negocios con Andrés y Kevin.\n"
      + "Sabes lo que vale una hora. Ahora falta que también sepas lo que vale una hora libre.";
  } else if (diasEquilibrados() >= 5) {
    finId = "EQUILIBRADO";
    finTitulo = "Equilibrio";
    finTexto = diasEquilibrados() + " días equilibrados de 10. Estudiaste, dormiste, entrenaste, estuviste con tu gente... y el celular no te manejó a ti.\n"
      + "No fue perfecto, pero fue tuyo. Ese es el mejor final.";
  } else if (nivelSocial() == 0 && amigos == 0) {
    finId = "SOLEDAD";
    finTitulo = "Solo en la foto";
    finTexto = "Diez días y nadie con quién tomarse la foto.\n"
