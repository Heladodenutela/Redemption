// El día 10 a las 12:30 muestra los resultados del semestre.
void revisarResultados() {
  if (resultadosVistos || dia != 10 || minutoAhora() < 12 * 60 + 30) return;
  if (actividad != ACT_NINGUNA || cel != 0 || finJuego) return;
  resultadosVistos = true;
  if (ramosPerdidos() == 0) sumarBandera("GRADUADO", 1);
