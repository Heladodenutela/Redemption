// Acciones del gimnasio: usar un aparato si te queda energía.
boolean accionNueva7(String a) {
  if (a.equals(ACC_GYM_BARRA) || a.equals(ACC_GYM_PESAS) || a.equals(ACC_GYM_CAMINADORA)) {
    if (stats[ST_ENERGIA] < 8) { aviso("No te queda energía ni para levantar una botella de agua."); return true; }
    usarAparato(a);
    return true;
  }
  if (a.equals(ACC_CICLISMO)) { iniciarCiclismo(); return true; }
  return false;
}

// Teclas del gimnasio (repeticiones, caminadora).
boolean teclasActividad7() {
  if (teclasActividad9()) return true;
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  if (actividad == ACT_GYM_REPS) { teclaReps(); return true; }
  if (actividad == ACT_GYM_CAMINADORA) { teclaCaminadora(); return true; }
  if (actividad == ACT_CICLISMO) { teclaCiclismo(true); return true; }
  if (actividad == ACT_GYM_RES) { if (usar) terminarActividad(); return true; }
  return false;
}

// Teclas soltadas en el gimnasio y el ciclismo.
void soltarTeclas7() {
  soltarTeclas9();
  if (actividad == ACT_CICLISMO) teclaCiclismo(false);
}

// Clicks del gimnasio.
boolean clickActividad7() {
  if (clickActividad9()) return true;
  if (actividad == ACT_GYM_REPS || actividad == ACT_GYM_CAMINADORA || actividad == ACT_CICLISMO) return true;
  if (actividad == ACT_GYM_RES) { terminarActividad(); return true; }
