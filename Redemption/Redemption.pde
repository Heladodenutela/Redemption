  {"5", "Laboratorio", "ME3"},
  {"8", "Física", "S6"}
};

// ¿Este nodo de diálogo es de una escena de clase?
boolean esNodoDeClase(String n) {
  for (int k = 0; k < ESCENAS_CLASE.length; k++) { partirPorLetra(ESCENAS_CLASE[k][2], '|'); String[] aux1 = resPartirPorLetra; if (tieneTexto(aux1, n)) return true; }
  return false;
}

String[] resEscenasDeClase;

// Escenas que pasan al terminar una clase (quedan en resEscenasDeClase).
void escenasDeClase(int c) {
  for (int k = 0; k < ESCENAS_CLASE.length; k++) {
    if (ESCENAS_CLASE[k][0].equals(CLASES[c][0]) && empiezaCon(CLASES[c][3], ESCENAS_CLASE[k][1])) { partirPorLetra(ESCENAS_CLASE[k][2], '|'); resEscenasDeClase = resPartirPorLetra; return; }
  }
  resEscenasDeClase = new String[0];
}

// Si no fuiste a la clase, su escena se pierde (y lo que dependía de ella no pasa)
void perderEscenasClase(int c) {
  escenasDeClase(c);
  String[] e = resEscenasDeClase;
  for (int i = 0; i < e.length; i++) if (!tieneTexto(nodosHechos, e[i])) { agregarTexto(nodosHechos, e[i]); sumarBandera("FALTÓ_" + e[i], 1); }
}

// Qué tan difícil está la materia según el día (1 a 4).
int nivelClase() {
  if (dia <= 2) return 1;
  if (dia <= 5) return 2;
  if (dia <= 9) return 3;
  return 4;
}

// Minijuego que toca en cada clase (tiro, péndulo, pendiente, balanza, bichos...).
int minijuegoDe(int c) {
  String m = CLASES[c][3];
  if (posicionDe(m, "Laboratorio") >= 0) return MJ_PENDULO;
  if (posicionDe(m, "Física") >= 0) return MJ_PROYECTIL;
  if (posicionDe(m, "Cálculo") >= 0) return MJ_CALCULO;
  if (posicionDe(m, "Álgebra") >= 0) return MJ_BALANZA;
  return MJ_BICHOS;
}

// Lo llama tomarClase()
void empezarMinijuegoClase() {
  mjActual = minijuegoDe(claseActual);
  if (mjActual == MJ_PROYECTIL) iniciarProyectil();
  else if (mjActual == MJ_PENDIENTE) iniciarPendiente();
  else if (mjActual == MJ_BALANZA) iniciarBalanza();
  else if (mjActual == MJ_BICHOS) iniciarBichos();
  else if (mjActual == MJ_CALCULO) iniciarCalculo();
  else iniciarPendulo();
  empezarActividad(ACT_CLASE_JUEGO);
}

// Cada minijuego llama esto al acabar: cuántas notas suma (bien = +3, a medias = +1)
void terminarMinijuegoClase(int notas, String texto) {
  if (parcialEncadenado(notas, texto)) return;
  notas = notasParcial(notas);
  texto = textoParcial(texto);
  if (claseEstado[claseActual] == 2) { if (notas > 0) notas = max(1, notas / 2); else notas = notas; }
  if (empiezaCon(CLASES[claseActual][3], "PARCIAL")) notas *= 2;
  notasClase = notas;
  mjResultado = texto;
  empezarActividad(ACT_CLASE_RES);
}

// Dibuja el resultado del minijuego de la clase.
void dibujarClaseRes() {
  ventana(450, 260, 700, 320, MJ_NOMBRE[mjActual] + " · " + CLASES[claseActual][3]);
  fill(40);
