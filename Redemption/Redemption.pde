// Lo que ayuda (tiempo, empuje) se divide por difMult; lo que estorba (rival, gravedad) se multiplica
float facil(float v) { return v / difMult; }
// Ajusta un número para que sea más difícil según la dificultad elegida (más alto en Difícil, más bajo en Fácil).
float dificil(float v) { return v * difMult; }

// 1.0 sin vicio; con VICIO 3 = 0.82 (más lento en los deportes)
float lentitudVicio() {
  return max(0.6, 1 - bandera("VICIO") * B_VICIO_LENTITUD);
}

// Copia los números de la caja de balance a las variables de cada minijuego, ya multiplicados por la dificultad.
void aplicarBalance() {
  difMult = DIF_MULT[constrain(dificultad, 0, 2)];
  PY_GRAVEDAD = B_PY_GRAVEDAD;
  PEND_SEGUNDOS = round(facil(B_PEND_SEGUNDOS));
  BAL_SEGUNDOS = round(facil(B_BAL_SEGUNDOS));
  BICHOS_VIDA_MS = round(facil(B_BICHOS_VIDA_MS));
  if (bandera("GYM_BONUS") > 0) {
    PRESS_EMPUJE = facil(B_PRESS_EMPUJE) * lentitudVicio() * 1.1;
  } else {
    PRESS_EMPUJE = facil(B_PRESS_EMPUJE) * lentitudVicio() * 1;
  }
  PRESS_GRAVEDAD = dificil(B_PRESS_GRAVEDAD);
  PRESS_SOSTENER_MS = round(dificil(B_PRESS_SOSTENER_MS));
  GYM_ZONA_BASE = facil(B_GYM_ZONA);
  GYM_CAMINADORA_MS = B_CAMINADORA_MS;
  float aux1;
  if (bandera("NADO_BONUS") > 0) aux1 = 1.08; else aux1 = 1;
  float aux2;
  if (bandera("NADO_TECNICA") > 0) aux2 = 1.05; else aux2 = 1;
  NADO_IMPULSO = facil(B_NADO_IMPULSO) * lentitudVicio() * aux1 * aux2;
  NADO_RIVAL = dificil(B_NADO_RIVAL);
  if (bandera("BICI_ARREGLADA") > 0) {
    CIC_VEL_JOAQUIN = dificil(B_CIC_JOAQUIN) * 0.94;
  } else {
    CIC_VEL_JOAQUIN = dificil(B_CIC_JOAQUIN) * 1;
  }
  VELE_BASE = dificil(B_RUG_VEL_RIVAL);
  if (bandera("RUGBY_BONUS") > 0) {
    velj = B_RUG_VEL_TU * lentitudVicio() * 1.06;
  } else {
    velj = B_RUG_VEL_TU * lentitudVicio() * 1;
  }
  fpGravedad = dificil(B_FLAPPY_GRAVEDAD);
  fpImpulso = B_FLAPPY_SALTO;
  fpVelTubos = dificil(B_FLAPPY_TUBOS);
  pgVelBarra = facil(B_PONG_BARRA);
  ROYALE_VEL_JUGADOR = facil(B_ROYALE_VEL);
  ROYALE_VIDAS = max(1, round(facil(B_ROYALE_VIDAS)));
}

