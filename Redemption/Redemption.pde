// Cuántas líneas ocupa un texto en un ancho (para acomodar los renglones del cartel)
int lineasDeTexto(String t, float ancho) {
  partirPorLetra(t, ' ');
  String[] p = resPartirPorLetra;
  int lineas = 1;
  float x = 0;
  float esp = textWidth(" ");
  for (int i = 0; i < p.length; i++) {
    float wp = textWidth(p[i]);
    if (x > 0 && x + wp > ancho) { lineas++; x = 0; }
    x = x + wp + esp;
  }
  return lineas;
}

// El click y las teclas cierran el cartel (y nada más pasa con ese click)
boolean clickAvisoMJ() {
  if (!avisoMJActivo()) return false;
  if (millis() - avisoMJDesde > 300) cerrarAvisoMJ();
  return true;
}

// ESPACIO, E o ENTER cierran el cartel.
boolean teclaAvisoMJ() {
  if (!avisoMJActivo()) return false;
  boolean usar = key == ' ' || key == 'e' || key == 'E' || key == ENTER || key == RETURN;
  if (usar && millis() - avisoMJDesde > 300) cerrarAvisoMJ();
  return true;
}

