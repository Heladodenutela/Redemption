// Dibuja un botón del celular (se aclara cuando el mouse está encima).
void botonCel(float x, float y, float w, float h, String t, int c) {
  boolean enc = mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + h;
  noStroke();
  if (enc) fill(lerpColor(c, color(255), 0.2)); else fill(c);
  rect(x, y, w, h, 10);
  fill(255);
  textSize(18);
  textAlign(CENTER, CENTER);
  text(t, x + w / 2, y + h / 2 - 1);
  textAlign(LEFT, BASELINE);
}

// ¿El mouse está dentro del botón?
boolean enBoton(float x, float y, float w, float h) {
  return mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + h;
}

// Clicks en el panel de planes: lugar y hora.
boolean clickPlanesChat() {
  if (cel != 6 || chatAbierto < 0) return false;
  if (invitacionPendiente(msg[chatAbierto][0]) >= 0 && clickInvitacion()) return true;
  if (planPanel) {
    if (enBoton(celX1 + 44, celY1 + 530, 200, 44)) { planPanel = false; return true; }
    if (planPasoLugar < 0) {
      for (int i = 0; i < LUGARES_PLAN.length; i++) if (enBoton(celX1 + 44, celY1 + 180 + i * 70, celX2 - celX1 - 88, 58)) { planPasoLugar = i; return true; }
    } else {
      horasPlan();
      int[] hs = resHorasPlan;
      for (int i = 0; i < hs.length; i++) if (enBoton(celX1 + 44, celY1 + 180 + i * 70, celX2 - celX1 - 88, 58)) { proponerPlan(planPasoLugar, hs[i]); planPanel = false; return true; }
    }
    return true;
  }
  int f = personaDeChatAbierto();
  if (f < 0) return false;
  if (enBoton(celX2 - 190, celY1 + 14, 176, 44)) {
    int pp = planPendienteCon(DLG_PERSONA[f]);
    if (pp >= 0) cancelarPlan(pp);
    else if (puedeProponer()) { planPanel = true; planPasoLugar = -1; }
    return true;
  }
  return false;
}

// Propone un plan: la persona acepta o no según la amistad y su agenda.
void proponerPlan(int lugar, int minuto) {
  int f = personaDeChatAbierto();
  if (f < 0 || planN >= MAX_PLANES) return;
  String p = DLG_PERSONA[f];
  agregarMensaje(msg[chatAbierto][0], '0', "¿Nos vemos hoy a las " + nf(minuto / 60, 2) + ":00 en " + LUGARES_PLAN[lugar][0] + "?");
  boolean si = aceptaPlan(f, p, lugar, minuto);
  planPersona[planN] = p;
  planDia[planN] = dia;
  planMin[planN] = minuto;
  planLugar[planN] = lugar;
  planEstado[planN] = 0;
  planEscena[planN] = "";
  planLlego[planN] = false;
  planRespChat = chatAbierto;
  planRespIdx = planN;
  planRespSi = si;
  planRespHasta = millis() + 2200;
  planN++;
}

// La respuesta llega después del "escribiendo..."
void revisarRespuestaPlan() {
  if (planRespIdx < 0 || millis() < planRespHasta) return;
  int i = planRespIdx;
  planRespIdx = -1;
  int f = personaIndice(planPersona[i]);
  String chat = nombreChat(f);
  if (planRespSi) {
    planEstado[i] = 1;
    agregarMensaje(chat, '1', RESP_PLAN_SI[int(random(RESP_PLAN_SI.length))]);
    ponerEnHorario(planDia[i], planMin[i] / 60, planMin[i] / 60 + 1, "Plan con " + nombreCorto(f), color(230, 80, 120));
  } else {
    planEstado[i] = 4;
    String r = rechazoPlan(f);
    agregarMensaje(chat, '1', r);
  }
}

String[] RESP_PLAN_SI = { "¡Dale! Allá nos vemos.", "Hecho. No me dejes plantado.", "Listo. Llevo hambre.", "Va. Si llegas tarde, pagas tú." };

// Cancela un plan (la persona se molesta un poco).
void cancelarPlan(int i) {
  int f = personaIndice(planPersona[i]);
  planEstado[i] = 4;
  if (f >= 0) {
    agregarMensaje(nombreChat(f), '0', "Perdón, al final no puedo. ¿Lo movemos?");
    agregarMensaje(nombreChat(f), '1', "Ah. Bueno. Gracias por avisar, al menos.");
    cambiarAmistad(f, -2);
  }
}

