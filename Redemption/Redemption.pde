int[] resPoseFinal;

// Fila y columna de la pose en protagonista_poses_foto.png (8 columnas x 4 filas, 2 cuadros cada pose)
// Deja el resultado en resPoseFinal.
void poseFinal() {
  if (finId.equals("CAMPEON")) { if ((bandera("TROFEO_RUGBY") + bandera("TROFEO_FÚTBOL") + bandera("TROFEO_NATACIÓN")) >= 2) { resPoseFinal = new int[] { 0, 2 }; return; } else { resPoseFinal = new int[] { 0, 0 }; return; } }
  if (finId.equals("CEREBRITO")) { resPoseFinal = new int[] { 0, 4 }; return; }
  if (finId.equals("ESTRELLA")) { resPoseFinal = new int[] { 1, 2 }; return; }
  if (finId.equals("EMPRENDEDOR")) { resPoseFinal = new int[] { 2, 0 }; return; }
  if (finId.equals("QUEMADO")) { resPoseFinal = new int[] { 3, 2 }; return; }
  if (finId.equals("REPROBADO")) { resPoseFinal = new int[] { -1, 0 }; return; }
  if (finId.equals("FAMILIAR")) { resPoseFinal = new int[] { 2, 4 }; return; }
  if (finId.equals("SOLEDAD")) { if (bandera("CANELA_ADOPTADA") > 0) { resPoseFinal = new int[] { 1, 6 }; return; } else { resPoseFinal = new int[] { 3, 0 }; return; } }
  int mama = personaIndice("Mamá (Claudia)");
  if (mama >= 0 && amistad[mama] >= 75 && parejaFinal() < 0) { resPoseFinal = new int[] { 2, 4 }; return; }
  if (parejaFinal() >= 0 || amigosDeVerdad() >= 3) { resPoseFinal = new int[] { 0, 6 }; return; }
  resPoseFinal = new int[] { 2, 6 };
}

int[] resGenteDeLaFoto;

// Quiénes salen en tu foto: pareja, amigos de verdad y familia (máximo 5)
// Deja el resultado en resGenteDeLaFoto.
void genteDeLaFoto() {
  int[] l = new int[8];
  int p = parejaFinal();
  if (p >= 0) agregarInt(l, p);
  if (finId.equals("SOLEDAD") || finId.equals("REPROBADO") || finId.equals("QUEMADO")) {
    if (finId.equals("QUEMADO")) { int ch = personaIndice("Chato"); if (ch >= 0 && bandera("VICIO") >= 2) agregarInt(l, ch); }
    resGenteDeLaFoto = l;
    return;
  }

  for (int vuelta = 0; vuelta < 5 && tamInt(l) < 5; vuelta++) {
    int mejor = -1;
    for (int f = 0; f < amistad.length; f++) {
      if (esPersonaDeVerdad(f) && !tieneInt(l, f) && amistad[f] >= 60 && !hojaDePersona(f).equals("")) {
        if (mejor < 0 || amistad[f] > amistad[mejor]) mejor = f;
      }
    }
    if (mejor < 0) break;
    agregarInt(l, mejor);
  }
  resGenteDeLaFoto = l;
}

// Dibuja la foto final por capas: fondo, la gente que te acompaña y tú.
void dibujarFotoFinal() {
  background(20);
  PImage fondo = fondoFinal();
  float fx = 200, fy = 70, fw = 1200, fh = 675;

  noStroke();
  fill(250);
  rect(fx - 20, fy - 50, fw + 40, fh + 160, 18);
  fill(30);
  textSize(24);
  textAlign(LEFT, CENTER);
  text("Aurora+  ·  Tú", fx, fy - 26);
  if (fondo != null && fondo.width > 1) image(fondo, fx, fy, fw, fh);
  else { fill(60, 70, 110); rect(fx, fy, fw, fh); }

  genteDeLaFoto();
  int[] g = resGenteDeLaFoto;
  int n = tamInt(g);
  int col = (cuadros / 20) % 2;
  float esc = 2.0;
  float piso = fy + fh - 40;
  for (int i = 1; i <= n; i++) {
    int f = g[i];
    PImage h = hojaPorNombre(hojaDePersona(f));
    float x;
    if (i % 2 == 1) {
      x = fx + fw / 2 + (-1) * (150 + ((i - 1) / 2) * 170);
    } else {
      x = fx + fw / 2 + 1 * (150 + ((i - 1) / 2) * 170);
    }
    if (h != null) dibujarHoja(h, PJ_CW, PJ_CH, 0, 0, x - PJ_CENTRO * esc, piso - PJ_PIES * esc, esc);
  }

  poseFinal();
  int[] pose = resPoseFinal;
  if (pose[0] < 0 && pj_protagonista != null) dibujarHoja(pj_protagonista, PJ_CW, PJ_CH, FILA_AFK, (cuadros / VEL_AFK) % 4, fx + fw / 2 - PJ_CENTRO * 2.2, piso - PJ_PIES * 2.2, 2.2);
  else if (pj_protagonista_poses_foto != null && pj_protagonista_poses_foto.width > 1) {
    int c = pose[1] + col;
    image(pj_protagonista_poses_foto, fx + fw / 2 - 80 * 2.2, piso - 225 * 2.2, 160 * 2.2, 240 * 2.2,
      c * 160, pose[0] * 240, c * 160 + 160, pose[0] * 240 + 240);
  } else if (pj_protagonista != null) dibujarHoja(pj_protagonista, PJ_CW, PJ_CH, 0, 0, fx + fw / 2 - PJ_CENTRO * 2.2, piso - PJ_PIES * 2.2, 2.2);
  PImage fr = frenteFinal();
  if (fr != null && fr.width > 1) image(fr, fx, fy, fw, fh);

  int likes = round(stats[ST_SEGUIDORES] * 0.6) + amigosDeVerdad() * 3;
  fill(220, 40, 70);
  textSize(22);
  text("<3  " + likes + " me gusta", fx, fy + fh + 30);
  fill(40);
  textSize(20);
  text(pieDeFotoFinal(), fx, fy + fh + 64);
  fill(110);
  textSize(17);
  text(comentarioFoto(), fx, fy + fh + 94);
  fill(255);
  textSize(18);
  textAlign(RIGHT, BASELINE);
  text("[E] o click para seguir", ANCHO - 30, ALTO - 16);
  textAlign(LEFT, BASELINE);
}

