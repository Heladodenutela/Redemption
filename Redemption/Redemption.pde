// ¿Se cumplen todos los requisitos de una lista separada por ';'?
boolean cumpleReq(String req) {
  if (req == null || quitarBordes(req).equals("")) return true;
  partirPorLetra(req, ';');
  String[] partes = resPartirPorLetra;
  for (int i = 0; i < partes.length; i++) {
    String r = quitarBordes(partes[i]);
    if (empiezaCon(r, "MAPA:")) { partirPorLetra(r.substring(5), '|'); String[] aux1 = resPartirPorLetra; if (!tieneTexto(aux1, MAPA_COD[mapaActual])) return false; }
    else if (empiezaCon(r, "HORA:")) {
      partirPorLetra(r.substring(5), '-');
      String[] h = resPartirPorLetra;
      int m = minutoAhora();
      if (m < aMin(h[0]) || m > aMin(h[1])) return false;
    }
    else if (empiezaCon(r, "DIA:")) {
      partirPorLetra(r.substring(4), '-');
      String[] d = resPartirPorLetra;
      if (dia < int(d[0]) || dia > int(d[1])) return false;
    }
    else if (empiezaCon(r, "HOY:")) { if (!hechoHoy(r.substring(4))) return false; }
    else if (!condicionMsg(r)) return false;
  }
  return true;
}

