// Lee una tabla de letras del archivo.
void leerTablaChars(String v) {
  if (v.equals("\\N")) { resTablaChars = null; return; }
  partirPorLetra(v, ';');
  String[] f = resPartirPorLetra;
  int n = int(f[0]);
  resTablaChars = new char[n][];
  for (int i = 0; i < n; i++) { leerChars(f[i + 1]); resTablaChars[i] = resChars; }
