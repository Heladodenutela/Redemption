  text("Toca una lista: corta la música y suena esa por 3 horas.", celX1 + 40, celY1 + MSG_HEAD + 24);
  boolean efectoListo = minutoAbs() - playlistUlt >= ESPERA_EFECTO;
  boolean suena = listaSuena();
  if (!listasBuscadas) { listasBuscadas = true; for (int i = 0; i < 3; i++) listasImg[i] = cargarSiExiste("extras/interfaz/1_celular/" + LISTAS_ARCHIVO[i] + ".png"); }
  for (int i = 0; i < 3; i++) {
    float by = celY1 + LISTA_Y0 + i * LISTA_PASO;
    String t = LISTAS[i];
    if (efectoListo) t = t + "  [" + LISTAS_EFECTO[i] + "]";
    botonCel(celX1 + 130, by, celX2 - celX1 - 170, 80, t, color(150, 110, 210));
    if (hay(listasImg[i])) image(listasImg[i], celX1 + 40, by, 80, 80);
