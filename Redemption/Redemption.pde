// ============================ CONDICIONES (una sola forma para todo) ============================
// "F:BANDERA", "!F:BANDERA", "AM:Sofía>=50", "N:Popular", "CLASE:1:Física" (fuiste a esa clase)
// "MAPA:1:U1" (estuviste en U1 el día 1; "MAPA:*:K4" cualquier día; "MAPA:HOY:K4"), "AQUI:P3"
// "E:S1:0" (elegiste esa opción), "HECHO:S4" (ese nodo ya pasó), "HOY:GYM", "ESCENA:SOF1"
// "ROM:Sofía>=2", "DIA>=3", "HORA>=17:00", "VICIO>=2", "NOTAS>=60", "SOCIAL>=40", "SEG>=100"
// "DINERO>=20", "ENERGIA<30", "DEUDA>=2", "FALTAS>=3", "LLUVIA", "FINDE"
// Se juntan con "&". Un "!" adelante niega cualquiera.
boolean cumple(String c) {
  if (c == null) return true;
  c = quitarBordes(c);
  if (c.length() == 0) return true;
  if (posicionDe(c, " | ") >= 0) {
    partir(c, " | ");
    String[] o = resPartir;
    for (int i = 0; i < o.length; i++) if (cumple(o[i])) return true;
    return false;
  }
  if (posicionDe(c, "&") >= 0) {
    partirPorLetra(c, '&');
    String[] p = resPartirPorLetra;
    for (int i = 0; i < p.length; i++) if (!cumple(p[i])) return false;
    return true;
  }
  boolean neg = empiezaCon(c, "!");
  if (neg) c = quitarBordes(c.substring(1));
  boolean r = cumpleUna(c);
  if (neg) return !r; else return r;
}

// ¿Se cumple una sola condición (bandera, amistad, día, hora...)?
boolean cumpleUna(String c) {
  if (empiezaCon(c, "CHARLAS:") || empiezaCon(c, "ANTES:") || empiezaCon(c, "CONTACTO:") || empiezaCon(c, "DIARIO:") || empiezaCon(c, "AYER:")) return cumpleSocial(c);
  if (empiezaCon(c, "F:")) return bandera(c.substring(2)) > 0;
  if (empiezaCon(c, "AM:")) {
    partirComparacion(c.substring(3));
    String[] p = resPartirComparacion;
    int f = personaPorNombre(p[0]);
    if (f < 0) return false;
    return comparar(amistad[f], p[1], int(p[2]));
  }
  if (empiezaCon(c, "ROM:")) {
    partirComparacion(c.substring(4));
    String[] p = resPartirComparacion;
    return comparar(nivelRomance(p[0]), p[1], int(p[2]));
  }
  if (empiezaCon(c, "N:")) return NIVELES[nivelSocial()].equals(c.substring(2));
  if (empiezaCon(c, "CLASE:")) {
    partirPorLetra(c.substring(6), ':');
    String[] p = resPartirPorLetra;
    if (p[0].equals("HOY")) return asistioA(dia, p[1]); else return asistioA(int(p[0]), p[1]);
  }
  if (empiezaCon(c, "FALTO:")) {
    partirPorLetra(c.substring(6), ':');
    String[] p = resPartirPorLetra;
    int d;
    if (p[0].equals("HOY")) d = dia; else d = int(p[0]);
    for (int k = 0; k < CLASES.length; k++) if (int(CLASES[k][0]) == d && empiezaCon(CLASES[k][3], p[1]) && claseEstado[k] == 3) return true;
    return false;
  }
  if (empiezaCon(c, "MAPA:")) {
    partirPorLetra(c.substring(5), ':');
    String[] p = resPartirPorLetra;
    int m = mapaPorCodigo(p[1]);
    if (m < 0) return false;
    if (p[0].equals("*")) { for (int d = 1; d <= 10; d++) if (estuvoEn[d][m]) return true; return false; }
    int d;
    if (p[0].equals("HOY")) d = dia; else d = int(p[0]);
    return d >= 0 && d < estuvoEn.length && estuvoEn[d][m];
  }
  if (empiezaCon(c, "AQUI:")) return MAPA_COD[mapaActual].equals(c.substring(5));
  if (empiezaCon(c, "E:")) return tieneTexto(elecciones, c.substring(2));
  if (empiezaCon(c, "RESP:")) { String r = c.substring(5); int i = posicionDe(r, ":"); return i > 0 && respondio(r.substring(0, i), r.substring(i + 1)); }
  if (empiezaCon(c, "JUGO:")) { int k = int(c.substring(5)); return k >= 0 && k < copaEstado.length && (copaEstado[k] == 1 || copaEstado[k] == 2); }
  if (empiezaCon(c, "GANO:")) { int k = int(c.substring(5)); return k >= 0 && k < copaEstado.length && copaEstado[k] == 1; }
  if (c.equals("NUNCA")) return false;
  if (empiezaCon(c, "HECHO:")) return tieneTexto(nodosHechos, c.substring(6));
  if (empiezaCon(c, "HOY:")) return hechoHoy(c.substring(4));
  if (empiezaCon(c, "ESCENA:")) return escenaVista(c.substring(7));
  if (c.equals("LLUVIA")) return lloviendo;
  if (c.equals("FINDE")) return dia == 6 || dia == 7;
  if (c.equals("NOCHE")) return minutoAhora() >= 19 * 60 || minutoAhora() < 5 * 60;
  partirComparacion(c);
  String[] p = resPartirComparacion;
  if (p[1].equals("")) return bandera(c) > 0;
  String n = p[0];
  int v;
  if (n.equals("HORA")) return comparar(minutoAhora(), p[1], aMin(p[2]));
  if (n.equals("DIA")) v = dia;
  else if (n.equals("VICIO")) v = bandera("VICIO");
  else if (n.equals("NOTAS")) v = stats[ST_NOTAS];
  else if (n.equals("SOCIAL")) v = stats[ST_SOCIAL];
  else if (n.equals("SEG")) v = stats[ST_SEGUIDORES];
  else if (n.equals("DINERO")) v = dinero;
  else if (n.equals("ENERGIA")) v = stats[ST_ENERGIA];
  else if (n.equals("DEUDA")) v = round(deudaSueno);
  else if (n.equals("FALTAS")) v = faltas;
  else if (n.equals("ASIST")) v = asistencias;
  else if (n.equals("AMIGOS")) v = amigosDeVerdad();
  else if (n.equals("EQUIL")) v = diasEquilibrados();
  else if (n.equals("PANTALLA")) v = stats[ST_PANTALLA];
  else if (n.equals("SUENO")) v = ultimoSuenoMin;
  else if (n.equals("ROMANCES")) { v = 0; for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 1) v++; }
  else if (n.equals("PISTAS")) { int aux1; if (tieneTexto(nodosHechos, "J3")) aux1 = 1; else aux1 = 0; int aux2; if (tieneTexto(nodosHechos, "CE3")) aux2 = 1; else aux2 = 0; int aux3; if (bandera("PISTA_CAMILO") > 0) aux3 = 1; else aux3 = 0; int aux4; if (bandera("PISTA_VALDES") > 0) aux4 = 1; else aux4 = 0; int aux5; if (tieneTexto(nodosHechos, "M5")) aux5 = 1; else aux5 = 0; v = aux1 + aux2 + aux3 + aux4 + aux5; }
  else if (n.equals("COPAGANADOS")) { v = 0; for (int k = 0; k < copaEstado.length; k++) if (copaEstado[k] == 1) v++; }
  else v = bandera(n);
  return comparar(v, p[1], int(p[2]));
}

String[] resPartirComparacion;

// "Sofía>=50" -> { "Sofía", ">=", "50" }
// Deja el resultado en resPartirComparacion.
void partirComparacion(String s) {
  String[] ops = { ">=", "<=", "!=", ">", "<", "=" };
  for (int i = 0; i < ops.length; i++) {
    int k = posicionDe(s, ops[i]);
    if (k > 0) { resPartirComparacion = new String[] { quitarBordes(s.substring(0, k)), ops[i], quitarBordes(s.substring(k + ops[i].length())) }; return; }
  }
  resPartirComparacion = new String[] { quitarBordes(s), "", "0" };
}

// Compara dos números con el operador escrito en texto (>=, <=, >, <, ==).
boolean comparar(int a, String op, int b) {
  if (op.equals(">=")) return a >= b;
  if (op.equals("<=")) return a <= b;
  if (op.equals(">")) return a > b;
  if (op.equals("<")) return a < b;
  if (op.equals("!=")) return a != b;
  return a == b;
}

// ¿Fuiste a una clase de ese día cuya materia empieza así? (a tiempo o tarde)
boolean asistioA(int d, String materia) {
  for (int c = 0; c < CLASES.length; c++) {
    if (int(CLASES[c][0]) == d && empiezaCon(CLASES[c][3], materia)) {
      if (claseEstado[c] == 1 || claseEstado[c] == 2) return true;
    }
  }
  return false;
}

// Cuántas personas tienen amistad de 60 o más contigo.
int amigosDeVerdad() {
  int n = 0;
  for (int f = 0; f < amistad.length; f++) if (amistad[f] >= 60 && esPersonaDeVerdad(f)) n++;
  return n;
}

// Los animales y "Familia" no cuentan como amistades
boolean esPersonaDeVerdad(int f) {
  String p = DLG_PERSONA[f];
  return !(p.equals("Canela") || p.equals("Tuerca") || p.equals("Newton") || p.equals("Familia"));
}

// ============================ LEER TEXTOS DE LAS TABLAS (a mano, letra por letra) ============================
// ¿La letra es un signo + o −?
boolean esSigno(char c) {
  return c == '+' || c == '-' || c == '−';
}

// ¿La letra es un número del 0 al 9?
boolean esDigito(char c) {
  return c >= '0' && c <= '9';
}

// Mayúsculas y minúsculas sin la clase Character: se compara la letra con su versión en mayúscula / minúscula
char mayuscula(char c) {
  return letraEn(("" + c).toUpperCase(), 0);
}

// Pasa una letra a minúscula.
char minuscula(char c) {
  return letraEn(("" + c).toLowerCase(), 0);
}

// ¿La letra es mayúscula?
boolean esMayuscula(char c) {
  return !("" + c).equals(("" + c).toLowerCase());
}

// ¿La letra es minúscula?
boolean esMinuscula(char c) {
  return !("" + c).equals(("" + c).toUpperCase());
}

// ¿Es una letra (mayúscula o minúscula, con tilde o ñ)?
boolean esLetra(char c) {
  return esMayuscula(c) || esMinuscula(c);
}

// ¿Hay en el texto un signo (de "signos") pegado a un número del 1 al 9? ("+5", "−3")
boolean signoConNumero(String q, String signos) {
  if (posicionDe(q, "\n") >= 0) return false;
  for (int i = 0; i + 1 < q.length(); i++) {
    if (posicionDe(signos, str(letraEn(q, i))) >= 0 && letraEn(q, i + 1) >= '1' && letraEn(q, i + 1) <= '9') return true;
  }
  return false;
}

// ¿Es un espacio, tabulador o salto de línea?
boolean esEspacio(char c) {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

String[] resPartirEfecto;

// "Am +5", "Estudio +30 min", "$ −2,5": { nombre, signo, número, unidad ("h", "min" o "") }; null si no es así
// Deja el resultado en resPartirEfecto.
void partirEfecto(String p) {
  if (posicionDe(p, "\n") >= 0) { resPartirEfecto = null; return; }
  for (int i = 1; i < p.length(); i++) {
    if (esSigno(letraEn(p, i))) {
      int j = i + 1;
      while (j < p.length() && esEspacio(letraEn(p, j))) j++;
      if (!(j >= p.length()) && esDigito(letraEn(p, j))) {
        int ini = j;
        while (j < p.length() && esDigito(letraEn(p, j))) j++;
        if (j + 1 < p.length() && letraEn(p, j) == ',' && esDigito(letraEn(p, j + 1))) {
          j++;
          while (j < p.length() && esDigito(letraEn(p, j))) j++;
        }
        String numero = p.substring(ini, j);
        while (j < p.length() && esEspacio(letraEn(p, j))) j++;
        String resto = p.substring(j);
        String unidad = "";
        if (empiezaCon(resto, "h")) unidad = "h";
        else if (empiezaCon(resto, "min")) unidad = "min";
        resPartirEfecto = new String[] { p.substring(0, i), p.substring(i, i + 1), numero, unidad };
        return;
      }
    }
  }
  resPartirEfecto = null;
}

String[][] resVariantesConEtiqueta;

// "Amigo: “...” Molesto: [...]" -> filas { etiqueta, línea } (etiqueta de 2 a 30 letras antes de ":")
// Deja el resultado en resVariantesConEtiqueta.
void variantesConEtiqueta(String t) {
  String[][] v = new String[10][];
  String prohibidas = ":“”[]";
  int pos = 0;
  int c = posicionDeDesde(t, ":", pos);
  while (c >= 0) {
    int r = c;
    while (r > pos && posicionDe(prohibidas, str(letraEn(t, r - 1))) < 0) r--;
    boolean seguir8 = true;
    if (c - r >= 2) {
      if (c - r > 30) r = c - 30;
      int j = c + 1;
      while (j < t.length() && esEspacio(letraEn(t, j))) j++;
      int fin = -1;
      if (j < t.length() && letraEn(t, j) == '“') {
        int e = posicionDeDesde(t, "”", j + 1);
        if (e >= 0) fin = e + 1;
      } else if (j < t.length() && letraEn(t, j) == '[') {
        int e = posicionDeDesde(t, "]", j + 1);
        if (e >= 0) fin = e + 1;
      }
      if (fin > 0) {
        agregarFila(v, new String[] { quitarBordes(t.substring(r, c)), t.substring(j, fin) });
        pos = fin;
        c = posicionDeDesde(t, ":", pos);
        seguir8 = false;
      }
    }
    if (seguir8) {
      c = posicionDeDesde(t, ":", c + 1);
    }
  }
  resVariantesConEtiqueta = v;
}

// ============================ LO QUE HICISTE (para Aurora+, eventos y finales) ============================
boolean[][] estuvoEn = new boolean[12][NUM_MAPAS + 1];

// Al entrar a un mapa: anota que estuviste y revisa si hay un evento ahí.
void alEntrarMapa(int m) {
  if (dia >= 0 && dia < estuvoEn.length && m >= 0 && m < estuvoEn[0].length) estuvoEn[dia][m] = true;
  revisarEventosAlEntrar(m);
}

// ============================ REACCIÓN A CADA RESPUESTA ============================
// Lo que contesta una persona a la respuesta que le diste en un nodo.
String reaccionDe(String nodo, String resp) {
  if (nodo == null || resp == null) return null;
  for (int k = 0; k < REAC_RESP.length; k++) {
    if (REAC_RESP[k][0].equals(nodo) && empiezaCon(resp, REAC_RESP[k][1])) return REAC_RESP[k][2];
  }
  return null;
}

// ============================ PRIMER ENCUENTRO (va antes que cualquier charla) ============================
// { persona, escena del primer encuentro }: hasta que no pase, al hablarle (R) sale esa escena.
String[][] PRIMER_ENCUENTRO = {
  {"Iris", "IRIS1"}
};

// Si es la primera vez que hablas con alguien, arranca su presentación.
boolean primerEncuentroAlHablar(int f) {
  if (f < 0) return false;
  for (int k = 0; k < PRIMER_ENCUENTRO.length; k++) {
    if (PRIMER_ENCUENTRO[k][0].equals(DLG_PERSONA[f])) {
      String id = PRIMER_ENCUENTRO[k][1];
      if (escenaVista(id) || !escenaExiste(id)) return false;
      empezarEscena(id);
      return true;
    }
  }
  return false;
}

// Respuestas que diste en los árboles ("S1:[Le tomas una foto...]") para las condiciones RESP:
String[] respuestasDadas = new String[MAX_NODOS];

// ¿Ya le diste esta respuesta en este nodo?
boolean respondio(String nodo, String inicio) {
  String b = nodo + ":" + inicio;
  for (int i = 0; i < tamTexto(respuestasDadas); i++) if (empiezaCon(respuestasDadas[i], b)) return true;
  return false;
}

// Lo que contesta la persona a tu respuesta: la escrita a mano (REAC_RESP) o una genérica.
String reaccionDeOpcion(String clave, String[] o, int f) {
  if (clave != null && empiezaCon(clave, "A:")) {
    String r = reaccionDe(clave.substring(2), o[0]);
    if (r != null) return r;
  }
  return reaccion(f, signoEfecto(o[1], f));
}

