// Acostarse: empieza el minijuego del insomnio (notificaciones que no te dejan dormir).
void acostarseCama() {
  empezarActividad(ACT_INSOMNIO);
  for (int k = 0; k < MAX_NOTIF; k++) notif[k][4] = 0;
  notifSiguiente = millis() + 800;
  notifQuitadas = 0;
  notifAbiertas = 0;
  notifSacudida = 0;
  aviso("A dormir... si el celular te deja");
}

// Dificultad: sube con el tiempo de pantalla del día y la deuda de sueño; No molestar la baja
float dificultadInsomnio() {
  float d = 1 + stats[ST_PANTALLA] / 240.0 + deudaSueno * 0.15;
  if (noMolestar) d *= NO_MOLESTAR_FACTOR;
  return max(0.5, d);
}

// Dibuja el insomnio: notificaciones que salen y hay que tirar antes de que te despierten.
void dibujarInsomnio() {
  int t = millis() - actividadInicio;
  float dif = dificultadInsomnio();
  int vidaMs = int(NOTIF_VIDA_MS / (0.8 + 0.2 * dif));

  noStroke();
  cargarSprites11();
  if (hay(in_cama)) { image(in_cama, 0, 0, ANCHO, ALTO); fill(10, 15, 50, 90); }
  else fill(10, 15, 50, 170);
  rect(0, 0, ANCHO, ALTO);
  if (hay(in_celular)) image(in_celular, 1260, 420, 300, 500);

  if (t < INSOMNIO_MS - 1500 && millis() >= notifSiguiente) {
    nuevaNotificacion();
    float f = t / (float) INSOMNIO_MS;
    notifSiguiente = millis() + int(lerp(NOTIF_CADA_MS_INI, NOTIF_CADA_MS_FIN, f) / dif * filtroModeria());
  }
  float dx = 0;
  if (millis() < notifSacudida) dx = random(-8, 8);
  for (int k = 0; k < MAX_NOTIF; k++) {
    if (notif[k][4] != 0) {
      int vida = millis() - int(notif[k][2]);
      int tipo = int(notif[k][5]);
      if (vida > vidaMs) {
        notif[k][4] = 0;
        notifAbiertas++;
        notifSacudida = millis() + 300;
        if (notifArrastrada == k) notifArrastrada = -1;
      } else {
        if (tipo == NOTIF_MOVIL) {
          notif[k][0] += notif[k][6] * pasoCuadro;
          notif[k][1] += notif[k][7] * pasoCuadro;
          if (notif[k][0] < 40 || notif[k][0] > 1180) notif[k][6] *= -1;
          if (notif[k][1] < 80 || notif[k][1] > 720) notif[k][7] *= -1;
        }
        float x = notif[k][0] + dx, y = notif[k][1];
        if (notifArrastrada == k) x += mouseX - notifArrastreX;
        float resto = 1 - vida / (float) vidaMs;
        if (tipo == NOTIF_IMPORTANTE) fill(255, 245, 210, 240);
        else fill(250, 250, 255, 235);
        rect(x, y, 380, 86, 12);
        int app = int(notif[k][3]);
        if (ui_iconos_apps != null && ui_iconos_apps.width > 1) image(ui_iconos_apps, x + 10, y + 11, 64, 64, app * 80, 0, app * 80 + 80, 80);
        else { fill(120, 80, 200); rect(x + 10, y + 11, 64, 64, 10); }
        fill(30);
        textSize(17);
        textAlign(LEFT, TOP);
        String titulo;
        if (tipo == NOTIF_IMPORTANTE) titulo = "Charla · importante"; else titulo = APPS[app];
        text(titulo, x + 86, y + 10);
        if (tipo == NOTIF_DESLIZAR) {
          float dx2 = x + 86 + textWidth(titulo + "   ");
          fill(220, 30, 30);
          text("DESLIZA →", dx2, y + 10);
          text("DESLIZA →", dx2 + 1, y + 10);
          fill(30);
        }
        textSize(15);
        if (tipo == NOTIF_IMPORTANTE) {
          text(notifTexto[k], x + 86, y + 34, 190, 46);
        } else {
          text(notifTexto[k], x + 86, y + 34, 280, 46);
        }
        if (tipo == NOTIF_IMPORTANTE) {
          fill(90, 180, 110);
          rect(x + 284, y + 26, 86, 36, 8);
          fill(255);
          textAlign(CENTER, CENTER);
          text("Contestar", x + 327, y + 43);
        }
        fill(255, 90, 90);
        rect(x + 10, y + 78, 360 * resto, 4);
      }
    }
  }
  textAlign(LEFT, BASELINE);
  fill(255);
  textSize(22);
  String ayuda1 = "Click para quitar · las que dicen ";
  text(ayuda1, 40, 870);
  float ax = 40 + textWidth(ayuda1);
  fill(255, 70, 70);
  text("DESLIZA →", ax, 870);
  text("DESLIZA →", ax + 1, 870);
  ax = ax + textWidth("DESLIZA →") + 1;
  fill(255);
  text(" se arrastran · a la familia se le contesta", ax, 870);
  textAlign(RIGHT, BASELINE);
  textSize(24);
  if (noMolestar) {
    text("Quitadas " + notifQuitadas + "   ·   Abiertas " + notifAbiertas + " (−" + (notifAbiertas * PENAL_NOTIF_MIN) + " min de sueño)   ·   " + max(0, (INSOMNIO_MS - t) / 1000) + " s"
    + "   ·   No molestar", 1560, 50);
  } else {
    text("Quitadas " + notifQuitadas + "   ·   Abiertas " + notifAbiertas + " (−" + (notifAbiertas * PENAL_NOTIF_MIN) + " min de sueño)   ·   " + max(0, (INSOMNIO_MS - t) / 1000) + " s"
    + "", 1560, 50);
  }
  textAlign(LEFT, BASELINE);
  if (t >= INSOMNIO_MS) terminarInsomnio();
}

// Saca una notificación nueva en el insomnio.
void nuevaNotificacion() {
  for (int k = 0; k < MAX_NOTIF; k++) {
    if (notif[k][4] == 0) {
      int app = int(random(APPS.length));
      float r = random(1);
      int tipo;
      if (r < 0.4) {
        tipo = NOTIF_NORMAL;
      } else {
        if (r < 0.65) tipo = NOTIF_DESLIZAR; else if (r < 0.85) tipo = NOTIF_MOVIL; else tipo = NOTIF_IMPORTANTE;
      }
      notif[k][0] = random(80, 1140);
      notif[k][1] = random(90, 700);
      notif[k][2] = millis();
      if (tipo == NOTIF_IMPORTANTE) notif[k][3] = 5; else notif[k][3] = app;
      notif[k][4] = 1;
      notif[k][5] = tipo;
      if (random(1) < 0.5) notif[k][6] = -3; else notif[k][6] = 3;
      notif[k][7] = random(-2.5, 2.5);
      if (tipo == NOTIF_IMPORTANTE) {
        notifTexto[k] = NOTIF_FAMILIA[int(random(NOTIF_FAMILIA.length))];
      } else {
        notifTexto[k] = NOTIF_TEXTOS[app][int(random(NOTIF_TEXTOS[app].length))];
      }
      return;
    }
  }
}

// Qué notificación del insomnio está debajo del mouse.
int notifEnMouse() {
  for (int k = MAX_NOTIF - 1; k >= 0; k--) {
    if (notif[k][4] != 0) {
      if (mouseX >= notif[k][0] && mouseX <= notif[k][0] + 380 && mouseY >= notif[k][1] && mouseY <= notif[k][1] + 86) return k;
    }
  }
  return -1;
}

// Click en una notificación del insomnio: la tira (o te engancha si es tentadora).
void clickInsomnio() {
  int k = notifEnMouse();
  if (k < 0) return;
  int tipo = int(notif[k][5]);
  if (tipo == NOTIF_DESLIZAR) { notifArrastrada = k; notifArrastreX = mouseX; return; }
  notif[k][4] = 0;
  notifQuitadas++;
  if (tipo == NOTIF_IMPORTANTE) {
    int fam = personaIndice("Mamá (Claudia)");
    boolean contesto = mouseX >= notif[k][0] + 284 && mouseX <= notif[k][0] + 370 && mouseY >= notif[k][1] + 26 && mouseY <= notif[k][1] + 62;
    if (contesto) cambiarAmistad(fam, 1);
    else { cambiarAmistad(fam, -2); aviso("La dejaste en visto: Mamá −2"); }
  }
}

// Lo llama mouseReleased(): las de deslizar se van si las arrastraste lo suficiente
void soltarInsomnio() {
  if (actividad != ACT_INSOMNIO || notifArrastrada < 0) return;
  int k = notifArrastrada;
  notifArrastrada = -1;
  if (notif[k][4] != 0 && abs(mouseX - notifArrastreX) > 120) {
    notif[k][4] = 0;
    notifQuitadas++;
  }
}

// Calcula cuánto duermes, adelanta el reloj y deja la pantalla de "despertaste"
void terminarInsomnio() {
  int ahora = horaDelDia() / 2;
  boolean finde = (dia == 5 || dia == 6);
  int alarma;
  if (finde) alarma = ALARMA_FINDE; else alarma = ALARMA_SEMANA;
  int hastaAlarma = (alarma - ahora + 1440) % 1440;
  if (hastaAlarma == 0) hastaAlarma = 1440;
  int duerme = min(hastaAlarma, SUENO_MAX_MIN) - notifAbiertas * PENAL_NOTIF_MIN;
  duerme = max(SUENO_MIN_MIN, duerme);
  if (duerme >= 480 && notifAbiertas <= 1) sumarBandera("BUEN_DORMIR", 1);
  guardarAntesDeDormir();
  dormir(duerme);
  guardarDespuesDeDormir(duerme);
  empezarActividad(ACT_DESPERTAR);
}

// Duerme "minutos": deuda de sueño, energía, reloj y día nuevo
void dormir(int minutos) {
  float horas = minutos / 60.0;
  if (horas >= 10) deudaSueno = max(0, deudaSueno - 2);
  else if (horas >= 7) deudaSueno = max(0, deudaSueno - 1);
  else if (horas >= 4) deudaSueno = max(0, deudaSueno - 0.5);
  ultimoSuenoMin = minutos;
  int inicio = horaDelDia() / 2;
  avanzarTiempo(minutos);
  nocheDormida();
  revisarCambioDia();

  int fin = horaDelDia() / 2;
  boolean deNoche = inicio >= 17 * 60 || inicio < 5 * 60;
  if (deNoche && fin < 5 * 60 && diaDelReloj() == diaRelojVisto) {
    diaRelojVisto++;
    if (dia < 10) dia++;
    nuevoDia();
    nuevoDiaV20();
  }

  stats[ST_ENERGIA] = constrain(ENERGIA_DESPERTAR_BASE + int(horas * ENERGIA_POR_HORA), 0, energiaMax());
  suenoResultadoMin = minutos;
  suenoEnergia = stats[ST_ENERGIA];
  suenoDespiertaHd = horaDelDia();
  invalidarFondo();
}

// Dibuja la pantalla al despertar.
void dibujarDespertar() {
  noStroke();
  fill(10, 15, 50, 120);
  rect(0, 0, ANCHO, ALTO);
  ventana(450, 230, 700, 380, "Despertaste · Día " + dia);
  fill(40);
  textSize(26);
  text("Dormiste " + (suenoResultadoMin / 60) + " h " + nf(suenoResultadoMin % 60, 2) + " min", 490, 330);
  text("Hora: " + horaTexto(suenoDespiertaHd), 490, 375);
  text("Energía: " + suenoEnergia + " / " + energiaMax(), 490, 420);
  text("Notificaciones quitadas " + notifQuitadas + " · abiertas " + notifAbiertas, 490, 465);
  text("Deuda de sueño: " + nf(deudaSueno, 1, 1), 490, 510);
  textSize(20);
  fill(110);
  text("[E] o click para levantarte", 490, 575);
}

