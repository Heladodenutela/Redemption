// ¿Tienes el número de esta persona?
boolean esContacto(int f) {
  return f >= 0 && bandera("NUM_" + f) > 0;
}

// ¿Es de tu familia?
boolean esFamilia(int f) {
  if (f < 0) return false;
  String p = DLG_PERSONA[f];
  return p.equals("Mamá (Claudia)") || p.equals("Papá (Ernesto)") || p.equals("Abuela Nena") || p.equals("Lili");
}

// ¿Este chat es un grupo?
boolean esGrupo(String chat) {
  for (int i = 0; i < GRUPOS.length; i++) if (GRUPOS[i].equals(chat)) return true;
  return false;
}

// ¿Este chat es de avisos del sistema?
boolean esChatSistema(String chat) {
  return chat.equals("Avisos") || chat.equals("Alertas");
}

// ¿Estás en este grupo (algunos piden entrar al club o a la Copa)?
boolean enGrupo(String chat) {
  if (chat.equals("Aurora 1° Sem") || chat.equals("Familia")) return true;
  if (chat.equals("Club del Deporte")) return bandera("CLUB_DEPORTE") > 0;
  if (chat.equals("Copa Aurora")) return bandera("INSCRITO_COPA") > 0 || bandera("CLUB_RUGBY") > 0;
  if (chat.equals("Los del Fondo")) return bandera("GRUPO_FONDO") > 0;
  return false;
}

// ¿Puede llegarte algo de ese chat? (grupo al que perteneces, app, o persona que tiene tu número)
boolean puedeEscribirte(String chat) {
  if (chat == null || chat.equals("")) return false;
  if (esChatSistema(chat)) return true;
  if (esGrupo(chat)) return enGrupo(chat);
  return esContacto(personaDelChat(chat));
}

// ============================ QUE NO SE AMONTONEN ============================
// Tipo 0: tema nuevo (uno al día por persona y nunca si te está esperando una respuesta)
// tipo 1: reclamo (te llamé, te esperé, ¿me estás ignorando?): uno al día, aunque te esté esperando
int[] chatNuevoDia = new int[MSG_FILAS], chatReclamoDia = new int[MSG_FILAS];

// ¿Puede llegarte un mensaje de este chat ahora (sin amontonar varios de la misma persona)?
boolean llegaMensaje(String chat, int tipo) {
  if (!puedeEscribirte(chat)) return false;
  if (esChatSistema(chat) || esGrupo(chat)) return true;
  int f = filaChatSiExiste(chat);
  if (f < 0) return true;
  if (tipo == 1) {
    if (chatReclamoDia[f] == dia) return false;
    chatReclamoDia[f] = dia;
    return true;
  }
  if (msgPendiente[f] >= 0) { insistir(chat, f); return false; }
  if (chatNuevoDia[f] == dia) return false;
  chatNuevoDia[f] = dia;
  return true;
}

