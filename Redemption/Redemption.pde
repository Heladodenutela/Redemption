boolean[] ctxEnviado;

// Manda mensajes según lo que estás haciendo (contexto) cuando llega su hora.
void revisarMensajesCtx() {
  if (ctxEnviado == null) ctxEnviado = new boolean[MSG_CTX.length];
  int m = minutoAhora();
  for (int k = 0; k < MSG_CTX.length; k++) {
    String[] c = MSG_CTX[k];
    if (!ctxEnviado[k] && diaEn(c[2], dia) && m >= aMin(c[3]) && m >= 5 * 60 && cumple(c[4]) && llegaMensaje(c[1], 0)) {
      ctxEnviado[k] = true;
      mandarConOpciones(c[1], c[5], new String[] { c[6], c[7], c[8], c[9], c[10], c[11] });
    }
  }
}

// Manda un mensaje que espera respuesta (fila nueva en MSG_DIN)
void mandarConOpciones(String chat, String texto, String[] ops) {
  String[] fila = { str(dia), nf(minutoAhora() / 60, 2) + ":" + nf(minutoAhora() % 60, 2), chat, "", texto, ops[0], ops[1], ops[2], ops[3], ops[4], ops[5] };
  if (tamFilas(MSG_DIN) >= MSG_DIN.length) {
    agregarMensaje(chat, '1', texto);
    return;
  }
  agregarFila(MSG_DIN, fila);
