// +1 si le gustó, -1 si no, 0 neutral (según la amistad que da el efecto)
int signoEfecto(String ef, int f) {
  if (ef == null) return 0;
  partirPorLetra(ef, '·');
  String[] partes = resPartirPorLetra;
  String yo = nombreCorto(f);
  for (int i = 0; i < partes.length; i++) {
    String q = quitarBordesProcessing(partes[i]);
    if (empiezaCon(q, "Am ") || empiezaCon(q, yo + " ")) {
      if (posicionDe(q, "+") >= 0 && posicionDe(q, "+0") < 0) return 1;
      if (posicionDe(q, "−") >= 0 || posicionDe(q, "-") >= 0) return -1;
    }
  }

  for (int i = 0; i < partes.length; i++) {
    String q = quitarBordesProcessing(partes[i]);
    if (signoConNumero(q, "+")) return 1;
    if (signoConNumero(q, "−-")) return -1;
  }
  return 0;
}

// Línea de reacción de una persona (buena o mala) según lo que hiciste.
String reaccion(int f, int signo) {
  String p;
  if (DLG_PERSONA[f].equals("Familia")) p = "Mamá (Claudia)"; else p = DLG_PERSONA[f];
  for (int k = 0; k < REACCIONES.length; k++) {
    if (REACCIONES[k][0].equals(p)) { if (signo > 0) return REACCIONES[k][1]; else if (signo < 0) return REACCIONES[k][3]; else return REACCIONES[k][2]; }
  }
  if (signo > 0) return "¡Gracias!"; else if (signo < 0) return "Mmm. Bueno."; else return "Ajá.";
}

// Tecla R
void hablar() {
  int k = npcParaHablar();
  if (k < 0) return;
  if (teEvita(npcPersona[k])) { dlgNPC = k; dlgFila = npcPersona[k]; asignarDialogo(dlgFila); dlgSoloDefault = true; empezarActividad(ACT_DIALOGO); return; }
  if (primerEncuentroAlHablar(npcPersona[k])) return;
  if (eventoAlHablar(npcPersona[k])) return;
  if (planAlHablar(npcPersona[k])) return;
  dlgNPC = k;
  dlgFila = npcPersona[k];
  if (dlgPos[dlgFila] >= largo(dlgFila)) asignarDialogo(dlgFila);
  dlgSoloDefault = largo(dlgFila) == 0;
  empezarActividad(ACT_DIALOGO);
}

// Línea del diálogo que se está mostrando.
String lineaActual() {
  if (dlgSoloDefault) return dlg[dlgFila][2];
  return dlg[dlgFila][DLG_INI + dlgPos[dlgFila]];
}

// Quién habla en la línea actual ('1' tú, '0' la otra persona).
char quienActual() {
  if (dlgSoloDefault) return '0';
  return letraEn(dlg[dlgFila][1], dlgPos[dlgFila]);
}

// Pasa a la siguiente línea del diálogo o lo termina.
void avanzarDialogo() {
  if (dlgFila < 0) { terminarActividad(); return; }
  int f = dlgFila;
  if (dlgSoloDefault) { terminarActividad(); return; }
  if (nodoActual() != null) return;
  int pos = dlgPos[f];

  String ef = dlgEfecto[f][DLG_INI + pos];
  if (ef != null) {
    dlgEfecto[f][DLG_INI + pos] = null;
    if (ef.equals("MESADA")) darMesada();
    else if (ef.equals("VAR")) recordarVariante(f, dlg[f][DLG_INI + pos]);
    else { String r = aplicarEfectos(ef, f); if (!r.equals("")) aviso(r); }
  }
  dlgPos[f] = pos + 1;
  if (dlgPos[f] >= largo(f)) {
    terminarCadena(f);
    terminarActividad();
  }
}

// Papá te da la mesada del día (una vez por día).
void darMesada() {
  if (mesadaDada[dia]) return;
  mesadaDada[dia] = true;
  int m;
  if (dia == 8) m = MESADA_LUNES - (faltas * 2); else m = MESADA_LUNES - 0;
  dinero += m;
  if (dia == 8 && faltas > 0) {
    aviso("Mesada: $" + m + (" (te recortaron por " + faltas + " faltas)"));
  } else {
    aviso("Mesada: $" + m + "");
  }
}

// Terminaste la cadena: lo normal ya no se repite hoy, y la cadena se vuelve a armar (por si hay algo nuevo)
void terminarCadena(int f) {
  registrarCharla(f);
  for (int i = 0; i < largo(f); i++) if (letraEn(dlg[f][1], i) == '0' && dlgNodo[f][DLG_INI + i] == null && !tieneTexto(dichasHoy[f], dlg[f][DLG_INI + i])) agregarTexto(dichasHoy[f], dlg[f][DLG_INI + i]);
  if (!charlaHoy[f]) {
    charlaHoy[f] = true;
    cambiarAmistad(f, AMISTAD_POR_CHARLA);
    catMedios[CAT_AMIGOS] += 10;
  }
  asignarDialogo(f);
}

// Al salir de un mapa: lo que quedó a medias vuelve a empezar
void reiniciarCadenasSinTerminar() {
  if (dlg == null) return;
  for (int f = 0; f < dlg.length; f++) if (dlgPos[f] > 0 && dlgPos[f] < largo(f)) asignarDialogo(f);
}

// Eligió la respuesta i
boolean elegirOpcionDialogo(int i) {
  String clave = nodoActual();
  if (clave == null) return false;
  if (empiezaCon(clave, "D:")) return elegirOpcionDiario(clave, i);
  int f = dlgFila;
  opcionesDe(clave, f);
  String[][] ops = resOpcionesDe;
  if (i < 0 || i >= tamFilas(ops)) return true;
  String[] o = ops[i];
  int pos = dlgPos[f];
  dlgNodo[f][DLG_INI + pos] = null;
  String res = "";
  if (empiezaCon(clave, "A:")) {
    String n = clave.substring(2);
    agregarTexto(nodosHechos, n);
    marcarArbolHoy(f, n);
    agregarTexto(elecciones, n + ":" + i);
    agregarTexto(respuestasDadas, n + ":" + o[0]);
    res = aplicarEfectos(o[1], f);
  } else if (empiezaCon(clave, "C:")) {
    res = aplicarEfectos(o[1], personaIndice("Mamá (Claudia)"));
  } else if (empiezaCon(clave, "E:")) {
    agregarTexto(encargosHoy, clave.substring(2));
    if (o[2].equals("ENCARGO")) { avanzarTiempo(ENCARGO_MIN); res = aplicarEfectos(o[1], f); }
  }
  int ins = pos + 1;
  if (!o[0].equals("") && !o[0].equals("0")) insertar(f, ins++, '1', o[0], null, null);

  String inmediato = null;
  partirPorLetra(o[2], ' ');
  String[] sig = resPartirPorLetra;
  for (int k = 0; k < sig.length; k++) {
    String n = sig[k];
    if (n.length() != 0 && !n.equals("ENCARGO") && !n.equals("Final")) {
      if (!tieneTexto(nodosAbiertos, n)) agregarTexto(nodosAbiertos, n);
      if (inmediato == null && !tieneTexto(nodosHechos, n) && personaDeNodo(n) == f && (diaNodo(n) == dia || diaNodo(n) == 0) && condicionEvaluable(cuandoNodo(n), f)) inmediato = n;
    }
  }
  if (inmediato != null) insertar(f, ins, '0', resolverLinea(f, lineaNodo(inmediato)), "A:" + inmediato, null);
  else if (empiezaCon(clave, "E:")) { if (o[2].equals("ENCARGO")) insertar(f, ins, '0', "¡Gracias! Me salvaste el día.", null, null); else insertar(f, ins, '0', "Tranquilo, otro día será.", null, null); }
  else insertar(f, ins, '0', reaccionDeOpcion(clave, o, f), null, null);
  dlgPos[f] = pos + 1;
  if (!res.equals("")) aviso(res);
  return true;
}

// Persona a la que pertenece un nodo del árbol.
int personaDeNodo(String n) {
  for (int k = 0; k < ARBOL.length; k++) if (ARBOL[k][1].equals(n)) return personaIndice(ARBOL[k][0]);
  return -1;
}

final float OPC_X = 450, OPC_W = 700, OPC_H = 60;

// Altura en pantalla de la opción i de respuesta.
float opcY(int i, int n) {
  return CAJA_Y - 56 - (n - i) * (OPC_H + 6);
}

// Dibuja las respuestas que puedes elegir.
void dibujarOpcionesDialogo() {
  String clave = nodoActual();
  if (clave == null) return;
  opcionesDe(clave, dlgFila);
  String[][] ops = resOpcionesDe;
  int n = tamFilas(ops);
  for (int i = 0; i < n; i++) {
    float y = opcY(i, n);
    boolean encima = mouseX > OPC_X && mouseX < OPC_X + OPC_W && mouseY > y && mouseY < y + OPC_H;
    if (ui_opcion_de_respuesta != null && ui_opcion_de_respuesta.width > 1) {
      int c;
      if (encima) c = 1; else c = 0;
      image(ui_opcion_de_respuesta, OPC_X, y, OPC_W, OPC_H, 0, c * 70, 700, c * 70 + 70);
    } else {
      noStroke();
      if (encima) fill(color(255, 235, 180)); else fill(color(250, 246, 235));
      rect(OPC_X, y, OPC_W, OPC_H, 10);
    }
    fill(40);
    textSize(18);
    textAlign(LEFT, CENTER);
    text((i + 1) + ".  " + ops[i][0], OPC_X + 22, y + 4, OPC_W - 40, OPC_H - 8);
  }
