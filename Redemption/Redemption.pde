// Crea la imagen del cielo (pequeña, se agranda al dibujarla) y las nubes.
void iniciarCielo() {
  cielo = createGraphics(CIELO_W, CIELO_H);
  cielo.noSmooth();
  cieloBasePx = new int[CIELO_W * CIELO_H];
  capaFondo = createGraphics(ANCHO, ALTO);
  capaFondo.noSmooth();
  hdCieloBase = -1;
  fondoSucio = true;
  bandaColor = new int[NUM_BANDAS];
  estX = new int[NUM_ESTRELLAS];
  estY = new int[NUM_ESTRELLAS];
  estTipo = new int[NUM_ESTRELLAS];
  estFase = new float[NUM_ESTRELLAS];
  estVel = new float[NUM_ESTRELLAS];
  for (int k = 0; k < NUM_ESTRELLAS; k++) {
    estX[k] = (int) random(2, CIELO_W - 2);
    estY[k] = (int) random(2, HORIZONTE_CIELO * 0.85);
    float rr = random(1);
    if (rr < 0.6) estTipo[k] = 0; else if (rr < 0.88) estTipo[k] = 1; else estTipo[k] = 2;
    estFase[k] = random(TWO_PI);
    estVel[k] = random(1.5, 4.5);
  }
  nubX = new float[NUM_NUBES];
  nubVel = new float[NUM_NUBES];
  nubY = new int[NUM_NUBES];
  nubAncho = new int[NUM_NUBES];
  nubPico = new int[NUM_NUBES];
  for (int k = 0; k < NUM_NUBES; k++) {
    nubX[k] = random(-40, CIELO_W);
    nuevaNube(k);
  }
}

// Crea una nube nueva con altura, ancho y forma al azar.
void nuevaNube(int k) {
  nubY[k] = (int) random(8, HORIZONTE_CIELO * 0.6);
  nubAncho[k] = (int) random(26, 70);
  nubPico[k] = (int) random(0, nubAncho[k] * 0.4);
  nubVel[k] = VEL_NUBES * random(0.5, 1.5);
}

// Color del cielo a una hora (h de 0 a 24); capa 0 arriba, 1 medio, 2 horizonte
int colorCielo(float h, int capa) {
  for (int k = 0; k < CIELO_HORA.length - 1; k++) {
    if (h < CIELO_HORA[k + 1]) {
      float t = (h - CIELO_HORA[k]) / (CIELO_HORA[k + 1] - CIELO_HORA[k]);
      return lerpColor(CIELO_COLOR[k][capa], CIELO_COLOR[k + 1][capa], t);
    }
  }
  return CIELO_COLOR[0][capa];
}

// Qué tan de noche es (para estrellas y nubes)
float factorNoche(float h) {
  if (h >= 20 || h <= 4.5) return 1;
  if (h > 18.5 && h < 20) return (h - 18.5) / 1.5;
  if (h > 4.5 && h < SALIDA_SOL) return 1 - (h - 4.5) / (SALIDA_SOL - 4.5);
  return 0;
}

// Franjas: más gruesas arriba y más delgadas cerca del horizonte
int bandaY(int b) {
  return round(HORIZONTE_CIELO * (1 - pow(1 - b / (float) NUM_BANDAS, 1.5)));
}

// Mezcla un píxel de un arreglo de 320x180 con otro color (a = 0 nada, 1 todo)
void pintarPixel(int[] px, int x, int y, int c, float a) {
  if (x < 0 || x >= CIELO_W || y < 0 || y >= CIELO_H || a <= 0) return;
  int i = y * CIELO_W + x;
  px[i] = lerpColor(px[i], c, min(1, a));
}

// Distancia entre dos horas del día, dando la vuelta por la medianoche.
int difHoras(int a, int b) {
  int dd = abs(a - b);
  return min(dd, 2880 - dd);
}

// ---- PARTE LENTA: franjas, sol y luna (cada REFRESCO_CIELO_MS o al saltar el tiempo) ----
// Calcula los colores del cielo según la hora (amanecer, día, atardecer, noche).
void calcularCieloBase(int hd) {
  float h = hd / 120.0;
  int arriba = colorCielo(h, 0), medio = colorCielo(h, 1), horiz = colorCielo(h, 2);
  cieloArriba = arriba;
  cieloMedio = medio;
  cieloHoriz = horiz;
  cieloNoche = factorNoche(h);
  int[] px = cieloBasePx;

  for (int b = 0; b < NUM_BANDAS; b++) {
    float t = (b + 0.5) / NUM_BANDAS;
    if (t < 0.5) {
      bandaColor[b] = lerpColor(arriba, medio, t * 2);
    } else {
      bandaColor[b] = lerpColor(medio, horiz, (t - 0.5) * 2);
    }
    int y0 = bandaY(b), y1 = bandaY(b + 1);
    for (int y = y0; y < y1; y++) {
      for (int x = 0; x < CIELO_W; x++) {
        boolean tramado = (b > 0 && y == y0 && (x + y) % 2 == 0);
        if (tramado) px[y * CIELO_W + x] = bandaColor[b - 1]; else px[y * CIELO_W + x] = bandaColor[b];
      }
    }
  }
  for (int y = HORIZONTE_CIELO; y < CIELO_H; y++) {
    for (int x = 0; x < CIELO_W; x++) px[y * CIELO_W + x] = horiz;
  }

  float ps = (h - SALIDA_SOL) / (PUESTA_SOL - SALIDA_SOL);
  if (ps > -0.03 && ps < 1.03) {
    int sx = round(lerp(20, CIELO_W - 20, ps));
    int sy = round(HORIZONTE_CIELO - sin(constrain(ps, 0, 1) * PI) * (HORIZONTE_CIELO - 22));
    float bajo = 1 - sin(constrain(ps, 0, 1) * PI);
    int nucleo = lerpColor(0xFFFFF8D2, 0xFFFF9A3C, bajo);
    int halo = lerpColor(0xFFFFF0AA, 0xFFFF7846, bajo);
    for (int y = sy - 13; y <= sy + 13; y++) {
      if (y < HORIZONTE_CIELO) {
        for (int x = sx - 13; x <= sx + 13; x++) {
          float dd = dist(x, y, sx, sy);
          if (dd <= 7) pintarPixel(px, x, y, nucleo, 1);
          else if (dd <= 9) pintarPixel(px, x, y, halo, 0.55);
          else if (dd <= 13) pintarPixel(px, x, y, halo, 0.2);
        }
      }
    }
  }

  float hl;
  if (h < 12) hl = h + 24; else hl = h;
  float pl = (hl - 18.5) / 11.0;
  if (pl > 0 && pl < 1) {
    int lx = round(lerp(30, CIELO_W - 30, pl));
    int ly = round(HORIZONTE_CIELO - sin(pl * PI) * (HORIZONTE_CIELO - 18));
    float a = max(cieloNoche, 0.35);
    for (int y = ly - 9; y <= ly + 9; y++) {
      if (y < HORIZONTE_CIELO) {
        for (int x = lx - 9; x <= lx + 9; x++) {
          float dd = dist(x, y, lx, ly);
          boolean dentro = dd <= 5 && dist(x, y, lx + 3, ly - 1) > 4.5;
          if (dentro) pintarPixel(px, x, y, 0xFFF0F0DC, a);
          else if (dd <= 8) pintarPixel(px, x, y, 0xFFB4BEDC, a * 0.12);
        }
      }
    }
  }
}

// ---- PARTE RÁPIDA: copia la base y pone estrellas, estrella fugaz y nubes ----
// dt = milisegundos desde la última vez (para que las nubes avancen lo mismo sin importar cada cuánto se llame)
void animarCielo(int dt) {
  dt = constrain(dt, 0, 1000);
  float fr = dt * 0.06;
  cielo.beginDraw();
  cielo.loadPixels();
  copiarEnteros(cieloBasePx, 0, cielo.pixels, 0, cieloBasePx.length);
  int[] px = cielo.pixels;

  if (cieloNoche > 0) {
    float seg = millis() / 1000.0;
    for (int k = 0; k < NUM_ESTRELLAS; k++) {
      float brillo = 0.5 + 0.5 * sin(seg * estVel[k] + estFase[k]);
      float a = cieloNoche * (0.35 + 0.65 * brillo);
      int x = estX[k], y = estY[k];
      if (estTipo[k] == 0) {
        pintarPixel(px, x, y, 0xFFC8D2FF, a * 0.6);
      } else if (estTipo[k] == 1) {
        pintarPixel(px, x, y, 0xFFFFFAE6, a);
      } else {
        pintarPixel(px, x, y, 0xFFFFFFFF, a);
        if (brillo > 0.6) {
          float b2 = a * (brillo - 0.6) / 0.4;
          pintarPixel(px, x - 1, y, 0xFFFFFAE6, b2);
          pintarPixel(px, x + 1, y, 0xFFFFFAE6, b2);
          pintarPixel(px, x, y - 1, 0xFFFFFAE6, b2);
          pintarPixel(px, x, y + 1, 0xFFFFFAE6, b2);
        }
      }
    }
    if (!fugazActiva && cieloNoche > 0.8 && random(1) < PROB_FUGAZ * fr) {
      fugazActiva = true;
      fugX = random(20, CIELO_W * 0.6);
      fugY = random(5, HORIZONTE_CIELO * 0.4);
      fugVida = 470;
    }
    if (fugazActiva) {
      for (int k = 0; k < 7; k++) pintarPixel(px, round(fugX - k * 2), round(fugY - k), 0xFFFFFFFF, cieloNoche * (1 - k / 7.0));
      fugX += 3 * fr;
      fugY += 1.5 * fr;
      fugVida -= dt;
      if (fugVida <= 0) fugazActiva = false;
    }
  }
  cielo.updatePixels();

  int luz = lerpColor(0xFFFFFFFF, cieloHoriz, 0.3);
  luz = lerpColor(luz, cieloMedio, cieloNoche * 0.7);
  int sombra = lerpColor(luz, cieloMedio, 0.45);
  int brillo = lerpColor(luz, 0xFFFFFFFF, 0.5 * (1 - cieloNoche));
  cielo.noStroke();
  for (int k = 0; k < NUM_NUBES; k++) {
    nubX[k] += nubVel[k] * fr;
    if (nubX[k] > CIELO_W + 10) {
      nubX[k] = -nubAncho[k] - 10;
      nuevaNube(k);
    }
    int x = round(nubX[k]), y = nubY[k], w = nubAncho[k], p = nubPico[k];
    int w1 = round(w * 0.65), w2 = round(w * 0.32);
    int x1 = x + round(w * 0.12) + p / 3, x2 = x + round(w * 0.25) + p / 2;
    cielo.fill(luz);
    cielo.rect(x, y + 6, w, 4);
    cielo.rect(x1, y + 3, w1, 3);
    cielo.rect(x2, y, w2, 3);
    cielo.fill(brillo);
    cielo.rect(x2 + 1, y, w2 - 2, 1);
    cielo.rect(x1 + 1, y + 3, w1 - 2, 1);
    cielo.fill(sombra);
    cielo.rect(x + 2, y + 10, w - 4, 1);
  }
  cielo.endDraw();
}

// Decide si toca recalcular algo. Devuelve true si el cielo cambió.
boolean actualizarCielo(int hd) {
  int ahora = millis();
  boolean rapido = viajeActivo;
  boolean cambio = false;
  boolean baseVencida = hdCieloBase < 0
    || ahora - ultimoCieloBase >= REFRESCO_CIELO_MS
    || difHoras(hd, hdCieloBase) > SALTO_INMEDIATO
    || (rapido && hd != hdCieloBase);
  if (baseVencida) {
    calcularCieloBase(hd);
    hdCieloBase = hd;
    ultimoCieloBase = ahora;
    cambio = true;
  }
  boolean animVencida = ANIMAR_CIELO && (rapido || fugazActiva || ahora - ultimoAnimCielo >= REFRESCO_ANIM_CIELO_MS);
  if (cambio || animVencida) {
    animarCielo(ahora - ultimoAnimCielo);
    ultimoAnimCielo = ahora;
    cambio = true;
  }
  return cambio;
}

// Cielo directo a la pantalla (pantallas de viaje a pie o en taxi)
void dibujarCielo(int hd) {
  actualizarCielo(hd);
  image(cielo, fondoX, fondoY, CIELO_W * 5 * escalaFondo, CIELO_H * 5 * escalaFondo);
}

