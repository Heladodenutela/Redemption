}

// "!" sobre quien tiene un evento contigo aquí y ahora
void dibujarMarcasEventos() {
  if (EVENTOS20 == null || actividad != ACT_NINGUNA || cel != 0) return;
  for (int k = 0; k < EVENTOS20.length; k++) {
    String[] e = EVENTOS20[k];
    if (e[10].equals("R")) {
      int f = personaIndice(e[1]);
      if (f >= 0 && agendaNPC != null && agendaNPC[f] >= 0) {
        int n = agendaNPC[f];
        if (npcMapa[n] == mapaActual && eventoActivo(k)) {
          float x = aPantallaX(npcX[n]);
          if (hay(ef_signo_evento)) {
            float sc = escalaPJ();
            int c = (cuadros / 8) % 4;
            float yCab = aPantallaY(pisoMapa[mapaActual]) - 240 * sc;
            image(ef_signo_evento, x - 20 * sc, yCab - 95 * sc, 40 * sc, 95 * sc, c * 40, 0, c * 40 + 40, 95);
          } else {
            float y = aPantallaY(pisoMapa[mapaActual]) - 250 * escalaPJ() + 6 * sin(cuadros * 0.1);
            noStroke();
            fill(0, 0, 0, 120);
            ellipse(x + 2, y + 2, 40, 40);
            fill(255, 200, 40);
            ellipse(x, y, 40, 40);
            fill(60, 30, 0);
            textSize(30);
            textAlign(CENTER, CENTER);
            text("!", x, y - 3);
            textAlign(LEFT, BASELINE);
          }
        }
      }
    }
  }
}

// Para el cuadro "AHORA": el evento más cercano que tienes hoy
String objetivoEvento() {
  if (EVENTOS20 == null) return null;
  int m = minutoAhora();
  String mejor = null;
  int mejorFalta = 9999;
  for (int k = 0; k < EVENTOS20.length; k++) {
    String[] e = EVENTOS20[k];
    if (evEstado[k] == 0 && diaEn(e[2], dia) && !e[9].equals("") && cumple(e[7]) && !(!evInvitado[k] && !e[11].equals(""))) {
      int a = aMin(e[3]), b = aMin(e[4]);
      if (m < b) {
        String lugar;
        if (e[5].equals("") || e[5].equals("*")) {
          lugar = "";
        } else {
          lugar = " · " + MAPA_NOMBRE[mapaPorCodigo(e[5])] + " (" + e[5] + ")";
        }
        if (m >= a) return "¡Ahora! " + e[9] + lugar + " · hasta las " + e[4];
        if (a - m < mejorFalta) { mejorFalta = a - m; mejor = e[9] + lugar + " · a las " + e[3]; }
      }
    }
  }
  if (mejorFalta <= 180) return mejor; else return null;
}

// Iris: cuando viviste sus cuatro historias
