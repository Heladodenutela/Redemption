void dibujarAvisosInteraccion() {
  if (actividad != ACT_NINGUNA || menuAbierto || cel != 0) return;
  String[] t = new String[4];
  if (newtonCerca() >= 0) agregarTexto(t, "[E] Acariciar a Newton");
