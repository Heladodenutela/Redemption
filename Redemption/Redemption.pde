// ---------------------------- Playlist ----------------------------
// Tres listas. Al tocar una, se corta la música que suena y empieza esa (dura 3 horas del juego).
// El efecto en los stats solo se gana una vez cada 3 horas, pero la música se puede cambiar cuando quieras.
// El cuarto botón quita la lista y vuelve la música de la zona.
String[] LISTAS = { "Para estudiar (lofi sin letra)", "Para entrenar (ritmo fuerte)", "Para bajar la ansiedad (calma)" };
String[] LISTAS_EFECTO = { "Notas +1", "Energía +4", "Energía +2 · Social +1" };
int[] LISTAS_TEMA = { 2, 5, 4 };
final int DURA_LISTA = 180;
final int ESPERA_EFECTO = 180;

// Portadas: extras/interfaz/1_celular/playlist_estudio.png, playlist_entrenar.png, playlist_calma.png (80x80)
String[] LISTAS_ARCHIVO = { "playlist_estudio", "playlist_entrenar", "playlist_calma" };
int[][] LISTAS_COLOR = { {90, 110, 170}, {210, 90, 60}, {90, 170, 160} };
PImage[] listasImg = new PImage[3];
boolean listasBuscadas = false;

// ¿Hay una lista sonando todavía?
boolean listaSuena() {
  return listaSonando > 0 && minutoAbs() < listaHasta;
}

// Pone la lista i (1 a 3): corta la música y, si ya pasaron 3 horas desde el último efecto, da el efecto
void ponerPlaylist(int i) {
  listaSonando = i;
  listaHasta = minutoAbs() + DURA_LISTA;
  playlist = i;
  cortarMusica = true;
  String apagada = "";
  if (!musicaOn) apagada = "  (la música está apagada en Ajustes)";
  if (minutoAbs() - playlistUlt < ESPERA_EFECTO) {
    aviso("Suena " + LISTAS[i - 1] + ". El efecto vuelve en " + (ESPERA_EFECTO - (minutoAbs() - playlistUlt)) + " min." + apagada);
    return;
  }
  playlistUlt = minutoAbs();
  aplicarEfectos(LISTAS_EFECTO[i - 1], -1);
  catMedios[CAT_REDES] += 2;
  avanzarTiempo(1);
  aviso("Pones " + LISTAS[i - 1] + "  (" + LISTAS_EFECTO[i - 1] + ")" + apagada);
  sumarBandera("PLAYLIST_" + i, 1);
}

// Quita la lista: vuelve la música del lugar donde estás
void quitarPlaylist() {
  if (!listaSuena()) { aviso("Ya suena la música del lugar."); return; }
  listaSonando = 0;
  cortarMusica = true;
  aviso("Quitaste la lista. Vuelve la música del lugar.");
}

final float LISTA_Y0 = 150, LISTA_PASO = 96;

// Dibuja la app Playlist: las 3 listas, la que suena y el botón para volver a la música del lugar.
