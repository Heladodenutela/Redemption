// ============================ 3. BALANZA (Álgebra) ============================
// Deja la x sola: elige el valor de x que equilibra la balanza (1-4 o click).
int balRondas, balRonda, balX, balBien, balMal, balFin, balInclina;
String balEcuacion = "";
int[] balOpciones = new int[4];

// Empieza la balanza: cuántas ecuaciones según el nivel.
void iniciarBalanza() {
  balRondas = min(5, 2 + nivelClase());
  balRonda = 0;
  balBien = 0;
  balMal = 0;
  balFin = millis() + BAL_SEGUNDOS * 1000;
  nuevaEcuacion();
}

// Inventa una ecuación al azar para la balanza.
void nuevaEcuacion() {
  balX = int(random(1, 10));
  int a = int(random(2, 6)), b = int(random(1, 10));
  if (nivelClase() >= 2) {
    int d = int(random(1, a));
    int e = (a - d) * balX + b;
    balEcuacion = a + "x + " + b + " = " + d + "x + " + e;
  } else {
    balEcuacion = a + "x + " + b + " = " + (a * balX + b);
  }

  int[] cambios = { -3, -2, -1, 1, 2, 3, 4, 5 };
  int bien = int(random(4));
  int desde = int(random(cambios.length));
  int usados = 0;
  for (int i = 0; i < 4; i++) {
    if (i == bien) { balOpciones[i] = balX; } else {
      int o = -1;
      while (o < 0) {
        o = balX + cambios[(desde + usados) % cambios.length];
        usados++;
      }
      balOpciones[i] = o;
    }
  }
  balInclina = 0;
}

// Dibuja la balanza con la ecuación y las 4 respuestas.
void dibujarBalanza() {
  noStroke();
  fill(245, 238, 225);
  rect(0, 0, ANCHO, ALTO);

  float ang = radians(balInclina);
  if (!balanzaConSprite(balInclina)) {
    stroke(90, 70, 50);
    strokeWeight(10);
    line(800, 560, 800, 380);
    pushMatrix();
    translate(800, 380);
    rotate(ang);
    line(-300, 0, 300, 0);
    popMatrix();
    strokeWeight(1);
    noStroke();
    fill(90, 70, 50);
    triangle(740, 600, 860, 600, 800, 540);
  }
  fill(30);
  textSize(54);
  textAlign(CENTER, CENTER);
  text(balEcuacion, 800, 250);
  textSize(24);
  text("x = ?", 800, 320);
  for (int i = 0; i < 4; i++) {
    float x = 380 + i * 220;
    boolean encima = mouseX > x && mouseX < x + 180 && mouseY > 660 && mouseY < 740;
    if (encima) fill(color(255, 220, 140)); else fill(color(255));
    rect(x, 660, 180, 80, 12);
    fill(30);
    textSize(34);
    text((i + 1) + ")  " + balOpciones[i], x + 90, 700);
  }
  int resto = max(0, (balFin - millis()) / 1000);
  textSize(26);
  text("BALANZA · ecuación " + (balRonda + 1) + " de " + balRondas + " · " + resto + " s", 800, 70);
  textAlign(LEFT, BASELINE);
  balInclina = balInclina * 9 / 10;
  if (balRonda >= balRondas || millis() > balFin) {
    int notas;
    if (balBien >= balRondas) {
      if (resto > 15) notas = 3 + 1; else notas = 3 + 0;
    } else {
      if (balBien > 0) notas = 1; else notas = 0;
    }
    if (balMal > 0) {
      terminarMinijuegoClase(notas, "Resolviste " + balBien + " de " + balRondas + " ecuaciones" + (" (" + balMal + " errores)."));
    } else {
      terminarMinijuegoClase(notas, "Resolviste " + balBien + " de " + balRondas + " ecuaciones" + ".");
    }
  }
}

// Elige una respuesta de la balanza: si es la x correcta, la balanza se equilibra.
void elegirBalanza(int i) {
  if (i < 0 || i > 3) return;
  if (balOpciones[i] == balX) {
    balBien++;
    balRonda++;
    if (balRonda < balRondas) nuevaEcuacion();
  } else {
    balMal++;
    if (balOpciones[i] > balX) balInclina = 18; else balInclina = -18;
    balFin -= 3000;
  }
}

// Click en una de las 4 respuestas de la balanza.
void clickBalanza() {
  for (int i = 0; i < 4; i++) {
    float x = 380 + i * 220;
    if (mouseX > x && mouseX < x + 180 && mouseY > 660 && mouseY < 740) elegirBalanza(i);
  }
}

// ============================ 4. CAZABICHOS (Programación) ============================
// Sobre el código salen bichos (mariquitas): dispárales con click. También salen cosas que
// NO son bichos (el café, el check verde, las llaves { }, el cursor): si les disparas, pierdes.
final int MAX_COSAS = 30;
float[][] cosas = new float[MAX_COSAS][7];
int bcCazados, bcEscapados, bcErrores, bcSiguiente, bcFin, bcFlash;
String[] CODIGO_FALSO = { "int notas = 0;", "for (int i = 0; i < n; i++) {", "  if (x > max) max = x;", "  suma += lista[i];", "}",
  "void setup() {", "  size(800, 600);", "  println(\"hola\");", "}", "while (vivo) dormir();", "return notas / n;" };

// Empieza el minijuego de Programación: atrapar los bichos (errores) del código.
void iniciarBichos() {
  for (int k = 0; k < MAX_COSAS; k++) cosas[k][6] = 0;
  bcCazados = 0;
  bcEscapados = 0;
  bcErrores = 0;
  bcSiguiente = millis() + 600;
  bcFin = millis() + BICHOS_SEGUNDOS * 1000;
}

// Dibuja la pantalla de código con los bichos moviéndose.
void dibujarBichos() {
  noStroke();
  fill(28, 30, 38);
  rect(0, 0, ANCHO, ALTO);

  textSize(26);
  textAlign(LEFT, BASELINE);
  for (int i = 0; i < CODIGO_FALSO.length; i++) {
    fill(110, 120, 140);
    text(nf(i + 1, 2), 200, 190 + i * 52);
    fill(170, 200, 230);
    text(CODIGO_FALSO[i], 270, 190 + i * 52);
  }

  int cada = int(BICHOS_CADA_MS / (0.8 + nivelClase() * 0.2));
  if (millis() < bcFin - 800 && millis() >= bcSiguiente) {
    for (int k = 0; k < MAX_COSAS; k++) {
      if (cosas[k][6] == 0) {
        cosas[k][0] = random(220, 1380);
        cosas[k][1] = random(150, 720);
        float v = 1.2 + nivelClase() * 0.5;
        cosas[k][2] = random(-v, v);
        cosas[k][3] = random(-v, v);
        cosas[k][4] = millis();
        if (random(1) < 0.62) cosas[k][5] = 0; else cosas[k][5] = 1 + int(random(4));
        cosas[k][6] = 1;
        break;
      }
    }
    bcSiguiente = millis() + cada;
  }
  for (int k = 0; k < MAX_COSAS; k++) {
    if (cosas[k][6] != 0) {
      if (millis() - cosas[k][4] > BICHOS_VIDA_MS) {
        cosas[k][6] = 0;
        if (cosas[k][5] == 0) bcEscapados++;
      } else {
        cosas[k][0] = constrain(cosas[k][0] + cosas[k][2] * pasoCuadro, 200, 1400);
        cosas[k][1] = constrain(cosas[k][1] + cosas[k][3] * pasoCuadro, 140, 740);
        if (cosas[k][0] <= 200 || cosas[k][0] >= 1400) cosas[k][2] *= -1;
        if (cosas[k][1] <= 140 || cosas[k][1] >= 740) cosas[k][3] *= -1;
        dibujarCosa(int(cosas[k][5]), cosas[k][0], cosas[k][1]);
      }
    }
  }

  stroke(255, 80, 80);
  strokeWeight(2);
  noFill();
  ellipse(mouseX, mouseY, 40, 40);
  line(mouseX - 28, mouseY, mouseX + 28, mouseY);
  line(mouseX, mouseY - 28, mouseX, mouseY + 28);
  strokeWeight(1);
  noStroke();
  if (millis() < bcFlash) { fill(255, 0, 0, 60); rect(0, 0, ANCHO, ALTO); }

  float p = constrain(1 - (bcFin - millis()) / (BICHOS_SEGUNDOS * 1000.0), 0, 1);
  fill(60);
  rect(200, 800, 1200, 20, 8);
  fill(230, 160, 80);
  rect(200, 800, 1200 * p, 20, 8);
  fill(255);
  textSize(22);
  text("Valdés se acerca a tu pantalla...", 200, 860);
  textSize(26);
  text("CAZABICHOS · dispárale a los bichos, ¡no al resto!   Cazados " + bcCazados + " · se escaparon " + bcEscapados + " · errores " + bcErrores, 200, 80);
  if (millis() > bcFin) {
    float r;
    if ((bcCazados + bcEscapados) == 0) r = 0; else r = bcCazados / (float) (bcCazados + bcEscapados) - bcErrores * 0.1;
    int notas;
    if (r >= 0.85) notas = 3; else if (r >= 0.5) notas = 1; else notas = 0;
    terminarMinijuegoClase(notas, "Cazaste " + bcCazados + " bichos, se escaparon " + bcEscapados + " y le disparaste a " + bcErrores + " cosas que no eran bichos.");
  }
}

// 0 mariquita, 1 café, 2 check verde, 3 llaves { }, 4 cursor
void dibujarCosa(int tipo, float x, float y) {
  if (cosaConSprite(tipo, x, y)) return;
  noStroke();
  if (tipo == 0) {
    fill(20);
    ellipse(x, y - 18, 22, 18);
    stroke(20);
    strokeWeight(2);
    line(x - 4, y - 26, x - 10, y - 34);
    line(x + 4, y - 26, x + 10, y - 34);
    noStroke();
    fill(220, 30, 30);
    ellipse(x, y, 44, 40);
    stroke(20);
    strokeWeight(2);
    line(x, y - 19, x, y + 19);
    noStroke();
    fill(20);
    ellipse(x - 11, y - 6, 9, 9);
    ellipse(x + 11, y - 6, 9, 9);
    ellipse(x - 9, y + 9, 8, 8);
    ellipse(x + 9, y + 9, 8, 8);
    strokeWeight(1);
  } else if (tipo == 1) {
    fill(240);
    rect(x - 18, y - 16, 34, 36, 4);
    fill(120, 70, 40);
    rect(x - 15, y - 12, 28, 10);
    noFill();
    stroke(240);
    strokeWeight(4);
    ellipse(x + 20, y + 2, 14, 16);
    strokeWeight(1);
    noStroke();
  } else if (tipo == 2) {
    fill(60, 190, 100);
    ellipse(x, y, 42, 42);
    stroke(255);
    strokeWeight(5);
    line(x - 10, y, x - 2, y + 9);
    line(x - 2, y + 9, x + 12, y - 9);
    strokeWeight(1);
    noStroke();
  } else if (tipo == 3) {
    fill(255, 210, 90);
    textSize(40);
    textAlign(CENTER, CENTER);
    text("{ }", x, y);
    textAlign(LEFT, BASELINE);
  } else {
    fill(255);
    triangle(x - 10, y - 18, x - 10, y + 16, x + 14, y + 6);
  }
}

// Click: atrapa el bicho más cercano al mouse.
void clickBichos() {
  int mejor = -1;
  float md = 32;
  for (int k = 0; k < MAX_COSAS; k++) {
    if (cosas[k][6] != 0) {
      float d = dist(mouseX, mouseY, cosas[k][0], cosas[k][1]);
      if (d < md) { md = d; mejor = k; }
    }
  }
  if (mejor < 0) return;
  cosas[mejor][6] = 0;
  if (cosas[mejor][5] == 0) bcCazados++;
  else { bcErrores++; bcFlash = millis() + 200; }
}

// ============================ 5. PÉNDULO (Laboratorio) ============================
// ESPACIO justo cuando el péndulo pasa por la franja verde del centro.
int peIntentos, peAciertos, peInicio, peEspera;
String peMensaje = "";

// Empieza el péndulo del laboratorio.
void iniciarPendulo() {
  peIntentos = 0;
  peAciertos = 0;
  peInicio = millis();
  peEspera = 0;
  peMensaje = "ESPACIO cuando pase por el centro";
}

// Ángulo del péndulo ahora (oscila más rápido en niveles altos).
float anguloPendulo() {
  float w = 0.0025 + nivelClase() * 0.0006;
  return 50 * sin((millis() - peInicio) * w);
}

// Dibuja el péndulo y la zona del centro.
void dibujarPendulo() {
  noStroke();
  fill(235, 240, 245);
  rect(0, 0, ANCHO, ALTO);
  fill(150, 230, 150, 160);
  arc(800, 150, 1000, 1000, HALF_PI - radians(6), HALF_PI + radians(6));
  float a = radians(anguloPendulo());
  float bx = 800 + sin(a) * 480, by = 150 + cos(a) * 480;
  if (!penduloConSprite(a)) {
    stroke(60);
    strokeWeight(4);
    line(800, 150, bx, by);
    strokeWeight(1);
    noStroke();
    fill(70, 90, 160);
    ellipse(bx, by, 70, 70);
  }
  fill(60);
  rect(640, 130, 320, 24, 6);
  fill(30);
  textSize(26);
  textAlign(CENTER, BASELINE);
  text("PÉNDULO · aciertos " + peAciertos + " de " + peIntentos + " (" + PENDULO_INTENTOS + " intentos)", 800, 70);
  text(peMensaje, 800, 760);
  textAlign(LEFT, BASELINE);
  if (peIntentos >= PENDULO_INTENTOS && millis() > peEspera) {
    int notas;
    if (peAciertos >= 4) notas = 3; else if (peAciertos >= 2) notas = 1; else notas = 0;
    terminarMinijuegoClase(notas, peAciertos + " de " + PENDULO_INTENTOS + " mediciones en el centro.");
  }
}

// ESPACIO: acierta si el péndulo pasa por el centro en ese momento.
void teclaPendulo() {
  if (key != ' ' || millis() < peEspera || peIntentos >= PENDULO_INTENTOS) return;
  peIntentos++;
  boolean bien = abs(anguloPendulo()) < 6;
  if (bien) peAciertos++;
  if (bien) {
    peMensaje = "¡Medición perfecta!";
  } else {
    if (anguloPendulo() > 0) peMensaje = "Muy " + "a la derecha"; else peMensaje = "Muy " + "a la izquierda";
  }
  peEspera = millis() + 350;
}

// ============================ ENGANCHES (los llama el núcleo) ============================
// Teclas de los minijuegos de clase (tiro, péndulo, balanza...).
boolean teclasActividad4() {
  boolean usar = key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN;
  if (actividad == ACT_CLASE_JUEGO) {
    if (mjActual == MJ_PROYECTIL) teclaProyectil();
    else if (mjActual == MJ_PENDULO) teclaPendulo();
    else if (mjActual == MJ_BALANZA && key >= '1' && key <= '4') elegirBalanza(key - '1');
    else {
      boolean aux1;
      if (mjActual == MJ_PENDIENTE && key >= '1') {
        if (prDoble) aux1 = key <= '2'; else aux1 = key <= '3';
      } else {
        aux1 = false;
      }
      if (aux1) elegirPendiente(key - '1');
      else if (mjActual == MJ_CALCULO) teclaCalculo();
    }
    return true;
  }
  if (actividad == ACT_CLASE_RES) { if (usar) despuesDelResultado(); return true; }
  if (actividad == ACT_CINEMATICA) {
    if (!cinRespondida && key >= '1' && key <= '5') elegirEnCinematica(key - '1');
    else if (cinRespondida && usar) siguienteEscena();
    return true;
  }
  return false;
}

// Clicks de los minijuegos de clase.
boolean clickActividad4() {
  if (actividad == ACT_CLASE_JUEGO) {
    if (mjActual == MJ_PENDIENTE) clickPendiente();
    else if (mjActual == MJ_BALANZA) clickBalanza();
    else if (mjActual == MJ_BICHOS) clickBichos();
    else if (mjActual == MJ_CALCULO) clickCalculo();
    return true;
  }
  if (actividad == ACT_CLASE_RES) { despuesDelResultado(); return true; }
  if (actividad == ACT_CINEMATICA) {
    if (!cinRespondida) { int i = cinOpcionBajoMouse(); if (i >= 0) elegirEnCinematica(i); }
    else siguienteEscena();
    return true;
  }
  return false;
}

// Dibuja el minijuego de clase que esté abierto.
boolean dibujarActividad4() {
  if (actividad == ACT_CLASE_JUEGO) {
    if (mjActual == MJ_PROYECTIL) dibujarProyectil();
    else if (mjActual == MJ_PENDIENTE) dibujarPendiente();
    else if (mjActual == MJ_BALANZA) dibujarBalanza();
    else if (mjActual == MJ_BICHOS) dibujarBichos();
    else if (mjActual == MJ_CALCULO) dibujarCalculo();
    else dibujarPendulo();
    return true;
  }
  if (actividad == ACT_CLASE_RES) { dibujarClaseRes(); return true; }
  if (actividad == ACT_CINEMATICA) { dibujarCinematica(); return true; }
  return false;
}

