  fill(110);
  textSize(15);
  textAlign(LEFT, TOP);
  float yt = yq + 84;
  if (suena) {
    text("Suena: " + LISTAS[listaSonando - 1] + " · quedan " + (listaHasta - minutoAbs()) + " min.", celX1 + 40, yt);
    yt += 26;
  }
  if (!efectoListo) text("El efecto de las listas vuelve en " + (ESPERA_EFECTO - (minutoAbs() - playlistUlt)) + " min.", celX1 + 40, yt);
  textAlign(LEFT, BASELINE);
}

// ---------------------------- Batería ----------------------------
// Dibuja la app Batería con la carga del celular.
void dibujarBateria() {
  encabezadoCel("Batería", 95, 100, 125);
  int b = int(bateria);
  noStroke();
  fill(225);
  rect(celX1 + 60, celY1 + MSG_HEAD + 50, celX2 - celX1 - 120, 70, 12);
  if (b > 40) fill(color(70, 170, 90)); else if (b > 15) fill(color(230, 170, 50)); else fill(color(210, 60, 60));
  rect(celX1 + 64, celY1 + MSG_HEAD + 54, (celX2 - celX1 - 128) * b / 100.0, 62, 10);
  fill(40);
  textSize(30);
  textAlign(CENTER, CENTER);
  text(b + " %", (celX1 + celX2) / 2, celY1 + MSG_HEAD + 85);
  textAlign(LEFT, TOP);
  fill(70);
  textSize(18);
  text("Pantalla hoy: " + (stats[ST_PANTALLA] / 60) + " h " + nf(stats[ST_PANTALLA] % 60, 2) + " min", celX1 + 50, celY1 + 230);
  text("Se carga sola cuando estás en tu casa\ny se llena mientras duermes.", celX1 + 50, celY1 + 270);
  text("Con el celular abierto gasta mucho más.\nSi llega a 0 %, se apaga hasta que lo cargues.", celX1 + 50, celY1 + 340);
  if (b <= 15) {
    fill(210, 60, 60);
    text("¡Batería baja! Busca una casa donde cargarlo.", celX1 + 50, celY1 + 430);
  }
  textAlign(LEFT, BASELINE);
}

// ============================ RELOJ DE LAS APPS (cada intervalo de 30 s de juego) ============================
int ofertaDia = 0, busLlenoDia = 0, visitaDia = 0;
String enfermoHoy = "";
int ofertaAvisada = 0;

// Cada avance del reloj: desbloquea fotos de la galería (cada 5 minutos o al cambiar de mapa) y gasta batería.
void tickApps4() {
  if (bloqueCincoMin() != galeriaBloque || mapaActual != galeriaMapa) {
    galeriaBloque = bloqueCincoMin();
    galeriaMapa = mapaActual;
    revisarGaleria();
  }

  boolean enCasa = empiezaCon(MAPA_COD[mapaActual], "C");
  if (enCasa) bateria = min(100, bateria + 0.12);
  else if (cel != 0) bateria = max(0, bateria - 0.14); else bateria = max(0, bateria - 0.012);
  if (bateria <= 0 && cel != 0) {
    cel = 0;
    aviso("Se apagó el celular: sin batería. Cárgalo en tu casa.");
    anotarDiario("Me quedé sin batería. Aprendí a mirar el porcentaje antes de abrir las redes.");
  }
  if (bateria < 15 && bateria > 14.8) aviso("Batería baja (15 %). Busca dónde cargar.");

  if (ofertaDia == dia && ofertaAvisada != dia && minutoAhora() >= 12 * 60) {
    ofertaAvisada = dia;
    aviso("Pedidazo: envío gratis solo por hoy.");
  }
}

// Al empezar un día: carga la batería y aplica lo de compartir la ubicación con Mamá.
void nuevoDiaApps4() {
  bateria = 100;

  if (ubicacionCompartida) {
    int mama = personaIndice("Mamá (Claudia)");
    if (faltas > faltasAlAmanecer) {
      if (mama >= 0) cambiarAmistad(mama, -4);
      anotarDiario("Mamá vio en el mapa que no estaba en la U. Hablamos largo.");
    } else if (mama >= 0) {
      cambiarAmistad(mama, 1);
    }
  }
  faltasAlAmanecer = faltas;

  enfermoHoy = "";
  if (dia >= 2 && dia <= 9) {
    if (random(1) < 0.30) {
      String[] c = { "Nico, el del café", "Don Pablo, jardinero", "Doña Mery, empanadas", "Marlene, bibliotecaria", "Don Fabio, árbitro", "Pili, aficionada", "Marcela, fisioterapeuta", "Esteban, corredor", "Iván, el de la guitarra" };
      enfermoHoy = c[int(random(c.length))];
      partirPorLetra(enfermoHoy, ',');
      String[] aux1 = resPartirPorLetra;
      anotarDiario("Hoy no vino " + aux1[0] + ": dicen que amaneció enfermo.");
      partirPorLetra(enfermoHoy, ',');
      String[] aux2 = resPartirPorLetra;
      aviso("Hoy " + aux2[0] + " no vino: amaneció enfermo.");
    }
    if (random(1) < 0.30) { busLlenoDia = dia; anotarDiario("El bus iba llenísimo hoy."); }
    if (random(1) < 0.25) { ofertaDia = dia; }
  }
  if (dia >= 3 && dia <= 8 && visitaDia != dia && random(1) < 0.30) {
    String v = visitaPosible();
    if (v != null) { sumarBandera(v, 1); visitaDia = dia; }
  }
}

// ============================ NOTAS DE VOZ Y "VISTO" ============================
int[] vozPend = new int[MSG_FILAS];

// Un mensaje que empieza con "[voz] " es una nota de voz: dura según lo largo; escucharla gasta ese tiempo
String textoVoz(String t) {
  String r = quitarBordes(t.substring(5));
  int seg = 6 + r.length() / 4;
  return "> Nota de voz  0:" + nf(min(seg, 59), 2) + "\n" + "“" + r + "”";
}

// Escucha las notas de voz pendientes de un chat.
void escucharVoces(int fila) {
  if (fila < 0 || fila >= vozPend.length || vozPend[fila] <= 0) return;
  int n = vozPend[fila];
  vozPend[fila] = 0;
  avanzarTiempo(n);
  catMedios[CAT_REDES] += 2 * n;
  if (n == 1) {
    aviso("Escuchaste " + n + " nota de voz" + " (" + n + " min)");
  } else {
    aviso("Escuchaste " + n + " notas de voz" + " (" + n + " min)");
  }
}

// Leído pero sin contestar
boolean vistoSinResponder(int f) {
  return f >= 0 && f < MSG_FILAS && msgPendiente[f] >= 0 && noLeidos[f] == 0;
}

