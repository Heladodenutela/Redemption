// ============================ DIÁLOGOS DIARIOS ============================
// Cada persona tiene sus charlas numeradas: la 1 sale el primer día que le hablas, la 2 el segundo
// día distinto, y así (si ese día no tiene ya una charla de su historia). Cada número puede tener varias
// versiones según lo que ha pasado (amistad, romance, lo que le contestaste antes): sale la primera cuya
// condición se cumple. Los que se presentan en la 1 (SE_PRESENTAN) se la saltan si ya se conocían.
// Los textos están en las tablas DIALOGOS_* (sección TEXTOS), una línea por cosa:
// @Persona
// #número¦id¦condición¦lo que dice
// >condición de la opción¦lo que dices tú¦efectos¦lo que te contesta (con // se parte en dos globos)
// en vez del número puede ir un nivel de amistad: #A60 (ya son amigos), #A80 (muy cercanos),
// #BAJA (fueron amigos y la amistad se cayó). Esos salen una sola vez, apenas se cumple, antes que el del día.
int dN = 0, dOpN = 0;
int[] dNodoP, dNodoN, dOpIni, dOpFin;
String[] dNodoId, dNodoCond, dNodoLinea, dOpCond, dOpTexto, dOpEf, dOpReac, dNodoHito;

// Lee los diálogos diarios de cada persona desde sus textos (una sola vez).
void leerDiario() {
  if (dNodoP != null) return;

  bloquesDiario();
  String[] base = resBloquesDiario;
  String[] bloques = new String[base.length + DIALOGOS_V22.length];
  for (int i = 0; i < base.length; i++) bloques[i] = base[i];
  for (int i = 0; i < DIALOGOS_V22.length; i++) bloques[base.length + i] = DIALOGOS_V22[i];
  int nn = 0, no = 0;
  for (int b = 0; b < bloques.length; b++) {
    partirPorLetra(bloques[b], '\n');
    String[] L = resPartirPorLetra;
    for (int i = 0; i < L.length; i++) {
      String l = quitarBordesProcessing(L[i]);
      if (empiezaCon(l, "#")) nn++;
      else if (empiezaCon(l, ">")) no++;
    }
  }
  dNodoP = new int[nn]; dNodoN = new int[nn]; dOpIni = new int[nn]; dOpFin = new int[nn];
  dNodoId = new String[nn]; dNodoCond = new String[nn]; dNodoLinea = new String[nn]; dNodoHito = new String[nn];
  dOpCond = new String[no]; dOpTexto = new String[no]; dOpEf = new String[no]; dOpReac = new String[no];
  dN = 0;
  dOpN = 0;
  int p = -1;
  for (int b = 0; b < bloques.length; b++) {
    partirPorLetra(bloques[b], '\n');
    String[] L = resPartirPorLetra;
    for (int i = 0; i < L.length; i++) {
      String l = quitarBordesProcessing(L[i]);
      if (l.length() != 0) {
        char c = letraEn(l, 0);
        boolean seguir11 = true;
        if (c == '@') {
          p = personaIndice(quitarBordesProcessing(l.substring(1)));
        } else if (c == '#') {
          partirPorLetra(l.substring(1), '¦');
          String[] q = resPartirPorLetra;
          if (q.length < 4) { seguir11 = false; }
          if (seguir11) {
            dNodoP[dN] = p;
            String num = quitarBordesProcessing(q[0]);
            dNodoHito[dN] = "";
            if (empiezaCon(num, "A") || empiezaCon(num, "B")) { dNodoHito[dN] = num; num = "0"; }
            dNodoN[dN] = int(num);
            dNodoId[dN] = quitarBordesProcessing(q[1]);
            dNodoCond[dN] = quitarBordesProcessing(q[2]);
            dNodoLinea[dN] = quitarBordesProcessing(q[3]);
            dOpIni[dN] = dOpN;
            dOpFin[dN] = dOpN;
            dN++;
          }
        } else if (c == '>' && dN > 0) {
          partirPorLetra(l.substring(1), '¦');
          String[] q = resPartirPorLetra;
          if (q.length < 4) { seguir11 = false; }
          if (seguir11) {
            dOpCond[dOpN] = quitarBordesProcessing(q[0]);
            dOpTexto[dOpN] = quitarBordesProcessing(q[1]);
            dOpEf[dOpN] = quitarBordesProcessing(q[2]);
            dOpReac[dOpN] = quitarBordesProcessing(q[3]);
            dOpN++;
            dOpFin[dN - 1] = dOpN;
          }
        }
      }
    }
  }
}

// Quienes se presentan en su primer diálogo diario ("Bienvenido a...", "Hola, soy la de...").
