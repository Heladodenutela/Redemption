// Click en un ícono de la cuarta fila de apps.
boolean clickIconosCelular4() {
  for (int k = 0; k < APPS4.length; k++) {
    float x = 530 + k * 100, y = 440;
    if (mouseX >= x && mouseX <= x + 80 && mouseY >= y && mouseY <= y + 80) {
      cel = APPS4_CEL[k];
      return true;
    }
  }
  return false;
}

