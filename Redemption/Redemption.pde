// ---- convertir valores a texto y de vuelta ----
// Los textos se "escapan" para que no tengan los separadores: \ -> \\, | -> \p, ; -> \s, salto -> \n
// Un texto que no existe (null) se guarda como \N
String escaparTexto(String s) {
  if (s == null) return "\\N";
  return s.replace("\\", "\\\\").replace("|", "\\p").replace(";", "\\s").replace("\n", "\\n").replace("\r", "\\r");
}

// Deshace escaparTexto: salta de \ en \ (con posicionDeDesde) sin revisar letra por letra
String desescaparTexto(String s) {
  if (s.equals("\\N")) return null;
  int i = posicionDe(s, "\\");
  if (i < 0) return s;
  String r = "";
  int desde = 0;
  while (i >= 0 && i + 1 < s.length()) {
    String c = s.substring(i + 1, i + 2);
    String e = c;
    if (c.equals("p")) e = "|";
    else if (c.equals("s")) e = ";";
    else if (c.equals("n")) e = "\n";
    else if (c.equals("r")) e = "\r";
    r = r + s.substring(desde, i) + e;
    desde = i + 2;
    i = posicionDeDesde(s, "\\", desde);
  }
  return r + s.substring(desde);
}

// Guarda un tiempo de millis() como 'cuánto falta', para que siga bien al cargar otro día.
String tiempoAGuardar(int t) {
  if (t <= 0) return "" + t;
  return "~" + (t - millis());
}

// Vuelve a convertir en millis() un tiempo guardado como 'cuánto falta'.
int tiempoCargado(String v) {
  if (!empiezaCon(v, "~")) return int(v);
  return max(1, millis() + int(v.substring(1)));
}

// Vectores: "cuántos:valor|valor|valor", tablas: "filas;fila;fila" (cada fila como un vector)
String guardarInts(int[] a) {
  if (a == null) return "\\N";
  String[] t = new String[a.length];
  for (int i = 0; i < a.length; i++) t[i] = "" + a[i];
  return a.length + ":" + juntar(t, "|");
}

// Pasa un vector de decimales a texto para el archivo.
String guardarFloats(float[] a) {
  if (a == null) return "\\N";
  String[] t = new String[a.length];
  for (int i = 0; i < a.length; i++) t[i] = "" + a[i];
  return a.length + ":" + juntar(t, "|");
}

// Pasa un vector de verdadero/falso a texto para el archivo.
String guardarBools(boolean[] a) {
  if (a == null) return "\\N";
  String[] t = new String[a.length];
  for (int i = 0; i < a.length; i++) {
    if (a[i]) t[i] = "1";
    else t[i] = "0";
  }
  return a.length + ":" + juntar(t, "|");
}

// Pasa un vector de textos a texto para el archivo (escapando los separadores).
String guardarTextos(String[] a) {
  if (a == null) return "\\N";
  String[] t = new String[a.length];
  for (int i = 0; i < a.length; i++) t[i] = escaparTexto(a[i]);
  return a.length + ":" + juntar(t, "|");
}

// Pasa un vector de letras a texto para el archivo.
String guardarChars(char[] a) {
  if (a == null) return "\\N";
  String[] t = new String[a.length];
  for (int i = 0; i < a.length; i++) t[i] = "" + int(a[i]);
  return a.length + ":" + juntar(t, "|");
}

// Pasa una tabla de enteros a texto para el archivo.
String guardarTablaInts(int[][] a) {
  if (a == null) return "\\N";
  String[] f = new String[a.length + 1];
  f[0] = "" + a.length;
  for (int i = 0; i < a.length; i++) f[i + 1] = guardarInts(a[i]);
  return juntar(f, ";");
}

// Pasa una tabla de decimales a texto para el archivo.
String guardarTablaFloats(float[][] a) {
  if (a == null) return "\\N";
  String[] f = new String[a.length + 1];
  f[0] = "" + a.length;
  for (int i = 0; i < a.length; i++) f[i + 1] = guardarFloats(a[i]);
  return juntar(f, ";");
}

// Pasa una tabla de verdadero/falso a texto para el archivo.
String guardarTablaBools(boolean[][] a) {
  if (a == null) return "\\N";
  String[] f = new String[a.length + 1];
  f[0] = "" + a.length;
  for (int i = 0; i < a.length; i++) f[i + 1] = guardarBools(a[i]);
  return juntar(f, ";");
}

// Pasa una tabla de textos a texto para el archivo.
String guardarTablaTextos(String[][] a) {
  if (a == null) return "\\N";
  String[] f = new String[a.length + 1];
  f[0] = "" + a.length;
  for (int i = 0; i < a.length; i++) f[i + 1] = guardarTextos(a[i]);
  return juntar(f, ";");
}

// Pasa una tabla de letras a texto para el archivo.
String guardarTablaChars(char[][] a) {
  if (a == null) return "\\N";
  String[] f = new String[a.length + 1];
  f[0] = "" + a.length;
  for (int i = 0; i < a.length; i++) f[i + 1] = guardarChars(a[i]);
