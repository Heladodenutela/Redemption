    fill(210, 205, 190);
    rect(CAJA_X + 28, CAJA_Y + 28, 192, 192, 10);
  }
  if (dibujarRetratoExpr()) { }
  else if (hoja != null && hoja.width > 1) {
    float rx = col * PJ_CW + recorte[0], ry = fila * PJ_CH + recorte[1], rl = recorte[2];
    image(hoja, CAJA_X + 32, CAJA_Y + 32, 184, 184, int(rx), int(ry), int(rx + rl), int(ry + rl));
  }
