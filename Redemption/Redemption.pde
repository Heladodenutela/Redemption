// Si un entrenador ya te vio jugar, te invita al Club del Deporte.
void revisarClub() {
  if (bandera("CLUB_INVITADO") > 0 || charlaHoy == null) return;
  for (int i = 0; i < 4; i++) {
    int f = personaIndice(COACHES[i]);
    if (f >= 0 && charlaHoy[f] && !coachHoy[i]) { coachHoy[i] = true; coachDias++; }
  }
  if (bandera("INSCRITO_COPA") > 0 || bandera("CLUB_RUGBY") > 0 || coachDias >= 2) sumarBandera("CLUB_INVITADO", 1);
}

// Un mal día (perder en la Copa, dormir mal, notas bajas, pelear en la casa, el rumor) te deja vulnerable
void revisarEstres() {
  if (bandera("ESTRES") > 0) return;
  boolean perdio = false;
  for (int k = 0; k < copaEstado.length; k++) if (copaEstado[k] == 2) perdio = true;
  int mama = personaIndice("Mamá (Claudia)");
  boolean rumor = dia == 8 && minutoAhora() > 13 * 60 && bandera("RUMOR_RESUELTO") <= 0;
  if (perdio || deudaSueno >= 2 || stats[ST_NOTAS] < 40 || (mama >= 0 && amistad[mama] < 30) || rumor) sumarBandera("ESTRES", 1);
}

// Si decidiste dejarlo y pasas un día sin fumar ni tomar, el VICIO baja
int vicioAlEmpezarDia = 0;

// Si quieres dejar el vicio y hoy no fumaste, baja un poco.
void revisarDejarVicio() {
  int v = bandera("VICIO");
  if (bandera("QUIERE_DEJAR") > 0 && v > 0 && v <= vicioAlEmpezarDia) {
