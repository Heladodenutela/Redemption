// Dibuja un botón del título (apagado si no se puede usar).
void botonTitulo(float x, float y, float w, float h, String t, boolean activo) {
  boolean enc = activo && menuRanuras == 0 && mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + h;
  noStroke();
  if (!activo) fill(40, 40, 60, 150);
  else if (enc) fill(110, 80, 200);
  else fill(50, 60, 100, 230);
  rect(x, y, w, h, 12);
  if (activo) fill(255);
  else fill(150);
  textSize(24);
  textAlign(CENTER, CENTER);
  text(t, x + w / 2, y + h / 2 - 2);
  textAlign(LEFT, BASELINE);
}

