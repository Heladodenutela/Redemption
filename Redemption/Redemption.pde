PImage tituloVentana;

// Vuelve transparente el vidrio azul de la ventana del título para ver las estrellas detrás
void prepararTitulo() {
  if (ui_tituloSinBoton == null) return;
  tituloVentana = createImage(ui_tituloSinBoton.width, ui_tituloSinBoton.height, ARGB);
  ui_tituloSinBoton.loadPixels();
  tituloVentana.loadPixels();
  for (int y = 0; y < tituloVentana.height; y++) {
    for (int x = 0; x < tituloVentana.width; x++) {
      int i = y * tituloVentana.width + x;
      int c = ui_tituloSinBoton.pixels[i];
      boolean vidrio = x >= 700 && x <= 900 && y >= 215 && y <= 420
        && ((red(c) == 138 && green(c) == 168 && blue(c) == 222) || (red(c) == 160 && green(c) == 188 && blue(c) == 236)) && alpha(c) == 255;
      if (vidrio) tituloVentana.pixels[i] = color(0, 0, 0, 0); else tituloVentana.pixels[i] = c;
    }
  }
  tituloVentana.updatePixels();
}

