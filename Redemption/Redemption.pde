final float GAL_X = 536, GAL_W = 164, GAL_H = 92, GAL_FILA = 126, GAL_SEP = 10;

// Altura donde empieza la cuadrícula de la galería.
float galY0() { return celY1 + MSG_HEAD + 60; }

// Dibuja el fondo y el título de la galería.
void cabeceraGaleria(String t) {
  noStroke();
  fill(248, 246, 250);
  rect(celX1, celY1, celX2 - celX1, celY2 - celY1);
  fill(200, 80, 125);
  rect(celX1, celY1, celX2 - celX1, MSG_HEAD);
  fill(255);
  textSize(34);
  textAlign(LEFT, CENTER);
  text("<", celX1 + 18, celY1 + MSG_HEAD / 2 - 2);
  textSize(26);
  text(recortarA(t, 330), celX1 + 56, celY1 + MSG_HEAD / 2);
  boolean enc = enBoton(celX2 - 112, celY1 + 16, 96, 38);
  if (enc) fill(color(255, 255, 255, 90)); else fill(color(255, 255, 255, 50));
  rect(celX2 - 112, celY1 + 16, 96, 38, 19);
  fill(255);
  textSize(18);
  textAlign(CENTER, CENTER);
  text("Salir", celX2 - 64, celY1 + 34);
  textAlign(LEFT, BASELINE);
}

// Dibuja la galería: las fotos desbloqueadas y las que faltan con candado.
void dibujarGaleria() {
  iniciarGaleriaSiFalta();
  if (galVer >= 0) { dibujarFotoGaleria(galVer); return; }
  cabeceraGaleria("Galería · " + fotosDesbloqueadas() + "/" + fotosEnGaleria());

  for (int i = 0; i < GAL_FILTROS.length; i++) {
    float x = celX1 + 16 + i * 176, y = celY1 + MSG_HEAD + 12;
    noStroke();
    if (i == galFiltro) {
      fill(color(200, 80, 125));
    } else {
      if (enBoton(x, y, 164, 36)) fill(color(236, 222, 232)); else fill(color(230, 226, 234));
    }
    rect(x, y, 164, 36, 18);
    if (i == galFiltro) fill(255); else fill(70);
    textSize(17);
    textAlign(CENTER, CENTER);
    text(GAL_FILTROS[i], x + 82, y + 17);
  }
  galLista();
  int[] l = resGalLista;
  int n = tamInt(l);
  int paginas = max(1, (n + GAL_POR_PAG - 1) / GAL_POR_PAG);
  galPagina = constrain(galPagina, 0, paginas - 1);
  if (n == 0) {
    fill(120);
    textSize(18);
    textAlign(CENTER, CENTER);
    if (galFiltro == 2) {
      text("Todavía no has subido ninguna foto.", (celX1 + celX2) / 2, celY1 + 360);
    } else {
      text("No tienes fotos nuevas. Sal a vivir el día.", (celX1 + celX2) / 2, celY1 + 360);
    }
  }
  for (int i = 0; i < GAL_POR_PAG; i++) {
    int idx = galPagina * GAL_POR_PAG + i + 1;
    if (idx > n) break;
    int k = l[idx];
    float x = GAL_X + (i % 3) * (GAL_W + GAL_SEP), y = galY0() + (i / 3) * GAL_FILA;
    boolean enc = enBoton(x, y, GAL_W, GAL_H + 22);
    if (galDesbloq[k]) {
      miniatura(k, x, y, GAL_W, GAL_H);
      if (!galVista[k]) etiquetaGal(x + 6, y + 6, "NUEVA", color(230, 70, 120));
      if (galSubida[k]) etiquetaGal(x + 6, y + GAL_H - 26, galLikes[k] + " me gusta", color(40, 40, 50, 200));
      fill(50);
      textSize(13);
      textAlign(LEFT, TOP);
      text(recortarA(FOTOS_GALERIA[k][FG_TIT], GAL_W), x, y + GAL_H + 4);
    } else {
      noStroke();
      fill(52, 52, 64);
      rect(x, y, GAL_W, GAL_H, 6);
      candado(x + GAL_W / 2, y + GAL_H / 2 - 4, 34);
      fill(150);
      textSize(13);
      textAlign(LEFT, TOP);
      text("???", x, y + GAL_H + 4);
    }
    if (enc) { noFill(); stroke(200, 80, 125); strokeWeight(3); rect(x - 2, y - 2, GAL_W + 4, GAL_H + 4, 7); noStroke(); strokeWeight(1); }
  }

  float py = celY2 - 52;
  if (galPagina > 0) botonCel(celX1 + 16, py, 70, 40, "<", color(200, 80, 125));
  if (galPagina < paginas - 1) botonCel(celX2 - 86, py, 70, 40, ">", color(200, 80, 125));
  fill(90);
  textSize(17);
  textAlign(CENTER, CENTER);
  text("Página " + (galPagina + 1) + " de " + paginas, (celX1 + celX2) / 2, py + 19);
  textAlign(LEFT, BASELINE);
}

// Dibuja una etiqueta pequeña sobre una foto ('Subida', 'Nueva').
void etiquetaGal(float x, float y, String t, int c) {
  textSize(12);
  noStroke();
  fill(c);
  rect(x, y, textWidth(t) + 14, 20, 10);
  fill(255);
  textAlign(LEFT, CENTER);
  text(t, x + 7, y + 9);
  textAlign(LEFT, BASELINE);
}

// Una foto en grande
void dibujarFotoGaleria(int k) {
  if (galDesbloq[k]) cabeceraGaleria(FOTOS_GALERIA[k][FG_TIT]); else cabeceraGaleria("Foto bloqueada");
  float x = celX1 + 16, y = celY1 + MSG_HEAD + 16, w = celX2 - celX1 - 32, h = w * 9 / 16;
  if (galDesbloq[k]) {
    galVista[k] = true;
    miniatura(k, x, y, w, h);
  } else {
    noStroke();
    fill(52, 52, 64);
    rect(x, y, w, h, 8);
    candado(x + w / 2, y + h / 2 - 6, 70);
  }

  galLista();
  int[] l = resGalLista;
  int pos = posEnLista(l, k);
  if (pos > 1) flechaFoto(x + 8, y + h / 2 - 24, "<");
  if (pos > 0 && pos < tamInt(l)) flechaFoto(x + w - 52, y + h / 2 - 24, ">");
  float ty = y + h + 34;
  textAlign(LEFT, TOP);
  if (!galDesbloq[k]) {
    fill(60);
    textSize(19);
    text("Cómo conseguirla:", x, ty - 10);
    fill(90);
    textSize(18);
    text(FOTOS_GALERIA[k][FG_PISTA], x, ty + 20, w, 80);
  } else {
    String salen = FOTOS_GALERIA[k][FG_SALEN];
    fill(90);
    textSize(17);
    if (salen.equals("")) {
      text("No sale nadie más.", x, ty - 10);
    } else {
      text("Salen: " + salen.replace("/", ", "), x, ty - 10);
    }
    if (galSubida[k]) {
      fill(200, 80, 125);
      textSize(18);
      text("En tu perfil · " + galLikes[k] + " me gusta", x, ty + 18);
      fill(60);
      textSize(17);
      text("“" + galPie[k] + "”", x, ty + 46, w, 60);
    } else {
      fill(110);
      textSize(16);
      text("Todavía no la subes. Antes de subirla eliges filtro, recorte, pie de foto y a quién etiquetas.", x, ty + 18, w, 60);
      botonCel(x, celY2 - 150, w, 62, "Editar y subir a Aurora+", color(110, 80, 200));
    }
  }
  textAlign(LEFT, BASELINE);
  botonCel(x, celY2 - 74, w, 54, "Volver a la galería", color(150, 145, 160));
}

// Dibuja una flecha para pasar de foto.
void flechaFoto(float x, float y, String t) {
  noStroke();
  if (enBoton(x, y, 44, 48)) fill(0, 0, 0, 150); else fill(0, 0, 0, 90);
  rect(x, y, 44, 48, 10);
  fill(255);
  textSize(28);
  textAlign(CENTER, CENTER);
  text(t, x + 22, y + 21);
  textAlign(LEFT, BASELINE);
}

// Posición de una foto en la lista de la galería.
int posEnLista(int[] l, int k) {
  for (int i = 1; i <= tamInt(l); i++) if (l[i] == k) return i;
  return 0;
}

// Clicks en la galería: abrir una foto, pasar, subirla o volver.
void clickGaleria() {
  iniciarGaleriaSiFalta();

  if (enBoton(celX2 - 112, celY1 + 16, 96, 38)) { cel = 1; galVer = -1; return; }
  if (enBoton(celX1, celY1, 70, MSG_HEAD)) { if (galVer >= 0) galVer = -1; else cel = 1; return; }
  if (galVer >= 0) { clickFotoGaleria(galVer); return; }
  for (int i = 0; i < GAL_FILTROS.length; i++) {
    if (enBoton(celX1 + 16 + i * 176, celY1 + MSG_HEAD + 12, 164, 36)) { galFiltro = i; galPagina = 0; return; }
  }
  galLista();
  int[] l = resGalLista;
  int n = tamInt(l);
  int paginas = max(1, (n + GAL_POR_PAG - 1) / GAL_POR_PAG);
  float py = celY2 - 52;
  if (galPagina > 0 && enBoton(celX1 + 16, py, 70, 40)) { galPagina--; return; }
  if (galPagina < paginas - 1 && enBoton(celX2 - 86, py, 70, 40)) { galPagina++; return; }
  for (int i = 0; i < GAL_POR_PAG; i++) {
    int idx = galPagina * GAL_POR_PAG + i + 1;
    if (idx > n) break;
    float x = GAL_X + (i % 3) * (GAL_W + GAL_SEP), y = galY0() + (i / 3) * GAL_FILA;
    if (enBoton(x, y, GAL_W, GAL_H + 22)) { galVer = l[idx]; return; }
  }
}

// Clicks en una foto abierta: flechas o el botón Subir.
void clickFotoGaleria(int k) {
  float x = celX1 + 16, y = celY1 + MSG_HEAD + 16, w = celX2 - celX1 - 32, h = w * 9 / 16;
  galLista();
  int[] l = resGalLista;
  int pos = posEnLista(l, k);
  if (pos > 1 && enBoton(x + 8, y + h / 2 - 24, 44, 48)) { galVer = l[pos - 1]; return; }
  if (pos > 0 && pos < tamInt(l) && enBoton(x + w - 52, y + h / 2 - 24, 44, 48)) { galVer = l[pos + 1]; return; }
  if (enBoton(x, celY2 - 74, w, 54)) { galVer = -1; return; }
  if (galDesbloq[k] && !galSubida[k] && enBoton(x, celY2 - 150, w, 62)) {
    ftElegida = k;
    ftContexto = "";
    iniciarMinijuegoV20("FOTO");
  }
}

// ============================ EDITOR DE FOTOS (pantalla completa) ============================
// Empieza el editor de fotos para subir a Aurora+.
void iniciarFoto() {
  iniciarGaleriaSiFalta();
  ftFiltro = 0;
  ftRecorte = 0;
  ftPie = -1;
  ftEtiqueta = -1;
  ftGris = null;
  ftDesdeGaleria = false;
  if (ftContexto.equals("HELADERIA")) { ftFoto = indiceFoto("heladeria"); ftPaso = 1; return; }
  if (ftElegida >= 0) { ftFoto = ftElegida; ftElegida = -1; ftPaso = 1; ftDesdeGaleria = true; return; }
  ftPaso = 0;
  vaciarInt(ftOpciones);
  for (int k = 0; k < FOTOS_GALERIA.length && tamInt(ftOpciones) < 12; k++) {
    if (fotoDeGaleria(k) && galDesbloq[k] && !galSubida[k]) agregarInt(ftOpciones, k);
  }
  if (tamInt(ftOpciones) == 0) agregarInt(ftOpciones, indiceFoto("selfie_clase"));
}

// Tipo del pie de foto i (bueno, regular o malo).
int tipoPie(int k, int i) { return PIE_ORDEN[k % PIE_ORDEN.length][i]; }
// Tipo de la etiqueta i (nadie, bien o mal).
int tipoEtiqueta(int k, int i) { if (k % 2 == 1 && (i == 1 || i == 2)) return 3 - i; else return i; }

// Texto de cada forma de etiquetar a la gente de la foto.
String textoEtiqueta(int k, int tipo) {
  if (tipo == 0) return "No etiquetar a nadie";
  if (tipo == 1) return FOTOS_GALERIA[k][FG_TAG_BIEN];
  if (tipo == 2) return FOTOS_GALERIA[k][FG_TAG_MAL];
  return "Solo para mis mejores amigos (nadie más la ve)";
}

String[] resOpcionesFoto;

// Opciones del paso actual del editor (filtros, recortes, pies o etiquetas), en resOpcionesFoto.
void opcionesFoto() {
  if (ftPaso == 1) { resOpcionesFoto = FT_FILTROS; return; }
  if (ftPaso == 2) { resOpcionesFoto = FT_RECORTES; return; }
  String[] o = new String[4];
  for (int i = 0; i < 4; i++) { if (ftPaso == 3) o[i] = FOTOS_GALERIA[ftFoto][FG_PIE + tipoPie(ftFoto, i)]; else o[i] = textoEtiqueta(ftFoto, tipoEtiqueta(ftFoto, i)); }
  resOpcionesFoto = o;
}

// ¿La opción i es la que elegiste en este paso?
int elegidaEnPaso(int i) {
  if (ftPaso == 1) { if (ftFiltro == i) return 1; else return 0; }
  if (ftPaso == 2) { if (ftRecorte == i) return 1; else return 0; }
  if (ftPaso == 3) { if (ftPie == tipoPie(ftFoto, i)) return 1; else return 0; }
  if (ftPaso == 4) { if (ftEtiqueta == tipoEtiqueta(ftFoto, i)) return 1; else return 0; }
  return 0;
}

// ¿Se puede salir del editor sin subir?
boolean puedeSalirFoto() { return ftContexto.equals("") && !escVolverDeMJ; }
// ¿Se puede volver al paso anterior?
boolean puedeAtrasFoto() { return ftPaso >= 2 || (ftPaso == 1 && ftContexto.equals("")); }

final float FT_OX = 860, FT_OY = 230, FT_OW = 680, FT_OH = 100, FT_OSEP = 114;

// Clicks en el editor de fotos: elegir opción, atrás, salir o publicar.
void clickFoto() {
  if (puedeAtrasFoto() && dentro(80, 816, 190, 56)) { atrasFoto(); return; }
  if (puedeSalirFoto() && dentro(290, 816, 250, 56)) { salirFoto(); return; }
  if (ftPaso == 0) {
    for (int i = 1; i <= tamInt(ftOpciones); i++) {
      float x = 100 + ((i - 1) % 4) * 360, y = 170 + ((i - 1) / 4) * 210;
      if (dentro(x, y, 340, 191)) { ftFoto = ftOpciones[i]; ftPaso = 1; return; }
    }
    return;
  }
  if (ftPaso == 5) { if (dentro(FT_OX, 610, FT_OW, 90)) publicarFoto(); return; }
  opcionesFoto();
  String[] ops = resOpcionesFoto;
  for (int i = 0; i < ops.length; i++) {
    if (dentro(FT_OX, FT_OY + i * FT_OSEP, FT_OW, FT_OH)) {
      if (ftPaso == 1) { ftFiltro = i; if (i == 2) hacerGris(); }
      else if (ftPaso == 2) ftRecorte = i;
      else if (ftPaso == 3) ftPie = tipoPie(ftFoto, i);
      else ftEtiqueta = tipoEtiqueta(ftFoto, i);
      ftPaso++;
      return;
    }
  }
}

// Vuelve al paso anterior del editor.
void atrasFoto() {
  if (ftPaso >= 2) ftPaso--;
  else if (ftDesdeGaleria) salirFoto();
  else ftPaso = 0;
}

// Salir sin publicar: no pasa tiempo ni cambia nada
void salirFoto() {
  mj20 = "";
  terminarActividad();
  if (ftDesdeGaleria) { cel = 19; galVer = ftFoto; }
  ftDesdeGaleria = false;
}

// Prepara la versión en blanco y negro de la foto (filtro).
void hacerGris() {
  PImage img = imagenFoto(ftFoto);
  if (img == null) return;
  ftGris = img.get(0, 0, img.width, img.height);
  ftGris.loadPixels();
  for (int i = 0; i < ftGris.pixels.length; i++) {
    int c = ftGris.pixels[i];
    int g = round(red(c) * 0.3 + green(c) * 0.59 + blue(c) * 0.11);
    ftGris.pixels[i] = color(g, g, g, alpha(c));
  }
  ftGris.updatePixels();
}

// Publica la foto: me gusta y reacciones según lo que elegiste (y si respetaste a la gente que sale).
void publicarFoto() {
  String[] f = FOTOS_GALERIA[ftFoto];
  boolean hayGente = !f[FG_SALEN].equals("");
  int p = 50;
  if (ftFiltro <= 1) p += 10; else if (ftFiltro == 2) p += 5; else p += -5;
  if (ftRecorte == 1) p += 10; else if (ftRecorte == 2) p += 5; else p += 0;
  if (ftPie == 0) p += 20; else if (ftPie == 2) p += 15; else if (ftPie == 1) p += -15; else p += -40;
  if (ftEtiqueta == 1) {
    p += 15;
  } else {
    if (ftEtiqueta == 2) p += -25; else if (ftEtiqueta == 3) p += 10; else if (hayGente) p += 0; else p += 5;
  }
  float mult = 1;
  if (ftFiltro == 3) mult *= 1.3;
  if (ftPie == 1) mult *= 1.4;
  if (ftPie == 3) mult *= 1.6;
  if (ftEtiqueta == 2) mult *= 1.3;
  if (ftEtiqueta == 3) mult *= 0.35;
  ftLikes = round((6 + stats[ST_SEGUIDORES] / 3) * mult);
  String ef = "Seg +" + max(1, ftLikes / 6);
  if (ftPie == 0) ef += " · Social +2";
  if (ftPie == 1) ef += " · Social −2";
  if (ftPie == 3) ef += " · Social −4 · MALA_REPUTACIÓN";
  if (ftEtiqueta == 3) ef += " · Social +1 · MEJORES_AMIGOS";
  if (ftEtiqueta == 1 && !f[FG_EF_BIEN].equals("")) ef += " · " + f[FG_EF_BIEN];
  if (ftEtiqueta == 2 && !f[FG_EF_MAL].equals("")) ef += " · " + f[FG_EF_MAL];
  String r = aplicarEfectos(ef, -1);
  hecho("FOTO");
  sumarBandera("FOTO_" + f[FG_ID].toUpperCase(), 1);
  String pie = f[FG_PIE + ftPie];
  String txt = ftLikes + " me gusta. ";
  if (ftPie == 0) txt += "Pocos filtros: los comentarios son de gente que te conoce.";
  else if (ftPie == 1) txt += "Muchos me gusta, pocos comentarios de verdad.";
  else if (ftPie == 2) txt += "Reírse de uno mismo cae bien: comentarios cariñosos.";
  else txt += "Más me gusta... y tres personas dejaron de seguirte.";
  if (ftEtiqueta == 1) txt += "\n" + f[FG_REAC_BIEN];
  else if (ftEtiqueta == 2) txt += "\n" + f[FG_REAC_MAL];
  else if (ftEtiqueta == 3) txt += "\nSolo la ven tus mejores amigos: pocos me gusta, pero de verdad.";
  else if (hayGente) txt += "\nNo etiquetaste a nadie: nadie se molestó, nadie se enteró."; else txt += "\nSin etiquetas: la foto habla sola.";
  galSubida[ftFoto] = true;
  galVista[ftFoto] = true;
  galLikes[ftFoto] = ftLikes;
  galPie[ftFoto] = pie;

  int n = tamFilas(feed);
  if (feed != null && n < feed.length) {
    for (int i = n; i > feedPos; i--) feed[i] = feed[i - 1];
    feed[feedPos] = new String[] { "Tú · acabas de subir", f[FG_TIT] + " — " + pie, "tuyo", "-1", null, f[FG_ID] };
  }
  finMJ(constrain(p, 0, 100), txt);
  mj20Efecto = r;
}

// Termina el editor y vuelve a la galería o a la escena.
void terminarFotoSuelta(int puntaje) {
  if (ftDesdeGaleria) { cel = 19; galVer = ftFoto; }
  ftDesdeGaleria = false;
  ftContexto = "";
}

// Dibuja el editor de fotos en el paso que toca.
