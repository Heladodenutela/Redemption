// ---- la app Horario: matriz día x hora con las clases (CLASES) y los eventos (EVENTOS) ----
// Arma la agenda del celular al empezar la partida.
void iniciarAgenda() {
  actualizarHorario();
}

// ¿Se cumple alguna de las condiciones (separadas por ";")?
boolean condicionEvento(String c) {
  if (c == null || c.equals("")) return true;
  partirPorLetra(c, ';');
  String[] partes = resPartirPorLetra;
  for (int i = 0; i < partes.length; i++) if (condicionMsg(partes[i])) return true;
  return false;
}

// Vuelve a llenar la matriz día x hora: clases siempre; eventos solo si te invitaron; la Copa si estás inscrito
void actualizarHorario() {
  for (int d = 0; d < agendaNombre.length; d++) for (int h = 0; h < 24; h++) { agendaNombre[d][h] = null; agendaColor[d][h] = 0; }

  for (int k = 0; k < tamTexto(eventosVistos); k++) {
    if (empiezaCon(eventosVistos[k], "EV:")) {
      partirPorLetra(eventosVistos[k].substring(3), '|');
      String[] e = resPartirPorLetra;
      ponerEnHorario(int(e[0]), int(e[1]), int(e[2]), e[3], unhex("FF" + e[4]));
    }
  }

  for (int k = 0; k < EVENTOS.length; k++) {
    if (condicionEvento(EVENTOS[k][5])) {
      ponerEnHorario(int(EVENTOS[k][0]), int(EVENTOS[k][1]), int(EVENTOS[k][2]), EVENTOS[k][3], unhex("FF" + EVENTOS[k][4]));
    }
  }

  boolean copaVista = tieneTexto(eventosVistos, "COPA");
  for (int k = 0; k < COPA.length; k++) {
    boolean ins = inscrito(COPA[k][2]);
    if (!(!ins && !copaVista) && !(ins && eliminado(COPA[k][2]) && copaEstado[k] == 0)) {
      int a = aMin(COPA[k][1]) / 60;
      String est;
      if (copaEstado[k] == 1) {
        est = " OK";
      } else {
        if (copaEstado[k] >= 2) est = " X"; else if (ins) est = ""; else est = " (sin inscribirte)";
      }
      ponerEnHorario(int(COPA[k][0]), a, a + 2, "Copa: " + COPA[k][2] + " " + COPA[k][3] + est, 0xFF93C47D);
    }
  }

  for (int c = 0; c < CLASES.length; c++) {
    String nombre = CLASES[c][3] + " · " + MAPA_NOMBRE[mapaPorCodigo(CLASES[c][4])].substring(4);
    int col;
    if (empiezaCon(CLASES[c][3], "PARCIAL")) col = 0xFFE06666; else col = 0xFF6FA8DC;
    ponerEnHorario(int(CLASES[c][0]), aMin(CLASES[c][1]) / 60, aMin(CLASES[c][2]) / 60, nombre, col);
  }
  ponerPropiosEnHorario();
}

// Escribe una actividad en la agenda del día d entre las horas a y b.
void ponerEnHorario(int d, int a, int b, String nombre, int col) {
  if (d < 0 || d >= agendaNombre.length) return;
  for (int h = a; h < b && h < 24; h++) { agendaNombre[d][h] = nombre; agendaColor[d][h] = col; }
}

// ---- carteleras -> Horario ----
String[] eventosVistos = new String[100];

// Lo llama dibujarCartelera() por cada aviso que se ve: "EV:día|desde|hasta|nombre|color", "COPA", varios con ";"
void anotarDelCartel(String ev) {
  if (ev == null || ev.equals("")) return;
  partirPorLetra(ev, ';');
  String[] partes = resPartirPorLetra;
  for (int i = 0; i < partes.length; i++) {
    String p = partes[i];
    if (!p.equals("") && !tieneTexto(eventosVistos, p)) {
      agregarTexto(eventosVistos, p);
      if (p.equals("COPA")) aviso("Anotaste los partidos de la Copa Aurora en tu Horario");
      else { partirPorLetra(p.substring(3), '|'); String[] aux1 = resPartirPorLetra; aviso("Anotado en tu Horario: " + aux1[3]); }
      actualizarHorario();
    }
  }
}

