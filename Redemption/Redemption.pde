}

// En la agenda gana la fila de un día puntual sobre la de "todos los días" (así la fiesta del día 5 o
// la Feria del día 10 le ganan a "Camilo está en PixelZone de 1:00 a 10:00 p. m. todos los días")
boolean filaDeUnDia(String dias) {
  return posicionDe(dias, "-") < 0 && posicionDe(dias, ",") < 0;
}

// ============================ TE PILLARON CON VARIAS ============================
// Cuando sale el chisme, cada una te manda un mensaje. Al leerlo (abrir el chat), te borra el número,
// no te vuelve a escribir y en persona no te habla.
String[][] BLOQUEO_LINEA = {
  {"Sofía", "[Sofía te ve, se pone los audífonos y cambia de puesto.]"},
  {"Laura", "[Laura cierra el cuaderno y se va a otra mesa sin mirarte.]"},
  {"Marta", "[Marta saca el celular, te graba dos segundos y se da la vuelta. No dice nada.]"},
  {"Nadia", "[Nadia se tira al agua. No sale hasta que te vas.]"},
  {"Valentina", "[Valentina le pide a su compañero que te atienda y se mete a la cocina.]"}
};

// ¿Esta persona te bloqueó?
boolean bloqueado(int f) {
  return f >= 0 && bandera("BLOQUEO_" + f) > 0;
}

// Lo que pasa cuando hablas con alguien que te bloqueó.
String lineaBloqueo(int f) {
  for (int k = 0; k < BLOQUEO_LINEA.length; k++) if (BLOQUEO_LINEA[k][0].equals(DLG_PERSONA[f])) return BLOQUEO_LINEA[k][1];
  return "[" + nombreCorto(f) + " te ve y se da la vuelta. No te habla.]";
}

// Esa persona te bloquea: borra su número y deja de hablarte.
void bloquear(int f) {
  if (f < 0 || bloqueado(f)) return;
  sumarBandera("BLOQUEO_" + f, 1);
  int n = bandera("NUM_" + f);
  if (n > 0) sumarBandera("NUM_" + f, -n);
}

// Lo llama el celular al abrir un chat
void alAbrirChatV22(int fila) {
  if (fila < 0 || fila >= MSG_FILAS) return;
  String chat = msg[fila][0];
  if (chat.equals("") || esGrupo(chat) || esChatSistema(chat)) return;
  int f = personaDelChat(chat);
  if (f < 0 || bandera("ENTERADA_" + f) <= 0 || bloqueado(f)) return;
  bloquear(f);
  agregarMensaje(chat, '1', "[" + nombreCorto(f) + " eliminó tu número]");
  avisoGrande("Te borró el número", nombreCorto(f), "Leíste su mensaje. Ya no te va a escribir ni a hablar.", color(200, 60, 60));
}

// ============================ NIVELES DE AMISTAD (para los diálogos por nivel) ============================
// La llama cambiarAmistad(): recuerda si alguna vez fueron amigos (para el diálogo de "esto se dañó")
void revisarNivelAmistad(int f) {
  if (f < 0 || amistad == null) return;
  if (amistad[f] >= 60 && bandera("FUE_AMIGO_" + f) <= 0) sumarBandera("FUE_AMIGO_" + f, 1);
}

// "A60" ya son amigos, "A80" muy cercanos, "BAJA" fueron amigos y ahora la amistad está por el piso
boolean hitoAmistad(int f, String h) {
  if (h.equals("A60")) return amistad[f] >= 60;
  if (h.equals("A80")) return amistad[f] >= 80;
  if (h.equals("BAJA")) return amistad[f] < 35 && bandera("FUE_AMIGO_" + f) > 0;
  return false;
}

// Hoy ya tuvieron la conversación de verdad (un árbol o el diálogo diario): lo demás sobra
int[] arbolDia;

// Marca que hoy ya tuviste la conversación del árbol con esa persona.
void marcarArbolHoy(int f, String nodo) {
  if (empiezaCon(nodo, "X_NU_")) return;
  if (arbolDia == null || arbolDia.length != DLG_PERSONA.length) {
    arbolDia = new int[DLG_PERSONA.length];
    for (int i = 0; i < arbolDia.length; i++) arbolDia[i] = -1;
  }
  if (f >= 0 && f < arbolDia.length) arbolDia[f] = dia;
}

// ¿Hoy ya tuviste la conversación del árbol con esa persona?
boolean arbolHecho(int f) {
  return arbolDia != null && f >= 0 && f < arbolDia.length && arbolDia[f] == dia;
}

// ¿Hoy ya conversaste con esa persona (árbol o diálogo diario)?
boolean conversaronHoy(int f) {
  if (arbolHecho(f)) return true;
  return diarioDia != null && f >= 0 && f < diarioDia.length && diarioDia[f] == dia;
}

// ============================ ENGANCHES (los llama el núcleo) ============================
// Cada cuadro del mundo, encima de todo
void dibujarMundoV22() {
  tickMundoV23();
  revisarTutorial();
  dibujarAvisoGrande();
  dibujarTutorial();
}

