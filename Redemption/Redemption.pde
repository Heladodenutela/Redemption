// Dibuja la página de mecánicas del tutorial (las 5 categorías, el celular...).
void dibujarTutorialMecanicas() {
  float x0 = TUT_X + 34, y0 = TUT_Y + 96;
  float cw = 408, ch = 182;
  for (int i = 0; i < TUT_MECANICAS.length; i++) {
    float x = x0 + (i % 3) * (cw + 18);
    float y = y0 + (i / 3) * (ch + 14);
    noStroke();
    fill(255);
    rect(x, y, cw, ch, 14);
    PImage img = null;
    if (tutImg != null) img = tutImg[i];
    if (img == null || img.width <= 1) img = imagenReemplazoTutorial(i);
    boolean propio = tutImg != null && tutImg[i] != null && tutImg[i].width > 1;
    float iw = 140, ih = 150;
    if (img != null && img.width > 1) {
      float e = max(iw / img.width, ih / img.height);
      if (propio) e = min(iw / img.width, ih / img.height);
      float dw = img.width * e, dh = img.height * e;
      if (propio) image(img, x + 14 + (iw - dw) / 2, y + 16 + (ih - dh) / 2, dw, dh);
      else {

        float rw = iw / e, rh = ih / e;
        image(img, x + 14, y + 16, iw, ih, int((img.width - rw) / 2), int((img.height - rh) / 2), int((img.width + rw) / 2), int((img.height + rh) / 2));
      }
    } else {
      huecoSprite(null, x + 14, y + 16, iw, ih, "", "");
    }
    fill(60, 90, 160);
    textSize(21);
    textAlign(LEFT, TOP);
    text(TUT_MECANICAS[i][2], x + 168, y + 16);
    fill(50);
    textSize(15);
    text(TUT_MECANICAS[i][3], x + 168, y + 48, cw - 182, ch - 56);
  }
  textAlign(LEFT, BASELINE);
}

// Mientras no esté el sprite propio: el fondo del lugar, el celular o la comida
PImage imagenReemplazoTutorial(int i) {
  String id = TUT_MECANICAS[i][0];
  if (id.equals("celular")) return in_celular;
  String cod = TUT_MECANICAS[i][1];
  if (cod.equals("")) return null;
  int m = mapaPorCodigo(cod);
  if (m < 0 || fondos[m] == null) return null;
  return fondos[m];
}

// El recuadro donde va un sprite; si todavía no existe, se ve el hueco punteado con el nombre del archivo
void huecoSprite(PImage img, float x, float y, float w, float h, String titulo, String archivo) {
  if (img != null && img.width > 1) {
    float e = min(w / img.width, h / img.height);
    image(img, x + (w - img.width * e) / 2, y + (h - img.height * e) / 2, img.width * e, img.height * e);
    return;
  }
  noFill();
  stroke(170, 165, 155);
  strokeWeight(2);
  for (float t = 0; t < w; t += 18) { line(x + t, y, x + min(t + 9, w), y); line(x + t, y + h, x + min(t + 9, w), y + h); }
  for (float t = 0; t < h; t += 18) { line(x, y + t, x, y + min(t + 9, h)); line(x + w, y + t, x + w, y + min(t + 9, h)); }
  noStroke();
  fill(150);
  textAlign(CENTER, CENTER);
  textSize(20);
  if (!titulo.equals("")) text(titulo + "\n(pendiente)", x + w / 2, y + h / 2 - 16);
  textSize(14);
  if (!archivo.equals("")) text(archivo, x + w / 2, y + h / 2 + 36);
  textAlign(LEFT, BASELINE);
}

// Flechas para pasar de página; ESPACIO o E para seguir.
boolean teclaTutorial() {
  if (!tutorialAbierto) return false;
  if (key == CODED) {
    if (keyCode == LEFT && tutorialPag > 0) tutorialPag--;
    else if (keyCode == RIGHT) siguienteTutorial();
    return true;
  }
  if (key == 'a' || key == 'A') { if (tutorialPag > 0) tutorialPag--; }
  else if (key == 'd' || key == 'D' || key == 'e' || key == 'E' || key == ' ' || key == ENTER || key == RETURN) siguienteTutorial();
  else if (key == 'q' || key == 'Q' || key == BACKSPACE) cerrarTutorial();
  return true;
}

// Pasa a la siguiente página o cierra el tutorial.
void siguienteTutorial() {
  if (tutorialPag == 0) tutorialPag = 1;
  else cerrarTutorial();
}

// Clicks en los botones del tutorial.
boolean clickTutorial() {
  if (!tutorialAbierto) return false;
  float by = TUT_Y + TUT_H - 76;
  if (mouseY > by && mouseY < by + 56) {
    if (tutorialPag > 0 && mouseX > TUT_X + 34 && mouseX < TUT_X + 264) tutorialPag--;
    if (mouseX > TUT_X + TUT_W - 290 && mouseX < TUT_X + TUT_W - 34) siguienteTutorial();
  }
  return true;
}

// Teclas del mundo para el tutorial (mientras está abierto se come todas las teclas).
boolean teclaV22() {
  if (teclaTutorial()) return true;
  if (key == CODED && keyCode == 112 && screen == 1 && !finJuego) {
    abrirTutorial();
    return true;
  }
  return false;
}

