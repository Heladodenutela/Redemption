// La app avisa AVISO_EVENTO_MIN antes de que empiece algo
void revisarAvisosHorario() {
  int m = minutoAhora() + AVISO_EVENTO_MIN;
  int h = m / 60;
  if (h >= 24 || dia > 10) return;
  if (agendaNombre[dia][h] == null || eventoAvisado[dia][h]) return;
  if (h > 0 && agendaNombre[dia][h].equals(agendaNombre[dia][h - 1])) return;
  if (m % 60 != 0) return;
  eventoAvisado[dia][h] = true;
  if (!noMolestar || !esDeNoche()) aviso("Horario: en " + AVISO_EVENTO_MIN + " min · " + agendaNombre[dia][h]);
  celNotificacion = true;
}

