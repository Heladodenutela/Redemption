      strokeWeight(1);
    }
    fill(30);
    textAlign(LEFT, TOP);
    textSize(16);
    text("Nivel " + (k + 1), x + 16, y + 162);
    textSize(21);
    text(TD_NOMBRES[k], x + 16, y + 184, 240, 60);
