// Carga una imagen solo si el archivo existe; si no está, devuelve null sin sacar error en la consola
PImage cargarSiExiste(String ruta) {
  if (createInput(ruta) == null) return null;
  return loadImage(ruta);
}

// Cortar un cuadro de una hoja: col = columna, fila = fila, cw/ch = medida de la celda en x5
// (por ejemplo, cada cuadro de los personajes mide 160x240).
PImage cuadro(PImage hoja, int col, int fila, int cw, int ch) {
  return hoja.get(col * cw, fila * ch, cw, ch);
}

