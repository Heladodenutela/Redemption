// Arma la escena del plan con lo que dice esa persona (llegaste a tiempo o tarde).
void armarEscenaPlan(int f, boolean tarde) {
  String p = DLG_PERSONA[f];
  String[] l = null;
  for (int k = 0; k < PLAN_LINEAS.length; k++) if (PLAN_LINEAS[k][0].equals(nombreCorto(f))) l = PLAN_LINEAS[k];
  if (l == null) l = new String[] { p, "¡Hola! Llegaste.", "¿Cómo va la semana?", "Ahí vamos. Con ganas.", "Gracias por el plan." };
  String aux1;
  if (tarde) aux1 = "Llegaste tarde... pero llegaste. " + l[1]; else aux1 = l[1];
  String aux2;
  if (tarde) aux2 = "EF:Am +3"; else aux2 = "EF:Am +6";
  String[][] rows = {
    {"PLAN", "", p, aux1, aux2},
    {"PLAN", "", p, l[2], ""},
    {"PLAN", "", "Tú", l[3], ""},
    {"PLAN", "", p + ":feliz", l[4], "CMD:AMIGOS 60"},
    {"PLAN", "", "*", "", "FIN"}
  };

  int n = 0;
  for (int k = 0; k < ESCENAS.length; k++) if (!ESCENAS[k][0].equals("PLAN")) n++;
  String[][] t = new String[n + rows.length][];
  int j = 0;
  for (int k = 0; k < ESCENAS.length; k++) if (!ESCENAS[k][0].equals("PLAN")) t[j++] = ESCENAS[k];
  for (int k = 0; k < rows.length; k++) t[j++] = rows[k];
  ESCENAS = t;
}

