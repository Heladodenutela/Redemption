void dibujarIconosCelular() {
  PImage[] ics = { ui_icWordle, ui_icFlappy, ui_icPong, ui_icMensajes };
  String[] nom = { "Wordle", "Flappy", "Pong", "Mensajes" };
  textAlign(CENTER, TOP);
  textSize(15);
  for (int k = 0; k < ics.length; k++) {
    float x = 530 + k * 100, y = 80;
    if (ics[k] != null) {
      image(ics[k], x, y, 80, 80);
    } else {
      noStroke();
      fill(200, 200, 256);
      rect(x, y, 80, 80);
    }
    fill(225, 225, 235);
    text(nom[k], x + 40, y + 84);
    if (k == 3) burbujaRoja(x + 74, y + 6, totalNoLeidos());
  }
  dibujarIconoNeurona();
  textAlign(LEFT, BASELINE);
}

