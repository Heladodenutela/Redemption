// Clicks en la pausa: pestañas, ajustes, continuar, guardar y salir.
void clickPausa() {
  if (pausaPestana == 4 && clickBotonTutorialPausa()) return;
  for (int i = 0; i < PAUSA_PESTANAS.length; i++) {
    float x = PZ_X + 30 + i * 236, y = PZ_Y + 72;
    if (mouseX > x && mouseX < x + 226 && mouseY > y && mouseY < y + 44) { pausaPestana = i; pausaSalir = false; return; }
  }
  if (pausaPestana == 3) {
    for (int i = 0; i < 3; i++) {
      float bx = PZ_X + 40 + i * 260, by = PZ_Y + 140 + 60;
      if (mouseX > bx && mouseX < bx + 240 && mouseY > by && mouseY < by + 60) { dificultad = i; aplicarBalance(); return; }
    }
    if (clickAjustesMusica(PZ_Y + 140)) return;
    if (clickOpcionesVentana(PZ_X + 40, PZ_Y + 140 + VENTANA_Y)) return;
    if (clickOpcionFPS(PZ_X + 40, PZ_Y + 140 + FPS_Y)) return;
  }
  float yb = PZ_Y + PZ_H - 70;
  if (mouseY > yb && mouseY < yb + 50) {
    if (mouseX > PZ_X + 30 && mouseX < PZ_X + 390) { alternarPausa(); return; }
    if (mouseX > PZ_X + PZ_W / 2 - 180 && mouseX < PZ_X + PZ_W / 2 + 180) { guardarDesdePausa(); return; }
    if (mouseX > PZ_X + PZ_W - 390 && mouseX < PZ_X + PZ_W - 30) {
      if (pausaSalir) {
        if (ranuraActual > 0 && estadoSeguroGuardar()) guardarPartida(ranuraActual);
        guardarCuenta();
        exit();
      }
      pausaSalir = true;
      return;
    }
  }
  pausaSalir = false;
}

// ============================ TÍTULO: SELECTOR DE DIFICULTAD ============================
// Un poco más abajo, y la dificultad también decide cuánto dura cada hora del juego
final float SEL_DIF_Y = 735;

// Cuánto dura una hora del juego en tiempo real (para Ajustes).
String textoDuracionHora(int d) {
  float m = MIN_POR_HORA[d];
  int seg = round(m * 60);
  return (seg / 60) + ":" + nf(seg % 60, 2) + " min";
}

// Dibuja los botones Fácil / Normal / Difícil del título.
void dibujarSelectorDificultad() {
  float y = SEL_DIF_Y;
  fill(255);
  textSize(20);
  textAlign(CENTER, BASELINE);
  text("Dificultad: minijuegos y cuánto dura el día", 800, y - 8);
  for (int i = 0; i < 3; i++) {
    float x = 590 + i * 145;
    boolean enc = mouseX > x && mouseX < x + 130 && mouseY > y && mouseY < y + 40;
    noStroke();
    if (i == dificultad) {
      fill(color(110, 80, 200));
    } else {
      if (enc) fill(color(90, 90, 120)); else fill(color(40, 40, 60, 200));
    }
    rect(x, y, 130, 40, 8);
    fill(255);
    textSize(19);
    textAlign(CENTER, CENTER);
    text(DIF_NOMBRE[i], x + 65, y + 18);
    fill(235);
    textSize(15);
    text("1 h = " + textoDuracionHora(i), x + 65, y + 56);
  }
  textAlign(LEFT, BASELINE);
}

// Click en Fácil / Normal / Difícil.
boolean clickSelectorDificultad() {
  float y = SEL_DIF_Y;
  for (int i = 0; i < 3; i++) {
    float x = 590 + i * 145;
    if (mouseX > x && mouseX < x + 130 && mouseY > y && mouseY < y + 40) { dificultad = i; aplicarBalance(); return true; }
  }
  return false;
}

// ============================ OBJETIVO (arriba a la derecha) ============================
// Texto de lo próximo que deberías hacer (la siguiente clase, un evento).
String objetivoActual() {
  int m = minutoAhora();

  for (int c = 0; c < CLASES.length; c++) {
    if (int(CLASES[c][0]) == dia && claseEstado[c] == 0) {
      int a = aMin(CLASES[c][1]), b = aMin(CLASES[c][2]);
      if (m < b) {
        String lugar = MAPA_NOMBRE[mapaPorCodigo(CLASES[c][4])] + " (" + CLASES[c][4] + ")";
        if (m < a) return CLASES[c][3] + " a las " + CLASES[c][1] + " · " + lugar + " · faltan " + duracion(a - m);
        return "¡" + CLASES[c][3] + " ya empezó! · " + lugar + " · usa los pupitres (E)";
      }
    }
  }
  String ev = objetivoEvento();
  if (ev != null) return ev;
  String p = proximoEvento();
  if (!empiezaCon(p, "Hoy no queda")) return p;
  if (m >= 22 * 60 || m < 5 * 60) return "Ya es tarde: a dormir (cama de tu cuarto, E)";
  return "Tiempo libre: habla con alguien, entrena, estudia o descansa";
}

// Pasa minutos a texto: '45 min' o '1 h 30 min'.
String duracion(int min) {
  if (min < 60) return min + " min";
  return (min / 60) + " h " + nf(min % 60, 2) + " min";
}

// Dibuja el objetivo actual arriba de la pantalla.
void dibujarObjetivo() {
  if (actividad != ACT_NINGUNA && actividad != ACT_SENTADO && actividad != ACT_ESTUDIAR && actividad != ACT_SOFA) return;
  if (cel != 0) return;
  String t = objetivoActual();
  textSize(19);
  float w = min(760, textWidth(t) + 120);
  float x = ANCHO - w - 12, y = 12;
  noStroke();
  fill(0, 0, 0, 160);
  rect(x, y, w, 46, 8);
  fill(255, 210, 90);
  textAlign(LEFT, CENTER);
  text("AHORA", x + 14, y + 21);
  fill(255);
  text(recortarA(t, w - 100), x + 86, y + 21);
  textAlign(LEFT, BASELINE);
}

// Corta un texto con '...' para que quepa en un ancho en pantalla.
String recortarA(String t, float w) {
  if (textWidth(t) <= w) return t;
  while (t.length() > 3 && textWidth(t + "...") > w) t = t.substring(0, t.length() - 1);
  return t + "...";
}

