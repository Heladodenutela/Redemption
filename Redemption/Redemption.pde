// La escena que pasa en cada clase (nodos del árbol, en orden): { día, materia (como empieza), nodos }
String[][] ESCENAS_CLASE = {
  {"1", "Física", "ME1|S0|S1"},
  {"1", "Cálculo", "R1"},
  {"2", "Álgebra", "SA1"},
  {"2", "Programación", "V1"},
