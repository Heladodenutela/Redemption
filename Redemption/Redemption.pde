// Qué máquina está bajo el mouse.
int arcadeEnMouse() {
  for (int k = 0; k < 3; k++) {
    float y = 290 + k * 80;
    if (mouseX > 460 && mouseX < 1140 && mouseY > y && mouseY < y + 72) return k;
  }
  if (mouseX > 460 && mouseX < 1140 && mouseY > 530 && mouseY < 602) return 3;
  return -1;
}

// Juega una máquina (gasta una ficha o paga).
void jugarArcade(int k) {
  if (k == 3) { iniciarModerador(); return; }
  if (k < 0 || k > 2) return;
  if (!quitarInventario("Ficha de PixelZone", 1)) {
    if (dinero < FICHA_PIXEL) { aviso("No tienes fichas ni $" + FICHA_PIXEL); return; }
    dinero -= FICHA_PIXEL;
  }
  arcadeJuego = k;
  for (int i = 0; i < 4; i++) arcTecla[i] = false;
  if (k == 0) iniciarRoyale();
  else if (k == 1) iniciarTorre();
  else iniciarDuelo();
}

// Termina una máquina y da el premio si hiciste récord.
void terminarArcade(int puntos, int premio, String mensaje) {
  if (arcadeDesdeEscena(puntos, premio, mensaje)) return;
  arcadePuntos = puntos;
  arcadePremio = premio;
  arcadeMensaje = mensaje;
  boolean mejor;
  if (arcadeJuego == 2) {
    mejor = (puntos > 0 && (arcadeRecord[2] == 0 || puntos < arcadeRecord[2]));
  } else {
    mejor = puntos > arcadeRecord[arcadeJuego];
  }
  if (mejor) { arcadeRecord[arcadeJuego] = puntos; arcadeMensaje += "  ¡Nuevo récord!"; }
  guardarRecordsArcade();
  if (premio > 0) dinero += premio;
  avanzarTiempo(ARCADE_MIN);
  empezarActividad(ACT_ARC_FIN);
}

// Dibuja el resultado de la máquina.
void dibujarArcadeFin() {
  ventana(500, 280, 600, 300, ARCADE_JUEGOS[arcadeJuego]);
  fill(40);
  textSize(26);
  text(arcadeMensaje, 540, 380, 520, 80);
  if (arcadePremio > 0) text("Premio: $" + arcadePremio, 540, 480); else text("Sin premio esta vez", 540, 480);
  fill(110);
  textSize(20);
  text("[E] volver a las máquinas · [Q] salir", 540, 550);
}

// ---- 1. Pixel Royale: esquiva las balas que vienen de los bordes (cada vez más y más rápidas) ----
final float RY_X1 = 400, RY_Y1 = 120, RY_X2 = 1200, RY_Y2 = 800;
final int MAX_BALAS = 120;
float[][] balas = new float[MAX_BALAS][5];
float ryX, ryY;
int ryVidas, ryInicio, rySiguiente, ryInvencible;

// Empieza Pixel Royale: esquiva las balas el mayor tiempo posible.
void iniciarRoyale() {
  empezarActividad(ACT_ARC_ROYALE);
  for (int k = 0; k < MAX_BALAS; k++) balas[k][4] = 0;
  ryX = (RY_X1 + RY_X2) / 2;
  ryY = (RY_Y1 + RY_Y2) / 2;
  ryVidas = ROYALE_VIDAS;
  ryInicio = millis();
  rySiguiente = millis() + 600;
  ryInvencible = 0;
}

// Dibuja Pixel Royale: la zona se cierra y salen balas.
void dibujarRoyale() {
  int t = millis() - ryInicio;
  float seg = t / 1000.0;
  noStroke();
  fill(10, 10, 25);
  rect(0, 0, ANCHO, ALTO);
  fill(25, 30, 60);
  rect(RY_X1, RY_Y1, RY_X2 - RY_X1, RY_Y2 - RY_Y1);

  if (arcTecla[0]) ryX -= ROYALE_VEL_JUGADOR * pasoCuadro;
  if (arcTecla[1]) ryX += ROYALE_VEL_JUGADOR * pasoCuadro;
  if (arcTecla[2]) ryY -= ROYALE_VEL_JUGADOR * pasoCuadro;
  if (arcTecla[3]) ryY += ROYALE_VEL_JUGADOR * pasoCuadro;
  ryX = constrain(ryX, RY_X1 + 12, RY_X2 - 12);
  ryY = constrain(ryY, RY_Y1 + 12, RY_Y2 - 12);

  if (millis() >= rySiguiente) {
    float vel = 3 + seg * 0.12;
    if (random(1) < 0.2 && seg > 10) { for (int i = -2; i <= 2; i++) dispararBala(vel, i * 0.18); }
    else dispararBala(vel, random(-0.1, 0.1));
    rySiguiente = millis() + int(max(120, 650 - seg * 12));
  }

  fill(255, 90, 120);
  for (int k = 0; k < MAX_BALAS; k++) {
    if (balas[k][4] != 0) {
      balas[k][0] += balas[k][2] * pasoCuadro;
      balas[k][1] += balas[k][3] * pasoCuadro;
      if (balas[k][0] < RY_X1 - 30 || balas[k][0] > RY_X2 + 30 || balas[k][1] < RY_Y1 - 30 || balas[k][1] > RY_Y2 + 30) { balas[k][4] = 0; } else {
        if (!tira(px_royaleBala, 1, 0, balas[k][0] - 8, balas[k][1] - 8, 16, 16)) ellipse(balas[k][0], balas[k][1], 14, 14);
        if (millis() > ryInvencible && dist(balas[k][0], balas[k][1], ryX, ryY) < 17) {
          balas[k][4] = 0;
          ryVidas--;
          ryInvencible = millis() + 1000;
        }
      }
    }
  }
  boolean parpadea = millis() < ryInvencible && (millis() / 100) % 2 == 0;
  cargarSprites11();
  dibujarTiradoresRoyale();
  if (!parpadea && !tira(px_royaleJugador, 4, (millis() / 120) % 4, ryX - 24, ryY - 24, 48, 48)) { fill(120, 230, 255); rect(ryX - 12, ryY - 12, 24, 24, 4); }
  fill(255);
  textSize(24);
  textAlign(LEFT, BASELINE);
  text("PIXEL ROYALE · flechas o WASD · Vidas " + ryVidas, RY_X1, RY_Y1 - 20);
  textAlign(RIGHT, BASELINE);
  text(nf(seg, 1, 1) + " s", RY_X2, RY_Y1 - 20);
  textAlign(LEFT, BASELINE);
  if (ryVidas <= 0) {
    int s = int(seg);
    int premio;
    if (s >= 60) premio = ROYALE_PREMIO_60; else if (s >= 30) premio = ROYALE_PREMIO_30; else premio = 0;
    terminarArcade(s, premio, "Aguantaste " + s + " segundos.");
  }
}

// Dispara una bala desde un borde al azar.
void dispararBala(float vel, float giro) {
  for (int k = 0; k < MAX_BALAS; k++) {
    if (balas[k][4] == 0) {
      int lado = int(random(4));
      float x;
      if (lado == 0) x = RY_X1 - 10; else if (lado == 1) x = RY_X2 + 10; else x = random(RY_X1, RY_X2);
      float y;
      if (lado == 2) y = RY_Y1 - 10; else if (lado == 3) y = RY_Y2 + 10; else y = random(RY_Y1, RY_Y2);
      float ang = atan2(ryY - y, ryX - x) + giro;
      balas[k][0] = x;
      balas[k][1] = y;
      balas[k][2] = cos(ang) * vel;
      balas[k][3] = sin(ang) * vel;
      balas[k][4] = 1;
      return;
    }
  }
}

// ---- 2. Torre: el bloque va y viene; ESPACIO o click para soltarlo. Lo que sobresale se cae. ----
final int MAX_PISOS = 200;
float[][] pisos = new float[MAX_PISOS][2];
int numPisos;
float trX, trAncho, trVel;
int trDir;
final float TR_ALTO = 40, TR_BASE_Y = 780, TR_X1 = 500, TR_X2 = 1100;

// Empieza la Torre: apila pisos lo más alto que puedas.
void iniciarTorre() {
  empezarActividad(ACT_ARC_TORRE);
  numPisos = 1;
  pisos[0][0] = 650;
  pisos[0][1] = 300;
  trAncho = 300;
  trX = TR_X1;
  trVel = 5;
  trDir = 1;
}

// Dibuja la torre y el piso que se mueve.
void dibujarTorre() {
  noStroke();
  fill(15, 15, 30);
  rect(0, 0, ANCHO, ALTO);
  fill(30, 30, 55);
  rect(TR_X1, 100, TR_X2 - TR_X1, 700);
  trX += trDir * trVel * pasoCuadro;
  if (trX < TR_X1) { trX = TR_X1; trDir = 1; }
  if (trX + trAncho > TR_X2) { trX = TR_X2 - trAncho; trDir = -1; }

  int desde = max(0, numPisos - 14);
  for (int k = desde; k < numPisos; k++) {
    float y = TR_BASE_Y - (k - desde + 1) * TR_ALTO;
    cargarSprites11();
    if (!tira(px_torreBloque, 5, k % 5, pisos[k][0], y, pisos[k][1], TR_ALTO - 4)) {
      fill(lerpColor(color(90, 200, 255), color(255, 120, 200), (k % 12) / 12.0));
      rect(pisos[k][0], y, pisos[k][1], TR_ALTO - 4, 4);
    }
  }
  float yMov = TR_BASE_Y - (numPisos - desde + 1) * TR_ALTO;
  if (!tira(px_torreBloque, 5, numPisos % 5, trX, yMov, trAncho, TR_ALTO - 4)) {
    fill(255, 230, 120);
    rect(trX, yMov, trAncho, TR_ALTO - 4, 4);
  }
  fill(255);
  textSize(24);
  text("TORRE · ESPACIO o click para soltar · Pisos " + (numPisos - 1), TR_X1, 80);
}

// Suelta el piso: lo que sobra se cae y el siguiente queda más angosto.
void soltarTorre() {
  float[] abajo = pisos[numPisos - 1];
  float izq = max(trX, abajo[0]), der = min(trX + trAncho, abajo[0] + abajo[1]);
  float ancho = der - izq;
  if (ancho <= 0) {
    int p = numPisos - 1;
    int premio;
    if (p >= 25) premio = TORRE_PREMIO_25; else if (p >= 15) premio = TORRE_PREMIO_15; else premio = 0;
    terminarArcade(p, premio, "Tu torre llegó a " + p + " pisos.");
    return;
  }
  if (abs(trX - abajo[0]) < 5) { izq = abajo[0]; ancho = abajo[1]; }
  if (numPisos < MAX_PISOS) {
    pisos[numPisos][0] = izq;
    pisos[numPisos][1] = ancho;
    numPisos++;
  }
  trAncho = ancho;
  trVel *= 1.07;
  if (random(1) < 0.5) trX = TR_X1; else trX = TR_X2 - trAncho;
  if (trX == TR_X1) trDir = 1; else trDir = -1;
}

// ---- 3. Duelo de reflejos vs Camilo: espera el ¡YA! y aprieta ESPACIO. Al mejor de 5. ----
int duRonda, duTuyas, duSuyas, duFase, duCambio, duTuTiempo, duElTiempo, duMejor;
String duTexto = "";

// Empieza el Duelo: dispara apenas la pantalla se ponga verde.
void iniciarDuelo() {
  empezarActividad(ACT_ARC_DUELO);
  duRonda = 1;
  duTuyas = 0;
  duSuyas = 0;
  duMejor = 0;
  nuevaRondaDuelo();
}

// Empieza una ronda del duelo con un tiempo de espera al azar.
void nuevaRondaDuelo() {
  duFase = 0;
  duCambio = millis() + int(random(1500, 4000));
  duTexto = "Prepárate...";
}

// Dibuja el duelo (rojo esperar, verde disparar).
void dibujarDuelo() {
  noStroke();
  if (duFase == 1) fill(color(40, 140, 60)); else fill(color(60, 20, 30));
  rect(0, 0, ANCHO, ALTO);
  if (duFase == 0 && millis() >= duCambio) { duFase = 1; duCambio = millis(); duTexto = "¡YA!"; }
  if (duFase == 1) {

    duElTiempo = int(random(210, 330) - duRonda * 6);
    if (millis() - duCambio > duElTiempo + 60) { duSuyas++; duTexto = "Camilo fue más rápido (" + duElTiempo + " ms)"; finRondaDuelo(); }
  }
  if (duFase == 2 && millis() >= duCambio) {
    if (duTuyas >= 3 || duSuyas >= 3) {
      boolean gano = duTuyas >= 3;
      if (gano) cambiarAmistad(personaIndice("Camilo"), DUELO_AMISTAD_CAMILO);
      int aux1;
      if (gano) aux1 = DUELO_PREMIO; else aux1 = 0;
      String aux2;
      if (gano) {
        aux2 = "¡Le ganaste a Camilo " + duTuyas + "-" + duSuyas + "!";
      } else {
        aux2 = "Camilo ganó " + duSuyas + "-" + duTuyas + ". Pide la revancha.";
      }
      terminarArcade(duMejor, aux1, aux2);
      return;
    }
    duRonda++;
    nuevaRondaDuelo();
  }
  cargarSprites11();
  if (hay(px_dueloVaquero)) {
    boolean camiloGana = duFase == 2 && (empiezaCon(duTexto, "Camilo") || posicionDe(duTexto, "adelant") >= 0);
    boolean tuGanas = duFase == 2 && !camiloGana;
    int fTu;
    if (tuGanas) fTu = 1; else if (camiloGana) fTu = 2; else fTu = 0;
    int fCa;
    if (camiloGana) fCa = 1; else if (tuGanas) fCa = 2; else fCa = 0;
    tira(px_dueloVaquero, 3, fTu, 260, 420, 240, 300);
    tiraEspejo(px_dueloVaquero, 3, fCa, 1100, 420, 240, 300, true);
  }
  fill(255);
  textAlign(CENTER, CENTER);
  textSize(90);
  if (duTexto.equals("¡YA!")) text("¡YA!", 800, 380); else text("", 800, 380);
  textSize(34);
  if (!duTexto.equals("¡YA!")) text(duTexto, 800, 400);
  textSize(28);
  text("Ronda " + duRonda + " · Tú " + duTuyas + " - " + duSuyas + " Camilo", 800, 160);
  textSize(20);
  text("ESPACIO cuando salga ¡YA! (si te adelantas, pierdes la ronda)", 800, 820);
  textAlign(LEFT, BASELINE);
}

// Termina la ronda del duelo.
void finRondaDuelo() {
  duFase = 2;
  duCambio = millis() + 1400;
}

// ESPACIO en el duelo: si fue antes de tiempo pierdes la ronda.
void teclaDuelo() {
  if (key != ' ') return;
  if (duFase == 0) { duSuyas++; duTexto = "¡Te adelantaste!"; finRondaDuelo(); }
  else if (duFase == 1) {
    duTuTiempo = millis() - duCambio;
    if (duTuTiempo <= duElTiempo) { duTuyas++; duTexto = "¡Ganaste la ronda! " + duTuTiempo + " ms"; }
    else { duSuyas++; duTexto = "Camilo: " + duElTiempo + " ms · tú: " + duTuTiempo + " ms"; }
    if (duMejor == 0 || duTuTiempo < duMejor) duMejor = duTuTiempo;
    finRondaDuelo();
  }
}

