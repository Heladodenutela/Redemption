// Imagen de una publicación (se carga la primera vez).
PImage fotoSubida(String id) {
  int n = tamTexto(fotoNombre);
  for (int i = 0; i < n; i++) if (fotoNombre[i].equals(id)) return fotoImg[i];
  if (n >= fotoNombre.length) return null;
  PImage img = cargarSiExiste("extras/fotos/aurora/" + id + ".png");
  if (img != null && img.width > 1) fotoImg[n] = img; else fotoImg[n] = null;
  agregarTexto(fotoNombre, id);
  return fotoImg[n];
}

