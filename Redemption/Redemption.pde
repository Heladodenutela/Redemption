// Dibuja la foto con el filtro y el recorte elegidos.
void dibujarVistaPrevia() {
  PImage img;
  if (ftFiltro == 2 && ftGris != null) img = ftGris; else img = imagenFoto(ftFoto);
  float px = 80, py = 150, pw = 720, ph = 405;
  noStroke();
  fill(255);
  rect(px - 12, py - 12, pw + 24, ph + 24, 14);
  if (hay(img)) {
    if (ftFiltro == 1) tint(255, 225, 190);
    if (ftFiltro == 3) tint(255, 200, 255);
    if (ftRecorte == 0) image(img, px, py, pw, ph);
    else if (ftRecorte == 1) image(img, px, py, pw, ph, img.width / 8, img.height / 8, img.width * 7 / 8, img.height * 7 / 8);
    else image(img, px, py, pw, ph, img.width / 4, img.height / 5, img.width * 3 / 4, img.height * 3 / 5);
    noTint();
  } else {
    if (ftRecorte == 0) miniatura(ftFoto, px, py, pw, ph);
    else if (ftRecorte == 1) miniatura(ftFoto, px + pw / 16, py + ph / 16, pw * 7 / 8, ph * 7 / 8);
    else miniatura(ftFoto, px + pw / 4, py + ph / 5, pw / 2, ph * 3 / 5);
    noStroke();
    if (ftFiltro == 1) { fill(255, 170, 90, 60); rect(px, py, pw, ph); }
    if (ftFiltro == 2) { fill(128, 128, 128, 150); rect(px, py, pw, ph); }
    if (ftFiltro == 3) { fill(255, 60, 220, 60); rect(px, py, pw, ph); }
  }

  String[] f = FOTOS_GALERIA[ftFoto];
  textAlign(LEFT, TOP);
  fill(110);
  textSize(17);
  if (f[FG_SALEN].equals("")) {
    text("En la foto no sale nadie más.", px, py + ph + 26);
  } else {
    text("Salen: " + f[FG_SALEN].replace("/", ", "), px, py + ph + 26);
  }
  if (ftPie >= 0) {
    fill(40);
    textSize(21);
    text("“" + f[FG_PIE + ftPie] + "”", px, py + ph + 56, pw, 60);
  }
  if (ftEtiqueta >= 0) {
    fill(110, 80, 200);
    textSize(17);
    text("Etiquetas: " + textoEtiqueta(ftFoto, ftEtiqueta), px, py + ph + 122, pw, 50);
  }
  textAlign(LEFT, BASELINE);
}

