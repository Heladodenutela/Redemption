// Dibuja el cuadro 0 de la hoja del producto ajustado a un cuadrado de "tam"
void dibujarIconoProducto(String producto, float x, float y, float tam) {
  if (dibujarIconoPropio(producto, x, y, tam)) return;
  String hoja = null;
  for (int k = 0; k < PRODUCTO_IMG.length; k++) if (PRODUCTO_IMG[k][0].equals(producto)) hoja = PRODUCTO_IMG[k][1];
  if (hoja == null) return;
  for (int k = 0; k < VISOR_DATOS.length; k++) {
    if (VISOR_DATOS[k][0].equals(hoja)) {
      PImage img = hojaPorNombre(hoja);
      if (img == null || img.width <= 1) return;
      int cw = int(VISOR_DATOS[k][2]), ch = int(VISOR_DATOS[k][3]);
      float e = min(tam / cw, tam / ch);
      image(img, x + (tam - cw * e) / 2, y + (tam - ch * e) / 2, cw * e, ch * e, 0, 0, cw, ch);
      return;
    }
  }
}

// ============================ MINIJUEGO DE ESTUDIAR (concentración) ============================
// Mantén el cursor dentro del círculo que se mueve. Salen distracciones (el celular vibra):
// ciérralas con click en la X o el círculo se esconde un rato. Con poca energía cabeceas.
float estCX, estCY, estDentroMs, estTotalMs;
int estUltimo, estDistNace, estDistSiguiente, estCiegoHasta, estCabeceoHasta, estCabeceoSiguiente;
float estDistX, estDistY;
String estDistTexto = "";
boolean estDistViva = false;
int estNotasGanadas;
float estPorcentaje;
String[] DISTRACCIONES = { "Charla: 12 mensajes nuevos", "Aurora+: te etiquetaron en una foto", "ClipU: un video más...",
  "Camilo: ¿ranked?", "Lili: ¿me prestas tu cargador?", "Confesiones: hay chisme nuevo", "Tu racha se va a perder" };

// Empieza el minijuego de estudiar en el escritorio.
void empezarSesionEstudio() {
  empezarActividad(ACT_ESTUDIO_JUEGO);
  estDentroMs = 0;
  estTotalMs = 0;
  estUltimo = millis();
  estDistViva = false;
  estDistSiguiente = millis() + int(random(1500, ESTUDIO_DISTRACCION_MS));
  estCiegoHasta = 0;
  estCabeceoHasta = 0;
  estCabeceoSiguiente = millis() + int(random(3000, 6000));
}

// Dibuja el estudio: mantén el mouse en la zona de concentración y cierra las distracciones.
void dibujarEstudioJuego() {
  int ahora = millis();
  int t = ahora - actividadInicio;
  int dt = ahora - estUltimo;
  estUltimo = ahora;
  boolean cansado = stats[ST_ENERGIA] < ENERGIA_CABECEO;
  float vel;
  if (cansado) vel = ESTUDIO_VEL * 1.35 * (1 + deudaSueno * 0.1); else vel = ESTUDIO_VEL * 1 * (1 + deudaSueno * 0.1);

  float tt = t * 0.001 * vel;
  estCX = 800 + 380 * sin(tt * 0.9) + 120 * sin(tt * 2.3 + 1);
  estCY = 420 + 170 * sin(tt * 1.3 + 2) + 60 * cos(tt * 2.9);

  noStroke();
  fill(0, 0, 0, 150);
  rect(0, 0, ANCHO, ALTO);
  cargarSprites11();
  if (hay(es_libro)) image(es_libro, 250, 140, 1100, 600);
  else {
    fill(250, 248, 238);
    rect(250, 140, 1100, 600, 14);
    stroke(190, 210, 235);
    for (float y = 180; y < 740; y += 34) line(270, y, 1330, y);
    noStroke();
  }

  boolean ciego = ahora < estCiegoHasta;
  boolean dentro = dist(mouseX, mouseY, estCX, estCY) < ESTUDIO_RADIO;
  if (!ciego) {
    if (dentro) fill(color(120, 210, 140, 160)); else fill(color(255, 170, 90, 150));
    ellipse(estCX, estCY, ESTUDIO_RADIO * 2, ESTUDIO_RADIO * 2);
    fill(40);
    textSize(18);
    textAlign(CENTER, CENTER);
    if (dentro) text("concentrado", estCX, estCY); else text("¡vuelve!", estCX, estCY);
  }
  estTotalMs += dt;
  if (dentro && !ciego && ahora >= estCabeceoHasta) estDentroMs += dt;

  if (!estDistViva && ahora >= estDistSiguiente) {
    estDistViva = true;
    estDistNace = ahora;
    estDistX = random(300, 1000);
    estDistY = random(170, 600);
    estDistTexto = DISTRACCIONES[int(random(DISTRACCIONES.length))];
  }
  if (estDistViva) {
    float sx = estDistX + random(-3, 3);
    fill(255);
    stroke(120);
    rect(sx, estDistY, 360, 80, 12);
    noStroke();
    fill(30);
    textSize(18);
    textAlign(LEFT, CENTER);
    boolean conIcono = tira(es_distracciones, 6, iconoDistraccion(estDistTexto), sx + 8, estDistY + 8, 64, 64);
    if (conIcono) text(estDistTexto, sx + 80, estDistY + 40); else text(estDistTexto, sx + 16, estDistY + 40);
    fill(220, 70, 70);
    rect(sx + 320, estDistY + 8, 32, 32, 8);
    fill(255);
    textAlign(CENTER, CENTER);
    text("X", sx + 336, estDistY + 23);
    fill(255, 90, 90);
    rect(sx + 10, estDistY + 72, 340 * (1 - (ahora - estDistNace) / (float) ESTUDIO_DISTRACCION_VIDA), 4);
    if (ahora - estDistNace > ESTUDIO_DISTRACCION_VIDA) {
      estDistViva = false;
      estCiegoHasta = ahora + ESTUDIO_CIEGO_MS;
      estDistSiguiente = ahora + int(random(ESTUDIO_DISTRACCION_MS * 0.6, ESTUDIO_DISTRACCION_MS * 1.4));
    }
  }

  if (cansado && ahora >= estCabeceoSiguiente) {
    estCabeceoHasta = ahora + 900;
    estCabeceoSiguiente = ahora + int(random(3500, 7000));
  }
  if (ahora < estCabeceoHasta) {
    fill(0, 0, 0, 220);
    rect(0, 0, ANCHO, ALTO);
  }

  fill(255);
  textSize(24);
  textAlign(LEFT, BASELINE);
  text("Estudiando · mantén el cursor en el círculo · cierra las distracciones con la X", 250, 120);
  textAlign(RIGHT, BASELINE);
  text("Concentración " + round(100 * estDentroMs / max(1, estTotalMs)) + " %   ·   " + max(0, (ESTUDIO_SESION_MS - t) / 1000) + " s", 1350, 790);
  textAlign(LEFT, BASELINE);
  if (cansado) { fill(255, 200, 120); text("Tienes poca energía: vas a cabecear", 250, 790); }
  if (t >= ESTUDIO_SESION_MS) terminarSesionEstudio();
}

// Click en el estudio: cierra la distracción que salió.
boolean clickEstudio() {
  if (!estDistViva) return true;
  if (mouseX > estDistX + 316 && mouseX < estDistX + 356 && mouseY > estDistY + 4 && mouseY < estDistY + 44) {
    estDistViva = false;
    estDistSiguiente = millis() + int(random(ESTUDIO_DISTRACCION_MS * 0.6, ESTUDIO_DISTRACCION_MS * 1.4));
  }
  return true;
}

// Termina el estudio y calcula cuántas notas subes según qué tan concentrado estuviste.
void terminarSesionEstudio() {
  hecho("ESTUDIO");
  estPorcentaje = estDentroMs / max(1, estTotalMs);
  float mult;
  if (mapaActual == U11) mult = ESTUDIO_MULT_BIBLIO; else mult = 1;
  estNotasGanadas = round(estPorcentaje * ESTUDIO_NOTAS_MAX * mult);
  cambiarStat(ST_NOTAS, estNotasGanadas);
  cambiarStat(ST_ENERGIA, -ESTUDIO_ENERGIA_SESION);
  empezarActividad(ACT_ESTUDIO_FIN);
}

// Dibuja el resultado de la sesión de estudio.
void dibujarEstudioFin() {
  ventana(500, 280, 600, 300, "Sesión de estudio");
  fill(40);
  textSize(26);
  text("Concentración: " + round(estPorcentaje * 100) + " %", 540, 380);
  if (mapaActual == U11) {
    text("Notas +" + estNotasGanadas + ("  (biblioteca ×" + ESTUDIO_MULT_BIBLIO + ")"), 540, 425);
  } else {
    text("Notas +" + estNotasGanadas + "", 540, 425);
  }
  text("Energía −" + ESTUDIO_ENERGIA_SESION, 540, 470);
  fill(110);
  textSize(20);
  text("[E] otra sesión · [Q] levantarte", 540, 550);
}

