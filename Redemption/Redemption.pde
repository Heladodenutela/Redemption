// Quita los corchetes de un texto como '[acción]'.
String sinCorchetes(String t) {
  t = quitarBordes(t);
  if (empiezaCon(t, "[") && terminaCon(t, "]")) return t.substring(1, t.length() - 1);
  return t;
}

