final int ACT_FUTBOL = 50, ACT_NATACION = 51, ACT_DEPORTE_RES = 52;
final String ACC_FUTBOL = "FUTBOL", ACC_NADAR = "NADAR", ACC_CASILLEROS = "CASILLEROS", ACC_DUCHAS = "DUCHAS";

// ============================ COPA AURORA ============================
// { día, hora, deporte, ronda, dificultad (1-6), rival, premio, mapa }
String[][] COPA = {
  {"4", "15:00", "Rugby", "Cuartos", "1", "Ingeniería B", "8", "D2"},
  {"5", "15:00", "Fútbol", "Cuartos", "2", "Arquitectura", "8", "D1"},
  {"6", "10:00", "Natación", "Cuartos", "3", "Biología", "8", "D3"},
  {"6", "16:00", "Rugby", "Semifinal", "3", "Derecho", "12", "D2"},
  {"7", "10:00", "Fútbol", "Semifinal", "4", "Economía", "12", "D1"},
  {"7", "16:00", "Natación", "Semifinal", "4", "Medicina", "12", "D3"},
  {"8", "15:00", "Rugby", "Final", "5", "Los Roca (Medicina)", "25", "D2"},
  {"9", "15:00", "Fútbol", "Final", "6", "Ingeniería A", "25", "D1"},
  {"9", "17:00", "Natación", "Final", "6", "Nadia (campeona)", "25", "D3"}
};
int[] copaEstado = new int[COPA.length];
int copaActual = -1;
int rugbyGanados = 0;

// Puntos que hay que sacar para ganar según la dificultad: 30, 40, 50, 60, 70 u 80
int umbralCopa(int dif) {
  return 20 + 10 * dif;
}

// ¿Estás inscrito en la Copa Aurora (o en el club de rugby)?
boolean inscrito(String deporte) {
  if (deporte.equals("Rugby") && bandera("CLUB_RUGBY") > 0) return true;
  return bandera("INSCRITO_COPA") > 0;
}

// ¿Ya te eliminaron de la Copa en este deporte?
boolean eliminado(String deporte) {
  for (int k = 0; k < COPA.length; k++) if (COPA[k][2].equals(deporte) && copaEstado[k] >= 2) return true;
  return false;
}

// Partido de este deporte que se puede jugar ahora en este mapa (-1 si no hay)
int partidoAhora(String deporte) {
  int m = minutoAhora();
  for (int k = 0; k < COPA.length; k++) {
    if (COPA[k][2].equals(deporte) && int(COPA[k][0]) == dia && copaEstado[k] == 0 && mapaPorCodigo(COPA[k][7]) == mapaActual) {
      int h = aMin(COPA[k][1]);
      if (m >= h - 30 && m <= h + 60) return k;
    }
  }
  return -1;
}

// Los partidos a los que no llegaste cuentan como perdidos
void revisarCopa() {
  int m = minutoAhora();
  for (int k = 0; k < COPA.length; k++) {
    if (int(COPA[k][0]) == dia && copaEstado[k] == 0 && m > aMin(COPA[k][1]) + 60 && inscrito(COPA[k][2]) && !eliminado(COPA[k][2])) {
      copaEstado[k] = 3;
      aviso("No llegaste al partido de " + COPA[k][2] + " (" + COPA[k][3] + "). Quedas fuera de la Copa.");
    }
  }
}

// ¿Empieza un partido de la Copa? si no, devuelve false y se juega una práctica
boolean empezarPartido(String deporte) {
  int k = partidoAhora(deporte);
  if (k < 0) { copaActual = -1; return false; }
  if (!inscrito(deporte)) { aviso("No estás inscrito en la Copa de " + deporte + ". Juegas de práctica."); copaActual = -1; return false; }
  if (eliminado(deporte)) { aviso("Ya quedaste fuera en " + deporte + ". Juegas de práctica."); copaActual = -1; return false; }
  copaActual = k;
  aviso("Copa Aurora · " + deporte + " · " + COPA[k][3] + " contra " + COPA[k][5]);
  return true;
}

// Resultado de un partido (o de una práctica)
void registrarPartido(boolean gano, String detalle) {
  if (copaActual >= 0) cambiarStat(ST_ENERGIA, -ENERGIA_PARTIDO); else cambiarStat(ST_ENERGIA, -ENERGIA_PRACTICA);
  catMedios[CAT_EJERCICIO] += MIN_PARTIDO * 2;
  if (copaActual < 0) {
    deporteTexto = "Práctica · " + detalle;
    deportePremio = "";
    return;
  }
  int k = copaActual;
  if (gano) copaEstado[k] = 1; else copaEstado[k] = 2;
  if (gano) {
    int premio = int(COPA[k][6]);
    dinero += premio;
    cambiarStat(ST_SOCIAL, 3);
    cambiarStat(ST_SEGUIDORES, 10);
    sumarBandera("VICTORIA", 1);
    if (COPA[k][2].equals("Rugby")) rugbyGanados++;
    boolean trofeo = true;
    for (int j = 0; j < COPA.length; j++) if (COPA[j][2].equals(COPA[k][2]) && copaEstado[j] != 1) trofeo = false;
    if (trofeo) sumarBandera("TROFEO_" + COPA[k][2].toUpperCase(), 1);
    if (trofeo) {
      deportePremio = "¡Ganaste! Premio $" + premio + (" · ¡TROFEO de " + COPA[k][2] + "!");
    } else {
      deportePremio = "¡Ganaste! Premio $" + premio + " · pasas a la siguiente ronda";
    }
  } else {
    banderaValor0("VICTORIA");
    deportePremio = "Perdiste: quedas fuera de " + COPA[k][2] + ".";
    if (stats[ST_ENERGIA] < 30) { sumarBandera("HERIDA", 1); deportePremio += " Y te lastimaste (Herida)."; }
  }
  deporteTexto = COPA[k][2] + " · " + COPA[k][3] + " vs " + COPA[k][5] + " · " + detalle;
  copaActual = -1;
}

// Pone una bandera en 0.
void banderaValor0(String n) {
  int i = posBandera(n);
  if (i >= 0) banderaValor[i] = 0;
}

String deporteTexto = "", deportePremio = "";

// Dibuja el resultado de un partido.
