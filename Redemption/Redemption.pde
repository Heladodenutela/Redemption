// Prepara la galería de fotos la primera vez.
void iniciarGaleriaSiFalta() {
  if (galDesbloq != null) return;
  int n = FOTOS_GALERIA.length;
  galDesbloq = new boolean[n];
  galVista = new boolean[n];
  galSubida = new boolean[n];
  galLikes = new int[n];
  galPie = new String[n];
}

// ¿Esta foto aparece en la galería?
boolean fotoDeGaleria(int k) {
  return !FOTOS_GALERIA[k][FG_COND].equals("NUNCA");
}

// Número de una foto a partir de su código.
int indiceFoto(String id) {
  for (int k = 0; k < FOTOS_GALERIA.length; k++) if (FOTOS_GALERIA[k][FG_ID].equals(id)) return k;
  return 0;
}

// Una foto se desbloquea cuando se cumple su condición, y ya queda para siempre
void revisarGaleria() {
  iniciarGaleriaSiFalta();
  for (int k = 0; k < FOTOS_GALERIA.length; k++) {
    if (!galDesbloq[k] && fotoDeGaleria(k) && cumple(FOTOS_GALERIA[k][FG_COND])) {
      galDesbloq[k] = true;
      aviso("Galería · foto nueva: " + FOTOS_GALERIA[k][FG_TIT]);
    }
  }
}

// Cuántas fotos ya desbloqueaste.
int fotosDesbloqueadas() {
  iniciarGaleriaSiFalta();
  int n = 0;
  for (int k = 0; k < galDesbloq.length; k++) if (galDesbloq[k]) n++;
  return n;
}

// Cuántas fotos hay en total en la galería.
int fotosEnGaleria() {
  int n = 0;
  for (int k = 0; k < FOTOS_GALERIA.length; k++) if (fotoDeGaleria(k)) n++;
  return n;
}

int[] resGalLista;

// Las de la pestaña elegida: primero las que ya tienes, después las bloqueadas
// Deja el resultado en resGalLista.
void galLista() {
  int[] r = new int[FOTOS_GALERIA.length + 1];
  for (int pasada = 0; pasada < 2; pasada++) {
    for (int k = 0; k < FOTOS_GALERIA.length; k++) {
      if (fotoDeGaleria(k) && galDesbloq[k] == (pasada == 0) && !(galFiltro == 1 && !(galDesbloq[k] && !galSubida[k])) && !(galFiltro == 2 && !galSubida[k])) {
        agregarInt(r, k);
      }
    }
  }
  resGalLista = r;
}

// Abre la app Galería.
void abrirGaleria() {
  iniciarGaleriaSiFalta();
  revisarGaleria();
  cel = 19;
  galVer = -1;
  galPagina = 0;
}

// Imagen de una foto de la galería.
PImage imagenFoto(int k) {
  if (k < 0) return null;
  return fotoSubida(FOTOS_GALERIA[k][FG_ID]);
}

// Título de una foto de la galería.
String nombreFoto(int k) {
  if (k < 0) return ""; else return FOTOS_GALERIA[k][FG_TIT];
}

// ---------------------------- dibujo de una foto (o su recuadro si falta la imagen) ----------------------------
int[][] FOTO_TONOS = { {120, 170, 230}, {240, 160, 120}, {140, 200, 150}, {200, 140, 210}, {240, 200, 110}, {110, 190, 200}, {230, 130, 150}, {150, 150, 210} };

// Dibuja una foto pequeña (o un cuadro gris si falta la imagen).
void miniatura(int k, float x, float y, float w, float h) {
  PImage img = imagenFoto(k);
  noStroke();
  if (hay(img)) { image(img, x, y, w, h); return; }
  int[] c = FOTO_TONOS[k % FOTO_TONOS.length];
  fill(c[0], c[1], c[2]);
  rect(x, y, w, h, 6);
  fill(255, 255, 255, 120);
  ellipse(x + w * 0.76, y + h * 0.3, h * 0.28, h * 0.28);
  fill(c[0] * 0.7, c[1] * 0.7, c[2] * 0.7);
  triangle(x, y + h, x + w * 0.38, y + h * 0.42, x + w * 0.7, y + h);
  fill(c[0] * 0.55, c[1] * 0.55, c[2] * 0.55);
  triangle(x + w * 0.4, y + h, x + w * 0.68, y + h * 0.55, x + w, y + h);
  fill(0, 0, 0, 110);
  rect(x, y + h - min(30, h * 0.32), w, min(30, h * 0.32), 0, 0, 6, 6);
  fill(255);
  textSize(constrain(h * 0.13, 11, 26));
  textAlign(CENTER, CENTER);
  text(recortarA(FOTOS_GALERIA[k][FG_TIT], w - 12), x + w / 2, y + h - min(30, h * 0.32) / 2 - 1);
  textAlign(LEFT, BASELINE);
}

// Dibuja un candado sobre las fotos que faltan.
void candado(float cx, float cy, float s) {
  noFill();
  stroke(200, 200, 215);
  strokeWeight(s * 0.12);
  arc(cx, cy - s * 0.15, s * 0.6, s * 0.7, PI, TWO_PI);
  noStroke();
  fill(200, 200, 215);
  rect(cx - s * 0.42, cy - s * 0.15, s * 0.84, s * 0.62, s * 0.1);
  fill(60, 60, 75);
  ellipse(cx, cy + s * 0.12, s * 0.16, s * 0.16);
  strokeWeight(1);
}

