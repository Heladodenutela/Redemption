// Texto del epílogo del romance para el final.
String epilogoRomance() {
  if (bandera("CHISME_ROMANCE") > 0) return "Lo de coquetear con dos personas a la vez se supo por Confesiones Aurora. Las dos rutas se cerraron. La confianza no tiene botón de deshacer.";
  int p = -1;
  for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 3) p = k;
  if (p < 0) {
    for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] == 2) return "Con " + ROM_PERSONA[k] + " quedó algo pendiente: una cita bonita y un \"después hablamos\". El próximo semestre dirá.";
    return null;
  }
  String[] e = {
    "Sofía duerme un poco más desde que alguien le cubre los turnos del sábado. Los domingos son de los dos: café, termo y cero alarmas.",
    "Laura sacó 88 en el parcial y no lloró. Dice que fue porque alguien le enseñó que 88 también es bonito. Estudian juntos... y a veces no estudian.",
    "Marta subió una foto contigo sin filtro y sin etiquetas raras. Pie de foto: \"Este sí viene por mí, no por la fiesta\".",
    "Nadia y tú entrenan juntos a las 6 a. m. Ella sigue ganando. Tú sigues perdiendo. A ninguno de los dos le importa.",
    "Valentina terminó \"Capuchino de canela\" y la estrenó en el micrófono abierto. Al final dijo: \"Esta es para el que se quedaba hasta el cierre\". Todo el Grano te miró."
  };
  return e[p];
}

// Con quién terminaste en pareja (o -1).
int parejaFinal() {
  for (int k = 0; k < ROM_PERSONA.length; k++) if (romance[k] >= 3) return personaIndice(ROM_PERSONA[k]);
  return -1;
}

// ============================ EFECTOS EXTRA EN LAS ESCENAS ============================
// Además de lo del guion, las escenas entienden: "ROM>Sofía>2" (sube la ruta), "BLOQ>Sofía" (la cierra)
String aplicarEfectosV20(String ef, int persona) {
  if (ef == null) return "";
  String resto = "";
  partirPorLetra(ef, '·');
  String[] p = resPartirPorLetra;
  for (int i = 0; i < p.length; i++) {
    String q = quitarBordesProcessing(p[i]);
    if (empiezaCon(q, "ROM>")) { partirPorLetra(q, '>'); String[] r = resPartirPorLetra; subirRomance(r[1], int(r[2])); }
    else if (empiezaCon(q, "BLOQ>")) bloquearRomance(q.substring(5));
    else if (resto.equals("")) resto += "" + q; else resto += " · " + q;
  }
  return aplicarEfectos(resto, persona);
}

// ============================ LLUVIA (filtro + gotas hechas con código) ============================
boolean lloviendo = false;
int lluviaDia = -1, lluviaDesde = 0, lluviaHasta = 0;
float[] gotaX = new float[140], gotaY = new float[140], gotaV = new float[140];
boolean gotasListas = false;

// Los que no salen si llueve
String[] AUSENTES_LLUVIA = { "Esteban, corredor", "Valeria, niña con cometa", "Mateo, niño con globo", "Don Aurelio, pintor",
  "Pareja de ancianos en la banca", "Lalo, músico callejero", "Doña Lucha, con pan para las palomas", "Joaquín, ciclista" };

// Mapas al aire libre (ahí se ve la lluvia)
String EXTERIORES = "C1 I2 I3 I4 I6 I7 I8 U1 U2 U3 U15 P1 K1 K2 K3 K4 K5 K6 K7 K8 K9 D1 D2 D4 D7 F1 F2 F3 F4 F5";

// Cada mañana se decide si llueve (el día 8 llueve seguro: es la escena de Canela bajo la banca)
void decidirLluvia() {
  lluviaDia = dia;
  float azar = random(1);
  if (dia == 8) { lluviaDesde = 14 * 60; lluviaHasta = 19 * 60; }
  else if (dia != 1 && dia != 10 && azar < 0.28) {
    lluviaDesde = int(random(9, 16)) * 60;
    lluviaHasta = lluviaDesde + int(random(2, 5)) * 60;
  } else { lluviaDesde = 0; lluviaHasta = 0; }
  if (lluviaHasta > lluviaDesde) sumarBandera("LLUEVE_D" + dia, 1);
}

// ¿Esta persona no sale hoy por la lluvia o porque está enferma?
boolean ausentePorLluvia(String persona) {
  if (persona.equals(enfermoHoy)) return true;
  if (!lloviendo) return false;
  for (int i = 0; i < AUSENTES_LLUVIA.length; i++) if (AUSENTES_LLUVIA[i].equals(persona)) return true;
  return false;
}

// ¿El mapa es al aire libre (para la lluvia)?
boolean esExterior(int m) {
  return posicionDe(EXTERIORES, MAPA_COD[m] + " ") >= 0 || terminaCon(EXTERIORES, MAPA_COD[m]);
}

// Prende o apaga la lluvia según la hora (si hoy llueve).
void actualizarLluvia() {
  if (lluviaDia != dia) decidirLluvia();
  int m = minutoAhora();
  boolean antes = lloviendo;
  lloviendo = m >= lluviaDesde && m < lluviaHasta;
  if (lloviendo && !antes && esExterior(mapaActual)) aviso("Empezó a llover. Algunos planes al aire libre se cancelan.");
}

// Dibuja la lluvia (filtro gris y gotas) en los mapas al aire libre.
void dibujarClima() {
  if (!lloviendo || !esExterior(mapaActual)) return;
  if (!gotasListas) {
    for (int i = 0; i < gotaX.length; i++) { gotaX[i] = random(ANCHO); gotaY[i] = random(ALTO); gotaV[i] = random(14, 24); }
    gotasListas = true;
  }
  noStroke();
  fill(60, 80, 115, 70);
  rect(0, 0, ANCHO, ALTO);
  stroke(200, 215, 240, 150);
  strokeWeight(2);
  float piso = aPantallaY(pisoMapa[mapaActual]);
  for (int i = 0; i < gotaX.length; i++) {
    line(gotaX[i], gotaY[i], gotaX[i] - 3, gotaY[i] + 12);
    gotaY[i] += gotaV[i] * pasoCuadro;
    gotaX[i] -= 1.5 * pasoCuadro;
    if (gotaY[i] > piso + random(-20, 60)) {

      noFill();
      ellipse(gotaX[i], gotaY[i], 10, 3);
      gotaY[i] = random(-60, 0);
      gotaX[i] = random(ANCHO + 40);
    }
  }
  strokeWeight(1);
  noStroke();
}

