PImage iconosLogros = null;
boolean iconosLogrosBuscados = false;

// Dibuja la medalla de un logro con su ícono (o con figuras).
void dibujarMedallaLogro(int i, float x, float y, float d, boolean hecha) {
  if (!iconosLogrosBuscados) { iconosLogrosBuscados = true; iconosLogros = cargarSiExiste("extras/interfaz/logros/iconos_logros.png"); }
  if (i < 0 || !hay(iconosLogros) || (i / 8) * 80 + 80 > iconosLogros.height) { dibujarMedalla(x, y, d, hecha); return; }
  float t = d * 1.5;
  if (!hecha) tint(110, 110, 120, 150);
  image(iconosLogros, x - t / 2, y - t / 2, t, t, (i % 8) * 80, (i / 8) * 80, (i % 8) * 80 + 80, (i / 8) * 80 + 80);
  noTint();
}

// Dibuja una medalla con figuras (roja si está ganada, gris si no).
void dibujarMedalla(float x, float y, float d, boolean hecha) {
  noStroke();
  if (hecha) fill(color(200, 60, 60)); else fill(color(90));
  triangle(x - d * 0.3, y - d * 0.9, x + d * 0.3, y - d * 0.9, x, y - d * 0.2);
  if (hecha) fill(color(245, 195, 60)); else fill(color(120));
  ellipse(x, y, d, d);
  if (hecha) fill(color(255, 230, 140)); else fill(color(150));
  ellipse(x, y, d * 0.6, d * 0.6);
}

// ============================ PAUSA (ESC o P) ============================
boolean pausado = false;
int pausaDesde = 0;
int pausaPestana = 0;
boolean pausaSalir = false;
String[] PAUSA_PESTANAS = { "Resumen", "Logros", "Notas", "Ajustes", "Controles" };
final float PZ_X = 180, PZ_Y = 60, PZ_W = 1240, PZ_H = 780;

// Abre o cierra la pausa (el reloj se detiene mientras está abierta).
void alternarPausa() {
  if (screen != 1) return;
  if (!pausado) {
    pausado = true;
    cel = 0;
    pausaDesde = millis();
    pausaSalir = false;
    revisarLogros();
  } else {
    pausado = false;
    int quieto = millis() - pausaDesde;
    desplazarTiempos(quieto);
    aplicarBalance();
  }
}

// Dibuja la pausa con sus pestañas: resumen, logros, ajustes, controles y tutorial.
void dibujarPausa() {
  noStroke();
  fill(10, 12, 25, 235);
  rect(0, 0, ANCHO, ALTO);
  fill(245, 240, 228);
  rect(PZ_X, PZ_Y, PZ_W, PZ_H, 16);
  fill(40);
  textSize(34);
  textAlign(LEFT, BASELINE);
  text("PAUSA", PZ_X + 30, PZ_Y + 50);
  textSize(18);
  fill(120);
  text("El reloj está quieto. Día " + dia + " · " + horaTexto(horaDelDia()) + " · Dificultad: " + DIF_NOMBRE[dificultad] + " (1 h = " + textoDuracionHora(dificultad) + ")", PZ_X + 160, PZ_Y + 48);

  for (int i = 0; i < PAUSA_PESTANAS.length; i++) {
    float x = PZ_X + 30 + i * 236, y = PZ_Y + 72;
    if (i == pausaPestana) fill(color(110, 80, 200)); else fill(color(220, 214, 200));
    rect(x, y, 226, 44, 10);
    if (i == pausaPestana) fill(255); else fill(50);
    textSize(20);
    textAlign(CENTER, CENTER);
    text(PAUSA_PESTANAS[i], x + 113, y + 21);
  }
  textAlign(LEFT, BASELINE);
  float cy = PZ_Y + 140;
  if (pausaPestana == 0) dibujarPausaResumen(cy);
  else if (pausaPestana == 1) dibujarPausaLogros(cy);
  else if (pausaPestana == 2) dibujarNotasRamos(PZ_X + 40, cy);
  else if (pausaPestana == 3) dibujarPausaAjustes(cy);
  else { dibujarPausaControles(cy); dibujarBotonTutorialPausa(); }

  botonPausa(PZ_X + 30, PZ_Y + PZ_H - 70, 360, 50, "Continuar  (ESC o P)", color(60, 150, 90));
  botonPausa(PZ_X + PZ_W / 2 - 180, PZ_Y + PZ_H - 70, 360, 50, "Guardar partida " + ranuraActual, color(70, 110, 180));
  if (pausaSalir) {
    botonPausa(PZ_X + PZ_W - 390, PZ_Y + PZ_H - 70, 360, 50, "¿Seguro? Click otra vez", color(190, 70, 60));
  } else {
    botonPausa(PZ_X + PZ_W - 390, PZ_Y + PZ_H - 70, 360, 50, "Salir", color(190, 70, 60));
  }
  dibujarMensajeGuardado();
}

