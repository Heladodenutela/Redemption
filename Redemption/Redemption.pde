    }
  }
}

// ============================ 14. BUSCAR A LA MAMÁ DE MATEO ============================
int[][] BU_CAMISA = { {240, 210, 40}, {60, 120, 220}, {220, 60, 60}, {80, 170, 90}, {240, 240, 240}, {150, 80, 180} };
String[] BU_CAMISA_N = { "amarilla", "azul", "roja", "verde", "blanca", "morada" };
int buRonda, buBien, buFin, buN;
float[] buX = new float[40], buY = new float[40];
int[] buCam = new int[40];
boolean[] buSombrero = new boolean[40], buBolso = new boolean[40];
int buObjetivo;
String buMsg = "";
int buMsgHasta = 0;

// Empieza el minijuego de buscar a la mamá de Mateo en la Plaza.
void iniciarBuscar() {
  buRonda = 0;
  buBien = 0;
  nuevaRondaBuscar();
}

// Nueva ronda: más gente en la Plaza.
void nuevaRondaBuscar() {
  buN = 16 + buRonda * 8;
  for (int i = 0; i < buN; i++) {
    buX[i] = random(140, 1460);
    buY[i] = random(260, 800);
    buCam[i] = int(random(BU_CAMISA.length));
    buSombrero[i] = random(1) < 0.4;
    buBolso[i] = random(1) < 0.4;
  }
  buObjetivo = int(random(buN));

  for (int i = 0; i < buN; i++) if (i != buObjetivo && buCam[i] == buCam[buObjetivo] && buSombrero[i] == buSombrero[buObjetivo] && buBolso[i] == buBolso[buObjetivo]) buBolso[i] = !buBolso[i];
  buFin = millis() + round(facil(15) * 1000);
}

// Describe a la persona que hay que encontrar (ropa, sombrero...).
String descripcionBuscar() {
  int k = buObjetivo;
  String aux1;
  if (buSombrero[k]) aux1 = ", con sombrero"; else aux1 = ", sin sombrero";
  String aux2;
  if (buBolso[k]) aux2 = " y cartera roja"; else aux2 = " y sin cartera";
  return "Camisa " + BU_CAMISA_N[buCam[k]] + aux1 + aux2;
}

// Click en una persona: ¿es ella?
void clickBuscar() {
  for (int i = 0; i < buN; i++) {
    if (!(dist(mouseX, mouseY, buX[i], buY[i] - 30) > 34)) {
      if (i == buObjetivo) { buBien++; buMsg = "¡Es ella! Mateo corre a abrazarla."; }
      else buMsg = "No es ella...";
      buMsgHasta = millis() + 1100;
      if (i == buObjetivo || true) { buRonda++; if (buRonda < 3) nuevaRondaBuscar(); }
      return;
    }
  }
}

// Dibuja la Plaza llena de gente y la descripción.
void dibujarBuscar() {
  if (buRonda < 3) {
    fondoMJ(210, 200, 180, "LA PLAZA LLENA · ¿dónde está la mamá de Mateo? (" + min(buRonda + 1, 3) + "/3)", "Mateo dice: " + descripcionBuscar());
  } else {
    fondoMJ(210, 200, 180, "LA PLAZA LLENA · ¿dónde está la mamá de Mateo? (" + min(buRonda + 1, 3) + "/3)", "Mateo dice: " + "");
  }
  int resta = buFin - millis();
  if (buRonda < 3) barraTiempoMJ(resta / (facil(15) * 1000));
  if (buRonda >= 3 && millis() > buMsgHasta) {
    if (buBien >= 2) {
      finMJ(round(100.0 * buBien / 3), "La encontraste. La mamá de Mateo no para de darte las gracias.");
    } else {
      finMJ(round(100.0 * buBien / 3), "Julián la encontró por el altavoz. Mateo te regala su globo igual.");
    }
    return;
  }
  if (resta <= 0 && buRonda < 3) { buRonda++; buMsg = "Se te perdió entre la gente..."; buMsgHasta = millis() + 1000; if (buRonda < 3) nuevaRondaBuscar(); }
  noStroke();
  for (int i = 0; i < buN && buRonda < 3; i++) {
    int[] c = BU_CAMISA[buCam[i]];
    fill(c[0], c[1], c[2]);
    rect(buX[i] - 16, buY[i] - 40, 32, 46, 6);
    fill(230, 190, 150);
    ellipse(buX[i], buY[i] - 56, 26, 26);
    if (buSombrero[i]) { fill(90, 60, 30); rect(buX[i] - 18, buY[i] - 74, 36, 8); rect(buX[i] - 10, buY[i] - 86, 20, 14); }
    if (buBolso[i]) { fill(200, 30, 40); rect(buX[i] + 12, buY[i] - 26, 12, 16, 3); }
    fill(60);
    rect(buX[i] - 12, buY[i] + 6, 9, 22);
    rect(buX[i] + 3, buY[i] + 6, 9, 22);
  }
  if (millis() < buMsgHasta) {
    fill(0, 0, 0, 170);
    rect(500, 820, 600, 54, 10);
    fill(255);
    textSize(24);
    textAlign(CENTER, CENTER);
    text(buMsg, 800, 846);
    textAlign(LEFT, BASELINE);
  }
}

// ============================ 15. RONDO (Rojas) ============================
// El defensa tapa a dos compañeros (en rojo): pásale a uno libre (verde) antes de que se acabe el tiempo.
float[][] RO_POS = { {800, 220}, {1180, 480}, {800, 760}, {420, 480} };
int roPase, roBien, roHasta;
boolean[] roTapado = new boolean[4];
String roMsg = "";
int roMsgHasta = 0;

// Empieza el rondo de fútbol con Rojas.
void iniciarRondo() {
  roPase = 0;
  roBien = 0;
  nuevoPaseRondo();
}

// Nuevo pase: uno de los 4 compañeros queda tapado.
void nuevoPaseRondo() {
  for (int i = 0; i < 4; i++) roTapado[i] = false;
  int a = int(random(4));
  roTapado[a] = true;
  roTapado[(a + 1 + int(random(3))) % 4] = true;
  roHasta = millis() + round(facil(1700 - roPase * 70));
}

// Click en el compañero al que le pasas (no al tapado).
void clickRondo() {
  for (int i = 0; i < 4; i++) {
    if (!(dist(mouseX, mouseY, RO_POS[i][0], RO_POS[i][1]) > 60)) {
      if (!roTapado[i]) { roBien++; roMsg = "¡Pase limpio!"; } else roMsg = "¡Interceptado!";
      roMsgHasta = millis() + 500;
      roPase++;
      if (roPase < 12) nuevoPaseRondo();
      return;
    }
  }
}

// Dibuja el rondo con los compañeros y el tapado.
void dibujarRondo() {
  fondoMJ(70, 140, 70, "RONDO CON ROJAS (" + min(roPase + 1, 12) + "/12)", "Click en un compañero LIBRE (verde). El defensa tapa a los rojos. ¡Rápido!");
  if (roPase >= 12) {
    if (roBien >= 8) {
      finMJ(round(100.0 * roBien / 12), "Rojas: \"¡Eso es fútbol! Toque y toque.\"");
    } else {
      finMJ(round(100.0 * roBien / 12), "Rojas: \"Cabeza arriba antes de recibir, joven.\"");
    }
    return;
  }
  if (millis() > roHasta) { roMsg = "¡Muy lento!"; roMsgHasta = millis() + 500; roPase++; if (roPase < 12) nuevoPaseRondo(); return; }
  noStroke();
  stroke(255, 255, 255, 90);
  noFill();
  ellipse(800, 490, 820, 600);
  noStroke();
  for (int i = 0; i < 4; i++) {
    if (roTapado[i]) fill(color(220, 70, 60)); else fill(color(80, 220, 120));
    ellipse(RO_POS[i][0], RO_POS[i][1], 100, 100);
    fill(255);
    textSize(18);
    textAlign(CENTER, CENTER);
    if (roTapado[i]) text("tapado", RO_POS[i][0], RO_POS[i][1]); else text("libre", RO_POS[i][0], RO_POS[i][1]);
  }
  fill(30, 30, 160);
  ellipse(800 + 30 * sin(cuadros * 0.2), 490, 80, 80);
  fill(255);
  ellipse(800, 560, 34, 34);
  textAlign(LEFT, BASELINE);
  float frac = (roHasta - millis()) / facil(1700 - roPase * 70);
  fill(255, 230, 120);
  rect(700, 600, 200 * constrain(frac, 0, 1), 12, 6);
  if (millis() < roMsgHasta) { fill(255); textSize(28); text(roMsg, 60, 860); }
}

// ============================ 16. RESPIRAR (Paz y Nadia) ============================
// Mantén ESPACIO (o el click) mientras el círculo crece; suéltalo cuando se encoja.
boolean rsPresionado = false;
int rsInicio, rsCiclos = 5;
float rsBien, rsTotal;

// Empieza el minijuego de respirar.
void iniciarRespira() {
  rsInicio = millis();
  rsBien = 0;
  rsTotal = 0;
  rsPresionado = false;
}

// Dibuja el círculo que crece y se encoge: mantén ESPACIO al inhalar y suelta al exhalar.
void dibujarRespira() {
  if (escPersonaNombre().equals("")) {
    fondoMJ(40, 110, 150, "RESPIRAR · " + "con Paz", "Mantén ESPACIO (o el click) mientras el círculo crece (inhala). Suelta cuando se encoja (exhala).");
  } else {
    fondoMJ(40, 110, 150, "RESPIRAR · " + ("con " + escPersonaNombre()), "Mantén ESPACIO (o el click) mientras el círculo crece (inhala). Suelta cuando se encoja (exhala).");
  }
  float ciclo = 6000 / max(0.7, difMult);
  float t = (millis() - rsInicio) % ciclo / ciclo;
  int n = int((millis() - rsInicio) / ciclo);
  boolean inhala = t < 0.5;
  float r;
  if (inhala) r = 120 + 260 * (t / 0.5); else r = 380 - 260 * ((t - 0.5) / 0.5);
  boolean bien = (inhala && rsPresionado) || (!inhala && !rsPresionado);
  rsTotal++;
  if (bien) rsBien++;
  noStroke();
  if (bien) fill(color(150, 230, 210, 160)); else fill(color(240, 140, 120, 160));
  ellipse(800, 490, r * 2, r * 2);
  fill(255);
  textSize(36);
  textAlign(CENTER, CENTER);
  if (inhala) text("Inhala...", 800, 490); else text("Exhala...", 800, 490);
  textSize(20);
  text("Ciclo " + min(n + 1, rsCiclos) + " de " + rsCiclos + "   ·   al ritmo: " + round(100 * rsBien / max(1, rsTotal)) + " %", 800, 860);
  textAlign(LEFT, BASELINE);
  if (n >= rsCiclos) {
    int p = round(100 * rsBien / max(1, rsTotal));
    if (p >= 70) {
      finMJ(p, "El pulso baja. Los hombros también. \"Así se empieza\".");
    } else {
      finMJ(p, "Te cuesta soltar el aire. Es normal: se entrena.");
    }
  }
}

// Nombre de la persona principal de la escena.
String escPersonaNombre() {
  if (scePersona >= 0) return nombreCorto(scePersona); else return "";
}

