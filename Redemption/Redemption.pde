// Pasa un texto 'hh:mm' a minutos desde la medianoche.
int aMin(String hhmm) {
  partirPorLetra(quitarBordes(hhmm), ':');
  String[] p = resPartirPorLetra;
  if (p.length > 1) return int(p[0]) * 60 + int(p[1]); else return int(p[0]) * 60 + 0;
}

// Pasa minutos desde la medianoche a texto 'h:mm'.
String aHora(int m) {
  m = ((m % 1440) + 1440) % 1440;
  return (m / 60) + ":" + nf(m % 60, 2);
}

// ¿El día d está en la lista de días (por ejemplo '1,3,5' o '2-4')?
boolean diaEn(String dias, int d) {
  partirPorLetra(dias, ',');
  String[] partes = resPartirPorLetra;
  for (int k = 0; k < partes.length; k++) {
    String p = quitarBordes(partes[k]);
    int g = posicionDe(p, "-");
    if (g > 0) { if (d >= int(p.substring(0, g)) && d <= int(p.substring(g + 1))) return true; }
    else if (p.length() > 0 && int(p) == d) return true;
  }
  return false;
}

// Minuto actual del día (0 a 1439).
int minutoAhora() {
  return horaDelDia() / 2;
}

// ¿Esta fila de horario está abierta ahora? (el día del juego cambia a las 5:00, así que la madrugada sigue siendo "hoy")
boolean ventanaAbierta(String[] h, int d, int m) {
  int a = aMin(h[3]), c = aMin(h[4]);
  if (!diaEn(h[2], d)) return false;
  if (a <= c) return m >= a && m < c;
  return m >= a || m < c;
}

// 1 abierto, 0 cerrado, -1 no tiene horario (siempre abierto)
int estadoHorario(String tipo, String nombre, String mapaCod) {
  boolean hay = false;
  int m = minutoAhora();
  for (int k = 0; k < HORARIOS.length; k++) {
    String[] h = HORARIOS[k];
    if (h[0].equals(tipo) && h[1].equals(nombre) && !(tipo.equals("NPC") && !h[5].equals("") && !h[5].equals(mapaCod))) {
      hay = true;
      if (ventanaAbierta(h, dia, m)) return 1;
    }
  }
  if (hay) return 0; else return -1;
}

// ¿El lugar o la tienda está abierto ahora?
boolean abierto(String tipo, String nombre) {
  return estadoHorario(tipo, nombre, "") != 0;
}

// "Abre a las 10:00" / "hoy ya no abre"
String proximaApertura(String tipo, String nombre) {
  int m = minutoAhora(), mejor = 99999;
  for (int k = 0; k < HORARIOS.length; k++) {
    String[] h = HORARIOS[k];
    if (h[0].equals(tipo) && h[1].equals(nombre) && diaEn(h[2], dia)) {
      int a = aMin(h[3]);
      if (a > m && a < mejor) mejor = a;
    }
  }
  if (mejor < 99999) return "abre a las " + aHora(mejor);
  return "hoy ya no abre";
}

// ¿Por qué no se puede usar esta conexión? (null = sí se puede)
String motivoCerrado(int c) {
  if (conexiones[c][CX_MODO] == BUS && !abierto("BUS", "BUS")) return "El bus no pasa a esta hora (pasa de 5:00 a 23:00)";
  String cod = MAPA_COD[conexiones[c][CX_DESTINO]];
  if (abierto("MAPA", cod)) return null;
  if (vaHaciaLaCasa(c)) return null;
  return MAPA_NOMBRE[conexiones[c][CX_DESTINO]] + " está cerrado · " + proximaApertura("MAPA", cod);
}

// ¿El objeto se puede usar ahora? (por su propio horario o porque todas sus puertas llevan a algo cerrado)
String motivoObjetoCerrado(int o) {
  if (!abierto("OBJ", objNombre[o])) return objNombre[o] + " está cerrado · " + proximaApertura("OBJ", objNombre[o]);
  opciones(mapaActual, INTERACCION, o);
  int[] l = resOpciones;
  if (tamInt(l) == 0) return null;
  for (int i = 1; i <= tamInt(l); i++) if (motivoCerrado(l[i]) == null) return null;
  return motivoCerrado(l[1]);
}

// ============================ BANDERAS Y EFECTOS ============================
// Banderas del guion (VICIO, RISA_SOFÍA, MALA_REPUTACIÓN...) con un número cada una.
// Se guardan en dos vectores paralelos: banderaNombre (el nombre) y banderaValor (el número).
// Para no recorrer los 12000 nombres cada vez que se pregunta por una, se usa una imitación de
// tabla hash hecha con vectores: codigoBandera() convierte el nombre en un número de casilla y
// posBandera() busca en el vector banderaIndice desde esa casilla. Casi siempre la encuentra en un paso.
final int MAX_BANDERAS = 12000;
final int BAND_TABLA = 32768;
String[] banderaNombre = new String[MAX_BANDERAS];
int[] banderaValor = new int[MAX_BANDERAS];
int[] banderaIndice = new int[BAND_TABLA];
int banderasN = 0;
int faltas = 0;

// Parte de la imitación de tabla hash: convierte el nombre en un número de casilla (de 0 a BAND_TABLA - 1)
// recorriendo el nombre letra por letra con sumas, multiplicaciones y residuo (%). Con 9 y 25 ningún par de nombres del juego cae en la misma casilla.
int codigoBandera(String n) {
  int h = 9;
  for (int i = 0; i < n.length(); i++) {
    h = (h * 25 + letraEn(n, i)) % BAND_TABLA;
  }
  return h;
}

// La otra parte de la imitación de tabla hash: dónde está la bandera en los vectores (si no está, devuelve -1 - la casilla libre donde iría).
// Si dos nombres caen en la misma casilla, se prueba la siguiente hasta encontrarlo o una vacía.
int posBandera(String n) {
  int h = codigoBandera(n);
  while (banderaIndice[h] != 0) {
    int i = banderaIndice[h] - 1;
    if (banderaNombre[i].equals(n)) return i;
    h = (h + 1) % BAND_TABLA;
  }
  return -1 - h;
}

// Valor de una bandera (lo que ya pasó en la historia); 0 si nunca se puso. La busca con posBandera (la imitación de tabla hash).
int bandera(String n) {
  int i = posBandera(n);
  if (i >= 0) return banderaValor[i]; else return 0;
}

// Suma a una bandera; si no existe, la crea en la casilla libre que le da posBandera.
void sumarBandera(String n, int v) {
  int i = posBandera(n);
  if (i >= 0) { banderaValor[i] += v; return; }
  if (banderasN >= MAX_BANDERAS) return;
  banderaNombre[banderasN] = n;
  banderaValor[banderasN] = v;
  banderaIndice[-1 - i] = banderasN + 1;
  banderasN++;
}

// Persona por el nombre que usa el guion en los efectos ("Mamá", "Núñez", "Entrenador"...)
int personaPorNombre(String n) {
  n = quitarBordes(n);
  if (n.equals("Entrenador")) n = "Ochoa";
  for (int f = 0; f < DLG_PERSONA.length; f++) if (nombreCorto(f).equals(n)) return f;
  for (int f = 0; f < DLG_PERSONA.length; f++) if (posicionDe(DLG_PERSONA[f], n) >= 0) return f;
  return -1;
}

// Lee un efecto del guion ("Mamá +3, Social −2, Faltas +1, Redes +0,5 h, VICIO +1") y lo aplica.
// "Am" es la amistad con "persona". Lo que no entiende lo ignora. Devuelve un resumen corto.
String aplicarEfectos(String ef, int persona) {
  if (ef == null || quitarBordes(ef).equals("") || quitarBordes(ef).equals("0")) return "";
  String resumen = "";
  partirPorLetra(ef, '·');
  String[] partes = resPartirPorLetra;
  for (int i = 0; i < partes.length; i++) {
    String p = quitarBordes(partes[i]);
    partirEfecto(p);
    String[] m = resPartirEfecto;
    boolean seguir4 = true;
    if (m == null) {
      if (p.equals("NÚMERO")) { if (persona >= 0) darNumero(persona); seguir4 = false; }
      if (seguir4) {
  
        if (p.length() > 2 && p.equals(p.toUpperCase()) && posicionDe(p, " ") < 0) { sumarBandera(p, 1); resumen += p + " · "; }
        seguir4 = false;
      }
    }
    if (seguir4) {
      String nombre = quitarBordes(m[0]);
      int signo;
      if (m[1].equals("+")) signo = 1; else signo = -1;
      float valor = float(m[2].replace(',', '.')) * signo;
      String unidad = m[3];
      int v = round(valor);
      if (nombre.equals("Am")) { if (persona >= 0) cambiarAmistad(persona, v); }
      else if (nombre.equals("So") || nombre.equals("Social")) cambiarStat(ST_SOCIAL, v);
      else if (nombre.equals("En") || nombre.equals("Energía")) { if (posicionDe(p, "mañana") < 0) cambiarStat(ST_ENERGIA, v); }
      else if (nombre.equals("No") || nombre.equals("Notas")) cambiarStat(ST_NOTAS, v);
      else if (nombre.equals("Seg")) cambiarStat(ST_SEGUIDORES, v);
      else if (nombre.equals("$") || nombre.equals("Dinero")) cambiarStat(ST_DINERO, v);
      else if (nombre.equals("Faltas")) faltas += v;
      else if (nombre.equals("Tiempo")) avanzarTiempo(abs(v));
      else if (nombre.equals("Redes") || nombre.equals("Estudio") || nombre.equals("Amigos") || nombre.equals("Ejercicio")) {
        int minutos;
        if (unidad.equals("h")) minutos = round(abs(valor) * 60); else minutos = round(abs(valor));
        int cat;
        if (nombre.equals("Redes")) {
          cat = CAT_REDES;
        } else if (nombre.equals("Estudio")) {
          cat = CAT_ESTUDIAR;
        } else {
          if (nombre.equals("Ejercicio")) cat = CAT_EJERCICIO; else cat = CAT_AMIGOS;
        }
        catMedios[cat] += minutos * 2;
        if (cat == CAT_REDES) avanzarTiempo(minutos);
      }
      else if (nombre.equals("Romance") || nombre.equals("Rom")) { if (posicionDe(p, "si activo") < 0 || (persona >= 0 && nivelRomance(DLG_PERSONA[persona]) >= 1)) puntosRomance(persona, v); }
      else if (nombre.equals("Sueño")) { }
      else if (nombre.equals(nombre.toUpperCase())) sumarBandera(nombre, v);
      else {
  
        partirPorLetra(nombre, '/');
        String[] gente = resPartirPorLetra;
        for (int g = 0; g < gente.length; g++) {
          int f = personaPorNombre(gente[g]);
          if (f >= 0) cambiarAmistad(f, v);
        }
      }
      resumen += p + " · ";
    }
  }
  if (terminaCon(resumen, " · ")) resumen = resumen.substring(0, resumen.length() - 3);
  return resumen;
}

// Sube o baja la amistad con una persona; cuando ya es alta, sube más despacio.
void cambiarAmistad(int f, int v) {
  if (f < 0) return;

  if (v > 0 && amistad[f] >= 80) v = max(1, v / 3);
  else if (v > 0 && amistad[f] >= 60) v = max(1, v / 2);
  amistad[f] = constrain(amistad[f] + v, 0, 100);
  revisarNivelAmistad(f);
}

// ¿Esta respuesta es no contestar (dejar en visto o ignorar)?
boolean esSilencio(String op) {
  return empiezaCon(op, "Leer y no responder") || empiezaCon(op, "Sin responder") || empiezaCon(op, "Silencio")
    || empiezaCon(op, "No responder") || empiezaCon(op, "Ignorar");
}

// Texto del botón: sin las comillas
String sinComillas(String s) {
  s = quitarBordes(s);
  if (empiezaCon(s, "“") && terminaCon(s, "”")) return s.substring(1, s.length() - 1);
  return s;
}

// ============================ MENSAJES CON RESPUESTAS ============================
// MSG_PROG (más abajo) dice qué mensaje llega, qué día, a qué hora y qué puedes responder.
boolean[] msgEntregado;
int[] msgPendiente = new int[MSG_FILAS];
String[] msgClaves = new String[400];

// Prepara los mensajes que llegan a cierta hora de cierto día.
void iniciarMensajesProgramados() {
  sumarMensajesV20();
  msgEntregado = new boolean[MSG_PROG.length];
  for (int f = 0; f < MSG_FILAS; f++) msgPendiente[f] = -1;
}

// Si no existe el chat lo crea
int filaChat(String nombre) {
  for (int f = 0; f < MSG_FILAS; f++) if (msg[f][0].equals(nombre)) return f;
  for (int f = 0; f < MSG_FILAS; f++) {
    if (msg[f][0].equals("")) {
      msg[f][0] = nombre;
      msg[f][1] = "";
      msg[f][2] = str(msgN);
      msgN++;
      return f;
    }
  }
  return -1;
}

// Escribe un mensaje nuevo al final del chat y lo muestra ('1' te escriben, '0' escribes tú)
void agregarMensaje(String chat, char quien, String texto) {
  int f = filaChat(chat);
  if (f < 0) return;
  int col = MSG_INI + msg[f][1].length();
  if (col >= MSG_COLS) {
    for (int c = MSG_INI; c < MSG_COLS - 1; c++) msg[f][c] = msg[f][c + 1];
    msg[f][1] = msg[f][1].substring(1);
    col = MSG_COLS - 1;
  }
  msg[f][col] = texto;
  nuevomensaje(quien + str(f));
}

// ¿Se cumple la condición para que llegue un mensaje (nivel social, notas, bandera...)?
boolean condicionMsg(String c) {
  if (c == null || c.equals("")) return true;
  if (empiezaCon(c, "N:")) return NIVELES[nivelSocial()].equals(c.substring(2));
  if (empiezaCon(c, "NOTAS>=")) return stats[ST_NOTAS] >= int(c.substring(7));
  if (empiezaCon(c, "F:")) return bandera(c.substring(2)) > 0;
  if (empiezaCon(c, "E:")) return tieneTexto(elecciones, c.substring(2));
  if (empiezaCon(c, "MSG:")) return tieneTexto(msgClaves, c.substring(4));
  if (empiezaCon(c, "AM:")) {
    partir(c.substring(3), ">=");
    String[] p = resPartir;
    return amistad[personaPorNombre(p[0])] >= int(p[1]);
  }
  return true;
}

// Minuto "del día del juego": la madrugada (antes de las 5:00) cuenta como el final del día
int minutoJuego(int m) {
  if (m < 300) return m + 1440; else return m;
}

// Entrega los mensajes programados cuando llega su hora y se cumple su condición.
void revisarMensajesProgramados() {
  if (msgEntregado == null) return;
  int ahora = minutoJuego(minutoAhora());
  for (int r = 0; r < MSG_PROG.length; r++) {
    if (!msgEntregado[r] && int(MSG_PROG[r][0]) == dia && minutoJuego(aMin(MSG_PROG[r][1])) <= ahora) {
      msgEntregado[r] = true;
      String clave = MSG_PROG[r][0] + "|" + MSG_PROG[r][1] + "|" + MSG_PROG[r][2];
      if (!tieneTexto(msgClaves, clave) && condicionMsg(MSG_PROG[r][3]) && condicionMsgV21(r) && llegaMensaje(MSG_PROG[r][2], 0)) {
        agregarTexto(msgClaves, clave);
        String chat = MSG_PROG[r][2];
        agregarMensaje(chat, '1', MSG_PROG[r][4]);
        int f = filaChat(chat);
        if (f >= 0 && !MSG_PROG[r][5].equals("")) msgPendiente[f] = r;
        if (!noMolestar || !esDeNoche()) aviso("Mensaje de " + chat + ": " + recortarTexto(MSG_PROG[r][4], 50));
      }
    }
  }
}

// Corta un texto a n letras y le pone '...'.
String recortarTexto(String t, int n) {
  if (t.length() <= n) return t; else return t.substring(0, n) + "...";
}

// ¿Es de noche (de 10 p. m. a 7 a. m.)?
boolean esDeNoche() {
  int m = minutoAhora();
  return m >= 22 * 60 || m < 7 * 60;
}

// Persona a la que pertenece un chat.
int personaDelChat(String chat) {
  if (chat.equals("Mamá")) return personaIndice("Mamá (Claudia)");
  if (chat.equals("Papá")) return personaIndice("Papá (Ernesto)");
  return personaPorNombre(chat);
}

// Cuántas respuestas tiene un mensaje.
int numOpcionesMsg(int r) {
  int n = 0;
  for (int k = 0; k < 3; k++) { filaMsg(r); String[] aux1 = resFilaMsg; if (!aux1[5 + 2 * k].equals("")) n++; }
  return n;
}

// Responde un mensaje con la opción k: la escribe en el chat y aplica sus efectos.
void responderMensaje(int f, int k) {
  int r = msgPendiente[f];
  if (r < 0) return;
  filaMsg(r);
  String[] aux1 = resFilaMsg;
  String op = aux1[5 + 2 * k];
  filaMsg(r);
  String[] aux2 = resFilaMsg;
  String ef = aux2[6 + 2 * k];
  msgPendiente[f] = -1;
  String chat = msg[f][0];
  int p = personaDelChat(chat);
  if (!esSilencio(op) && !chat.equals("Avisos")) {
    int sep = posicionDe(op, "»");
    agregarMensaje(chat, '0', sinComillas(textoAntesDeFlecha(op)));

    if (sep >= 0) agregarMensaje(chat, '1', op.substring(sep + 1));
    else if (p >= 0) agregarMensaje(chat, '1', reaccion(p, signoEfecto(ef, p)));
  }
  if (chat.equals("Alertas") && empiezaCon(op, "[Te inscribes")) sumarBandera("INSCRITO_COPA", 1);
  String res = aplicarEfectosV20(ef, p);
  if (!res.equals("")) aviso(res);
}

// Al terminar el día: lo que no contestaste cuenta como "sin responder"
void mensajesSinResponder() {
  for (int f = 0; f < MSG_FILAS; f++) {
    int r = msgPendiente[f];
    if (r >= 0) {
      for (int k = 0; k < 3; k++) {
        filaMsg(r);
        String[] aux1 = resFilaMsg;
        String op = aux1[5 + 2 * k];
        if (!op.equals("") && esSilencio(op)) { filaMsg(r); String[] aux2 = resFilaMsg; aplicarEfectos(aux2[6 + 2 * k], personaDelChat(msg[f][0])); break; }
      }
      finDelDiaVisto(f);
      msgPendiente[f] = -1;
    }
  }
}

final float RESP_ALTO = 58;

// Dibuja las respuestas que puedes mandar en el chat.
void dibujarRespuestasChat() {
  if (cel != 6 || chatAbierto < 0 || msgPendiente[chatAbierto] < 0) return;
  int r = msgPendiente[chatAbierto];
  int n = numOpcionesMsg(r);
  float y0 = celY2 - BARRA_ENV - n * RESP_ALTO - 8;
  noStroke();
  fill(245, 245, 245, 245);
  rect(celX1, y0 - 34, celX2 - celX1, celY2 - y0 + 34);
  fill(90);
  textSize(17);
  textAlign(LEFT, TOP);
  text("Responder:", celX1 + 16, y0 - 28);
  int j = 0;
  for (int k = 0; k < 3; k++) {
    filaMsg(r);
    String[] aux1 = resFilaMsg;
    String op = aux1[5 + 2 * k];
    if (!op.equals("")) {
      float y = y0 + j * RESP_ALTO;
      boolean encima = mouseX > celX1 + 12 && mouseX < celX2 - 12 && mouseY > y && mouseY < y + RESP_ALTO - 8;
      if (encima) fill(color(200, 240, 210)); else fill(color(255));
      stroke(200);
      rect(celX1 + 12, y, celX2 - celX1 - 24, RESP_ALTO - 8, 12);
      noStroke();
      if (esSilencio(op)) fill(130); else fill(30);
      textSize(17);
      text(sinComillas(textoAntesDeFlecha(op)), celX1 + 26, y + 6, celX2 - celX1 - 50, RESP_ALTO - 14);
      j++;
    }
  }
  textAlign(LEFT, BASELINE);
}

// Click en una respuesta del chat.
boolean clickRespuestaChat() {
  if (cel != 6 || chatAbierto < 0 || msgPendiente[chatAbierto] < 0) return false;
  int r = msgPendiente[chatAbierto];
  int n = numOpcionesMsg(r);
  float y0 = celY2 - BARRA_ENV - n * RESP_ALTO - 8;
  int j = 0;
  for (int k = 0; k < 3; k++) {
    filaMsg(r);
    String[] aux1 = resFilaMsg;
    if (!aux1[5 + 2 * k].equals("")) {
      float y = y0 + j * RESP_ALTO;
      if (mouseX > celX1 + 12 && mouseX < celX2 - 12 && mouseY > y && mouseY < y + RESP_ALTO - 8) {
        responderMensaje(chatAbierto, k);
        msgBarra = maxBarra(altoChat(chatAbierto));
        return true;
      }
      j++;
    }
  }
  return mouseY > y0 - 34;
}

