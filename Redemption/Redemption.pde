// Clicks en Pedidazo: agregar, quitar y pagar.
void clickPedidazo() {
  float by = celY2 - 86;
  if (mouseY > by) {
    if (mouseX > celX2 - 150 && mouseX < celX2 - 76) pagarPedidazo();
    if (mouseX > celX2 - 70 && mouseX < celX2 - 14) for (int k = 0; k < carrito.length; k++) carrito[k] = 0;
    return;
  }
  if (mouseY < PED_Y0) return;
  int k = int((mouseY - PED_Y0 + pedScroll) / PED_FILA);
  if (k >= 0 && k < PEDIDAZO.length) carrito[k]++;
}

// Paga el pedido: cobra, y el paquete llega al día siguiente.
void pagarPedidazo() {
  int total = totalCarrito() + envioCarrito();
  if (total == 0) return;
  int primeroDelPedido = 0;
  for (int k = PEDIDAZO.length - 1; k >= 0; k--) if (carrito[k] > 0) primeroDelPedido = k;
  if (dinero < total) { aviso("No te alcanza: el pedido cuesta $" + total); return; }
  dinero -= total;
  for (int k = 0; k < PEDIDAZO.length; k++) {
    for (int c = 0; c < carrito[k]; c++) {
      int n = tamTexto(pedidosNombre);
      if (n >= MAX_PEDIDOS) break;
      pedidosNombre[n] = PEDIDAZO[k][0];
      pedidosDia[n] = dia + 1;
    }
    carrito[k] = 0;
  }
  avisoGrandeConIcono("¡Pedido pagado!", "Pedidazo", PEDIDAZO[primeroDelPedido][0], "−$" + total + " · llega mañana a las 7:00", color(230, 120, 40));
}

// El paquete llega a las 7:00 del día siguiente
void revisarPedidos() {
  if (tamTexto(pedidosNombre) == 0 || minutoAhora() < HORA_ENTREGA_PEDIDAZO || minutoAhora() >= 22 * 60) return;
  int n = 0;
  for (int k = tamTexto(pedidosNombre) - 1; k >= 0; k--) {
    if (pedidosDia[k] <= dia) {
      agregarInventario(pedidosNombre[k], 1);
      int total = tamTexto(pedidosNombre);
      for (int j = k; j < total - 1; j++) pedidosDia[j] = pedidosDia[j + 1];
      quitarTextoEn(pedidosNombre, k);
      n++;
    }
  }
  if (n > 0) {
    aviso("Yeison dejó tu paquete de Pedidazo (" + n + " cosas). Ya está en el inventario (TAB)");
    agregarMensaje("Avisos", '1', "Pedidazo: entregado (" + n + " cosas). Lo encuentras en tu inventario: tecla TAB.");
  }
}

