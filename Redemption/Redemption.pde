// ============================ FUTBOL - funciones ============================
// Equipo de un jugador (0 los tuyos, 1 los rivales).
int equipoDe(int k) { if (k < 4) return 0; else return 1; }
// Primer jugador de un equipo en la tabla.
int iniEq(int eq) { if (eq == 0) return 0; else return 4; }
// Hacia qué lado ataca un equipo (+1 o -1).
float dirAtaque(int eq) { if (eq == 0) return 1; else return -1; }
// Línea de anotación a la que ataca un equipo.
float bordeAtaque(int eq) { if (eq == 0) return CX2 - ENDZONE - 12; else return CX1 + ENDZONE + 12; }

// Qué jugador tiene el balón (o -1 si está suelto o en el aire).
int dueno() {
  int e = (int) football[BALON][B_EST];
  if (e >= 0 && e < 8) return e;
  return -1;
}

// Distancia entre dos jugadores.
float distJug(int a, int b) {
  return dist(football[a][F_X], football[a][F_Y], football[b][F_X], football[b][F_Y]);
}

// Distancia de un jugador a un punto.
float distA(int k, float x, float y) {
  return dist(football[k][F_X], football[k][F_Y], x, y);
}

// Velocidad de un jugador (más lento con el balón).
float velDe(int k) {
  float v;
  if (k < 4) v = velj; else v = vele;
  if (dueno() == k) v = v * FACTOR_BALON;
  return v;
}

// Velocidad del balon en el aire
float velPase(float largo) {
  return 7 + largo * 0.01;
}

// Dónde estará el balón en x dentro de fr cuadros (si va en el aire).
float balonXEn(float fr) {
  float p = min(1, football[BALON][B_P] + football[BALON][B_VP] * fr);
  return lerp(football[BALON][B_OX], football[BALON][B_DX], p);
}

// Dónde estará el balón en y dentro de fr cuadros.
float balonYEn(float fr) {
  float p = min(1, football[BALON][B_P] + football[BALON][B_VP] * fr);
  return lerp(football[BALON][B_OY], football[BALON][B_DY], p);
}

float[] resPuntoAlcanzable;

// ¿El jugador llega a tiempo a donde va a caer el balón?
// Deja el resultado en resPuntoAlcanzable.
void puntoAlcanzable(int k, float v, int maxFr, float radio) {
  int restantes = ceil((1 - football[BALON][B_P]) / max(0.0001, football[BALON][B_VP]));
  int lim = min(maxFr, restantes);
  for (int fr = 1; fr <= lim; fr++) {
    float bx = balonXEn(fr), by = balonYEn(fr);
    if (distA(k, bx, by) <= v * fr + radio) { resPuntoAlcanzable = new float[] { bx, by }; return; }
  }
  resPuntoAlcanzable = null;
}

// Probabilidad de que un tackle funcione según la distancia.
float chanceTackle(float dd) {
  float pr = constrain((RADIO_TACKLE - dd) / (RADIO_TACKLE - 20), 0, 1);
  return lerp(PROB_TACKLE, PROB_TACKLE_CERCA, pr);
}

float[] resPuntoCorteJugador;

// Punto donde un defensor puede cortarle el paso al que lleva el balón.
// Deja el resultado en resPuntoCorteJugador.
void puntoCorteJugador(int k, int du) {
  float px = football[du][F_X], py = football[du][F_Y];
  if (football[du][F_MOV] == 0) { resPuntoCorteJugador = new float[] { px, py }; return; }
  float vx = cos(football[du][F_ANG]) * velDe(du), vy = sin(football[du][F_ANG]) * velDe(du);
  for (int fr = 0; fr <= 60; fr += 3) {
    float fx = px + vx * fr, fy = py + vy * fr;
    if (distA(k, fx, fy) <= velDe(k) * fr + 10) { resPuntoCorteJugador = new float[] { fx, fy }; return; }
  }
  resPuntoCorteJugador = new float[] { px + vx * 8, py + vy * 8 };
}

// ¿Tu jugador se queda quieto esperando el pase que viene hacia él?
boolean autoRecibe(int k) {
  return k == controlado && !(tW || tA || tS || tD) && football[BALON][B_EST] == AIRE
    && (int) football[BALON][B_PASADOR] < 4 && (int) football[BALON][B_RECEPTOR] == k;
}

// Pone a los 8 jugadores en su lugar para el saque.
void formacion(int eqBalon) {
  float alto = CY2 - CY1;
  for (int k = 0; k < 8; k++) {
    for (int c = 0; c < F_COLS; c++) football[k][c] = 0;
    float yy = CY1 + alto * ((k % 4) + 0.5) / 4.0;
    football[k][F_Y] = yy;
    football[k][F_CARRIL] = yy;
    if (k < 4) {
      football[k][F_X] = FORM_XJ;
      football[k][F_ANG] = 0;
    } else {
      football[k][F_X] = FORM_XE;
      football[k][F_ANG] = PI;
    }
    football[k][F_ANGOBJ] = football[k][F_ANG];
    football[k][F_OBJX] = football[k][F_X];
    football[k][F_OBJY] = football[k][F_Y];
    football[k][F_QUIETO] = 3;
    football[k][F_MARCA] = -1;
    football[k][F_PROF] = random(90, 300);
  }
  for (int c = 0; c < F_COLS; c++) football[BALON][c] = 0;
  football[BALON][B_PASADOR] = -1;
  football[BALON][B_RECEPTOR] = -1;
  controlado = 1;
  if (eqBalon == 0) darBalon(1); else darBalon(5);
  fbMarcaT = 0;
}

// Le da el balón a un jugador.
void darBalon(int k) {
  football[BALON][B_EST] = k;
  football[BALON][B_X] = football[k][F_X];
  football[BALON][B_Y] = football[k][F_Y];
  football[BALON][B_ALT] = 0;
  equipoAtaque = equipoDe(k);
  if (football[k][F_ESTADO] == 1) {
    football[k][F_ESTADO] = 0;
    football[k][F_TIMER] = 0;
  }
  football[k][F_INMUNE] = T_INMUNE;
  football[k][F_DEC] = DEC_RECTO;
  football[k][F_DECT] = 3;
  football[k][F_OBJX] = constrain(football[k][F_X] + dirAtaque(equipoAtaque) * 150, CX1 + 10, CX2 - 10);
  football[k][F_OBJY] = football[k][F_Y];
  football[k][F_IR] = 1;
  for (int q = 0; q < 8; q++) {
    football[q][F_MANIOBRA] = MAN_NINGUNA;
    football[q][F_MANT] = 0;
  }
  fbMarcaT = 0;
  if (k < 4) cambiarControl(k);
}

// Cambia el jugador que manejas.
void cambiarControl(int nuevo) {
  if (nuevo < 0 || nuevo > 3 || nuevo == controlado) return;
  football[controlado][F_OBJX] = football[controlado][F_X];
  football[controlado][F_OBJY] = football[controlado][F_Y];
  football[controlado][F_IR] = 0;
  controlado = nuevo;
}

// El jugador se lanza (tackle o zambullida).
void lanzarse(int k, float ang) {
  football[k][F_ESTADO] = 1;
  football[k][F_TIMER] = T_LANCE;
  football[k][F_ANG] = ang;
  football[k][F_ANGOBJ] = ang;
  football[k][F_GIRO] = 0;
  football[k][F_MOV] = 1;
}

// Lanza un pase hacia un punto.
void lanzarPase(int k, float tx, float ty) {
  float x0 = football[k][F_X], y0 = football[k][F_Y];
  float largo = dist(x0, y0, tx, ty);
  if (largo < SALIDA_PASE) return;
  if (largo > PASE_MAX) {
    tx = x0 + (tx - x0) * PASE_MAX / largo;
    ty = y0 + (ty - y0) * PASE_MAX / largo;
  }
  tx = constrain(tx, CX1 + 6, CX2 - 6);
  ty = constrain(ty, CY1 + 6, CY2 - 6);
  largo = max(1, dist(x0, y0, tx, ty));
  football[BALON][B_EST] = AIRE;
  football[BALON][B_X] = x0;
  football[BALON][B_Y] = y0;
  football[BALON][B_OX] = x0;
  football[BALON][B_OY] = y0;
  football[BALON][B_DX] = tx;
  football[BALON][B_DY] = ty;
  football[BALON][B_P] = 0;
  football[BALON][B_VP] = velPase(largo) / largo;
  football[BALON][B_PASADOR] = k;
  int eq = equipoDe(k), ini = iniEq(eq);
  int rec = -1;
  float md = 99999;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k && football[q][F_ESTADO] != 2) {
      float dd = distA(q, tx, ty);
      if (dd < md) { md = dd; rec = q; }
    }
  }
  football[BALON][B_RECEPTOR] = rec;
  football[k][F_OBJX] = x0;
  football[k][F_OBJY] = y0;
  if (eq == 0 && rec >= 0) cambiarControl(rec);
}

// Pasa el balón a un compañero, apuntando adelante de él.
void pasarA(int k, int rec) {
  float rx = football[rec][F_X], ry = football[rec][F_Y];
  float largo = distJug(k, rec);
  float frames = largo / velPase(largo);
  if (football[rec][F_MOV] == 1) {
    float adel = velDe(rec) * frames * 0.6;
    rx += cos(football[rec][F_ANG]) * adel;
    ry += sin(football[rec][F_ANG]) * adel;
  }
  lanzarPase(k, rx, ry);
}

// Click: pasar el balón al compañero hacia donde apunta el mouse, o lanzarse si defiendes.
void clickFutbol() {
  int k = controlado;
  if (football[k][F_ESTADO] != 0) return;
  if (dueno() == k) {
    lanzarPase(k, mouseX, mouseY);
  } else {
    lanzarse(k, atan2(mouseY - football[k][F_Y], mouseX - football[k][F_X]));
  }
}

// Un cuadro del rugby: IA del rival, roles, tackles, movimiento y anotación.
void cicloFutbol() {
  int du = dueno();
  if (du >= 4) portadorRival(du);
  actualizarControl();
  calcularRoles();
  fbMarcaT--;
  if (fbMarcaT <= 0) {
    asignarMarcas();
    fbMarcaT = 5;
  }
  for (int k = 0; k < 8; k++) {
    if (k != controlado && football[k][F_ROL] == ROL_ATAQUE) {
      if (football[k][F_MANT] > 0) {
        football[k][F_MANT]--;
        if (football[k][F_MANT] <= 0) football[k][F_MANIOBRA] = MAN_NINGUNA;
      } else if (random(1) < PROB_MANIOBRA) {
        elegirManiobra(k);
      }
    }
  }
  du = dueno();
  for (int k = 0; k < 8; k++) {
    if (k != controlado && k != du && football[k][F_ESTADO] == 0) {
      if (random(1) < 0.5) actualizarObjetivo(k);
    }
  }
  intentarTackles();
  for (int k = 0; k < 8; k++) aplicarInercia(k);
}

// Pasa el control al jugador tuyo que tiene el balón o al más cercano.
void actualizarControl() {
  int du = dueno();
  if (du >= 0 && du < 4) {
    cambiarControl(du);
    return;
  }
  int est = (int) football[BALON][B_EST];
  float bx = football[BALON][B_X], by = football[BALON][B_Y];
  if (est == AIRE) {
    if ((int) football[BALON][B_PASADOR] < 4) return;
    bx = football[BALON][B_DX];
    by = football[BALON][B_DY];
  } else if (distA(controlado, bx, by) <= 40) {
    return;
  }
  int c = masCercano(0, bx, by);
  if (c >= 0 && (football[controlado][F_ESTADO] == 2 || distA(c, bx, by) + 15 < distA(controlado, bx, by))) cambiarControl(c);
}

// Jugador de un equipo más cercano a un punto.
int masCercano(int eq, float x, float y) {
  int ini = iniEq(eq), mejor = -1;
  float md = 99999;
  for (int q = ini; q < ini + 4; q++) {
    if (football[q][F_ESTADO] != 2) {
      float dd = distA(q, x, y);
      if (dd < md) { md = dd; mejor = q; }
    }
  }
  return mejor;
}

// Decide qué hace cada jugador: llevar el balón, apoyar, marcar o perseguir.
void calcularRoles() {
  int du = dueno();
  for (int k = 0; k < 8; k++) football[k][F_ROL] = ROL_NADA;
  if (du >= 0) {
    int eqA = equipoDe(du), iA = iniEq(eqA), iD = iniEq(1 - eqA);
    for (int k = iA; k < iA + 4; k++) football[k][F_ROL] = ROL_ATAQUE;
    football[du][F_ROL] = ROL_PORTADOR;
    for (int k = iD; k < iD + 4; k++) football[k][F_ROL] = ROL_MARCAR;
    int a = -1, b2 = -1;
    float da = 99999, db = 99999;
    for (int k = iD; k < iD + 4; k++) {
      if (football[k][F_ESTADO] != 2) {
        float dd = distJug(k, du);
        if (dd < da) { b2 = a; db = da; a = k; da = dd; }
        else if (dd < db) { b2 = k; db = dd; }
      }
    }
    if (a >= 0) football[a][F_ROL] = ROL_PERSEGUIR;
    if (a >= 0 && b2 >= 0) {
      float ladoA = football[a][F_Y] - football[du][F_Y];
      float ladoB = football[b2][F_Y] - football[du][F_Y];
      if (ladoA * ladoB < 0) football[b2][F_ROL] = ROL_PERSEGUIR;
    }
    return;
  }
  boolean aire = (football[BALON][B_EST] == AIRE);
  float bx = football[BALON][B_X], by = football[BALON][B_Y];
  int[] cerca = {-1, -1};
  float[] dCerca = {99999, 99999};
  int[] botBalon = {-1, -1};
  for (int eq = 0; eq < 2; eq++) {
    int ini = iniEq(eq);
    for (int k = ini; k < ini + 4; k++) { if (eq == equipoAtaque) football[k][F_ROL] = ROL_ATAQUE; else football[k][F_ROL] = ROL_MARCAR; }
    if (aire && eq == equipoAtaque) {
      int rec = (int) football[BALON][B_RECEPTOR];
      if (rec >= 0) {
        football[rec][F_ROL] = ROL_RECEPTOR;
        cerca[eq] = rec;
        dCerca[eq] = distA(rec, football[BALON][B_DX], football[BALON][B_DY]);
      }
    } else {
      float dBot = 99999;
      for (int k = ini; k < ini + 4; k++) {
        if (football[k][F_ESTADO] != 2) {
          float dd;
          if (aire) dd = distPuntoSegmento(football[k][F_X], football[k][F_Y], bx, by, football[BALON][B_DX], football[BALON][B_DY]);
          else dd = distA(k, bx, by);
          if (dd < dCerca[eq]) { dCerca[eq] = dd; cerca[eq] = k; }
          if (k != controlado && dd < dBot) { dBot = dd; botBalon[eq] = k; }
        }
      }
      if (botBalon[eq] >= 0) football[botBalon[eq]][F_ROL] = ROL_BALON;
    }
  }
  for (int eq = 0; eq < 2; eq++) {
    if (cerca[eq] >= 0 && !(dCerca[eq] * 1.6 > dCerca[1 - eq])) {
      int ini = iniEq(eq), mejor = -1;
      float dir = dirAtaque(eq), av = -99999;
      for (int k = ini; k < ini + 4; k++) {
        if (k != cerca[eq] && k != botBalon[eq] && k != controlado && football[k][F_ESTADO] != 2) {
          if (football[k][F_X] * dir > av) { av = football[k][F_X] * dir; mejor = k; }
        }
      }
      if (mejor >= 0) football[mejor][F_ROL] = ROL_SUBIR;
    }
  }
}

// ¿Este jugador está marcando a un rival?
boolean esMarcador(int q) {
  return q != controlado && football[q][F_ROL] == ROL_MARCAR;
}

// A cada defensor le asigna un atacante para marcar.
void asignarMarcas() {
  int du = dueno();
  int eqA = equipoAtaque, iA = iniEq(eqA), iD = iniEq(1 - eqA);
  boolean[] tomado = new boolean[8];
  boolean[] listo = new boolean[8];
  for (int vuelta = 0; vuelta < 4; vuelta++) {
    int mejor = -1;
    float md = 99999;
    for (int q = iD; q < iD + 4; q++) {
      if (!listo[q] && esMarcador(q)) {
        int mk = (int) football[q][F_MARCA];
        if (mk >= iA && mk < iA + 4 && mk != du) {
          float dd = distJug(q, mk);
          if (dd < md) { md = dd; mejor = q; }
        }
      }
    }
    if (mejor < 0) break;
    listo[mejor] = true;
    int marca = (int) football[mejor][F_MARCA];
    if (tomado[marca]) football[mejor][F_MARCA] = -1;
    else tomado[marca] = true;
  }
  for (int q = iD; q < iD + 4; q++) {
    if (esMarcador(q) && !(listo[q] && football[q][F_MARCA] >= 0)) {
      int mejor = -1;
      float md = 99999;
      for (int a = iA; a < iA + 4; a++) {
        if (a != du && !tomado[a]) {
          float dd = distJug(q, a);
          if (dd < md) { md = dd; mejor = a; }
        }
      }
      football[q][F_MARCA] = mejor;
      if (mejor >= 0) tomado[mejor] = true;
    }
  }
}

// El rival elige una jugada al azar (cortar, abrirse, pasar...).
void elegirManiobra(int k) {
  int man = 1 + (int) random(5);
  if (man == MAN_CORTAR && !puedeCortar(k)) man = 2 + (int) random(4);
  football[k][F_MANIOBRA] = man;
  football[k][F_MANT] = durManiobra[man];
}

// ¿El jugador tiene espacio para cortar hacia el centro?
boolean puedeCortar(int k) {
  float x = football[k][F_X], y = football[k][F_Y];
  if (abs(y - CENTRO_Y) < 90) return false;
  int eq = equipoDe(k), ini = iniEq(eq);
  float dir = dirAtaque(eq);
  for (int q = ini; q < ini + 4; q++) {
    if (q != k) {
      float adelante = (football[q][F_X] - x) * dir;
      if (adelante > -15 && adelante < 60) {
        if (football[q][F_MANIOBRA] == MAN_CORTAR || abs(football[q][F_Y] - CENTRO_Y) < 70) return false;
      }
    }
  }
  return true;
}

// Mantiene a los jugadores separados en línea para que no se amontonen.
float separarLinea(int k, float tx, boolean ataca) {
  int eq = equipoDe(k), ini = iniEq(eq);
  float dir = dirAtaque(eq);
  int du = dueno();
  int cuenta = 0;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k) {
      float lx = football[q][F_X];
      if (q != controlado && q != du && football[q][F_IR] == 1) lx = football[q][F_OBJX];
      if (abs(lx - tx) < 50) cuenta++;
    }
  }
  if (cuenta < 2) return tx;
  if (ataca) {
    float nuevo = tx + dir * 110;
    float borde = bordeAtaque(eq);
    if ((dir > 0 && nuevo > borde) || (dir < 0 && nuevo < borde)) nuevo = tx - dir * 110;
    return nuevo;
  }
  return tx - dir * 70;
}

// Calcula a dónde debe correr cada jugador según su rol.
void actualizarObjetivo(int k) {
  int rol = (int) football[k][F_ROL];
  int eq = equipoDe(k);
  float dir = dirAtaque(eq);
  int du = dueno();
  float x = football[k][F_X], y = football[k][F_Y];
  float tx = x, ty = y;
  float refx;
  if (du >= 0) refx = football[du][F_X]; else refx = football[BALON][B_X];
  float refy;
  if (du >= 0) refy = football[du][F_Y]; else refy = football[BALON][B_Y];

  if (rol == ROL_PERSEGUIR && du >= 0) {
    puntoCorteJugador(k, du);
    float[] pc = resPuntoCorteJugador;
    tx = pc[0];
    ty = pc[1];
  } else if (rol == ROL_MARCAR) {
    int mk = (int) football[k][F_MARCA];
    if (mk >= 0 && mk != du) {
      float f;
      if (du >= 0) f = 0.7; else f = 0.85;
      tx = lerp(refx, football[mk][F_X], f);
      ty = lerp(refy, football[mk][F_Y], f);
    } else {
      tx = refx - dir * 180;
      ty = lerp(refy, CENTRO_Y, 0.3);
    }
    tx = separarLinea(k, tx, false);
  } else if (rol == ROL_ATAQUE) {
    int man = (int) football[k][F_MANIOBRA];
    float carril = football[k][F_CARRIL];
    if (man == MAN_CORTAR) {
      tx = x + dir * 80;
      ty = CENTRO_Y;
    } else if (man == MAN_ACERCARSE) {
      float lado;
      if (carril < refy) lado = -1; else lado = 1;
      tx = refx + dir * 60;
      ty = refy + lado * 90;
    } else if (man == MAN_PROFUNDO) {
      tx = bordeAtaque(eq);
      ty = carril;
    } else if (man == MAN_ABRIRSE) {
      tx = x + dir * 80;
      if (y < CENTRO_Y) ty = CY1 + 40; else ty = CY2 - 40;
    } else if (man == MAN_REGRESO) {
      tx = refx + dir * 90;
      ty = y;
    } else {
      tx = refx + dir * football[k][F_PROF];
      ty = carril;
    }
    tx = separarLinea(k, tx, true);
  } else if (rol == ROL_BALON) {
    if (football[BALON][B_EST] == AIRE) {
      puntoAlcanzable(k, velDe(k), 400, RADIO_INTERCEPCION);
      float[] pt = resPuntoAlcanzable;
      if (pt != null) {
        tx = pt[0];
        ty = pt[1];
      } else {
        tx = football[BALON][B_DX];
        ty = football[BALON][B_DY];
      }
    } else {
      tx = football[BALON][B_X];
      ty = football[BALON][B_Y];
    }
  } else if (rol == ROL_RECEPTOR) {
    tx = football[BALON][B_DX];
    ty = football[BALON][B_DY];
  } else if (rol == ROL_SUBIR) {
    tx = x + dir * 150;
    ty = football[k][F_CARRIL];
  }
  if (rol == ROL_ATAQUE || rol == ROL_SUBIR) {
    float borde = bordeAtaque(eq);
    if (dir > 0) tx = min(tx, borde); else tx = max(tx, borde);
  }
  football[k][F_OBJX] = constrain(tx, CX1 + 10, CX2 - 10);
  football[k][F_OBJY] = constrain(ty, CY1 + 14, CY2 - 14);
  football[k][F_IR] = 1;
}

// Distancia de un punto a un segmento (para saber si un defensor tapa un pase).
float distPuntoSegmento(float px, float py, float ax, float ay, float bx, float by) {
  float vx = bx - ax, vy = by - ay;
  float len2 = vx * vx + vy * vy;
  float u = 0;
  if (len2 > 0) u = constrain(((px - ax) * vx + (py - ay) * vy) / len2, 0, 1);
  return dist(px, py, ax + vx * u, ay + vy * u);
}

// IA del rival que lleva el balón: busca un hueco o un compañero para pasar.
void portadorRival(int k) {
  int eq = equipoDe(k);
  float dir = dirAtaque(eq);
  float x = football[k][F_X], y = football[k][F_Y];
  int a = -1, b2 = -1;
  float da = 99999, db = 99999;
  int iD = iniEq(1 - eq);
  for (int q = iD; q < iD + 4; q++) {
    if (football[q][F_ESTADO] != 2) {
      float dd = distJug(k, q);
      if (dd < da) { b2 = a; db = da; a = q; da = dd; }
      else if (dd < db) { b2 = q; db = dd; }
    }
  }
  for (int q = iD; q < iD + 4; q++) {
    if (football[q][F_ESTADO] == 1 && !(distJug(k, q) > 110)) {
      if (random(1) < 0.5) {
        float angL = football[q][F_ANG];
        float cruz = cos(angL) * (y - football[q][F_Y]) - sin(angL) * (x - football[q][F_X]);
        float ang;
        if (cruz >= 0) ang = angL + HALF_PI; else ang = angL + (-HALF_PI);
        football[k][F_OBJX] = constrain(x + cos(ang) * 120, CX1 + 10, CX2 - 10);
        football[k][F_OBJY] = constrain(y + sin(ang) * 120, CY1 + 14, CY2 - 14);
        football[k][F_IR] = 1;
        return;
      }
    }
  }
  football[k][F_DECT]--;
  if (football[k][F_DECT] <= 0) {
    football[k][F_DECT] = 3;
    float pPase, pHueco;
    if (da >= RADIO_PRESION) {
      pPase = 0;
      pHueco = 0.3;
    } else {
      float pr = 1 - da / RADIO_PRESION;
      pPase = constrain(0.45 - 0.35 * pr, 0.10, 0.45);
      pHueco = constrain(0.25 + 0.55 * pr, 0.10, 0.80);
    }
    float pRecto = max(0.10, 1 - pPase - pHueco);
    float rr = random(pPase + pHueco + pRecto);
    if (rr < pPase) {
      int rec = mejorReceptor(k, a, b2);
      if (rec >= 0) {
        pasarA(k, rec);
        return;
      }
      football[k][F_DEC] = DEC_HUECO;
    } else if (rr < pPase + pHueco) {
      football[k][F_DEC] = DEC_HUECO;
    } else {
      football[k][F_DEC] = DEC_RECTO;
    }
  }
  if (random(1) < 0.5) {
    float ang;
    if (dir > 0) ang = 0; else ang = PI;
    if (football[k][F_DEC] == DEC_HUECO && a >= 0) ang = anguloHueco(k, a, b2);
    football[k][F_OBJX] = constrain(x + cos(ang) * 150, CX1 + 10, CX2 - 10);
    football[k][F_OBJY] = constrain(y + sin(ang) * 150, CY1 + 14, CY2 - 14);
    football[k][F_IR] = 1;
  }
}

// Ángulo del hueco más libre entre los defensores.
float anguloHueco(int k, int a, int b2) {
  float x = football[k][F_X], y = football[k][F_Y];
  float dir = dirAtaque(equipoDe(k));
  float empuje = 0;
  int[] dos = {a, b2};
  for (int n = 0; n < 2; n++) {
    int q = dos[n];
    if (q >= 0) {
      float adelante = (football[q][F_X] - x) * dir;
      float dy = football[q][F_Y] - y;
      float dd = max(25, distJug(k, q));
      float peso;
      if (adelante > -20) peso = 1.0; else peso = 0.35;
      float lado;
      if (dy >= 0) lado = 1; else lado = -1;
      empuje -= lado * peso * (RADIO_PRESION / dd);
    }
  }
  if (y < CY1 + 90) empuje += (CY1 + 90 - y) / 30;
  if (y > CY2 - 90) empuje -= (y - (CY2 - 90)) / 30;
  float incl = constrain(empuje * 0.2, -1, 1);
  return atan2(incl, dir);
}

// Mejor compañero para pasarle el balón.
int mejorReceptor(int k, int a, int b2) {
  int eq = equipoDe(k), ini = iniEq(eq);
  float dir = dirAtaque(eq);
  int mejor = -1;
  float mejorAv = -99999;
  for (int q = ini; q < ini + 4; q++) {
    if (q != k && football[q][F_ESTADO] != 2) {
      float dd = distJug(k, q);
      if (!(dd < 60) && !(dd > PASE_MAX) && !tapaPase(a, k, q) && !tapaPase(b2, k, q)) {
        float av = football[q][F_X] * dir;
        if (av > mejorAv) { mejorAv = av; mejor = q; }
      }
    }
  }
  return mejor;
}

// ¿Un defensor está en la línea del pase?
boolean tapaPase(int def, int k, int q) {
  if (def < 0) return false;
  return distPuntoSegmento(football[def][F_X], football[def][F_Y], football[k][F_X], football[k][F_Y], football[q][F_X], football[q][F_Y]) < 45;
}

// Los defensores cerca del que lleva el balón intentan taclearlo.
void intentarTackles() {
  int du = dueno();
  for (int k = 0; k < 8; k++) {
    if (k != controlado && football[k][F_ESTADO] == 0) {
      boolean seguir1 = true;
      if (du >= 0) {
        if (equipoDe(du) == equipoDe(k) || football[du][F_INMUNE] > 0) seguir1 = false;
        if (seguir1) {
          float dd = distJug(k, du);
          if (dd < RADIO_TACKLE && random(1) < chanceTackle(dd)) {
            float ax = football[du][F_X], ay = football[du][F_Y];
            float ox = football[k][F_OBJX], oy = football[k][F_OBJY];
            if (football[k][F_ROL] == ROL_PERSEGUIR && football[k][F_IR] == 1 && distA(k, ox, oy) > 10 && dist(ox, oy, ax, ay) < 60) {
              ax = ox;
              ay = oy;
            }
            lanzarse(k, atan2(ay - football[k][F_Y], ax - football[k][F_X]));
          }
        }
      } else if (football[k][F_ROL] == ROL_BALON) {
        float bx = football[BALON][B_X], by = football[BALON][B_Y];
        if (football[BALON][B_EST] == AIRE) {
          puntoAlcanzable(k, velDe(k) * 2, T_LANCE, RADIO_INTERCEPCION + 8);
          float[] pc = resPuntoAlcanzable;
          if (pc == null) seguir1 = false;
          if (seguir1) {
            bx = pc[0];
            by = pc[1];
          }
        }
        if (seguir1) {
          if (distA(k, bx, by) < RADIO_TACKLE && random(1) < PROB_TACKLE_BALON) {
            lanzarse(k, atan2(by - football[k][F_Y], bx - football[k][F_X]));
          }
        }
      }
    }
  }
}

// Inercia: 45 grados sin castigo, 90 = 1 ciclo, 135 = 2, 180 = 3 (girando va a media velocidad)
void aplicarInercia(int k) {
  if (football[k][F_ESTADO] != 0) return;
  boolean quiere = false;
  float deseado = football[k][F_ANG];
  if (autoRecibe(k)) {
    float ox = football[BALON][B_DX], oy = football[BALON][B_DY];
    if (distA(k, ox, oy) > 6) {
      quiere = true;
      deseado = atan2(oy - football[k][F_Y], ox - football[k][F_X]);
    }
  } else if (k == controlado) {
    int aux1;
    if (tD) aux1 = 1; else aux1 = 0;
    int aux2;
    if (tA) aux2 = 1; else aux2 = 0;
    float dx = aux1 - aux2;
    int aux3;
    if (tS) aux3 = 1; else aux3 = 0;
    int aux4;
    if (tW) aux4 = 1; else aux4 = 0;
    float dy = aux3 - aux4;
    if (dx != 0 || dy != 0) {
      quiere = true;
      deseado = atan2(dy, dx);
    }
  } else if (football[k][F_IR] == 1) {
    float ox = football[k][F_OBJX], oy = football[k][F_OBJY];
    if (distA(k, ox, oy) > 10) {
      quiere = true;
      deseado = atan2(oy - football[k][F_Y], ox - football[k][F_X]);
    }
  }
  if (!quiere) {
    football[k][F_MOV] = 0;
    football[k][F_GIRO] = 0;
    football[k][F_QUIETO] = min(football[k][F_QUIETO] + 1, 10);
    return;
  }
  if (football[k][F_MOV] == 0) {
    int castigo = max(0, castigoGiro(difAng(football[k][F_ANG], deseado)) - (int) football[k][F_QUIETO]);
    football[k][F_ANG] = deseado;
    football[k][F_ANGOBJ] = deseado;
    football[k][F_GIRO] = castigo;
    football[k][F_MOV] = 1;
    football[k][F_QUIETO] = 0;
    return;
  }
  football[k][F_QUIETO] = 0;
  float tol = radians(22.5);
  if (football[k][F_GIRO] > 0 && difAng(football[k][F_ANGOBJ], deseado) <= tol) {
    football[k][F_ANGOBJ] = deseado;
    football[k][F_GIRO]--;
    if (football[k][F_GIRO] <= 0) {
      football[k][F_GIRO] = 0;
      football[k][F_ANG] = deseado;
    }
  } else if (difAng(football[k][F_ANG], deseado) <= tol) {
    football[k][F_ANG] = deseado;
    football[k][F_ANGOBJ] = deseado;
    football[k][F_GIRO] = 0;
  } else {
    int castigo = castigoGiro(difAng(football[k][F_ANG], deseado));
    football[k][F_ANGOBJ] = deseado;
    if (castigo == 0) {
      football[k][F_ANG] = deseado;
      football[k][F_GIRO] = 0;
    } else {
      football[k][F_GIRO] = castigo;
    }
  }
}

// Cuánto se frena un jugador al girar bruscamente.
int castigoGiro(float dif) {
  return constrain(round(degrees(dif) / 45.0) - 1, 0, 3);
}

// Diferencia entre dos ángulos (de 0 a PI).
float difAng(float a, float b) {
  float dd = abs(a - b) % TWO_PI;
  if (dd > PI) dd = TWO_PI - dd;
  return dd;
}

// Mueve a todos los jugadores hacia su objetivo.
void moverFutbol() {
  for (int k = 0; k < 8; k++) {
    if (football[k][F_INMUNE] > 0) football[k][F_INMUNE]--;
    int est = (int) football[k][F_ESTADO];
    if (est == 2) {
      football[k][F_TIMER]--;
      if (football[k][F_TIMER] <= 0) {
        football[k][F_ESTADO] = 0;
        football[k][F_MOV] = 0;
        football[k][F_GIRO] = 0;
        football[k][F_QUIETO] = 3;
      }
    } else {
      float v = velDe(k);
      boolean seguir2 = true;
      if (est == 1) {
        v = v * 2;
        football[k][F_TIMER]--;
      } else {
        if (football[k][F_MOV] == 0) seguir2 = false;
        if (seguir2) {
          if (football[k][F_GIRO] > 0) v = v * 0.5;
          if (k != controlado && football[k][F_IR] == 1 && distA(k, football[k][F_OBJX], football[k][F_OBJY]) <= v) {
            football[k][F_X] = football[k][F_OBJX];
            football[k][F_Y] = football[k][F_OBJY];
            football[k][F_MOV] = 0;
            seguir2 = false;
          }
          if (seguir2) {
            if (autoRecibe(k) && distA(k, football[BALON][B_DX], football[BALON][B_DY]) <= v) {
              football[k][F_X] = football[BALON][B_DX];
              football[k][F_Y] = football[BALON][B_DY];
              football[k][F_MOV] = 0;
              seguir2 = false;
            }
          }
        }
      }
      if (seguir2) {
        football[k][F_X] += cos(football[k][F_ANG]) * v;
        football[k][F_Y] += sin(football[k][F_ANG]) * v;
        football[k][F_X] = constrain(football[k][F_X], CX1 + 8, CX2 - 8);
        football[k][F_Y] = constrain(football[k][F_Y], CY1 + 12, CY2 - 12);
        boolean seguir3 = true;
        if (est == 1) {
          if (revisarTackle(k)) seguir3 = false;
          if (seguir3) {
            if (football[k][F_TIMER] <= 0) {
              football[k][F_ESTADO] = 2;
              football[k][F_TIMER] = T_PISO;
              football[k][F_MOV] = 0;
            }
          }
        }
      }
    }
  }
  separarJugadores();
}

// ¿Este jugador tacleó al que lleva el balón?
boolean revisarTackle(int k) {
  int du = dueno();
  if (du < 0 || equipoDe(du) == equipoDe(k)) return false;
  if (football[du][F_INMUNE] > 0) return false;
  if (distJug(k, du) > RADIO_CONTACTO) return false;
  football[du][F_ESTADO] = 2;
  football[du][F_TIMER] = T_DERRIBADO;
  football[du][F_MOV] = 0;
  football[du][F_GIRO] = 0;
  darBalon(k);
  return true;
}

// Empuja a los jugadores que se pisan para que no se encimen.
void separarJugadores() {
  int du = dueno();
  for (int a = 0; a < 8; a++) {
    for (int q = a + 1; q < 8; q++) {
      if (football[a][F_ESTADO] == 0 && football[q][F_ESTADO] == 0) {
        float dx = football[q][F_X] - football[a][F_X];
        float dy = football[q][F_Y] - football[a][F_Y];
        float dd = sqrt(dx * dx + dy * dy);
        if (!(dd >= 18)) {
          if (dd < 0.01) {
            dx = random(-1, 1);
            dy = random(-1, 1);
            dd = max(0.01, sqrt(dx * dx + dy * dy));
          }
          float empA = (18 - dd) / 2, empQ = empA;
          if (a == du) { empA = 0; empQ = 18 - dd; }
          if (q == du) { empQ = 0; empA = 18 - dd; }
          football[a][F_X] -= dx / dd * empA;
          football[a][F_Y] -= dy / dd * empA;
          football[q][F_X] += dx / dd * empQ;
          football[q][F_Y] += dy / dd * empQ;
        }
      }
    }
  }
  for (int k = 0; k < 8; k++) {
    football[k][F_X] = constrain(football[k][F_X], CX1 + 8, CX2 - 8);
    football[k][F_Y] = constrain(football[k][F_Y], CY1 + 12, CY2 - 12);
  }
}

// Mueve el balón: pegado al jugador o volando en un pase.
void moverBalon() {
  int est = (int) football[BALON][B_EST];
  if (est >= 0 && est < 8) {
    football[BALON][B_X] = football[est][F_X];
    football[BALON][B_Y] = football[est][F_Y];
    return;
  }
  if (est == AIRE) {
    float x0 = football[BALON][B_X], y0 = football[BALON][B_Y];
    football[BALON][B_P] += football[BALON][B_VP];
    float p = min(1, football[BALON][B_P]);
    float ox = football[BALON][B_OX], oy = football[BALON][B_OY];
    float dx = football[BALON][B_DX], dy = football[BALON][B_DY];
    football[BALON][B_X] = lerp(ox, dx, p);
    football[BALON][B_Y] = lerp(oy, dy, p);
    football[BALON][B_ALT] = 4 * min(28, dist(ox, oy, dx, dy) * 0.06) * p * (1 - p);
    int q = quienAgarra(true, x0, y0);
    if (q >= 0) {
      darBalon(q);
      return;
    }
    if (p >= 1) {
      football[BALON][B_EST] = SUELTO;
      football[BALON][B_ALT] = 0;
    }
    return;
  }
  int q = quienAgarra(false, football[BALON][B_X], football[BALON][B_Y]);
  if (q >= 0) darBalon(q);
}

// Quién agarra el balón cuando llega (o queda suelto).
int quienAgarra(boolean enAire, float x0, float y0) {
  float bx = football[BALON][B_X], by = football[BALON][B_Y];
  int pasador = (int) football[BALON][B_PASADOR];
  int eqPase;
  if (pasador >= 0) eqPase = equipoDe(pasador); else eqPase = -1;
  if (enAire && dist(football[BALON][B_OX], football[BALON][B_OY], bx, by) < SALIDA_PASE) return -1;
  int mejor = -1;
  float md = 99999;
  for (int k = 0; k < 8; k++) {
    if (football[k][F_ESTADO] != 2 && !(enAire && k == pasador)) {
      float radio = RADIO_ATRAPE;
      if (enAire && equipoDe(k) != eqPase) radio = RADIO_INTERCEPCION;
      if (football[k][F_ESTADO] == 1) radio += 8;
      float dd = distPuntoSegmento(football[k][F_X], football[k][F_Y], x0, y0, bx, by);
      if (dd < radio && dd < md) { md = dd; mejor = k; }
    }
  }
  return mejor;
}

// ¿Alguien llegó a la zona de anotación con el balón?
void revisarAnotacion() {
  int du = dueno();
  if (du < 0 || fbEstado != 0) return;
  if (du < 4 && football[du][F_X] >= CX2 - ENDZONE) {
    golesJ++;
    anotacion(0);
  } else if (du >= 4 && football[du][F_X] <= CX1 + ENDZONE) {
    golesE++;
    anotacion(1);
  }
}

// Suma la anotación y prepara el siguiente saque.
void anotacion(int eq) {
  fbEstado = 1;
  fbPausa = 100;
  fbSaque = 1 - eq;
  if (eq == 0) fbMensaje = "¡TOUCHDOWN!"; else fbMensaje = "TOUCHDOWN DEL RIVAL";
  if (golesJ >= GOLES_GANAR || golesE >= GOLES_GANAR) fbTrasPausa = 2; else fbTrasPausa = 1;
}

