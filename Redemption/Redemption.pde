// Carga las imágenes del tutorial la primera vez.
void cargarTutorial() {
  if (tutorialCargado) return;
  tutorialCargado = true;
  tutTeclado = cargarSiExiste("extras/tutorial/teclado.png");
  tutImg = new PImage[TUT_MECANICAS.length];
  for (int i = 0; i < TUT_MECANICAS.length; i++) tutImg[i] = cargarSiExiste("extras/tutorial/" + TUT_MECANICAS[i][0] + ".png");
}

// Abre el tutorial de cómo se juega.
void abrirTutorial() {
  cargarTutorial();
  tutorialAbierto = true;
  tutorialVisto = true;
  tutorialPag = 0;
  if (cel != 0) cel = 0;
}

// Cierra el tutorial.
void cerrarTutorial() {
  tutorialAbierto = false;
}

// Cada cuadro: el día 1, apenas termina la intro y no estás haciendo nada, sale el tutorial
void revisarTutorial() {
  if (tutorialVisto || tutorialAbierto || screen != 1 || finJuego || dia != 1) return;
  if (!introVista || actividad != ACT_NINGUNA || !escId.equals("") || menuAbierto || viajeActivo) return;
  abrirTutorial();
}

