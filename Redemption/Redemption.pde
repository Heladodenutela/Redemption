}

// ============================ DEUDA DE SUEÑO ============================
// Cada vez que el reloj pasa la 1:00 y sigues despierto, la deuda sube 1 (también si una
// actividad larga adelanta la hora). Solo baja durmiendo en la cama (dormir).
int unaContada = -99;

// Cuántas noches han pasado en el reloj.
int nochesHastaAhora() {
  int abs = horagp / 2 + 360;
  return (abs - 60 + 1440) / 1440 - 1;
}

// Si pasó una noche sin dormir, suma deuda de sueño.
void revisarDeudaNoche() {
  int k = nochesHastaAhora();
  if (unaContada == -99 || k < unaContada) { unaContada = k; return; }
  if (k <= unaContada || finJuego) return;
  deudaSueno += k - unaContada;
  unaContada = k;
  aviso("Ya pasó la 1:00 y sigues despierto · Deuda de sueño " + nf(deudaSueno, 0, 1));
}

// Marca que esta noche sí dormiste.
void nocheDormida() {
  unaContada = nochesHastaAhora();
}

