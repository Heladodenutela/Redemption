String[] resRespuestaV21;

// La respuesta: primero las de esa persona, si no las de su círculo, si no las de todos
// Deja el resultado en resRespuestaV21.
void respuestaV21(int p, String tipo) {
  String nom = DLG_PERSONA[p], corto = nombreCorto(p), circ = circulosDe(p);
  for (int paso = 0; paso < 3; paso++) {
    int mejor = -1, cuantas = 0;
    for (int k = 0; k < RESP_V21.length; k++) {
      String[] r = RESP_V21[k];
      if (r[1].equals(tipo) && int(r[2]) <= amistad[p]) {
        boolean es;
        if (paso == 0) {
          es = (r[0].equals(nom) || r[0].equals(corto));
        } else {
          if (paso == 1) es = posicionDe(circ, " " + r[0] + " ") >= 0; else es = r[0].equals("TODOS");
        }
        if (es) {
          if (mejor < 0 || int(r[2]) > int(RESP_V21[mejor][2])) { mejor = k; cuantas = 1; }
          else if (int(r[2]) == int(RESP_V21[mejor][2])) cuantas++;
        }
      }
    }
    if (mejor >= 0) {
      int usada = bandera("ESCN_" + p + "_" + tipo);
      int toca = usada % cuantas, i = 0;
      for (int k = 0; k < RESP_V21.length; k++) {
        String[] r = RESP_V21[k];
        if (r[1].equals(tipo) && r[2].equals(RESP_V21[mejor][2])) {
          boolean es;
          if (paso == 0) {
            es = (r[0].equals(nom) || r[0].equals(corto));
          } else {
            if (paso == 1) es = posicionDe(circ, " " + r[0] + " ") >= 0; else es = r[0].equals("TODOS");
          }
          if (es) {
            if (i++ == toca) { resRespuestaV21 = r; return; }
          }
        }
      }
    }
  }
  resRespuestaV21 = new String[] { "", tipo, "0", "Ok.", "" };
}

// Cuando pasa el rato, llega la respuesta a lo que escribiste.
void revisarRespuestaEscritaV21() {
  if (escChatV21 == null || millis() < escEnV21) return;
  int p = escPersonaV21;
  respuestaV21(p, escTipoV21);
  String[] r = resRespuestaV21;
  sumarBandera("ESCN_" + p + "_" + escTipoV21, 1);
  String chat = escChatV21;
  escChatV21 = null;
  partir(r[3], "//");
  String[] partes = resPartir;
  for (int i = 0; i < partes.length; i++) if (quitarBordesProcessing(partes[i]).length() > 0) agregarMensaje(chat, '1', quitarBordesProcessing(partes[i]));
  int fc = filaChatSiExiste(chat);
  if (cel == 6 && chatAbierto == fc) msgBarra = maxBarra(altoChat(fc));
  else aviso("WhatsApp · " + chat + ": " + recortarTexto(partes[0], 50));
  String res = aplicarEfectosV20(r[4], p);
  if (!res.equals("")) aviso(res);
}

