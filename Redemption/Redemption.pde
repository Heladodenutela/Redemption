// ============================ SPRITES DEL PROTAGONISTA SEGÚN LO QUE HACE ============================
final int FILA_SENTADO = 10, FILA_ESTUDIAR = 12;
int celAntes = 0, celDesde = 0;
final int FILA_CANTAR = 15;
final int ACOST_DORMIR = 0, ACOST_CELULAR = 1;

// ¿La hoja de sprites tiene esa fila de animación?
boolean hojaTieneFila(PImage h, int fila, int ch) {
  return h != null && h.height >= (fila + 1) * ch;
}

// Devuelve true si ya lo dibujó (si no, dibujarProtagonista() sigue con caminar/AFK)
boolean dibujarProtagonistaEspecial() {
  float esc = escalaPJ();
  int col = (cuadros / VEL_AFK) % 4;
  if (actividad == ACT_SOFA || actividad == ACT_INSOMNIO || actividad == ACT_DESPERTAR) {
    boolean enSofa = actividad == ACT_SOFA;
    float x;
    if (enSofa) x = SOFA_X; else x = CAMA_X;
    float y;
    if (enSofa) y = SOFA_Y; else y = CAMA_Y;
    int fila;
    if (cel != 0) fila = ACOST_CELULAR; else fila = ACOST_DORMIR;
    dibujarHoja(pj_protagonista_acostado, 240, 160, fila, col, aPantallaX(x) - 120 * esc, aPantallaY(y) - 160 * esc, esc);
    return true;
  }
  if (actividad == ACT_SENTADO || actividad == ACT_CLASE || actividad == ACT_CLASE_JUEGO || actividad == ACT_CLASE_RES || actividad == ACT_CINEMATICA) {
    dibujarPersonaje(pj_protagonista, FILA_SENTADO, col, pjX, pisoMapa[mapaActual]);
    return true;
  }
  if (actividad == ACT_ESTUDIAR || actividad == ACT_ESTUDIO_JUEGO || actividad == ACT_ESTUDIO_FIN) {
    int fila;
    if (cel != 0) fila = FILA_SENTADO; else fila = FILA_ESTUDIAR;
    float sube;
    if (mapaActual == C5) sube = SILLA_SUBIR; else sube = 0;
    dibujarPersonaje(pj_protagonista, fila, col, pjX, pisoMapa[mapaActual] - sube);
    return true;
  }
  if (cel != 0) {

    if (celAntes == 0) celDesde = millis();
    celAntes = cel;
    int c = min(2, (millis() - celDesde) / CEL_SACAR_MS);
    dibujarPersonaje(pj_protagonista, FILA_AFK_ACCION, c, pjX, pisoMapa[mapaActual]);
    return true;
  }
  celAntes = 0;
  return false;
}

